FILE	frontend/src/lib/bootstrap.test.ts
import { describe, expect, it, vi } from 'vitest';
import { describeBootstrapError, startUi, whenDocumentReady } from './bootstrap';

function targetFixture() {
  const loading = { textContent: 'Loading...', remove: vi.fn() };
  let mounted = false;
  const target = {
    querySelector: vi.fn((selector: string) => {
      if (selector === '#kira-loading') return loading;
      if (selector === 'main.bar') return mounted ? {} : null;
      return null;
    }),
  } as unknown as HTMLElement;
  return { target, loading, markMounted: () => { mounted = true; } };
}

describe('Svelte bootstrap diagnostics', () => {
  it('keeps visible fallback when Svelte mount throws', () => {
    const { target, loading } = targetFixture();
    const logs: string[] = [];
    const result = startUi(target, () => {
      throw new TypeError('DOM API unavailable');
    }, (value) => logs.push(value));
    expect(result).toBe(false);
    expect(loading.textContent).toContain('TypeError: DOM API unavailable');
    expect(loading.remove).not.toHaveBeenCalled();
    expect(logs.join('\n')).toContain('bootstrap exception: TypeError: DOM API unavailable');
  });

  it('only removes the fallback after a rendered panel exists', () => {
    const { target, loading, markMounted } = targetFixture();
    const events: string[] = [];
    const result = startUi(target, markMounted, (value) => events.push(value));
    expect(result).toBe(true);
    expect(loading.remove).toHaveBeenCalledOnce();
    expect(events).toContain('bootstrap: Svelte mount and flush returned');
  });

  it('reports synchronous mounting that did not produce the panel', () => {
    const { target, loading } = targetFixture();
    const logs: string[] = [];
    expect(startUi(target, () => undefined, (value) => logs.push(value))).toBe(false);
    expect(logs.join(' ')).toContain('main.bar is missing');
    expect(loading.remove).not.toHaveBeenCalled();
  });

  it('reports errors with usable stack traces', () => {
    const error = new Error('bad mount');
    expect(describeBootstrapError(error)).toContain('bad mount');
    expect(describeBootstrapError(error)).toContain('stack=');
    expect(describeBootstrapError('failure')).toBe('failure');
  });
});

describe('Classic script bootstrap timing', () => {
  it('waits for the DOMContentLoaded event if body is still parsing', () => {
    const listeners = new Map<string, () => void>();
    const addEventListener = vi.fn((event: string, fn: () => void) => {
      listeners.set(event, fn);
    });
    const page = {
      readyState: 'loading',
      addEventListener,
    } as unknown as Pick<Document, 'readyState' | 'addEventListener'>;
    const start = vi.fn();
    whenDocumentReady(page, start);
    expect(start).not.toHaveBeenCalled();
    expect(addEventListener).toHaveBeenCalledWith('DOMContentLoaded', start, { once: true });
    listeners.get('DOMContentLoaded')?.();
    expect(start).toHaveBeenCalledOnce();
  });

  it('mounts immediately when the document has already loaded', () => {
    const addEventListener = vi.fn();
    const page = {
      readyState: 'complete',
      addEventListener,
    } as unknown as Pick<Document, 'readyState' | 'addEventListener'>;
    const start = vi.fn();
    whenDocumentReady(page, start);
    expect(start).toHaveBeenCalledOnce();
    expect(addEventListener).not.toHaveBeenCalled();
  });
});

FILE	frontend/src/lib/bootstrap.ts
/** Human-readable synchronous bootstrap failure, even when WebKit window.onerror is opaque. */
export function describeBootstrapError(error: unknown): string {
  if (error instanceof Error) {
    return [error.name + ': ' + error.message, error.stack].filter(Boolean).join(' | stack=');
  }
  if (error && typeof error === 'object') {
    const record = error as Record<string, unknown>;
    const message = typeof record.message === 'string' ? record.message : String(error);
    const stack = typeof record.stack === 'string' ? record.stack : '';
    return [message, stack].filter(Boolean).join(' | stack=');
  }
  return String(error);
}

/**
 * Keep the visible fallback until Svelte has rendered. Report every milestone.
 * Errors thrown inside a bundled inline script are caught here, rather than
 * relying on WebKit's opaque "Script error." window event.
 */
export function startUi(
  target: HTMLElement | null,
  mountAndFlush: (target: HTMLElement) => void,
  report: (message: string) => void,
): boolean {
  if (!target) {
    report('bootstrap failure: #app not found; readyState=' + document.readyState);
    return false;
  }

  const fallback = target.querySelector('#kira-loading');
  report('bootstrap: target found; fallback=' + Boolean(fallback));
  try {
    report('bootstrap: entering Svelte mount');
    mountAndFlush(target);
    report('bootstrap: Svelte mount and flush returned');
    if (!target.querySelector('main.bar')) {
      throw new Error('Svelte mount returned but main.bar is missing after flushSync');
    }
    fallback?.remove();
    return true;
  } catch (error) {
    const detail = describeBootstrapError(error);
    report('bootstrap exception: ' + detail);
    if (fallback) {
      fallback.textContent = 'Kira UI error: ' + detail.slice(0, 220);
    }
    return false;
  }
}

/**
 * Vite emits module scripts in <head> with deferred semantics. Our build
 * inlines that bundle as a classic script, which executes immediately.
 * Wait for DOMContentLoaded so #app exists before Svelte's mount().
 */
export function whenDocumentReady(
  page: Pick<Document, 'readyState' | 'addEventListener'>,
  start: () => void,
): void {
  if (page.readyState === 'loading') {
    page.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
}

