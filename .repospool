FILE	crates/kira-ipc/src/client.rs
//! Blocking, bounded Unix-socket client used by the Shell worker thread.
use std::io::{self, BufRead, BufReader, Read, Write};
use std::os::unix::net::UnixStream;
use std::path::Path;
use std::time::Duration;

use crate::{RpcRequest, RpcResponse};

const MAX_RESPONSE_BYTES: u64 = 64 * 1024;

/// Sends a single JSON-RPC request and waits for a single newline-delimited reply.
/// Call this on a worker thread, never on the GTK main loop.
pub fn call(socket: &Path, request: &RpcRequest) -> io::Result<RpcResponse> {
    let mut stream = UnixStream::connect(socket)?;
    stream.set_read_timeout(Some(Duration::from_secs(2)))?;
    stream.set_write_timeout(Some(Duration::from_secs(2)))?;

    serde_json::to_writer(&mut stream, request)?;
    stream.write_all(b"\n")?;
    stream.flush()?;

    let mut reader = BufReader::new(stream).take(MAX_RESPONSE_BYTES + 1);
    let mut reply = Vec::new();
    reader.read_until(b'\n', &mut reply)?;
    if reply.len() as u64 > MAX_RESPONSE_BYTES {
        return Err(io::Error::new(
            io::ErrorKind::InvalidData,
            "IPC response too large",
        ));
    }
    if !reply.ends_with(b"\n") {
        return Err(io::Error::new(
            io::ErrorKind::UnexpectedEof,
            "Incomplete IPC response",
        ));
    }
    let response: RpcResponse = serde_json::from_slice(&reply)?;
    if response.jsonrpc != crate::PROTOCOL_VERSION || response.id != Some(request.id) {
        return Err(io::Error::new(
            io::ErrorKind::InvalidData,
            "Invalid JSON-RPC response id/version",
        ));
    }
    Ok(response)
}

/// Subscribe to live read-only workspace snapshots over one persistent
/// Core connection. Each JSON-RPC frame repeats the id of the subscription
/// request; the callback is invoked on the CALLER'S thread, not GTK's loop.
/// Returns on disconnect so the caller can reconnect and mark the UI offline.
pub fn subscribe_workspaces<F: FnMut(crate::WorkspaceState)>(
    socket: &Path,
    on_state: F,
) -> io::Result<()> {
    subscribe_workspaces_with_timeout(socket, on_state, crate::SUBSCRIPTION_READ_TIMEOUT)
}

fn subscribe_workspaces_with_timeout<F: FnMut(crate::WorkspaceState)>(
    socket: &Path,
    mut on_state: F,
    read_timeout: Duration,
) -> io::Result<()> {
    let mut stream = UnixStream::connect(socket)?;
    // Core heartbeats keep genuinely idle subscriptions alive. If Core hangs
    // while keeping its socket open, the timeout returns control to Shell,
    // whose existing reconnect loop clears the stale workspace snapshot.
    stream.set_read_timeout(Some(read_timeout))?;
    stream.set_write_timeout(Some(Duration::from_secs(2)))?;
    let request = RpcRequest {
        params: None,
        jsonrpc: crate::PROTOCOL_VERSION.into(),
        id: 0,
        method: "subscribe_workspaces".into(),
    };
    serde_json::to_writer(&mut stream, &request)?;
    stream.write_all(b"\n")?;
    stream.flush()?;

    let mut reader = BufReader::new(stream);
    loop {
        let mut line = Vec::new();
        reader
            .by_ref()
            .take(MAX_RESPONSE_BYTES + 1)
            .read_until(b'\n', &mut line)?;
        if line.is_empty() {
            return Err(io::Error::new(
                io::ErrorKind::UnexpectedEof,
                "Core subscription closed",
            ));
        }
        if line.len() as u64 > MAX_RESPONSE_BYTES || !line.ends_with(b"\n") {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "Invalid workspace frame",
            ));
        }
        let reply: RpcResponse = serde_json::from_slice(&line)?;
        if reply.jsonrpc != crate::PROTOCOL_VERSION || reply.id != Some(0) || reply.error.is_some()
        {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "Invalid workspace reply",
            ));
        }
        let state = reply.result.ok_or_else(|| {
            io::Error::new(io::ErrorKind::InvalidData, "Workspace result missing")
        })?;
        if crate::is_subscription_heartbeat(&state) {
            continue; // Liveness is not a new workspace snapshot.
        }
        let state: crate::WorkspaceState = serde_json::from_value(state)?;
        on_state(state);
    }
}

/// Internal read-only config stream. Never called from the GTK main thread.
/// Returns on disconnect so the Shell can preserve last applied config and
/// reconnect. No JS command or filesystem write is exposed.
pub fn subscribe_config<F: FnMut(crate::ConfigState)>(
    socket: &Path,
    on_state: F,
) -> io::Result<()> {
    subscribe_config_with_timeout(socket, on_state, crate::SUBSCRIPTION_READ_TIMEOUT)
}

fn subscribe_config_with_timeout<F: FnMut(crate::ConfigState)>(
    socket: &Path,
    mut on_state: F,
    read_timeout: Duration,
) -> io::Result<()> {
    let mut stream = UnixStream::connect(socket)?;
    stream.set_read_timeout(Some(read_timeout))?;
    stream.set_write_timeout(Some(Duration::from_secs(2)))?;
    let request = RpcRequest {
        params: None,
        jsonrpc: crate::PROTOCOL_VERSION.into(),
        id: 0,
        method: "subscribe_config".into(),
    };
    serde_json::to_writer(&mut stream, &request)?;
    stream.write_all(b"\n")?;
    stream.flush()?;

    let mut reader = BufReader::new(stream);
    loop {
        let mut line = Vec::new();
        reader
            .by_ref()
            .take(MAX_RESPONSE_BYTES + 1)
            .read_until(b'\n', &mut line)?;
        if line.is_empty() {
            return Err(io::Error::new(
                io::ErrorKind::UnexpectedEof,
                "Core config stream closed",
            ));
        }
        if line.len() as u64 > MAX_RESPONSE_BYTES || !line.ends_with(b"\n") {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "Invalid config frame",
            ));
        }
        let reply: RpcResponse = serde_json::from_slice(&line)?;
        if reply.jsonrpc != crate::PROTOCOL_VERSION || reply.id != Some(0) || reply.error.is_some()
        {
            return Err(io::Error::new(
                io::ErrorKind::InvalidData,
                "Invalid config response",
            ));
        }
        let value = reply
            .result
            .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "Config result missing"))?;
        if crate::is_subscription_heartbeat(&value) {
            continue; // Keep the last known good config unchanged.
        }
        on_state(serde_json::from_value(value)?);
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::PROTOCOL_VERSION;
    use std::os::unix::net::UnixListener;
    use std::thread;

    #[test]
    fn round_trip_over_real_unix_socket() {
        let dir = std::env::temp_dir().join(format!("kira-ipc-test-{}", std::process::id()));
        std::fs::create_dir_all(&dir).unwrap();
        let path = dir.join("rpc.sock");
        let _ = std::fs::remove_file(&path);
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut raw = String::new();
            reader.read_line(&mut raw).unwrap();
            let request: RpcRequest = serde_json::from_str(&raw).unwrap();
            let response = crate::dispatch(request);
            let mut stream = reader.into_inner();
            serde_json::to_writer(&mut stream, &response).unwrap();
            stream.write_all(b"\n").unwrap();
        });

        let response = call(
            &path,
            &RpcRequest {
                params: None,
                jsonrpc: PROTOCOL_VERSION.into(),
                id: 42,
                method: "ping".into(),
            },
        )
        .unwrap();
        assert_eq!(response.result, Some(serde_json::json!("pong")));
        server.join().unwrap();
        std::fs::remove_file(&path).unwrap();
        std::fs::remove_dir(&dir).unwrap();
    }

    #[test]
    fn live_workspace_subscription_receives_multiple_snapshots() {
        let dir = std::env::temp_dir().join(format!("kira-sub-client-{}", std::process::id()));
        std::fs::create_dir_all(&dir).unwrap();
        let path = dir.join("ipc.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut raw = String::new();
            reader.read_line(&mut raw).unwrap();
            let request: RpcRequest = serde_json::from_str(&raw).unwrap();
            assert_eq!(request.method, "subscribe_workspaces");
            assert_eq!(request.id, 0);
            let mut stream = reader.into_inner();
            for state in [false, true] {
                let reply = crate::RpcResponse::success(
                    0,
                    serde_json::json!({
                        "connected": state, "workspaces": []
                    }),
                );
                serde_json::to_writer(&mut stream, &reply).unwrap();
                stream.write_all(b"\n").unwrap();
            }
        });
        let mut received = Vec::new();
        assert!(subscribe_workspaces(&path, |state| received.push(state.connected)).is_err());
        assert_eq!(received, vec![false, true]);
        server.join().unwrap();
        std::fs::remove_file(&path).unwrap();
        std::fs::remove_dir(&dir).unwrap();
    }

    #[test]
    fn config_subscription_receives_validated_settings() {
        let dir = std::env::temp_dir().join(format!("kira-config-client-{}", std::process::id()));
        std::fs::create_dir_all(&dir).unwrap();
        let path = dir.join("core.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (socket, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(socket);
            let mut line = String::new();
            reader.read_line(&mut line).unwrap();
            let request: RpcRequest = serde_json::from_str(&line).unwrap();
            assert_eq!(request.method, "subscribe_config");
            let mut socket = reader.into_inner();
            let state = crate::ConfigState {
                config: crate::UiConfig {
                    compact: true,
                    ..Default::default()
                },
                error: None,
            };
            let reply = crate::RpcResponse::success(0, serde_json::to_value(state).unwrap());
            serde_json::to_writer(&mut socket, &reply).unwrap();
            socket.write_all(b"\n").unwrap();
        });
        let mut seen = Vec::new();
        assert!(subscribe_config(&path, |state| seen.push(state.config.compact)).is_err());
        assert_eq!(seen, vec![true]);
        server.join().unwrap();
        std::fs::remove_file(path).unwrap();
        std::fs::remove_dir(dir).unwrap();
    }

    #[test]
    fn workspace_heartbeats_do_not_emit_duplicate_snapshots() {
        let directory = std::env::temp_dir().join(format!(
            "kira-ipc-heartbeat-ws-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let path = directory.join("rpc.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut request = String::new();
            reader.read_line(&mut request).unwrap();
            assert!(request.contains("subscribe_workspaces"));
            let mut stream = reader.into_inner();
            for frame in [
                crate::RpcResponse::success(
                    0,
                    serde_json::json!({"connected": false, "workspaces": []}),
                ),
                crate::RpcResponse::heartbeat(0),
                crate::RpcResponse::heartbeat(0),
                crate::RpcResponse::success(
                    0,
                    serde_json::json!({"connected": true, "workspaces": []}),
                ),
            ] {
                serde_json::to_writer(&mut stream, &frame).unwrap();
                stream.write_all(b"\n").unwrap();
            }
        });
        let mut observed = Vec::new();
        assert!(subscribe_workspaces(&path, |state| observed.push(state.connected)).is_err());
        assert_eq!(observed, vec![false, true]);
        server.join().unwrap();
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn config_heartbeats_preserve_last_valid_settings() {
        let directory = std::env::temp_dir().join(format!(
            "kira-ipc-heartbeat-config-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let path = directory.join("rpc.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut request = String::new();
            reader.read_line(&mut request).unwrap();
            assert!(request.contains("subscribe_config"));
            let mut stream = reader.into_inner();
            let state = crate::ConfigState::default();
            for frame in [
                crate::RpcResponse::success(0, serde_json::to_value(&state).unwrap()),
                crate::RpcResponse::heartbeat(0),
                crate::RpcResponse::heartbeat(0),
            ] {
                serde_json::to_writer(&mut stream, &frame).unwrap();
                stream.write_all(b"\n").unwrap();
            }
        });
        let mut observed = Vec::new();
        assert!(subscribe_config(&path, |state| observed.push(state)).is_err());
        assert_eq!(observed, vec![crate::ConfigState::default()]);
        server.join().unwrap();
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn silent_but_open_workspace_socket_times_out() {
        let directory = std::env::temp_dir().join(format!(
            "kira-ipc-silent-ws-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let path = directory.join("rpc.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut request = String::new();
            reader.read_line(&mut request).unwrap();
            let mut stream = reader.into_inner();
            let frame = crate::RpcResponse::success(
                0,
                serde_json::json!({"connected": true, "workspaces": []}),
            );
            serde_json::to_writer(&mut stream, &frame).unwrap();
            stream.write_all(b"\n").unwrap();
            thread::sleep(Duration::from_millis(500)); // TCP/Unix connection stays open.
        });
        let mut observed = Vec::new();
        let error = subscribe_workspaces_with_timeout(
            &path,
            |state| observed.push(state.connected),
            Duration::from_millis(150),
        )
        .unwrap_err();
        assert!(matches!(
            error.kind(),
            io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
        ));
        assert_eq!(observed, vec![true]);
        server.join().unwrap();
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn silent_but_open_config_socket_times_out() {
        let directory = std::env::temp_dir().join(format!(
            "kira-ipc-silent-config-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let path = directory.join("rpc.sock");
        let listener = UnixListener::bind(&path).unwrap();
        let server = thread::spawn(move || {
            let (stream, _) = listener.accept().unwrap();
            let mut reader = BufReader::new(stream);
            let mut request = String::new();
            reader.read_line(&mut request).unwrap();
            let mut stream = reader.into_inner();
            let frame = crate::RpcResponse::success(
                0,
                serde_json::to_value(crate::ConfigState::default()).unwrap(),
            );
            serde_json::to_writer(&mut stream, &frame).unwrap();
            stream.write_all(b"\n").unwrap();
            thread::sleep(Duration::from_millis(500));
        });
        let mut observed = Vec::new();
        let error = subscribe_config_with_timeout(
            &path,
            |state| observed.push(state),
            Duration::from_millis(150),
        )
        .unwrap_err();
        assert!(matches!(
            error.kind(),
            io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
        ));
        assert_eq!(observed, vec![crate::ConfigState::default()]);
        server.join().unwrap();
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn missing_socket_returns_error() {
        let response = call(
            Path::new("/nonexistent/kira-desktop.sock"),
            &RpcRequest {
                params: None,
                jsonrpc: PROTOCOL_VERSION.into(),
                id: 1,
                method: "ping".into(),
            },
        );
        assert!(response.is_err());
    }
}

FILE	crates/kira-ipc/src/lib.rs
//! Read-only, bounded JSON-RPC state shared between Core and the GTK Shell.
//! Niri EventStream updates are owned by Core; UI can only query snapshots.

pub mod client;

use std::time::Duration;

use serde::{Deserialize, Serialize};
use serde_json::{Value, json};

pub const PROTOCOL_VERSION: &str = "2.0";

/// Read-only subscription streams send a heartbeat even when Niri and KDL
/// have not changed. Clients reconnect after three missed heartbeat periods.
pub const SUBSCRIPTION_HEARTBEAT_INTERVAL: Duration = Duration::from_secs(5);
pub const SUBSCRIPTION_READ_TIMEOUT: Duration = Duration::from_secs(15);

/// Heartbeats share the subscription's JSON-RPC id but never represent state.
/// Match the *entire* shape so malformed results cannot silently mask errors.
pub fn is_subscription_heartbeat(value: &Value) -> bool {
    value == &json!({"heartbeat": true})
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct RpcRequest {
    pub jsonrpc: String,
    pub id: u64,
    pub method: String,
    #[serde(default, skip_serializing_if = "Option::is_none")]
    pub params: Option<Value>,
}

#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
pub struct RpcResponse {
    pub jsonrpc: String,
    pub id: Option<u64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub result: Option<Value>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub error: Option<RpcError>,
}

#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct RpcError {
    pub code: i32,
    pub message: String,
}

/// Niri workspace id is a u64. Send it as a string to avoid JS precision loss.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct Workspace {
    pub id: String,
    pub idx: u8,
    pub name: Option<String>,
    pub output: Option<String>,
    pub is_active: bool,
    pub is_focused: bool,
    pub is_urgent: bool,
}

#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
pub struct WorkspaceState {
    pub connected: bool,
    pub workspaces: Vec<Workspace>,
}

/// Validated KDL appearance settings sent to the trusted frontend.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct UiConfig {
    pub compact: bool,
    pub title: String,
    pub show_seconds: bool,
    pub show_names: bool,
    pub max_workspaces: u8,
}

impl Default for UiConfig {
    fn default() -> Self {
        Self {
            compact: false,
            title: "KIRA DESKTOP".into(),
            show_seconds: false,
            show_names: true,
            max_workspaces: 12,
        }
    }
}

/// Last successfully parsed config plus an optional validation diagnostic.
/// Invalid reloads preserve the previous working UiConfig.
#[derive(Debug, Clone, PartialEq, Eq, Default, Serialize, Deserialize)]
pub struct ConfigState {
    pub config: UiConfig,
    pub error: Option<String>,
}

impl RpcResponse {
    pub fn heartbeat(id: u64) -> Self {
        Self::success(id, json!({"heartbeat": true}))
    }

    pub fn success(id: u64, value: Value) -> Self {
        Self {
            jsonrpc: PROTOCOL_VERSION.into(),
            id: Some(id),
            result: Some(value),
            error: None,
        }
    }

    pub fn failure(id: Option<u64>, code: i32, message: &str) -> Self {
        Self {
            jsonrpc: PROTOCOL_VERSION.into(),
            id,
            result: None,
            error: Some(RpcError {
                code,
                message: message.into(),
            }),
        }
    }
}

pub fn dispatch(request: RpcRequest) -> RpcResponse {
    dispatch_with_workspaces(request, &WorkspaceState::default())
}

pub fn dispatch_with_workspaces(request: RpcRequest, state: &WorkspaceState) -> RpcResponse {
    dispatch_with_state(request, state, &ConfigState::default())
}

pub fn dispatch_with_state(
    request: RpcRequest,
    workspaces: &WorkspaceState,
    config: &ConfigState,
) -> RpcResponse {
    if request.jsonrpc != PROTOCOL_VERSION {
        return RpcResponse::failure(Some(request.id), -32600, "Invalid Request");
    }

    match request.method.as_str() {
        "ping" => RpcResponse::success(request.id, json!("pong")),
        "get_state" => RpcResponse::success(
            request.id,
            json!({ "version": env!("CARGO_PKG_VERSION"), "status": "bootstrap" }),
        ),
        "get_workspaces" => RpcResponse::success(request.id, json!(workspaces)),
        "get_config" => RpcResponse::success(request.id, json!(config)),
        _ => RpcResponse::failure(Some(request.id), -32601, "Method not found"),
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn heartbeat_cannot_be_mistaken_for_workspace_or_config_state() {
        let frame = RpcResponse::heartbeat(73);
        assert_eq!(frame.id, Some(73));
        assert_eq!(frame.jsonrpc, PROTOCOL_VERSION);
        assert!(frame.error.is_none());
        assert!(is_subscription_heartbeat(frame.result.as_ref().unwrap()));
        assert!(!is_subscription_heartbeat(&json!({"heartbeat": false})));
        assert!(!is_subscription_heartbeat(
            &json!({"heartbeat": true, "connected": true})
        ));
        assert!(!is_subscription_heartbeat(
            &json!(WorkspaceState::default())
        ));
        assert!(!is_subscription_heartbeat(&json!(ConfigState::default())));
    }

    #[test]
    fn ping_round_trip() {
        let request: RpcRequest =
            serde_json::from_str(r#"{"jsonrpc":"2.0","id":7,"method":"ping"}"#).unwrap();
        let response = dispatch(request);
        assert_eq!(response.result, Some(json!("pong")));
        assert_eq!(response.id, Some(7));
        assert_eq!(response.error, None);
        assert!(
            serde_json::to_string(&response)
                .unwrap()
                .contains("\"result\":\"pong\"")
        );
    }

    #[test]
    fn invalid_method_has_json_rpc_error_code() {
        let response = dispatch(RpcRequest {
            params: None,
            jsonrpc: PROTOCOL_VERSION.into(),
            id: 1,
            method: "missing".into(),
        });
        assert_eq!(response.error.unwrap().code, -32601);
    }

    #[test]
    fn invalid_version_is_rejected() {
        let response = dispatch(RpcRequest {
            params: None,
            jsonrpc: "1.0".into(),
            id: 2,
            method: "ping".into(),
        });
        assert_eq!(response.error.unwrap().code, -32600);
    }

    #[test]
    fn default_config_is_read_only_and_typed() {
        let req = RpcRequest {
            params: None,
            jsonrpc: PROTOCOL_VERSION.into(),
            id: 13,
            method: "get_config".into(),
        };
        let response = dispatch(req);
        assert_eq!(
            response.result.unwrap(),
            json!({
                "config": {"compact": false, "title": "KIRA DESKTOP",
                  "show_seconds": false, "show_names": true, "max_workspaces": 12},
                "error": null
            })
        );
        assert_eq!(
            dispatch(RpcRequest {
                params: None,
                jsonrpc: PROTOCOL_VERSION.into(),
                id: 14,
                method: "set_config".into()
            })
            .error
            .unwrap()
            .code,
            -32601
        );
    }

    #[test]
    fn disconnected_niri_does_not_fabricate_workspaces() {
        let response = dispatch(RpcRequest {
            params: None,
            jsonrpc: PROTOCOL_VERSION.into(),
            id: 3,
            method: "get_workspaces".into(),
        });
        assert_eq!(
            response.result,
            Some(json!({"connected": false, "workspaces": []}))
        );
    }

    #[test]
    fn typed_workspaces_preserve_large_ids_and_flags() {
        let state = WorkspaceState {
            connected: true,
            workspaces: vec![Workspace {
                id: u64::MAX.to_string(),
                idx: 2,
                name: Some("code".into()),
                output: Some("DP-1".into()),
                is_active: true,
                is_focused: false,
                is_urgent: true,
            }],
        };
        let response = dispatch_with_workspaces(
            RpcRequest {
                params: None,
                jsonrpc: PROTOCOL_VERSION.into(),
                id: 4,
                method: "get_workspaces".into(),
            },
            &state,
        );
        let value = response.result.unwrap();
        assert_eq!(value["workspaces"][0]["id"], u64::MAX.to_string());
        assert_eq!(value["workspaces"][0]["is_focused"], false);
        assert_eq!(value["workspaces"][0]["is_urgent"], true);
    }
}

/// Resolve Core's socket location. Preview can override it with an absolute path
/// in a private directory, leaving the user's running Core untouched.
pub fn core_socket_path() -> Result<std::path::PathBuf, &'static str> {
    let configured = std::env::var_os("KIRA_CORE_SOCKET").map(std::path::PathBuf::from);
    let runtime = std::env::var_os("XDG_RUNTIME_DIR").map(std::path::PathBuf::from);
    socket_path_from(configured.as_deref(), runtime.as_deref())
}

fn socket_path_from(
    configured: Option<&std::path::Path>,
    runtime: Option<&std::path::Path>,
) -> Result<std::path::PathBuf, &'static str> {
    if let Some(path) = configured {
        return if path.is_absolute() {
            Ok(path.to_path_buf())
        } else {
            Err("KIRA_CORE_SOCKET must be an absolute path")
        };
    }
    runtime
        .map(|dir| dir.join("kira-desktop.sock"))
        .ok_or("XDG_RUNTIME_DIR is required when KIRA_CORE_SOCKET is unset")
}

#[cfg(test)]
mod socket_path_tests {
    use super::*;
    use std::path::Path;

    #[test]
    fn preview_overrides_default_socket() {
        let path = socket_path_from(
            Some(Path::new("/tmp/kira-preview-abc/core.sock")),
            Some(Path::new("/run/user/1000")),
        );
        assert_eq!(path.unwrap(), Path::new("/tmp/kira-preview-abc/core.sock"));
    }

    #[test]
    fn refuses_relative_preview_socket() {
        assert!(socket_path_from(Some(Path::new("core.sock")), None).is_err());
    }

    #[test]
    fn default_stays_inside_user_runtime_directory() {
        assert_eq!(
            socket_path_from(None, Some(Path::new("/run/user/1000"))).unwrap(),
            Path::new("/run/user/1000/kira-desktop.sock")
        );
    }
}

FILE	crates/kira-shell/Cargo.toml
[package]
name = "kira-shell"
version.workspace = true
edition.workspace = true
license.workspace = true

[dependencies]
gtk = { package = "gtk4", version = "0.11", features = ["v4_10"] }
gtk4-layer-shell = "0.8.1"
webkit6 = "0.6.1"
