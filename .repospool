import { describe, expect, it } from 'vitest';
import { filterLauncherApps, nextLauncherSelection } from './launcher-model';
import type { LauncherApp } from './sdk/core';

const apps: LauncherApp[] = [
  { id: 7, name: 'Firefox', description: 'Web browser' },
  { id: 2, name: 'Files', description: 'Browse folders' },
  { id: 21, name: 'Terminal', description: 'Command line' },
];

describe('launcher model', () => {
  it('searches display names and descriptions without losing native GIO identity', () => {
    expect(filterLauncherApps(apps, 'fire').map(app => app.id)).toEqual([7]);
    expect(filterLauncherApps(apps, 'browse folders').map(app => app.id)).toEqual([2]);
    expect(filterLauncherApps(apps, 'WEB BROWSER').map(app => app.id)).toEqual([7]);
    expect(filterLauncherApps(apps, 'terminal command').map(app => app.id)).toEqual([21]);
    expect(filterLauncherApps(apps, 'unavailable')).toEqual([]);
    expect(filterLauncherApps(apps, '')).toEqual(apps);
    expect(apps[0].id).toBe(7);
  });

  it('ranks exact and prefix app names ahead of description-only hits', () => {
    const entries: LauncherApp[] = [
      { id: 10, name: 'Browser tools', description: 'Utilities' },
      { id: 11, name: 'WebKit diagnostics', description: 'Browser testing' },
      { id: 12, name: 'Browser', description: 'The browser' },
      { id: 13, name: 'My browser', description: 'Utility browser' },
      { id: 14, name: 'Browser editor', description: 'Window browser' },
      { id: 15, name: 'Cool Browser', description: 'Browser tool' },
    ];
    expect(filterLauncherApps(entries, 'browser').map(app => app.id))
      .toEqual([12, 10, 14, 13, 15, 11]);
    expect(filterLauncherApps(entries, 'browser editor').map(app => app.id)).toEqual([14]);
    expect(filterLauncherApps(entries, '').map(app => app.id))
      .toEqual([10, 11, 12, 13, 14, 15]);
    expect(entries[0].id).toBe(10);
  });

  it('bounds keyboard selection to visible results and handles empty lists', () => {
    expect(nextLauncherSelection(0, 4, -1)).toBe(0);
    expect(nextLauncherSelection(3, 4, 1)).toBe(3);
    expect(nextLauncherSelection(1, 4, 1)).toBe(2);
    expect(nextLauncherSelection(0, 0, 1)).toBe(0);
    expect(nextLauncherSelection(0, 0, -1)).toBe(0);
  });
});

FILE	frontend/src/lib/launcher-model.ts
import type { LauncherApp } from './sdk/core';

/** Search by desktop application's display name and description. The id stays
 * tied to the original native GIO catalog, even after filtering.
 */
export function filterLauncherApps(apps: readonly LauncherApp[], query: string): LauncherApp[] {
  const terms = query.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
  if (!terms.length) return [...apps];
  const joined = terms.join(' ');
  // Preserve native GIO IDs and source order among equal-relevance hits.
  return apps.map((app, index) => {
    const name = app.name.toLocaleLowerCase();
    const haystack = (name + ' ' + app.description).toLocaleLowerCase();
    if (!terms.every(term => haystack.includes(term))) return null;
    const rank = name === joined ? 0
      : name.startsWith(joined) ? 1
        : name.split(/\s+/).some(word => word.startsWith(joined)) ? 2
          : name.includes(joined) ? 3
            : terms.every(term => name.includes(term)) ? 4 : 5;
    return { app, index, rank };
  }).filter((entry): entry is { app: LauncherApp; index: number; rank: number } => entry !== null)
    .sort((a, b) => a.rank - b.rank || a.index - b.index)
    .map(({ app }) => app);
}

export function nextLauncherSelection(current: number, count: number, direction: -1 | 1): number {
  if (count <= 0) return 0;
  return Math.max(0, Math.min(count - 1, current + direction));
}

FILE	frontend/src/lib/lazy-widget.test.ts
import { describe, expect, it, vi } from 'vitest';
import { createLazyWidget } from './lazy-widget';

const flush = async () => {
  await Promise.resolve();
  await Promise.resolve();
  await Promise.resolve();
};

describe('lazy overlay widget lifecycle', () => {
  it('does not load or mount a hidden widget, and disposes it on hide', async () => {
    const mount = vi.fn(() => ({ mounted: true }));
    const unmount = vi.fn(async () => {});
    const onMounted = vi.fn();
    const load = vi.fn(async () => ({ mount, unmount, onMounted }));
    const errors = vi.fn();
    const widget = createLazyWidget(load, errors);
    await flush();
    expect(load).not.toHaveBeenCalled();

    widget.show(1);
    await flush();
    expect(load).toHaveBeenCalledTimes(1);
    expect(mount).toHaveBeenCalledTimes(1);
    expect(onMounted).toHaveBeenCalledWith(1);

    widget.hide();
    await flush();
    expect(unmount).toHaveBeenCalledTimes(1);
    expect(unmount).toHaveBeenCalledWith({ mounted: true });
    expect(errors).not.toHaveBeenCalled();

    widget.show(2);
    await flush();
    expect(mount).toHaveBeenCalledTimes(2);
    expect(onMounted).toHaveBeenCalledWith(2);
  });

  it('does not mount a component loaded after the window was hidden', async () => {
    const mount = vi.fn(() => ({}));
    const unmount = vi.fn();
    const onMounted = vi.fn();
    let finish!: (widget: { mount: typeof mount; unmount: typeof unmount; onMounted: typeof onMounted }) => void;
    const load = vi.fn(() => new Promise<{
      mount: typeof mount; unmount: typeof unmount; onMounted: typeof onMounted
    }>((resolve) => { finish = resolve; }));
    const widget = createLazyWidget(load, vi.fn());
    widget.show(7);
    widget.hide();
    finish({ mount, unmount, onMounted });
    await flush();
    expect(mount).not.toHaveBeenCalled();
    expect(onMounted).not.toHaveBeenCalled();
  });

  it('serializes unmount before the next mount during rapid toggles', async () => {
    const sequence: string[] = [];
    let completeUnmount!: () => void;
    const endUnmount = new Promise<void>((resolve) => { completeUnmount = resolve; });
    const widget = createLazyWidget(async () => ({
      mount() { sequence.push('mount'); return {}; },
      unmount() { sequence.push('unmount'); return endUnmount; },
      onMounted() { sequence.push('ready'); },
    }), vi.fn());

    widget.show(1);
    await flush();
    widget.hide();
    widget.show(2);
    await flush();
    expect(sequence).toEqual(['mount', 'ready', 'unmount']);
    completeUnmount();
    await flush();
    expect(sequence).toEqual(['mount', 'ready', 'unmount', 'mount', 'ready']);
  });

  it('ignores invalid generations without loading and reports loader failures', async () => {
    const load = vi.fn(async () => { throw new Error('test loader failure'); });
    const report = vi.fn();
    const widget = createLazyWidget(load, report);
    for (const invalid of [0, -1, 1.5, Number.NaN, 4294967296]) widget.show(invalid);
    await flush();
    expect(load).not.toHaveBeenCalled();
    widget.show(4);
    await flush();
    expect(report).toHaveBeenCalledTimes(1);
    expect(String(report.mock.calls[0][0])).toContain('test loader failure');
  });
});

FILE	frontend/src/lib/lazy-widget.ts
/**
 * A single WebKit page can host many widgets, but only the visible widget
 * should own DOM nodes, timers, subscriptions and Svelte reactive effects.
 * Serialize mount/unmount so quick hide/show never resurrects stale content.
 */
export interface LazyWidget<Instance> {
  mount(): Instance;
  unmount(instance: Instance): Promise<unknown> | void;
  onMounted(generation: number): void;
}

export function createLazyWidget<Instance>(
  load: () => Promise<LazyWidget<Instance>>,
  onError: (error: unknown) => void,
) {
  let desired: number | null = null;
  let active: { generation: number; instance: Instance; widget: LazyWidget<Instance> } | null = null;
  let draining = false;

  async function drain(): Promise<void> {
    if (draining) return;
    draining = true;
    try {
      while ((active?.generation ?? null) !== desired) {
        if (active) {
          const previous = active;
          active = null;
          // Svelte 5 unmount() cleans up onMount disposers, including
          // intervals and window listeners. Wait before mounting again.
          await previous.widget.unmount(previous.instance);
          continue;
        }
        if (desired === null) break;
        const generation = desired;
        const widget = await load();
        // A hidden or superseded widget is never mounted.
        if (desired !== generation) continue;
        const instance = widget.mount();
        active = { generation, instance, widget };
        widget.onMounted(generation);
      }
    } catch (error) {
      desired = null;
      onError(error);
    } finally {
      draining = false;
      if ((active?.generation ?? null) !== desired) void drain();
    }
  }

  function show(generation: number): void {
    if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff) return;
    desired = generation;
    void drain();
  }

  function hide(): void {
    desired = null;
    void drain();
  }

  return { show, hide };
}

