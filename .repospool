FILE	.github/workflows/ci.yml
name: CI

# PRs run only the fast Core + Svelte checks. A branch push that already
# has a PR must not launch the same tests again.
on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.event.pull_request.head.repo.full_name || github.repository }}-${{ github.event.pull_request.head.ref || github.ref_name }}
  cancel-in-progress: true

jobs:
  check:
    name: Core + Svelte checks
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - name: Install Task
        uses: arduino/setup-task@v2
      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - name: Cache Rust dependencies
        uses: Swatinem/rust-cache@v2
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - name: Install frontend dependencies
        run: npm ci --prefix frontend --no-audit --no-fund
      # task check already runs cargo fmt --check, Clippy, Rust unit tests,
      # Svelte type checking, Vitest, Python contracts and config validation.
      # Never modify/push code from CI: that caused duplicate and cancelled runs.
      - name: Check code and run tests
        run: task check
      - name: Build static Svelte assets
        run: task frontend:build

  native-shell:
    # This job always reports a stable status for branch protection, but
    # only installs GTK/WebKit dependencies for relevant PRs and pushes.
    name: Native Shell check
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Detect native Shell changes
        id: changes
        shell: bash
        env:
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          PUSH_BASE_SHA: ${{ github.event.before }}
        run: |
          set -euo pipefail
          if [ "$GITHUB_EVENT_NAME" = "pull_request" ]; then
            base="$PR_BASE_SHA"
            head="$PR_HEAD_SHA"
          else
            base="$PUSH_BASE_SHA"
            head="$GITHUB_SHA"
          fi
          # If GitHub cannot provide a comparable base (e.g. a force push),
          # run the check rather than accidentally skipping native code.
          if ! git cat-file -e "${base}^{commit}" 2>/dev/null ||
             ! git cat-file -e "${head}^{commit}" 2>/dev/null; then
            echo "shell=true" >> "$GITHUB_OUTPUT"
            echo "Revision unavailable; checking Shell conservatively"
            exit 0
          fi
          # Avoid git-diff SIGPIPE under pipefail when grep exits early.
          changed="$(git diff --name-only "$base" "$head" --)"
          if grep -Eq \
            '^(crates/kira-shell/|crates/kira-ipc/|\.cargo/|nix/|Cargo\.toml$|Cargo\.lock$|flake\.nix$|flake\.lock$|Taskfile\.yml$|\.github/workflows/ci\.yml$)' <<< "$changed"; then
            echo "shell=true" >> "$GITHUB_OUTPUT"
          else
            echo "shell=false" >> "$GITHUB_OUTPUT"
            echo "No native Shell dependency changed; skipping GTK/WebKit setup"
          fi

      - name: Install Nix for native dependencies
        if: steps.changes.outputs.shell == 'true'
        uses: cachix/install-nix-action@v31
        with:
          github_access_token: ${{ secrets.GITHUB_TOKEN }}
      - name: Optional shared Nix binary cache
        if: steps.changes.outputs.shell == 'true' && vars.KIRA_CACHIX_NAME != ''
        uses: cachix/cachix-action@v17
        with:
          name: ${{ vars.KIRA_CACHIX_NAME }}
          authToken: ${{ secrets.CACHIX_AUTH_TOKEN }}
      - name: Cache Rust dependencies
        if: steps.changes.outputs.shell == 'true'
        uses: Swatinem/rust-cache@v2
      - name: Compile native GTK/WebKit Shell (including test targets)
        if: steps.changes.outputs.shell == 'true'
        run: nix develop .#ci --command cargo check --locked -p kira-shell --all-targets
      - name: Test native Shell recovery and safety contracts
        if: steps.changes.outputs.shell == 'true'
        run: nix develop .#ci --command cargo test --locked -p kira-shell --bin kira-shell

FILE	.github/workflows/frontend-nix.yml
name: Frontend Nix package

# A changed npm lock must also carry the matching fixed-output Nix hash.
# This workflow builds only the frontend derivation (not GTK/WebKit Rust).
on:
  pull_request:
    paths:
      - 'frontend/package.json'
      - 'frontend/package-lock.json'
      - 'nix/package.nix'
      - '.github/workflows/frontend-nix.yml'
  push:
    branches: [main]
    paths:
      - 'frontend/package.json'
      - 'frontend/package-lock.json'
      - 'nix/package.nix'
      - '.github/workflows/frontend-nix.yml'

permissions:
  contents: read

concurrency:
  group: frontend-nix-${{ github.event.pull_request.head.repo.full_name || github.repository }}-${{ github.event.pull_request.head.ref || github.ref_name }}
  cancel-in-progress: true

jobs:
  frontend:
    name: Nix frontend package
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: cachix/install-nix-action@v31
        with:
          github_access_token: ${{ secrets.GITHUB_TOKEN }}
      - name: Validate package-lock metadata
        run: |
          npm install --prefix frontend --package-lock-only --ignore-scripts --no-audit --no-fund
          git diff -- frontend/package-lock.json
          git diff --exit-code -- frontend/package-lock.json
      - name: Validate locked offline UI package
        run: nix build .#frontend --no-link --print-build-logs

FILE	.github/workflows/nix.yml
name: Nix package (nightly / manual)

# GTK/WebKit native libraries and a full Nix/Crane release rebuild are far
# too expensive to run on every PR. Use Actions -> Nix package -> Run
# workflow (select the branch), or rely on the nightly check on main.
on:
  workflow_dispatch:
  schedule:
    - cron: '37 3 * * *'

permissions:
  contents: read

concurrency:
  group: nix-package-${{ github.ref }}
  cancel-in-progress: true

jobs:
  package:
    name: Build full Nix release package
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: cachix/install-nix-action@v31
        with:
          github_access_token: ${{ secrets.GITHUB_TOKEN }}
      - name: Optional shared binary cache
        if: ${{ vars.KIRA_CACHIX_NAME != '' }}
        uses: cachix/cachix-action@v17
        with:
          name: ${{ vars.KIRA_CACHIX_NAME }}
          authToken: ${{ secrets.CACHIX_AUTH_TOKEN }}
      # The Nix build already compiles the frontend, Core and GTK/WebKit Shell.
      # Do not additionally rebuild the same crates with cargo check and
      # three separate cargo test invocations in different profiles.
      - name: Build packaged Core, Shell and Svelte frontend
        run: nix build .#default -L

FILE	.github/workflows/overlay-smoke.yml
name: Overlay browser smoke

on:
  pull_request:
    paths:
      - 'frontend/**'
      - 'crates/kira-shell/src/calendar.rs'
      - '.github/workflows/overlay-smoke.yml'
  push:
    branches: [main]
    paths:
      - 'frontend/**'
      - 'crates/kira-shell/src/calendar.rs'
      - '.github/workflows/overlay-smoke.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: overlay-smoke-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  browser-smoke:
    runs-on: ubuntu-24.04
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: frontend/package-lock.json
      - name: Install frontend
        run: npm ci --prefix frontend --no-audit --no-fund
      - name: Build self-contained overlay HTML
        run: npm run build --prefix frontend
      - name: Validate real Calendar and System mounts
        run: node frontend/scripts/smoke-overlays.mjs

FILE	.github/workflows/publish-repospool.yml
name: Publish RepoSpool context

# The source index is generated mechanically from a pinned Git commit.
# A separate artifact-only commit tracks the resulting snapshot.
on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: repospool-${{ github.ref }}
  cancel-in-progress: true

jobs:
  snapshot:
    name: Generate and publish .repospool
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: true

      - name: Skip artifact-only commits
        id: changes
        shell: bash
        run: |
          set -euo pipefail
          changed="$(git diff-tree --no-commit-id --name-only -r "$GITHUB_SHA")"
          if [ "$changed" = ".repospool" ]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "Artifact-only commit: source revision is unchanged"
          fi

      - uses: cachix/install-nix-action@v31
        if: steps.changes.outputs.skip != 'true'
        with:
          github_access_token: ${{ secrets.GITHUB_TOKEN }}

      - name: Generate and verify a deterministic RepoSpool snapshot
        if: steps.changes.outputs.skip != 'true'
        shell: bash
        run: |
          set -euo pipefail
          # Immutable upstream revision: avoid non-reproducible floating refs.
          nix build "github:iivkis/repospool/3f7ff9570c9302690b21b96be84e7adb95b6990a#repospool" \
            --out-link "$RUNNER_TEMP/repospool-cli"
          cli="$RUNNER_TEMP/repospool-cli/bin/repospool"
          "$cli" generate . --rev "$GITHUB_SHA" --output "$RUNNER_TEMP/.repospool"
          "$cli" verify --artifact "$RUNNER_TEMP/.repospool" --repo .
          "$cli" generate . --rev "$GITHUB_SHA" --output "$RUNNER_TEMP/recheck.repospool"
          cmp "$RUNNER_TEMP/.repospool" "$RUNNER_TEMP/recheck.repospool"
          printf 'Source revision: %s\n' "$GITHUB_SHA" >> "$GITHUB_STEP_SUMMARY"
          sha256sum "$RUNNER_TEMP/.repospool" >> "$GITHUB_STEP_SUMMARY"

      - uses: actions/upload-artifact@v4
        if: steps.changes.outputs.skip != 'true'
        with:
          name: repospool-${{ github.sha }}
          path: ${{ runner.temp }}/.repospool
          include-hidden-files: true
          retention-days: 7
          if-no-files-found: error

      - name: Update the tracked context snapshot
        if: github.ref == 'refs/heads/main' && steps.changes.outputs.skip != 'true'
        shell: bash
        run: |
          set -euo pipefail
          if test -f .repospool && cmp -s .repospool "$RUNNER_TEMP/.repospool"; then
            echo "Snapshot already current"
            exit 0
          fi
          cp "$RUNNER_TEMP/.repospool" .repospool
          git add -- .repospool
          git -c user.name="github-actions[bot]" \
              -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
              commit -m "chore(repospool): update source snapshot for $GITHUB_SHA"
          git push origin HEAD:main

