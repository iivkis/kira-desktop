"""Shared geometry contract for calendar and system popup."""
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HELPERS = (ROOT / "crates/kira-shell/src/native_ui.rs").read_text()
CALENDAR = (ROOT / "crates/kira-shell/src/calendar.rs").read_text()
MONITOR = (ROOT / "crates/kira-shell/src/system_panel.rs").read_text()


class PopupGeometryTests(unittest.TestCase):
    def test_launcher_is_centered_without_affecting_other_widgets(self):
        self.assertIn("fn position_for(&self, kind: Surface)", CALENDAR)
        self.assertIn("let centered = kind == Surface::Launcher;", CALENDAR)
        self.assertIn("self.position_for(kind);", CALENDAR)
        self.assertIn("self.window.set_anchor(Edge::Top, !centered);", CALENDAR)
        self.assertIn("self.window.set_anchor(Edge::Right, !centered);", CALENDAR)
        self.assertIn("self.window.set_anchor(Edge::Bottom, false);", CALENDAR)
        self.assertIn("self.window.set_anchor(Edge::Left, false);", CALENDAR)
        self.assertIn("self.window.set_exclusive_zone(-1);", CALENDAR)
        self.assertIn("self.window.set_exclusive_zone(0);", CALENDAR)
        self.assertIn("self.window.set_margin(Edge::Top, 0);", CALENDAR)
        self.assertIn("self.window.set_margin(Edge::Right, 0);", CALENDAR)
        self.assertIn("self.window.set_margin(Edge::Right, 12);", CALENDAR)
        self.assertIn(
            "set_margin(Edge::Top, crate::native_ui::POPUP_TOP_MARGIN)",
            CALENDAR,
        )
        # The shared layer-shell window and WebKit renderer stay in place.
        self.assertIn("static CALENDAR: RefCell<Option<Rc<CalendarOverlay>>>", CALENDAR)
        self.assertNotIn("window.close()", CALENDAR)

    def test_switching_launcher_never_moves_a_mapped_webkit_buffer(self):
        # Calendar/System can switch in place. Moving to/from the centered
        # Launcher must unmap before changing layer-shell anchors, then
        # remap on a subsequent compositor frame with the new Svelte DOM.
        self.assertIn("let relocating = self.window.is_visible()", CALENDAR)
        self.assertIn("(old == Surface::Launcher) != (kind == Surface::Launcher)", CALENDAR)
        self.assertIn("let defer_present = relocating || self.reposition_pending.get();", CALENDAR)
        self.assertIn("self.window.set_visible(false);", CALENDAR)
        self.assertIn("self.reposition_pending.set(defer_present);", CALENDAR)
        show = CALENDAR.split("fn show(self: &Rc<Self>, kind: Surface)", 1)[1].split(
            "fn request_mount(", 1
        )[0]
        self.assertLess(show.index("self.window.set_visible(false)"),
                        show.index("self.position_for(kind);"))
        self.assertIn("self.was_active.set(false);", show)
        self.assertIn("self.window.set_opacity(0.0);", show)
        self.assertIn("Duration::from_millis(32)", show)
        self.assertIn("state.generation.get() == generation", show)
        self.assertIn("state.window.present();", show)
        self.assertIn("self.request_mount();", show)
        self.assertIn("reposition_pending: Cell<bool>", CALENDAR)
        # The current shared WebKit process must not be restarted on moves.
        self.assertEqual(CALENDAR.count("webkit6::WebView::builder()"), 1)
        self.assertNotIn("window.close()", CALENDAR)

    def test_svelte_intrinsic_height_and_scroll_are_bound_to_native_cap(self):
        style = (ROOT / "frontend/src/style.css").read_text()
        entry = (ROOT / "frontend/src/main.ts").read_text()
        sdk = (ROOT / "frontend/src/lib/sdk/core.ts").read_text()
        measure = (ROOT / "frontend/src/lib/overlay-size.ts").read_text()
        components = [
            (ROOT / "frontend/src/lib/components/" / name).read_text()
            for name in ("CalendarWidget.svelte", "SystemWidget.svelte",
                         "LauncherWidget.svelte")
        ]
        self.assertIn('html[data-kira-surface="calendar"] #app', style)
        self.assertIn('max-height: var(--kira-overlay-max-height, 560px)', style)
        self.assertIn('detail.maxHeight + \'px\'', entry)
        self.assertIn('observeOverlaySize(root, generation)', entry)
        self.assertIn('stopSizing?.()', entry)
        self.assertIn('notifyCalendarMounted(generation)', entry)
        self.assertLess(entry.index('observeOverlaySize(root, generation)'),
                        entry.index('notifyCalendarMounted(generation)'))
        self.assertIn('new ResizeObserver(measure)', measure)
        self.assertIn('root.getBoundingClientRect().height', measure)
        self.assertIn('observer?.disconnect()', measure)
        self.assertIn("sendCalendarUi('size:' + generation + ':' + height)", sdk)
        self.assertIn('Some(UiCommand::ContentHeight(generation, height))', CALENDAR)
        self.assertIn('self.generation.get() == generation', CALENDAR)
        self.assertIn('height.min(crate::native_ui::webview_popup_height_limit', CALENDAR)
        self.assertIn('self.content_height.get() == 0', CALENDAR)
        for source in components:
            self.assertIn('flex h-auto min-h-0 w-full flex-col', source)
            self.assertNotIn('flex h-full min-h-0 w-full flex-col', source)
        self.assertIn('overflow-y-auto', components[0])
        self.assertIn('overflow-y-auto', components[1])
        self.assertIn('overflow-y-auto', components[2])

    def test_half_margin_and_monitor_relative_height(self):
        self.assertIn("pub const POPUP_TOP_MARGIN: i32 = 25;", HELPERS)
        self.assertIn("i64::from(output_height.max(1)) * 7 / 10", HELPERS)
        self.assertIn("monitor_at_surface(&surface)", HELPERS)
        self.assertNotIn("connect_map(move |window|", HELPERS)
        self.assertIn("window.set_default_size(width, height)", HELPERS)
        self.assertNotIn("gtk::ScrolledWindow", HELPERS)
        self.assertNotIn("gtk::ScrolledWindow", MONITOR)
        self.assertNotIn("gtk::ApplicationWindow::new", MONITOR)
        self.assertIn("native_ui::configure_webview_popup", CALENDAR)
        self.assertIn("output_width.saturating_sub(24)", HELPERS)
        self.assertIn("height = content_height.clamp(1, webview_popup_height_limit(window))", HELPERS)
        self.assertIn("pub fn resize_webview_popup(", HELPERS)
        self.assertIn("pub fn webview_popup_height_limit(", HELPERS)
        self.assertIn("self.content_height.set(clamped)", CALENDAR)
        self.assertIn("resize_webview_popup(&self.window, 420, clamped)", CALENDAR)
        self.assertIn("maxHeight: {max_height}", CALENDAR)
        self.assertIn('size:42:512', CALENDAR)
        for source in (CALENDAR,):
            self.assertNotIn("408, 600", source)
            self.assertNotIn("378, 490", source)
            self.assertIn("native_ui::POPUP_TOP_MARGIN", source)
            self.assertNotIn("set_margin(Edge::Top, 50)", source)
            self.assertIn("set_exclusive_zone(0)", source)


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_qa_visual.py
"""Unit tests for safe visual QA capture without a GPU or a real Niri."""
import importlib.util
import json
from pathlib import Path
import socket
import struct
import tempfile
import threading
import unittest
from unittest.mock import Mock, patch

SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "qa_visual.py"
spec = importlib.util.spec_from_file_location("qa_visual", SCRIPT)
assert spec and spec.loader
qa = importlib.util.module_from_spec(spec)
spec.loader.exec_module(qa)


def png_header(width=1280, height=720):
    return qa.PNG_SIGNATURE + struct.pack(">I", 13) + b"IHDR" + struct.pack(">II", width, height) + b"\x08\x06\x00\x00\x00\x00\x00\x00\x00"


class VisualQATests(unittest.TestCase):
    def test_rejects_missing_niri_socket_before_any_command(self):
        with self.assertRaisesRegex(qa.VisualQAError, "missing"):
            qa.nested_socket({}, None)

    def test_rejects_parent_niri_socket(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "niri.sock"
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(str(path))
            try:
                with self.assertRaisesRegex(qa.VisualQAError, "equals parent"):
                    qa.nested_socket({"NIRI_SOCKET": str(path)}, str(path))
                self.assertEqual(qa.nested_socket({"NIRI_SOCKET": str(path)}, None), path)
            finally:
                server.close()

    def test_only_one_nested_output_is_accepted(self):
        with patch.object(qa, "niri_command", return_value=json.dumps({
            "Virtual-1": {"logical": {"scale": 1.0, "width": 1200, "height": 800}}
        })):
            name, details = qa.sole_output("niri", {})
        self.assertEqual(name, "Virtual-1")
        self.assertEqual(details["logical"]["width"], 1200)
        with patch.object(qa, "niri_command", return_value=json.dumps({
            "one": {"logical": {"scale": 1.0}},
            "two": {"logical": {"scale": 1.0}},
        })):
            with self.assertRaisesRegex(qa.VisualQAError, "exactly one"):
                qa.sole_output("niri", {})

    def test_mount_requires_verified_dom_not_just_started_shell(self):
        with tempfile.TemporaryDirectory() as directory:
            log = Path(directory) / "shell.log"
            log.write_text("Svelte entrypoint mounted\n")
            with self.assertRaisesRegex(qa.VisualQAError, "Timed out"):
                qa.wait_for_shell_ui(log, timeout=0)
            log.write_text("Svelte entrypoint mounted\nSvelte panel DOM verified\n")
            qa.wait_for_shell_ui(log, timeout=1)

    def test_invalid_png_does_not_pass_capture(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "screen.png"
            path.write_bytes(b"not a screenshot at all")
            with self.assertRaisesRegex(qa.VisualQAError, "Invalid PNG"):
                qa.png_dimensions(path)
            path.write_bytes(png_header(width=640, height=480))
            self.assertEqual(qa.png_dimensions(path), (640, 480))

    def test_core_smoke_checks_real_get_state_response(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "core.sock"
            listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            listener.bind(str(path))
            listener.listen(1)
            errors = []

            def serve():
                try:
                    conn, _ = listener.accept()
                    with conn:
                        raw = conn.recv(4096).decode("utf-8")
                        request = json.loads(raw)
                        self.assertEqual(request["method"], "get_state")
                        conn.sendall(json.dumps({
                            "jsonrpc": "2.0", "id": 1,
                            "result": {"version": "0.1.0", "status": "bootstrap"}
                        }).encode("utf-8") + b"\n")
                except Exception as error:
                    errors.append(error)

            thread = threading.Thread(target=serve)
            thread.start()
            try:
                self.assertEqual(qa.check_core(path)["version"], "0.1.0")
            finally:
                thread.join(timeout=3)
                listener.close()
            self.assertFalse(errors)

    def test_captures_four_scales_and_writes_pending_manifest(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            niri_socket = root / "niri.sock"
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(str(niri_socket))
            state = {"scale": 1.0}
            calls = []

            def command(_niri, environment, *args):
                self.assertEqual(environment["NIRI_SOCKET"], str(niri_socket))
                calls.append(args)
                if args == ("--json", "outputs"):
                    return json.dumps({"Virtual-1": {"logical": {
                        "scale": state["scale"], "width": 1280, "height": 720
                    }}})
                if args[:2] == ("output", "Virtual-1"):
                    self.assertEqual(args[2], "scale")
                    state["scale"] = float(args[3])
                return ""

            screenshots = []

            def shot(grim, environment, output, path):
                self.assertEqual(grim, "/nix/store/bin/grim")
                self.assertEqual(output, "Virtual-1")
                self.assertEqual(environment["WAYLAND_DISPLAY"], "wayland-nested")
                screenshots.append(path)
                path.write_bytes(png_header() + b"fake-screenshot" + qa.PNG_TRAILER)

            try:
                with patch.object(qa, "niri_command", side_effect=command), \
                     patch.object(qa, "wait_for_shell_ui"), \
                     patch.object(qa, "check_core", return_value={"status": "bootstrap"}), \
                     patch.object(qa, "check_niri_workspaces", return_value={"connected": True, "workspaces": []}), \
                     patch.object(qa.shutil, "which", return_value="/nix/store/bin/grim"), \
                     patch.object(qa, "screenshot_with_grim", side_effect=shot), \
                     patch.object(qa.time, "sleep"):
                    path = qa.capture("niri", {
                        "NIRI_SOCKET": str(niri_socket),
                        "WAYLAND_DISPLAY": "wayland-nested",
                    }, None, root / "shell.log", root / "core.sock",
                        root / "captures", packaged=True)
                manifest = json.loads((path / "manifest.json").read_text())
                self.assertEqual(manifest["status"], "captured_review_pending")
                self.assertEqual(manifest["visual_review"], "pending")
                self.assertEqual(manifest["build"], "packaged-nix")
                self.assertEqual([item["scale"] for item in manifest["screenshots"]],
                                 [1.0, 1.25, 1.5, 2.0])
                self.assertTrue(all((path / item["file"]).is_file()
                                    for item in manifest["screenshots"]))
                self.assertEqual(len(screenshots), 4)
                self.assertEqual(len([a for a in calls if a[:2] == ("output", "Virtual-1")]), 4)
                self.assertFalse(any(a[:2] == ("action", "screenshot-screen") for a in calls))
            finally:
                server.close()

    def test_smoke_checks_read_only_without_screenshots_or_scales(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            sock = root / "niri.sock"
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(str(sock))
            calls = []
            def command(_niri, _env, *args):
                calls.append(args)
                return json.dumps({"Virtual-1": {"logical": {"scale": 1.0}}})
            try:
                with patch.object(qa, "niri_command", side_effect=command), \
                     patch.object(qa, "wait_for_shell_ui"), \
                     patch.object(qa, "check_core", return_value={"status": "bootstrap"}), \
                     patch.object(qa, "check_niri_workspaces", return_value={"connected": True, "workspaces": []}):
                    state, output = qa.verify_smoke(
                        "niri", {"NIRI_SOCKET": str(sock)}, None,
                        root / "shell.log", root / "core.sock",
                    )
                self.assertEqual(state["status"], "bootstrap")
                self.assertEqual(output, "Virtual-1")
                self.assertEqual(calls, [("--json", "outputs")])
            finally:
                server.close()

    def test_grim_capture_does_not_use_clipboard_or_host_display(self):
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / "screen.png"
            env = {"WAYLAND_DISPLAY": "wayland-nested", "NIRI_SOCKET": "/tmp/child.sock"}
            with patch.object(qa.subprocess, "run", return_value=Mock(returncode=0)) as run:
                qa.screenshot_with_grim("grim", env, "Virtual-1", output)
            args, kwargs = run.call_args
            self.assertEqual(args[0], ["grim", "-o", "Virtual-1", str(output)])
            self.assertEqual(kwargs["env"], env)
            self.assertNotIn("wl-copy", args[0])
            self.assertNotIn("screenshot-screen", args[0])

    def test_failure_records_failed_not_a_pass(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            sock = root / "niri.sock"
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(str(sock))
            try:
                with patch.object(qa, "wait_for_shell_ui", side_effect=qa.VisualQAError("DOM failed")):
                    with self.assertRaisesRegex(qa.VisualQAError, "DOM failed"):
                        qa.capture("niri", {"NIRI_SOCKET": str(sock)}, None,
                                   root / "shell.log", root / "core.sock",
                                   root / "evidence", packaged=True)
                manifests = list((root / "evidence").glob("*/manifest.json"))
                self.assertEqual(len(manifests), 1)
                self.assertEqual(json.loads(manifests[0].read_text())["status"], "failed")
            finally:
                server.close()


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_ui_bootstrap_contract.py
"""Keep GTK, Svelte and WebKit bootstrap health checks framework-independent."""
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SELECTOR = "main[data-kira-ui-root]"


class BootstrapContractTests(unittest.TestCase):
    def test_svelte_root_matches_webkit_and_bootstrap(self):
        app = (ROOT / "frontend/src/App.svelte").read_text()
        bootstrap = (ROOT / "frontend/src/lib/bootstrap.ts").read_text()
        shell = (ROOT / "crates/kira-shell/src/main.rs").read_text()

        self.assertIn("data-kira-ui-root", app)
        self.assertIn(SELECTOR, bootstrap)
        self.assertIn(SELECTOR, shell)
        self.assertNotIn("main.bar", bootstrap)
        self.assertNotIn("main.bar", shell)

    def test_failure_is_not_overwritten_by_generic_timeout(self):
        bootstrap = (ROOT / "frontend/src/lib/bootstrap.ts").read_text()
        html = (ROOT / "frontend/index.html").read_text()
        self.assertIn("bootstrapError", bootstrap)
        self.assertIn("window.__kiraBoot.bootstrapError", html)


if __name__ == "__main__":
    unittest.main()

