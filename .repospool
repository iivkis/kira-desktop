import { describe, expect, it } from 'vitest';
import { bytesLabel, defaultSort, fractionLabel, nextSort, percentUsed, processMemoryLabel, sortedProcesses, systemHeadline, temperatureLabel, usageLabel, isSampleFresh } from './system-model';
import type { ProcessRow, SystemMetrics } from './sdk/core';

const processes: ProcessRow[] = [
  { pid: 3, name: 'zebra', state: 'R', cpu_percent: 20, rss_kib: 4000, pss_kib: 1200 },
  { pid: 1, name: 'alpha', state: 'S', cpu_percent: 80, rss_kib: 1000, pss_kib: 800 },
  { pid: 2, name: 'beta', state: 'S', cpu_percent: 50, rss_kib: 2000, pss_kib: 1300 },
  { pid: 4, name: 'missing', state: 'S', cpu_percent: null, rss_kib: null, pss_kib: null },
];

describe('Svelte System Monitor model', () => {
  it('never confuses a missing or stopped native stream with live telemetry', () => {
    expect(isSampleFresh(null, 10_000)).toBe(false);
    expect(isSampleFresh(5_000, 10_000)).toBe(true);
    expect(isSampleFresh(4_000, 10_000)).toBe(true);
    expect(isSampleFresh(3_999, 10_000)).toBe(false);
    expect(isSampleFresh(10_001, 10_000)).toBe(false);
    expect(isSampleFresh(9_000, Number.NaN)).toBe(false);
    expect(isSampleFresh(7_500, 10_000, 2_500)).toBe(true);
    expect(isSampleFresh(7_499, 10_000, 2_500)).toBe(false);
  });

  it('sorts each column in both directions and keeps missing metrics last', () => {
    for (const [field, ascending, descending] of [
      ['name', [1, 2, 4, 3], [3, 4, 2, 1]],
      ['pid', [1, 2, 3, 4], [4, 3, 2, 1]],
      ['cpu', [3, 2, 1, 4], [1, 2, 3, 4]],
      ['memory', [1, 2, 3, 4], [3, 2, 1, 4]],
      ['pss', [1, 3, 2, 4], [2, 3, 1, 4]],
    ] as const) {
      expect(sortedProcesses(processes, '', { field, descending: false }).map(row => row.pid)).toEqual(ascending);
      expect(sortedProcesses(processes, '', { field, descending: true }).map(row => row.pid)).toEqual(descending);
    }
    expect(nextSort(defaultSort, 'cpu')).toEqual({ field: 'cpu', descending: false });
    expect(nextSort(defaultSort, 'memory')).toEqual({ field: 'memory', descending: true });
    expect(nextSort(defaultSort, 'pss')).toEqual({ field: 'pss', descending: true });
    expect(nextSort(defaultSort, 'name')).toEqual({ field: 'name', descending: false });
  });

  it('filters processes by case-insensitive name and PID', () => {
    expect(sortedProcesses(processes, 'ALP', defaultSort).map(row => row.pid)).toEqual([1]);
    expect(sortedProcesses(processes, ' 3 ', defaultSort).map(row => row.pid)).toEqual([3]);
    expect(sortedProcesses(processes, 'nonsense', defaultSort)).toEqual([]);
    expect(processes.map(row => row.pid)).toEqual([3, 1, 2, 4]);
  });

  it('distinguishes unavailable metrics from real zero', () => {
    expect(percentUsed(null, 0)).toBeNull();
    expect(percentUsed(0, 0)).toBeNull();
    expect(percentUsed(100, 150)).toBeNull();
    expect(percentUsed(100, 0)).toBe(100);
    expect(usageLabel(null, null)).toBe('UNAVAILABLE');
    expect(usageLabel(0, 0)).toBe('NOT CONFIGURED');
    expect(usageLabel(100000, 100000)).toBe('0%');
    expect(usageLabel(7700000, 7679000)).toBe('0.3%');
    expect(usageLabel(1000000, 999999)).toBe('<0.1%');
    expect(usageLabel(100, 60)).toBe('40%');
    expect(usageLabel(100, 120)).toBe('UNAVAILABLE');

    expect(fractionLabel(null, null)).toBe('UNAVAILABLE');
    expect(bytesLabel(1_048_576)).toBe('1.0 GiB');
    expect(processMemoryLabel(null)).toBe('—');
    expect(processMemoryLabel(0)).toBe('0 KiB');
    expect(processMemoryLabel(512)).toBe('512 KiB');
    expect(temperatureLabel(null)).toBe('UNAVAILABLE');
    expect(temperatureLabel(57.125)).toBe('57.1 °C');
  });

  it('prioritizes offline, storage and memory pressure', () => {
    const m: SystemMetrics = {
      cpu_percent: 12, cpu_temperature_c: null, gpus: [],
      memory_total_kib: 100, memory_available_kib: 80,
      swap_total_kib: 0, swap_free_kib: 0,
      root_total_kib: 100, root_available_kib: 80, uptime_seconds: 3600,
      load: [0, 0, 0], battery_percent: null, battery_charging: null,
    };
    expect(systemHeadline(m, false, true)).toBe('CORE OFFLINE');
    expect(systemHeadline(m, true, false)).toBe('NIRI DISCONNECTED');
    expect(systemHeadline(m, true, true)).toBe('ALL SYSTEMS NOMINAL');
    expect(systemHeadline({ ...m, root_available_kib: 1 }, true, true)).toBe('LOW STORAGE');
    expect(systemHeadline({ ...m, memory_available_kib: 1 }, true, true)).toBe('MEMORY PRESSURE');
  });
});

FILE	frontend/src/lib/system-model.ts
import type { ProcessRow, SystemMetrics } from './sdk/core';

export type SortField = 'name' | 'pid' | 'cpu' | 'memory' | 'pss';
export type SortState = { field: SortField; descending: boolean };

export const defaultSort: SortState = { field: 'cpu', descending: true };

/** No browser polling of sensors: only classify the age of the last native event.
 * A missing, future, or expired timestamp never counts as a live sample.
 */
export function isSampleFresh(
  lastSampleAt: number | null, now: number, maxAgeMs = 6_000,
): boolean {
  return lastSampleAt !== null &&
    Number.isFinite(lastSampleAt) && Number.isFinite(now) &&
    Number.isFinite(maxAgeMs) && maxAgeMs >= 0 &&
    now >= lastSampleAt && now - lastSampleAt <= maxAgeMs;
}

export function nextSort(current: SortState, field: SortField): SortState {
  return current.field === field
    ? { field, descending: !current.descending }
    : { field, descending: field === 'cpu' || field === 'memory' || field === 'pss' };
}

export function sortedProcesses(rows: ProcessRow[], query: string, state: SortState): ProcessRow[] {
  const q = query.trim().toLocaleLowerCase();
  const compareUnknown = (a: number | null, b: number | null): number => {
    if (a === null) return b === null ? 0 : 1;
    if (b === null) return -1;
    return state.descending ? b - a : a - b;
  };
  return rows.filter(row => !q || row.name.toLocaleLowerCase().includes(q) || String(row.pid).includes(q))
    .sort((a, b) => {
      let delta: number;
      switch (state.field) {
        case 'name':
          delta = a.name.toLocaleLowerCase().localeCompare(b.name.toLocaleLowerCase());
          if (state.descending) delta = -delta;
          break;
        case 'pid':
          delta = state.descending ? b.pid - a.pid : a.pid - b.pid;
          break;
        case 'cpu':
          delta = compareUnknown(a.cpu_percent, b.cpu_percent);
          break;
        case 'memory':
          delta = compareUnknown(a.rss_kib, b.rss_kib);
          break;
        case 'pss':
          delta = compareUnknown(a.pss_kib, b.pss_kib);
          break;
      }
      return delta || a.pid - b.pid;
    });
}

export function percentUsed(total: number | null, available: number | null): number | null {
  if (total === null || available === null || total <= 0 || available > total) return null;
  return Math.floor(100 * (total - available) / total);
}

/** Unrounded-to-integer utilization for actual chart traces.
 * The headline status still uses whole percentages, but per-pulse RAM
 * changes of 0.1% must not disappear from its time series.
 */
export function percentUsedPrecise(total: number | null, available: number | null): number | null {
  if (total === null || available === null ||
      !Number.isFinite(total) || !Number.isFinite(available) ||
      total <= 0 || available < 0 || available > total) return null;
  return Math.round((100 * (total - available) / total) * 100) / 100;
}

/** Percentage for compact telemetry labels, without pretending a small
 * but nonzero swap allocation is 0%. This does not alter pressure thresholds.
 */
export function usageLabel(total: number | null, available: number | null): string {
  if (total === null || available === null || total < 0 || available < 0 ||
      available > total) return 'UNAVAILABLE';
  if (total === 0) return 'NOT CONFIGURED';
  const used = 100 * (total - available) / total;
  if (used === 0) return '0%';
  if (used < 0.1) return '<0.1%';
  if (used < 1) return used.toFixed(1) + '%';
  return Math.round(used) + '%';
}

export function bytesLabel(kib: number): string {
  return kib >= 1_048_576 ? (kib / 1_048_576).toFixed(1) + ' GiB' : Math.round(kib / 1024) + ' MiB';
}

export function temperatureLabel(celsius: number | null): string {
  return celsius === null ? 'UNAVAILABLE' : celsius.toFixed(1) + ' °C';
}

export function processMemoryLabel(kib: number | null): string {
  if (kib === null) return '—';
  return kib < 1024 ? kib + ' KiB' : bytesLabel(kib);
}

export function fractionLabel(total: number | null, available: number | null): string {
  return total === null || available === null || available > total ? 'UNAVAILABLE'
    : bytesLabel(total - available) + ' / ' + bytesLabel(total);
}

export function systemHeadline(metrics: SystemMetrics | null, core: boolean, niri: boolean): string {
  if (!core) return 'CORE OFFLINE';
  if (!niri) return 'NIRI DISCONNECTED';
  if (!metrics) return 'MEASURING';
  if ((percentUsed(metrics.root_total_kib, metrics.root_available_kib) ?? 0) >= 90) return 'LOW STORAGE';
  if ((percentUsed(metrics.memory_total_kib, metrics.memory_available_kib) ?? 0) >= 90) return 'MEMORY PRESSURE';
  if (metrics.battery_percent !== null && metrics.battery_percent <= 15 && metrics.battery_charging === false) return 'LOW BATTERY';
  if (metrics.cpu_percent !== null && metrics.cpu_percent >= 95) return 'SYSTEM BUSY';
  if (metrics.cpu_percent === null || percentUsed(metrics.memory_total_kib, metrics.memory_available_kib) === null) return 'MEASURING';
  if (metrics.root_total_kib === null) return 'PARTIAL DATA';
  return 'ALL SYSTEMS NOMINAL';
}

export function uptimeLabel(seconds: number | null): string {
  if (seconds === null) return 'UNAVAILABLE';
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor((seconds % 86400) / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  return (days ? days + 'd ' : '') + hours + 'h ' + minutes + 'm';
}

FILE	frontend/src/lib/themes/kira-default.css
/* Kira Default: Black / Prussian Blue / Orange / Alabaster Grey / White.
 * Exactly five canonical opaque colors; all other tones are derived.
 */
:root {
  color-scheme: dark;

  --black: #000000ff;
  --prussian-blue: #14213dff;
  --orange: #fca311ff;
  --alabaster-grey: #e5e5e5ff;
  --white: #ffffffff;

  --kira-color-background: var(--black);
  --kira-color-surface: var(--prussian-blue);
  --kira-color-muted: var(--alabaster-grey);
  --kira-color-accent: var(--orange);
  --kira-color-text: var(--white);
  /* Legacy alias retained for external widgets; prefer --kira-color-border. */
  --kira-color-earth: var(--prussian-blue);

  --kira-color-on-accent: var(--black);
  --kira-color-text-secondary: var(--alabaster-grey);
  --kira-color-surface-subtle: color-mix(in srgb, var(--prussian-blue) 75%, var(--black));
  --kira-color-border: color-mix(in srgb, var(--prussian-blue) 50%, var(--alabaster-grey));

  --kira-space-1: 4px;
  --kira-space-2: 8px;
  --kira-space-3: 12px;
  --kira-space-4: 16px;
  --kira-space-5: 20px;
  --kira-space-6: 24px;

  --kira-radius-sm: 6px;
  --kira-radius-md: 10px;
  --kira-radius-lg: 14px;

  /* Neo-brutalist construction: clear borders and hard, offset depth. */
  --kira-border-strong: 2px;
  --kira-shadow-brutal: 3px 3px 0 color-mix(in srgb, var(--prussian-blue) 50%, var(--alabaster-grey));
  --kira-shadow-panel: 8px 8px 0 color-mix(in srgb, var(--prussian-blue) 60%, var(--alabaster-grey));
  /* Popup depth: black nearest the surface, a darker orange behind it,
   * and a compact soft black shadow around all four edges. All colors
   * derive from the five canonical Kira colors. The 8px transparent inset
   * keeps the filtered silhouette inside the native WebKit surface. */
  --kira-widget-shadow-offset: 8px;
  --kira-widget-shadow-black: 2px 2px 0 var(--black);
  --kira-widget-shadow-accent: 2px 2px 0 color-mix(in srgb, var(--orange) 64%, var(--black));
  --kira-widget-shadow-soft: 0 0 3px color-mix(in srgb, var(--black) 78%, transparent);

  --kira-motion-fast: 120ms;
  --kira-motion-standard: 180ms;
  --kira-motion-easing: cubic-bezier(0.2, 0.8, 0.2, 1);
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --kira-motion-fast: 0ms;
    --kira-motion-standard: 0ms;
  }
}

