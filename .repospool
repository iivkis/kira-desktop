import { describe, expect, it } from 'vitest';
import { systemHealth } from './system-health';
import type { SystemMetrics } from './sdk/core';

const normal: SystemMetrics = {
  cpu_percent: 24, cpu_temperature_c: null, gpus: [],
  memory_total_kib: 1000, memory_available_kib: 580,
  swap_total_kib: 0, swap_free_kib: 0,
  root_total_kib: 1000, root_available_kib: 500,
  uptime_seconds: 3600, load: [0.2, 0.3, 0.1],
  battery_percent: null, battery_charging: null,
};

describe('read-only system health status', () => {
  it('does not call the whole system READY merely because Core and Niri work', () => {
    expect(systemHealth('connected', '0.1.0', true)).toMatchObject({ label: 'CHECKING', phase: 'pending' });
    expect(systemHealth('connected', '0.1.0', true, normal)).toMatchObject({ label: 'READY', phase: 'ready' });
  });

  it('prioritizes offline services before resource warnings', () => {
    expect(systemHealth('connecting', '', null, normal).label).toBe('STARTING');
    expect(systemHealth('unavailable', '', false, normal)).toMatchObject({ label: 'CORE OFF', phase: 'error' });
    expect(systemHealth('connected', '', false, normal)).toMatchObject({ label: 'NIRI OFF', phase: 'error' });
    expect(systemHealth('connected', '', null, normal).label).toBe('WAITING');
  });

  it('shows actual memory, disk and battery pressure', () => {
    expect(systemHealth('connected', '', true, { ...normal, root_available_kib: 50 }).label).toBe('LOW DISK');
    expect(systemHealth('connected', '', true, { ...normal, memory_available_kib: 50 }).label).toBe('LOW MEM');
    expect(systemHealth('connected', '', true, { ...normal, battery_percent: 10, battery_charging: false }).label).toBe('LOW BAT');
    expect(systemHealth('connected', '', true, { ...normal, battery_percent: 10, battery_charging: true }).label).toBe('READY');
    expect(systemHealth('connected', '', true, { ...normal, cpu_percent: 98 }).label).toBe('BUSY');
    expect(systemHealth('connected', '', true, { ...normal, root_total_kib: null }).label).toBe('PARTIAL');
  });

  it('never renders an unknown metric as zero', () => {
    const value = systemHealth('connected', '0.1.0', true, { ...normal, cpu_percent: null });
    expect(value.label).toBe('CHECKING');
    expect(value.details).toContain('CPU: Measuring');
    expect(value.details).toContain('Kira Core: Online (v0.1.0)');
  });
});

FILE	frontend/src/lib/system-health.ts
import type { SystemMetrics } from './sdk/core';

/** A system status reflects actual resource conditions as well as services.
 * Never imply the whole machine is healthy solely because Core responds.
 */
export type CoreConnectionStatus = 'connecting' | 'connected' | 'unavailable';
export type HealthPhase = 'ready' | 'pending' | 'warning' | 'error';

export interface HealthSummary {
  label: string;
  phase: HealthPhase;
  details: string;
}

function percentUsed(total: number | null, available: number | null): number | null {
  if (total === null || available === null || total <= 0 ||
      available < 0 || available > total) return null;
  return Math.floor((total - available) / total * 100);
}

export function systemHealth(
  core: CoreConnectionStatus,
  version: string,
  niriConnected: boolean | null,
  metrics: SystemMetrics | null = null,
): HealthSummary {
  const coreDetail = core === 'connected'
    ? 'Online' + (version ? ' (v' + version + ')' : '')
    : core === 'connecting' ? 'Connecting' : 'Offline';
  const niriDetail = niriConnected === null
    ? 'Waiting for first snapshot'
    : niriConnected ? 'Connected' : 'Disconnected';

  const mem = metrics && percentUsed(metrics.memory_total_kib, metrics.memory_available_kib);
  const disk = metrics && percentUsed(metrics.root_total_kib, metrics.root_available_kib);
  const details = [
    'Kira Core: ' + coreDetail,
    'Niri IPC: ' + niriDetail,
    'CPU: ' + (metrics?.cpu_percent === null || !metrics ? 'Measuring' : metrics.cpu_percent + '%'),
    'Memory: ' + (mem === null ? 'Unavailable' : mem + '% used'),
    'Root disk: ' + (disk === null ? 'Unavailable' : disk + '% used'),
    'Battery: ' + (metrics?.battery_percent == null ? 'Not detected' : metrics.battery_percent + '%'),
  ].join('\n');
  if (core === 'unavailable') return { label: 'CORE OFF', phase: 'error', details };
  if (core === 'connecting') return { label: 'STARTING', phase: 'pending', details };
  if (niriConnected === false) return { label: 'NIRI OFF', phase: 'error', details };
  if (niriConnected === null) return { label: 'WAITING', phase: 'pending', details };
  if (!metrics || mem === null || metrics.cpu_percent === null) {
    return { label: 'CHECKING', phase: 'pending', details };
  }
  if (disk !== null && disk >= 90) return { label: 'LOW DISK', phase: 'warning', details };
  if (mem >= 90) return { label: 'LOW MEM', phase: 'warning', details };
  if (metrics.battery_percent !== null && metrics.battery_percent <= 15 &&
      metrics.battery_charging === false) {
    return { label: 'LOW BAT', phase: 'warning', details };
  }
  if (metrics.cpu_percent >= 95) return { label: 'BUSY', phase: 'warning', details };
  if (disk === null) return { label: 'PARTIAL', phase: 'pending', details };
  return { label: 'READY', phase: 'ready', details };
}

