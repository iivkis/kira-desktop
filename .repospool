  it('does not claim calendar activation when the bridge throws', () => {
    globalThis.window = {
      webkit: { messageHandlers: { kiraCalendar: { postMessage: () => { throw new Error('closed'); } } } },
    } as unknown as Window & typeof globalThis;
    expect(toggleCalendar()).toBe(false);
  });

  it('rejects outside the host bridge', async () => {
    await expect(request('ping')).rejects.toThrow('bridge unavailable');
  });

  it('correlates responses by request id', async () => {
    const postMessage = vi.fn();
    // Browser-like mock for the native WebKit postMessage API.
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('get_state');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number; method: string };
    expect(payload.method).toBe('get_state');
    deliverReply({ jsonrpc: '2.0', id: payload.id, result: { version: '0.1.0', status: 'bootstrap' } });
    await expect(result).resolves.toEqual({ version: '0.1.0', status: 'bootstrap' });
  });

  it('requests typed real Niri workspaces with JS-safe IDs', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('get_workspaces');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number; method: string };
    expect(payload.method).toBe('get_workspaces');
    const workspace = {
      id: '18446744073709551615', idx: 2, name: 'code', output: 'DP-1',
      is_active: true, is_focused: false, is_urgent: true,
    };
    deliverReply({
      jsonrpc: '2.0', id: payload.id,
      result: { connected: true, workspaces: [workspace] },
    });
    await expect(result).resolves.toEqual({ connected: true, workspaces: [workspace] });
  });

  it('sends a single focus action by stable string id, never index or unsafe JS number', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const pending = focusWorkspace('18446744073709551615');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as {
      jsonrpc: string; id: number; method: string; params: { id: string };
    };
    expect(payload).toEqual({
      jsonrpc: '2.0', id: expect.any(Number),
      method: 'focus_workspace', params: { id: '18446744073709551615' },
    });
    expect(payload.params.id).toBe('18446744073709551615');
    deliverReply({ jsonrpc: '2.0', id: payload.id, result: { accepted: true } });
    await expect(pending).resolves.toBeUndefined();
  });

  it('rejects malformed workspace IDs without sending any native request', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    for (const id of ['-1', '01', '', 'code', '18446744073709551616', '3;quit']) {
      await expect(focusWorkspace(id)).rejects.toThrow('Invalid workspace ID');
    }
    expect(postMessage).not.toHaveBeenCalled();
  });

  it('propagates Niri focus failures rather than optimistically changing workspace', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const pending = focusWorkspace('9');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number };
    deliverReply({ jsonrpc: '2.0', id: payload.id, error: { code: -32602, message: 'Unknown workspace id' } });
    await expect(pending).rejects.toThrow('Unknown workspace id');
  });

  it('delivers live workspace events and unsubscribes without polling', () => {
    const handlers = new Map<string, EventListener>();
    const addEventListener = vi.fn((name: string, listener: EventListener) => {
      handlers.set(name, listener);
    });
    const removeEventListener = vi.fn();
    globalThis.window = { addEventListener, removeEventListener } as unknown as Window & typeof globalThis;
    const onChange = vi.fn();
    const stop = onWorkspaceUpdate(onChange);
    const handler = handlers.get('kira:workspaces');
    expect(handler).toBeDefined();
    handler!({ detail: { connected: true, workspaces: [{
      id: '33', idx: 2, name: null, output: 'winit',
      is_active: true, is_focused: true, is_urgent: false,
    }] } } as unknown as Event);
    expect(onChange).toHaveBeenCalledOnce();
    expect(onChange.mock.calls[0][0].workspaces[0].idx).toBe(2);
    handler!({ detail: { workspaces: [] } } as unknown as Event);
    expect(onChange).toHaveBeenCalledOnce();
    stop();
    expect(removeEventListener).toHaveBeenCalledWith('kira:workspaces', handler);
  });

  it('validates native metrics, delivers valid samples and unsubscribes', () => {
    const handlers = new Map<string, EventListener>();
    const addEventListener = vi.fn((name: string, listener: EventListener) => handlers.set(name, listener));
    const removeEventListener = vi.fn();
    globalThis.window = { addEventListener, removeEventListener } as unknown as Window & typeof globalThis;
    const changed = vi.fn();
    const stop = onSystemMetrics(changed);
    const listener = handlers.get('kira:system-metrics');
    expect(listener).toBeDefined();
    const metrics = {
      cpu_percent: 42, cpu_temperature_c: null, gpus: [],
      memory_total_kib: 16000, memory_available_kib: 8000,
      root_total_kib: 20000, root_available_kib: 12000,
      battery_percent: null, battery_charging: null,
    };
    for (const invalid of [
      null, { ...metrics, cpu_percent: 120 }, { ...metrics, cpu_percent: -1 },
      { ...metrics, root_available_kib: Number.NaN }, { ...metrics, battery_percent: 101 },
      { ...metrics, battery_charging: 'unknown' },
      { ...metrics, gpus: [{ label: 'bad', utilization_percent: NaN, temperature_c: null }] },
      { ...metrics, cpu_temperature_c: Infinity },
    ]) {
      listener!({ detail: invalid } as unknown as Event);
    }
    expect(changed).not.toHaveBeenCalled();
    listener!({ detail: metrics } as unknown as Event);
    expect(changed).toHaveBeenCalledExactlyOnceWith(metrics);
    stop();
    expect(removeEventListener).toHaveBeenCalledWith('kira:system-metrics', listener);
  });

  it('returns an inert event unsubscribe without a browser window', () => {
    globalThis.window = undefined as unknown as Window & typeof globalThis;
    expect(() => onSystemMetrics(vi.fn())()).not.toThrow();
    expect(() => onWorkspaceUpdate(vi.fn())()).not.toThrow();
    expect(() => onConfigUpdate(vi.fn())()).not.toThrow();
  });

  it('reads validated config state through read-only JSON-RPC', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const pending = request('get_config');
    const data = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number; method: string };
    expect(data.method).toBe('get_config');
    const config = { compact: true, title: 'KIRA QA', show_seconds: true, show_names: false, max_workspaces: 3 };
    deliverReply({ jsonrpc: '2.0', id: data.id, result: { config, error: null } });
    await expect(pending).resolves.toEqual({ config, error: null });
  });

  it('applies pushed KDL configuration, rejects malformed updates and unsubscribes', () => {
    const handlers = new Map<string, EventListener>();
    const addEventListener = vi.fn((name: string, listener: EventListener) => handlers.set(name, listener));
    const removeEventListener = vi.fn();
    globalThis.window = { addEventListener, removeEventListener } as unknown as Window & typeof globalThis;
    const changed = vi.fn();
    const stop = onConfigUpdate(changed);
    const listener = handlers.get('kira:config');
    expect(listener).toBeDefined();
    const config = { compact: true, title: 'Panel', show_seconds: true, show_names: false, max_workspaces: 8 };
    listener!({ detail: { config, error: null } } as unknown as Event);
    expect(changed).toHaveBeenCalledOnce();
    listener!({ detail: { config: { ...config, max_workspaces: 0 }, error: null } } as unknown as Event);
    expect(changed).toHaveBeenCalledOnce();
    stop();
    expect(removeEventListener).toHaveBeenCalledWith('kira:config', listener);
  });

  it('rejects Core errors', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('ping');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number };
    deliverReply({ jsonrpc: '2.0', id: payload.id, error: { code: -32000, message: 'unavailable' } });
    await expect(result).rejects.toThrow('unavailable');
  });
});

FILE	frontend/src/lib/sdk/core.ts
/** Typed, request/response bridge for trusted Svelte UI modules. */
export interface CoreState {
  version: string;
  status: 'bootstrap';
}

export interface Workspace {
  /** Stable Niri u64 ID encoded as a string (JavaScript numbers lose precision). */
  id: string;
  /** 1-based workspace position on its own output, NOT a globally unique ID. */
  idx: number;
  name: string | null;
  output: string | null;
  is_active: boolean;
  is_focused: boolean;
  is_urgent: boolean;
}

export interface WorkspaceState {
  connected: boolean;
  workspaces: Workspace[];
}

/** Linux resource snapshot forwarded by the trusted native Shell.
 * Null means unavailable, never zero. Units are KiB and seconds.
 */
export interface GpuMetrics {
  label: string;
  utilization_percent: number | null;
  temperature_c: number | null;
}

export interface SystemMetrics {
  cpu_percent: number | null;
  cpu_temperature_c: number | null;
  gpus: GpuMetrics[];
  memory_total_kib: number | null;
  memory_available_kib: number | null;
  swap_total_kib: number | null;
  swap_free_kib: number | null;
  root_total_kib: number | null;
  root_available_kib: number | null;
  uptime_seconds: number | null;
  load: [number, number, number] | null;
  battery_percent: number | null;
  battery_charging: boolean | null;
}

/** Subscribe to a trusted native event after checking its payload shape. */
function onNativeEvent<T>(
  name: string,
  isValid: (value: unknown) => value is T,
  callback: (value: T) => void,
): () => void {
  if (typeof window === 'undefined') return () => {};
  const listener = (event: Event) => {
    const value = (event as CustomEvent<unknown>).detail;
    if (isValid(value)) callback(value);
  };
  window.addEventListener(name, listener);
  return () => window.removeEventListener(name, listener);
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function isSystemMetrics(value: unknown): value is SystemMetrics {
  if (!isRecord(value)) return false;
  const valid = (n: unknown) => n === null ||
    (typeof n === 'number' && Number.isFinite(n) && n >= 0);
  const percent = (n: unknown) => valid(n) && (n === null || (typeof n === 'number' && n <= 100));
  const temperature = (n: unknown) => n === null ||
    (typeof n === 'number' && Number.isFinite(n) && n >= -40 && n <= 150);
  return percent(value.cpu_percent) &&
    temperature(value.cpu_temperature_c) &&
    Array.isArray(value.gpus) && value.gpus.length <= 8 &&
    value.gpus.every((gpu: unknown) => isRecord(gpu) &&
      typeof gpu.label === 'string' && gpu.label.length <= 80 &&
      percent(gpu.utilization_percent) && temperature(gpu.temperature_c)) &&
    valid(value.memory_total_kib) && valid(value.memory_available_kib) &&
    valid(value.root_total_kib) && valid(value.root_available_kib) &&
    percent(value.battery_percent) &&
    (value.battery_charging === null || typeof value.battery_charging === 'boolean');
}

/** Event-driven system metrics: does not add browser polling or an RPC method. */
export function onSystemMetrics(callback: (metrics: SystemMetrics) => void): () => void {
  return onNativeEvent('kira:system-metrics', isSystemMetrics, callback);
}

/** Lightweight native CPU/RAM samples at 500ms, only while Overview is open.
 * Expensive GPU/hwmon/process/storage measurements remain on slower feeds.
 */
export interface SystemPulse {
  cpu_percent: number | null;
  memory_total_kib: number | null;
  memory_available_kib: number | null;
}

export function onSystemPulse(callback: (pulse: SystemPulse) => void): () => void {
  const validKiB = (value: unknown) => value === null ||
    (typeof value === 'number' && Number.isSafeInteger(value) && value >= 0);
  return onNativeEvent('kira:system:pulse', (value): value is SystemPulse =>
    isRecord(value) &&
    (value.cpu_percent === null ||
      (typeof value.cpu_percent === 'number' && Number.isInteger(value.cpu_percent) &&
       value.cpu_percent >= 0 && value.cpu_percent <= 100)) &&
    validKiB(value.memory_total_kib) &&
    validKiB(value.memory_available_kib) &&
    (value.memory_total_kib === null || value.memory_available_kib === null ||
      (value.memory_available_kib as number) <= (value.memory_total_kib as number)),
    callback);
}

export interface SystemOverlayData {
  metrics: SystemMetrics;
  core: boolean;
  niri: boolean;
}

export interface ProcessRow {
  pid: number;
  name: string;
  state: string;
  cpu_percent: number | null;
  rss_kib: number | null;
  pss_kib: number | null;
}

export interface SystemProcesses {
  rows: ProcessRow[];
  total: number;
  truncated: boolean;
  error: string | null;
}

/** Overlay-specific, read-only events with strict bounded payload shapes. */
export function onSystemOverlayData(callback: (data: SystemOverlayData) => void): () => void {
  return onNativeEvent('kira:system:data', (value): value is SystemOverlayData =>
    isRecord(value) && typeof value.core === 'boolean' &&
    typeof value.niri === 'boolean' && isSystemMetrics(value.metrics) &&
    isRecord(value.metrics) &&
    (value.metrics.swap_total_kib === null || Number.isSafeInteger(value.metrics.swap_total_kib)) &&
    (value.metrics.swap_free_kib === null || Number.isSafeInteger(value.metrics.swap_free_kib)) &&
    (value.metrics.uptime_seconds === null || Number.isSafeInteger(value.metrics.uptime_seconds)) &&
    (value.metrics.load === null ||
      (Array.isArray(value.metrics.load) && value.metrics.load.length === 3 &&
        value.metrics.load.every((n: unknown) => typeof n === 'number' && Number.isFinite(n) && n >= 0))),
  callback);
}

export function onSystemProcesses(callback: (data: SystemProcesses) => void): () => void {
  return onNativeEvent('kira:system:processes', (value): value is SystemProcesses => {
    if (!isRecord(value) || !Array.isArray(value.rows) || value.rows.length > 4096 ||
        !Number.isSafeInteger(value.total) || (value.total as number) < 0 ||
        typeof value.truncated !== 'boolean' ||
        !(value.error === null || (typeof value.error === 'string' && value.error.length <= 120))) return false;
    return value.rows.every((row: unknown) => isRecord(row) &&
      Number.isSafeInteger(row.pid) && (row.pid as number) >= 0 && (row.pid as number) <= 4294967295 &&
      typeof row.name === 'string' && row.name.length <= 64 &&
      typeof row.state === 'string' && row.state.length === 1 &&
      (row.cpu_percent === null || (typeof row.cpu_percent === 'number' && Number.isFinite(row.cpu_percent) && row.cpu_percent >= 0 && row.cpu_percent <= 100)) &&
      (row.rss_kib === null || (Number.isSafeInteger(row.rss_kib) && (row.rss_kib as number) >= 0)) &&
      (row.pss_kib === null || (Number.isSafeInteger(row.pss_kib) && (row.pss_kib as number) >= 0)));
  }, callback);
}

/** Listen for typed workspace push events emitted by the native Shell.
 * No Niri or Core polling is performed here. Unsubscribe on Svelte unmount.
 */
export function onWorkspaceUpdate(callback: (state: WorkspaceState) => void): () => void {
  return onNativeEvent('kira:workspaces', (value): value is WorkspaceState =>
    isRecord(value) && typeof value.connected === 'boolean' && Array.isArray(value.workspaces),
  callback);
}

export interface UiConfig {
  compact: boolean;
  title: string;
  show_seconds: boolean;
  show_names: boolean;
  max_workspaces: number;
}

export interface ConfigState {
  config: UiConfig;
  error: string | null;
}

export const defaultUiConfig: UiConfig = {
  compact: false,
  title: 'KIRA DESKTOP',
  show_seconds: false,
  show_names: true,
  max_workspaces: 12,
};

/** Subscribe to Core's validated KDL config snapshots, without polling. */
export function onConfigUpdate(callback: (state: ConfigState) => void): () => void {
  return onNativeEvent('kira:config', (value): value is ConfigState => {
    if (!isRecord(value) || !isRecord(value.config)) return false;
    const cfg = value.config;
    return typeof cfg.compact === 'boolean' &&
      typeof cfg.title === 'string' && typeof cfg.show_seconds === 'boolean' &&
      typeof cfg.show_names === 'boolean' && typeof cfg.max_workspaces === 'number' &&
      Number.isInteger(cfg.max_workspaces) && cfg.max_workspaces >= 1 &&
      cfg.max_workspaces <= 32;
  }, callback);
}

type Methods = {
  ping: string;
  get_state: CoreState;
  get_workspaces: WorkspaceState;
  get_config: ConfigState;
};

type RpcReply = {
  jsonrpc: '2.0';
  id: number | null;
  result?: unknown;
  error?: { code: number; message: string };
};

type Bridge = {
  postMessage(message: string): void;
};

declare global {
  interface Window {
    webkit?: { messageHandlers?: { kira?: Bridge; kiraDiagnostics?: Bridge; kiraLauncher?: Bridge; kiraCalendar?: Bridge; kiraCalendarUi?: Bridge; kiraSystem?: Bridge } };
  }
}

/** Only fixed commands are exposed to trusted Svelte components. Keep host
 * bridge failures non-throwing so an offline overlay does not crash the bar.
 */
function postNativeCommand(channelName: 'kiraLauncher' | 'kiraCalendar' | 'kiraSystem', command: 'open' | 'toggle'): boolean {
  const channel = typeof window === 'undefined'
    ? undefined
    : window.webkit?.messageHandlers?.[channelName];
  if (!channel) return false;
  try {
    channel.postMessage(command);
    return true;
  } catch {
    return false;
  }
}

/** Native launcher control is a fixed-purpose channel, never a shell command. */
export function openLauncher(): boolean {
  return postNativeCommand('kiraLauncher', 'open');
}

/** Toggle the native calendar overlay through its fixed-purpose channel. */
export function toggleCalendar(): boolean {
  return postNativeCommand('kiraCalendar', 'toggle');
}

/** Only the calendar overlay has access to this dedicated host channel.
 * The Top Bar cannot copy arbitrary text or request calendar window actions.
 */
function sendCalendarUi(command: string): boolean {
  const channel = typeof window === 'undefined'
    ? undefined
    : window.webkit?.messageHandlers?.kiraCalendarUi;
  if (!channel) return false;
  try {
    channel.postMessage(command);
    return true;
  } catch {
    return false;
  }
}

/** The WebKit document is ready, but no widget has been mounted yet. */
export function notifyCalendarHostReady(): void {
  sendCalendarUi('host-ready');
}

/** Report a measured, clamped Svelte widget root height. Native GTK
 * validates the generation and enforces the real monitor's 70% limit.
 */
export function notifyOverlayHeight(generation: number, height: number): boolean {
  if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff ||
      !Number.isSafeInteger(height) || height < 1 || height > 20000) return false;
  return sendCalendarUi('size:' + generation + ':' + height);
}

/** A specific popup generation has finished its lazy Svelte mount. */
export function notifyCalendarMounted(generation: number): void {
  if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff) return;
  sendCalendarUi('mounted:' + generation);
}

export function closeCalendarOverlay(): void {
  sendCalendarUi('close');
}

export function copyCalendarDate(date: string): void {
  // Prevent arbitrary data crossing into the OS clipboard API. The Rust host
  // revalidates the exact date, including month lengths and leap years.
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return;
  sendCalendarUi('copy:' + date);
}

/** The shared overlay accepts only fixed read-only tab and copy actions. */
export function closeSystemOverlay(): void {
  sendCalendarUi('close');
}

export function setSystemMonitorTab(tab: 'overview' | 'processes'): void {
  if (tab === 'overview' || tab === 'processes') sendCalendarUi('tab:' + tab);
}

export function copySystemReport(): void {
  sendCalendarUi('copy-report');
}

export interface LauncherApp {
  id: number;
  name: string;
  description: string;
}

export interface LauncherCatalog {
  apps: LauncherApp[];
}

export interface LauncherIcon {
  id: number;
  data_url: string | null;
}

export interface LauncherIcons {
  icons: LauncherIcon[];
}

const iconDataUri = /^data:image\/(?:png|jpeg|webp|svg\+xml);base64,[A-Za-z0-9+/]+={0,2}$/;

/** Native GTK resolves themed icons into bounded image-only data URIs.
 * Never accept filesystem paths, file://, javascript: or HTTP URLs.
 */
export function onLauncherIcons(callback: (batch: LauncherIcons) => void): () => void {
  return onNativeEvent('kira:launcher:icons', (value): value is LauncherIcons =>
    isRecord(value) && Array.isArray(value.icons) && value.icons.length <= 16 &&
    value.icons.every((icon: unknown) => {
      if (!isRecord(icon) || !Number.isSafeInteger(icon.id) ||
          (icon.id as number) < 0 || (icon.id as number) >= 1024) return false;
      return icon.data_url === null ||
        (typeof icon.data_url === 'string' && icon.data_url.length <= 180_000 &&
          iconDataUri.test(icon.data_url));
    }), callback);
}

export function requestLauncherIcons(generation: number, ids: number[]): boolean {
  if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff ||
      ids.length === 0 || ids.length > 16 ||
      new Set(ids).size !== ids.length ||
      !ids.every(id => Number.isSafeInteger(id) && id >= 0 && id < 1024)) return false;
  return sendCalendarUi('icons-request:' + generation + ':' + ids.join(','));
}

/** The launcher receives a bounded, read-only catalog from native GIO. */
export function onLauncherCatalog(callback: (catalog: LauncherCatalog) => void): () => void {
  return onNativeEvent('kira:launcher:apps', (value): value is LauncherCatalog =>
    isRecord(value) && Array.isArray(value.apps) && value.apps.length <= 1024 &&
    value.apps.every((app: unknown) =>
      isRecord(app) && Number.isSafeInteger(app.id) &&
      (app.id as number) >= 0 && (app.id as number) < 1024 &&
      typeof app.name === 'string' && app.name.length <= 120 &&
      typeof app.description === 'string' && app.description.length <= 240),
  callback);
}

export function onLauncherError(callback: (message: string) => void): () => void {
  return onNativeEvent('kira:launcher:error',
    (value): value is { message: string } =>
      isRecord(value) && typeof value.message === 'string' && value.message.length <= 180,
    (value) => callback(value.message));
}

/** Index belongs to Rust's GIO catalog, never an executable path or a command. */
export function requestLauncherCatalog(generation: number): boolean {
  if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff) return false;
  return sendCalendarUi('apps-request:' + generation);
}

export function launchDesktopApp(generation: number, id: number): boolean {
  if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff ||
      !Number.isSafeInteger(id) || id < 0 || id >= 1024) return false;
  return sendCalendarUi('launch:' + generation + ':' + id);
}

export function closeLauncherOverlay(): void {
  sendCalendarUi('close');
}

/** Open or close the shared Svelte read-only system monitor. */
export function toggleSystemPanel(): boolean {
  return postNativeCommand('kiraSystem', 'toggle');
}

let nextId = 0;
const pending = new Map<number, {
  resolve: (value: unknown) => void;
  reject: (reason: Error) => void;
  timeout: ReturnType<typeof setTimeout>;
}>();

/** Deliver a reply from the Rust Host. Exported for contract tests. */
export function deliverReply(reply: RpcReply): void {
  if (reply.jsonrpc !== '2.0' || typeof reply.id !== 'number') return;
  const request = pending.get(reply.id);
  if (!request) return;
  pending.delete(reply.id);
  clearTimeout(request.timeout);
  if (reply.error) request.reject(new Error(`${reply.error.code}: ${reply.error.message}`));
  else request.resolve(reply.result);
}

if (typeof window !== 'undefined') {
  window.addEventListener('kira:rpc', (event: Event) => {
    deliverReply((event as CustomEvent<RpcReply>).detail);
  });
}

/**
 * Asks the Core for an allowlisted read-only method. Resolves only after the Rust
 * Host has returned a response; rejects if Core is unavailable or times out.
 */
export function request<M extends keyof Methods>(method: M): Promise<Methods[M]> {
  return send(method) as Promise<Methods[M]>;
}

/** One intentional, narrowly scoped Niri action.
 * Uses a stable string ID, never a per-monitor workspace index.
 * Core checks the live workspace snapshot before sending FocusWorkspace.
 */
export function focusWorkspace(workspaceId: string): Promise<void> {
  // u64 is decimal and may exceed Number.MAX_SAFE_INTEGER: never coerce to JS number.
  if (!/^(0|[1-9][0-9]*)$/.test(workspaceId) ||
      workspaceId.length > 20 ||
      BigInt(workspaceId) > 18446744073709551615n) {
    return Promise.reject(new Error('Invalid workspace ID'));
  }
  return send('focus_workspace', { id: workspaceId }).then(() => undefined);
}

function send(method: string, params?: { id: string }): Promise<unknown> {
  const channel = typeof window === 'undefined' ? undefined : window.webkit?.messageHandlers?.kira;
  if (!channel) return Promise.reject(new Error('Kira bridge unavailable (browser preview)'));

  const id = ++nextId;
  return new Promise<unknown>((resolve, reject) => {
    const timeout = setTimeout(() => {
      pending.delete(id);
      reject(new Error('Kira Core request timed out'));
    }, 3000);
    pending.set(id, { resolve, reject, timeout });
    try {
      channel.postMessage(JSON.stringify({
        jsonrpc: '2.0', id, method, ...(params ? { params } : {}),
      }));
    } catch (error) {
      clearTimeout(timeout);
      pending.delete(id);
      reject(error instanceof Error ? error : new Error('Kira bridge failed'));
    }
  });
}

