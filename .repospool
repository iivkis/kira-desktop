export function formatClock(date: Date, timeZone?: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
    ...(timeZone ? { timeZone } : {}),
  }).format(date);
}

FILE	frontend/src/main.ts
import { flushSync, mount } from 'svelte';
import App from './App.svelte';
import { startUi, whenDocumentReady } from './lib/bootstrap';
import './style.css';

function report(message: string): void {
  try {
    window.webkit?.messageHandlers?.kiraDiagnostics?.postMessage(message);
  } catch {
    // Diagnostic transport is best-effort and must not break the UI.
  }
}

Reflect.set(window, '__kiraEntryStarted', true);
report('Svelte entrypoint evaluating; document.readyState=' + document.readyState);

// The original Vite <script type="module"> ran after parsing the body.
// Our single-file build inlines it as a classic <script> in <head>, so
// attempting mount() immediately would fail because #app does not exist yet.
whenDocumentReady(document, () => {
  report('Svelte bootstrap after DOMContentLoaded; readyState=' + document.readyState);
  const target = document.getElementById('app');
  const mounted = startUi(
    target,
    (container) => {
      mount(App, { target: container });
      flushSync();
    },
    report,
  );
  Reflect.set(window, '__kiraMountReturned', mounted);
  if (mounted) {
    report('Svelte entrypoint mounted');
  }
});

FILE	frontend/src/style.css
@import './lib/themes/kira-default.css';

:root {
  font-family: Inter, 'Segoe UI Variable', 'Noto Sans', system-ui, sans-serif;
  font-synthesis: none;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  color: var(--kira-color-text);
  background: var(--kira-color-background);
}

* {
  box-sizing: border-box;
}

html,
body,
#app {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

:focus-visible {
  outline: 2px solid var(--kira-color-accent);
  outline-offset: 2px;
}

.bar {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 42px;
  min-height: 42px;
  padding: 0 var(--kira-space-4);
  border-bottom: 1px solid var(--kira-color-border);
  background: linear-gradient(
    110deg,
    var(--kira-color-surface-subtle) 0%,
    var(--kira-color-background) 41%,
    color-mix(in srgb, var(--kira-color-surface) 19%, var(--kira-color-background)) 100%
  );
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--kira-color-text) 9%, transparent),
    0 2px 10px color-mix(in srgb, var(--kira-color-background) 25%, transparent);
  color: var(--kira-color-text);
}

.bar::before {
  position: absolute;
  top: 0;
  right: 14%;
  left: 14%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    color-mix(in srgb, var(--kira-color-accent) 33%, transparent),
    transparent
  );
  content: '';
  pointer-events: none;
}

.bar__start,
.bar__end,
.brand,
.clock {
  display: flex;
  align-items: center;
}

.bar__start,
.bar__end {
  min-width: 0;
  gap: var(--kira-space-3);
}

.bar__start {
  flex: 1;
}

.bar__end {
  flex: 1;
  justify-content: flex-end;
}

.brand {
  gap: 7px;
  flex: none;
}

.brand__symbol {
  display: grid;
  place-items: center;
  width: 27px;
  height: 27px;
  border: 1px solid color-mix(in srgb, var(--kira-color-accent) 62%, var(--kira-color-background));
  border-radius: var(--kira-radius-sm);
  background: color-mix(in srgb, var(--kira-color-accent) 11%, var(--kira-color-background));
  color: var(--kira-color-accent);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.08em;
  line-height: 1;
  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--kira-color-accent) 12%, transparent);
}

.brand__wordmark {
  color: var(--kira-color-text);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.22em;
  line-height: 1;
}

.bar__separator {
  flex: none;
  width: 1px;
  height: 15px;
  background: color-mix(in srgb, var(--kira-color-muted) 27%, transparent);
}

.bar__center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 12px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.bar__center-line {
  width: 23px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--kira-color-muted));
  opacity: 0.5;
}

.bar__center-line:last-child {
  transform: rotate(180deg);
}

.bar__center-title {
  white-space: nowrap;
  color: var(--kira-color-accent);
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.19em;
}

.bar__center-title span {
  color: var(--kira-color-text-secondary);
  font-weight: 550;
}

.clock {
  justify-content: flex-end;
  gap: var(--kira-space-2);
  min-width: 56px;
  color: var(--kira-color-text);
}

.clock__icon {
  width: 14px;
  height: 14px;
  color: var(--kira-color-accent);
}

.clock time {
  font-size: 12px;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.03em;
  white-space: nowrap;
}

@media (max-width: 820px) {
  .bar__center {
    display: none;
  }
}

@media (max-width: 540px) {
  .bar {
    padding-inline: var(--kira-space-2);
  }

  .bar__start,
  .bar__end {
    gap: var(--kira-space-2);
  }

  .brand__wordmark,
  .clock__icon {
    display: none;
  }
}

@media (max-width: 380px) {
  .bar__end > .bar__separator {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

