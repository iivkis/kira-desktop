  width: 100%;
  height: 100%;
  overflow: hidden;
}

:focus-visible {
  outline: 2px solid var(--kira-color-accent);
  outline-offset: 2px;
}

.bar {
  position: relative;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 42px;
  min-height: 42px;
