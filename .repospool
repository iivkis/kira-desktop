"""Svelte Calendar overlay contract. Native GTK is just a Wayland window host."""
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RUST = (ROOT / "crates/kira-shell/src/calendar.rs").read_text()
SHELL = (ROOT / "crates/kira-shell/src/main.rs").read_text()
NATIVE = (ROOT / "crates/kira-shell/src/native_ui.rs").read_text()
SDK = (ROOT / "frontend/src/lib/sdk/core.ts").read_text()
FRONTEND = (ROOT / "frontend/src/App.svelte").read_text()
CALENDAR = (ROOT / "frontend/src/lib/components/CalendarWidget.svelte").read_text()
TS_MODEL = (ROOT / "frontend/src/lib/calendar-model.ts").read_text()
ENTRY = (ROOT / "frontend/src/main.ts").read_text()
NIX = (ROOT / "nix/package.nix").read_text()


class CalendarDesignTests(unittest.TestCase):
    def test_window_calendar_is_readable_and_responsive(self):
        sky = (ROOT / "frontend/src/lib/components/SkyMap.svelte").read_text()
        browser = (ROOT / "frontend/scripts/smoke-overlays.mjs").read_text()
        self.assertIn("data-calendar-rail", CALENDAR)
        self.assertIn("max-[760px]:flex-col", CALENDAR)
        self.assertIn("max-[760px]:w-full", CALENDAR)
        self.assertIn("max-[760px]:overflow-y-auto", CALENDAR)
        self.assertIn("max-[760px]:flex-none", sky)
        self.assertIn("bg-kira-surface", sky)
        self.assertIn("bg-kira-bg", sky)
        self.assertIn("{#if exampleLocation}", sky)
        self.assertIn("prefers-reduced-motion", sky)
        self.assertIn("motion.addEventListener('change', settleForReducedMotion)", sky)
        self.assertIn("1536 / Math.max(width, height)", sky)
        self.assertIn("await smokeCalendarSky('680,720', true)", browser)
        self.assertIn("root.scrollWidth<=root.clientWidth+2", browser)

    def test_sky_atlas_only_mounts_in_calendar_niri_window(self):
        atlas = (ROOT / "frontend/src/lib/components/SkyMap.svelte").read_text()
        model = (ROOT / "frontend/src/lib/astronomy/sky-model.ts").read_text()
        catalog = (ROOT / "frontend/src/lib/astronomy/sky-catalog.ts").read_text()
        self.assertIn("data-calendar-mode={detached ? 'window' : 'widget'}", CALENDAR)
        self.assertIn("if (current === generation) detached = true;", CALENDAR)
        self.assertIn("{#if detached}\n    <SkyMap date={selected} />", CALENDAR)
        self.assertIn("normal.set_default_size(1040, 720)", RUST)
        self.assertIn("const observer = $derived(observerCoordinates(latitude, longitude))", atlas)
        self.assertIn("const when = $derived(localObservationDate(date, time))", atlas)
        self.assertIn("shortestSiderealDelta", atlas)
        self.assertIn("prefers-reduced-motion", atlas)
        self.assertIn("ResizeObserver", atlas)
        self.assertIn("siderealDegrees", model)
        self.assertIn("constellation", catalog.lower())
        self.assertNotIn("fetch(", atlas)
        self.assertNotIn("navigator.geolocation", atlas)

    def test_svelte_owns_date_grid_and_calendar_actions(self):
        for token in (
            'data-kira-ui-root', 'aria-label="Kira Calendar"',
            "monthGrid(", "onclick={() => choose(date)}",
            "onclick={goToday}", "onCopy(selectedIso)",
            "aria-pressed={marker.selected}",
            "aria-current={marker.today ? 'date' : undefined}",
            "tabindex={marker.selected ? 0 : -1}",
            "focus-visible:outline-kira-on-accent",
        ):
            self.assertIn(token, CALENDAR)
        for token in ("role=\"group\" aria-label=\"Calendar dates\"",
                      "data-calendar-clock-play", "use:tenetCalendarGrid",
                      "kira-calendar-scroll", "aria-label=\"Navigate calendar\""):
            self.assertIn(token, CALENDAR)
        self.assertIn("{currentDateLabel}", CALENDAR)
        self.assertIn("{selectedIso}", CALENDAR)
        for filler in ("KIRA / CHRONOLOGY", "02 / DATE INDEX", "03 / ",
                       "LIVE / LOCAL", "01 / LOCAL TIME"):
            self.assertNotIn(filler, CALENDAR)
        self.assertIn("calendarDayState(", CALENDAR)
        self.assertIn("calendarDayState(", TS_MODEL)
        for token in ("monthGrid(", "shiftMonth(", "isoWeek(", "dayOfYear("):
            self.assertIn(token, TS_MODEL)
        for native_ui in ("gtk::Grid", "gtk::Button", "gtk::Label",
                          'include_str!("calendar.css")', "gtk::Calendar"):
            self.assertNotIn(native_ui, RUST)

    def test_calendar_host_is_an_isolated_webkit_overlay(self):
        self.assertIn('set_namespace(Some("kira-overlay"))', RUST)
        self.assertIn("set_exclusive_zone(0)", RUST)
        self.assertIn("set_keyboard_mode(KeyboardMode::OnDemand)", RUST)
        self.assertIn("native_ui::configure_webview_popup(&window, 420, 1)", RUST)
        self.assertIn("native_ui::POPUP_TOP_MARGIN", RUST)
        self.assertIn("restrict_webview_navigation(&view)", RUST)
        self.assertIn('register_script_message_handler("kiraCalendarUi", None)', RUST)
        self.assertIn("view.load_html(&overlay.document, None)", RUST)
        self.assertNotIn('register_script_message_handler("kira", None)', RUST)
        self.assertNotIn("gtk::CssProvider", RUST)
        self.assertIn("pub fn restrict_webview_navigation", NATIVE)
        self.assertIn("pub fn configure_webview_popup", NATIVE)

    def test_calendar_is_preloaded_and_reused_without_a_blank_surface(self):
        self.assertIn("calendar::prewarm(&calendar_app, &calendar_source, &warm_context)", SHELL)
        self.assertIn("static POOL: RefCell<Option<Rc<OverlayPool>>>", RUST)
        self.assertIn("scheduler: RefCell<WebviewScheduler>", RUST)
        self.assertIn("pool.scheduler.borrow_mut().prewarm_one(Instant::now())", RUST)
        self.assertIn("Reservation::Reused(id)", RUST)
        self.assertIn("Reservation::Created(id)", RUST)
        self.assertIn("fn ensure(", RUST)
        self.assertIn("self.window.set_visible(false)", RUST)
        self.assertIn("self.window.set_opacity(0.0)", RUST)
        self.assertIn("self.window.set_opacity(1.0)", RUST)
        self.assertIn("self.schedule_reveal_fallback(generation)", RUST)
        self.assertIn("Duration::from_millis(125)", RUST)
        self.assertIn("state.widget_ready.get()", RUST)
        self.assertIn("self.request_paint()", RUST)
        self.assertIn("requestAnimationFrame(() => requestAnimationFrame(", RUST)
        self.assertIn("self.generation.get() == generation", RUST)
        self.assertIn("view.window.close()", RUST)
        self.assertIn("view.disposed.set(true)", RUST)
        self.assertIn("pub fn prewarm(", RUST)
        self.assertIn("requestAnimationFrame", RUST)
        self.assertIn("sendCalendarUi('host-ready')", SDK)
        self.assertIn("sendCalendarUi('mounted:' + generation + ':'", SDK)
        self.assertIn("notifyCalendarMounted(generation, window.matchMedia", ENTRY)

    def test_lazy_svelte_mount_and_dispose_on_hide(self):
        self.assertIn("self.view.evaluate_javascript(", RUST)
        self.assertIn("kira:overlay:show", RUST)
        self.assertIn("kira:overlay:hide", RUST)
        self.assertIn("Some(UiCommand::HostReady)", RUST)
        self.assertIn("Some(UiCommand::Mounted(generation, reduced))", RUST)
        self.assertIn("self.widget_ready.set(false)", RUST)
        self.assertIn("self.generation.get() == generation", RUST)
        self.assertIn("notifyCalendarHostReady();", ENTRY)
        self.assertIn("notifyCalendarMounted", ENTRY)
        self.assertIn("host.hide()", ENTRY)
        self.assertIn("host.show(", ENTRY)
        self.assertIn("import CalendarWidget from './lib/components/CalendarWidget.svelte'", ENTRY)
        self.assertIn("return unmount(instance)", ENTRY)
        lifecycle = (ROOT / "frontend/src/lib/lazy-widget.ts").read_text()
        self.assertIn("await previous.widget.unmount(previous.instance)", lifecycle)
        self.assertIn("if (desired !== generation) continue", lifecycle)
        self.assertIn("if ((active?.generation ?? null) !== desired) void drain()", lifecycle)
        # The offline classic script cannot issue a dynamic import request.
        self.assertNotIn("await import(", ENTRY)
        # Live WebKit hosts remain warm; only excess idle hosts are reclaimed.
        self.assertIn("pool.release(self.id)", RUST)
        self.assertIn("fn prune(&self)", RUST)

    def test_surface_is_selected_by_trusted_html_marker(self):
        self.assertIn('data-kira-surface=\\"calendar\\"', RUST)
        self.assertIn("document.documentElement.dataset.kiraSurface === 'calendar'", ENTRY)
        self.assertIn("mount(CalendarWidget", ENTRY)
        self.assertIn("mount(App", ENTRY)
        self.assertIn('data-kira-ui-root', CALENDAR)
        self.assertIn("Svelte overlay DOM verified", RUST)
        self.assertIn("Svelte panel DOM verified", SHELL)
        self.assertIn("native_ui::restrict_webview_navigation(&view)", SHELL)

    def test_calendar_commands_are_allowlisted_and_dates_revalidated(self):
        self.assertIn("calendar_command(message)", RUST)
        self.assertIn("valid_date(year, month, day)", RUST)
        self.assertIn("display.clipboard().set_text(date)", RUST)
        self.assertIn("fn rejects_untrusted_calendar_commands()", RUST)
        self.assertIn("sendCalendarUi('close:' + generation)", SDK)
        self.assertIn("sendCalendarUi('copy:' + generation + ':' + date)", SDK)
        self.assertIn("kiraCalendarUi?: Bridge", SDK)
        self.assertIn('register_script_message_handler("kiraCalendar", None)', SHELL)
        self.assertIn('if value.to_string() == "toggle"', SHELL)
        self.assertIn("postNativeCommand('kiraCalendar', 'toggle')", SDK)
        self.assertIn("onclick={activateCalendar}", FRONTEND)

    def test_only_small_rust_date_copy_validation_survives(self):
        self.assertIn("fn valid_date(year: i32, month: u8, day: u8) -> bool", RUST)
        self.assertIn("fn rejects_untrusted_calendar_commands()", RUST)
        self.assertNotIn("mod calendar_model;", SHELL)
        self.assertNotIn("calendar_model.rs", RUST)
        self.assertNotIn("calendar.css", NIX)

if __name__ == "__main__":
    unittest.main()

