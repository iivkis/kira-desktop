import { describe, expect, it } from 'vitest';
import { dayOfYear, daysInMonth, isoDate, isoWeek, monthGrid, shiftDays, shiftMonth, clockGlyphs, localClockText, calendarDayState } from './calendar-model';

describe('Svelte Calendar Gregorian model', () => {
  it('keeps today, selection and adjacent-month identity independent', () => {
    const today = { year: 2026, month: 11, day: 2 };
    const selected = { year: 2026, month: 11, day: 4 };
    const visible = { year: 2026, month: 11 };
    expect(calendarDayState(today, selected, today, visible)).toEqual({
      iso: '2026-11-02', selected: false, today: true, outside: false,
    });
    expect(calendarDayState(selected, selected, today, visible)).toEqual({
      iso: '2026-11-04', selected: true, today: false, outside: false,
    });
    expect(calendarDayState({ year: 2026, month: 10, day: 31 }, selected, today, visible))
      .toEqual({ iso: '2026-10-31', selected: false, today: false, outside: true });
    expect(calendarDayState(today, today, today, visible))
      .toEqual({ iso: '2026-11-02', selected: true, today: true, outside: false });
  });

  it('respects leap years, including century rules', () => {
    expect(daysInMonth(2024, 2)).toBe(29);
    expect(daysInMonth(1900, 2)).toBe(28);
    expect(daysInMonth(2000, 2)).toBe(29);
    expect(daysInMonth(2025, 2)).toBe(28);
  });
  it('keeps six Monday-first rows with adjacent days', () => {
    const grid = monthGrid(2026, 11);
    expect(grid).toHaveLength(6);
    expect(grid.every((row) => row.length === 7)).toBe(true);
    expect(isoDate(grid[0][0]!)).toBe('2026-10-26');
    expect(isoDate(grid[0][6]!)).toBe('2026-11-01');
    expect(isoDate(grid[5][6]!)).toBe('2026-12-06');
    expect(isoWeek(grid[0][0]!)).toEqual({ year: 2026, week: 44 });
  });
  it('clamps selection on short months and respects year bounds', () => {
    expect(shiftMonth({ year: 2024, month: 1, day: 31 }, 1)).toEqual({ year: 2024, month: 2, day: 29 });
    expect(shiftMonth({ year: 2025, month: 1, day: 31 }, 1)).toEqual({ year: 2025, month: 2, day: 28 });
    expect(shiftMonth({ year: 2026, month: 1, day: 15 }, -1)).toEqual({ year: 2025, month: 12, day: 15 });
    expect(shiftMonth({ year: 1, month: 1, day: 1 }, -1)).toBeNull();
    expect(shiftMonth({ year: 9999, month: 12, day: 31 }, 1)).toBeNull();
  });
  it('calculates ISO week years and day-of-year', () => {
    expect(isoWeek({ year: 2021, month: 1, day: 1 })).toEqual({ year: 2020, week: 53 });
    expect(isoWeek({ year: 2018, month: 12, day: 31 })).toEqual({ year: 2019, week: 1 });
    expect(dayOfYear({ year: 2026, month: 11, day: 1 })).toBe(305);
    expect(dayOfYear({ year: 2024, month: 12, day: 31 })).toBe(366);
  });
  it('splits localized live clock into rolling numerals and static separators', () => {
    const date = new Date(2026, 10, 1, 12, 34, 59);
    const text = localClockText(date, 'en-GB');
    expect(text).toBe('12:34:59');
    expect(clockGlyphs(text).filter(part => part.digit).map(part => part.char).join('')).toBe('123459');
    expect(clockGlyphs(text).filter(part => !part.digit)).toEqual([
      { char: ':', digit: false }, { char: ':', digit: false },
    ]);
    expect(clockGlyphs('١٢:٣٤:٥٩').filter(part => part.digit)).toHaveLength(6);
  });

  it('avoids the JavaScript Date year-1900 trap', () => {
    expect(isoDate(shiftDays({ year: 1, month: 1, day: 1 }, 1)!)).toBe('0001-01-02');
    expect(shiftDays({ year: 1, month: 1, day: 1 }, -1)).toBeNull();
    expect(shiftDays({ year: 9999, month: 12, day: 31 }, 1)).toBeNull();
  });
});

FILE	frontend/src/lib/calendar-model.ts
/** Pure Gregorian calendar model for the Svelte widget.
 * UTC arithmetic avoids DST skips and Date's 1900 offset for years 0–99.
 */
export interface CivilDate {
  year: number;
  month: number;
  day: number;
}
const DAY_MS = 86_400_000;

function utcDate(date: CivilDate): Date {
  const value = new Date(0);
  value.setUTCHours(12, 0, 0, 0);
  value.setUTCFullYear(date.year, date.month - 1, date.day);
  return value;
}
function civilDate(date: Date): CivilDate | null {
  const year = date.getUTCFullYear();
  if (year < 1 || year > 9999) return null;
  return { year, month: date.getUTCMonth() + 1, day: date.getUTCDate() };
}
export function todayCivilDate(date = new Date()): CivilDate {
  return { year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate() };
}
export function isoDate(date: CivilDate): string {
  return [String(date.year).padStart(4, '0'), String(date.month).padStart(2, '0'), String(date.day).padStart(2, '0')].join('-');
}

/** One semantic source for calendar-day states: selection, today's date
 * and the displayed month are independent. Dates are compared as civil
 * values, never by local timestamps (which shift across DST boundaries).
 */
export function calendarDayState(
  date: CivilDate, selected: CivilDate, today: CivilDate,
  visible: { year: number; month: number },
): { iso: string; selected: boolean; today: boolean; outside: boolean } {
  const iso = isoDate(date);
  return {
    iso,
    selected: iso === isoDate(selected),
    today: iso === isoDate(today),
    outside: date.year !== visible.year || date.month !== visible.month,
  };
}
export function daysInMonth(year: number, month: number): number {
  if (month < 1 || month > 12 || year < 1 || year > 9999) throw new RangeError('Invalid calendar month');
  if (month === 2) return year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0) ? 29 : 28;
  return [4, 6, 9, 11].includes(month) ? 30 : 31;
}
export function shiftDays(date: CivilDate, days: number): CivilDate | null {
  const moved = utcDate(date);
  moved.setUTCDate(moved.getUTCDate() + days);
  return civilDate(moved);
}
export function shiftMonth(date: CivilDate, months: number): CivilDate | null {
  const index = (date.year - 1) * 12 + date.month - 1 + months;
  if (!Number.isInteger(months) || index < 0 || index >= 9999 * 12) return null;
  const year = Math.floor(index / 12) + 1;
  const month = index % 12 + 1;
  return { year, month, day: Math.min(date.day, daysInMonth(year, month)) };
}
/** Monday-first, always six rows, with dates in adjacent months. */
export function monthGrid(year: number, month: number): (CivilDate | null)[][] {
  daysInMonth(year, month);
  const first = utcDate({ year, month, day: 1 });
  const start = -((first.getUTCDay() + 6) % 7);
  return Array.from({ length: 6 }, (_, week) =>
    Array.from({ length: 7 }, (_, day) => shiftDays({ year, month, day: 1 }, start + week * 7 + day)));
}
export function dayOfYear(date: CivilDate): number {
  return Math.round((utcDate(date).getTime() - utcDate({ year: date.year, month: 1, day: 1 }).getTime()) / DAY_MS) + 1;
}
export function isoWeek(date: CivilDate): { year: number; week: number } {
  const weekday = (utcDate(date).getUTCDay() + 6) % 7;
  const thursday = shiftDays(date, 3 - weekday);
  const isoYear = thursday?.year ?? date.year;
  const jan4 = utcDate({ year: isoYear, month: 1, day: 4 });
  jan4.setUTCDate(jan4.getUTCDate() - (jan4.getUTCDay() + 6) % 7);
  const monday = utcDate(date);
  monday.setUTCDate(monday.getUTCDate() - weekday);
  return { year: isoYear, week: Math.round((monday.getTime() - jan4.getTime()) / (7 * DAY_MS)) + 1 };
}
/** Date labels are localized; arithmetic stays independent of the user's zone. */
export function localDateLabel(date: CivilDate, locale?: string, options?: Intl.DateTimeFormatOptions): string {
  const value = new Date(0);
  value.setFullYear(date.year, date.month - 1, date.day);
  value.setHours(12, 0, 0, 0);
  return new Intl.DateTimeFormat(locale, options ?? { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(value);
}

/** A single localized, actual wall-clock value drives the calendar time and
 * its decorative GSAP digit rolls. Avoid separate clocks for the animation.
 */
export function localClockText(value: Date, locale?: string): string {
  return new Intl.DateTimeFormat(locale, {
    hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',
  }).format(value);
}

export function clockGlyphs(value: string): { char: string; digit: boolean }[] {
  return Array.from(value, char => ({
    char,
    digit: /\p{Decimal_Number}/u.test(char),
  }));
}

