    const unmount = vi.fn(async () => {});
    const onMounted = vi.fn();
    const load = vi.fn(async () => ({ mount, unmount, onMounted }));
    const errors = vi.fn();
    const widget = createLazyWidget(load, errors);
    await flush();
    expect(load).not.toHaveBeenCalled();

    widget.show(1);
    await flush();
    expect(load).toHaveBeenCalledTimes(1);
    expect(mount).toHaveBeenCalledTimes(1);
    expect(onMounted).toHaveBeenCalledWith(1);

    widget.hide();
    await flush();
    expect(unmount).toHaveBeenCalledTimes(1);
    expect(unmount).toHaveBeenCalledWith({ mounted: true });
    expect(errors).not.toHaveBeenCalled();

    widget.show(2);
    await flush();
    expect(mount).toHaveBeenCalledTimes(2);
    expect(onMounted).toHaveBeenCalledWith(2);
  });

  it('does not mount a component loaded after the window was hidden', async () => {
    const mount = vi.fn(() => ({}));
    const unmount = vi.fn();
    const onMounted = vi.fn();
    let finish!: (widget: { mount: typeof mount; unmount: typeof unmount; onMounted: typeof onMounted }) => void;
    const load = vi.fn(() => new Promise<{
      mount: typeof mount; unmount: typeof unmount; onMounted: typeof onMounted
    }>((resolve) => { finish = resolve; }));
    const widget = createLazyWidget(load, vi.fn());
    widget.show(7);
    widget.hide();
    finish({ mount, unmount, onMounted });
    await flush();
    expect(mount).not.toHaveBeenCalled();
    expect(onMounted).not.toHaveBeenCalled();
  });

  it('serializes unmount before the next mount during rapid toggles', async () => {
    const sequence: string[] = [];
    let completeUnmount!: () => void;
    const endUnmount = new Promise<void>((resolve) => { completeUnmount = resolve; });
    const widget = createLazyWidget(async () => ({
      mount() { sequence.push('mount'); return {}; },
      unmount() { sequence.push('unmount'); return endUnmount; },
      onMounted() { sequence.push('ready'); },
    }), vi.fn());

    widget.show(1);
    await flush();
    widget.hide();
    widget.show(2);
    await flush();
    expect(sequence).toEqual(['mount', 'ready', 'unmount']);
    completeUnmount();
    await flush();
    expect(sequence).toEqual(['mount', 'ready', 'unmount', 'mount', 'ready']);
  });

  it('ignores invalid generations without loading and reports loader failures', async () => {
    const load = vi.fn(async () => { throw new Error('test loader failure'); });
    const report = vi.fn();
    const widget = createLazyWidget(load, report);
    for (const invalid of [0, -1, 1.5, Number.NaN, 4294967296]) widget.show(invalid);
    await flush();
    expect(load).not.toHaveBeenCalled();
    widget.show(4);
    await flush();
    expect(report).toHaveBeenCalledTimes(1);
    expect(String(report.mock.calls[0][0])).toContain('test loader failure');
  });
});

FILE	frontend/src/lib/lazy-widget.ts
/**
 * A single WebKit page can host many widgets, but only the visible widget
 * should own DOM nodes, timers, subscriptions and Svelte reactive effects.
 * Serialize mount/unmount so quick hide/show never resurrects stale content.
 */
export interface LazyWidget<Instance> {
  mount(): Instance;
  unmount(instance: Instance): Promise<unknown> | void;
  onMounted(generation: number): void;
}

export function createLazyWidget<Instance>(
  load: () => Promise<LazyWidget<Instance>>,
  onError: (error: unknown) => void,
) {
  let desired: number | null = null;
  let active: { generation: number; instance: Instance; widget: LazyWidget<Instance> } | null = null;
  let draining = false;

  async function drain(): Promise<void> {
    if (draining) return;
    draining = true;
    try {
      while ((active?.generation ?? null) !== desired) {
        if (active) {
          const previous = active;
          active = null;
          // Svelte 5 unmount() cleans up onMount disposers, including
          // intervals and window listeners. Wait before mounting again.
          await previous.widget.unmount(previous.instance);
          continue;
        }
        if (desired === null) break;
        const generation = desired;
        const widget = await load();
        // A hidden or superseded widget is never mounted.
        if (desired !== generation) continue;
        const instance = widget.mount();
        active = { generation, instance, widget };
        widget.onMounted(generation);
      }
    } catch (error) {
      desired = null;
      onError(error);
    } finally {
      draining = false;
      if ((active?.generation ?? null) !== desired) void drain();
    }
  }

  function show(generation: number): void {
    if (!Number.isSafeInteger(generation) || generation <= 0 || generation > 0xffffffff) return;
    desired = generation;
    void drain();
  }

  function hide(): void {
    desired = null;
    void drain();
  }

  return { show, hide };
}

FILE	frontend/src/lib/motion.ts
/** GSAP is the project's sole JavaScript motion engine.
 * Actions are scoped to the short-lived Svelte widget DOM. They never animate
 * GTK/Wayland windows, and reduced-motion is a functional no-animation path.
 */
import { gsap } from 'gsap';

const reducedMotion = () => typeof window !== 'undefined' &&
  window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/** Deliberately short, staggered entry animation for a newly mounted tab. */
export function revealStagger(node: HTMLElement) {
  if (reducedMotion()) return;
  const targets = node.querySelectorAll<HTMLElement>('[data-kira-enter]');
  const animation = gsap.fromTo(targets,
    { autoAlpha: 0, y: 14, scale: 0.985 },
    {
      autoAlpha: 1, y: 0, scale: 1, duration: 0.55,
      stagger: 0.065, ease: 'power3.out',
      clearProps: 'opacity,visibility,transform',
    },
  );
  return {
    destroy() {
      animation.kill();
      gsap.set(targets, { clearProps: 'opacity,visibility,transform' });
    },
  };
}

/** Flash a new numeric reading once without competing with ECharts updates. */
export function pulseReading(node: HTMLElement, initial: string) {
  let previous = initial;
  return {
    update(next: string) {
      if (next === previous) return;
      previous = next;
      if (reducedMotion()) return;
      gsap.killTweensOf(node);
      gsap.fromTo(node,
        { color: '#fca311' },
        { color: '#ffffff', duration: 0.6, ease: 'power2.out', clearProps: 'color' },
      );
    },
    destroy() {
      gsap.killTweensOf(node);
      gsap.set(node, { clearProps: 'color' });
    },
  };
}

/**
 * Calendar-only GSAP interaction: horizontal month/year reveal followed by a
 * restrained selection pop. Svelte owns actual dates and focus; GSAP changes
 * presentation only. No timers, fake dates, or transitional DOM copies.
 */
export function calendarGridMotion(
  node: HTMLElement,
  initial: { month: number; selected: string },
) {
  let lastMonth = initial.month;
  let lastSelected = initial.selected;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = () => node.querySelectorAll<HTMLElement>('[data-calendar-day]');
  const clear = () => {
    const days = buttons();
    gsap.killTweensOf(days);
    gsap.set(days, { clearProps: 'opacity,visibility,transform' });
  };
  const onMotionChange = () => {
    if (motion.matches) clear();
  };
  motion.addEventListener('change', onMotionChange);
  return {
    update(next: { month: number; selected: string }) {
      const monthChanged = next.month !== lastMonth;
      const selectedChanged = next.selected !== lastSelected;
      const direction = Math.sign(next.month - lastMonth);
      lastMonth = next.month;
      lastSelected = next.selected;
      if ((!monthChanged && !selectedChanged) || motion.matches) {
        if (motion.matches) clear();
        return;
      }
      if (monthChanged) {
        const days = buttons();
        gsap.killTweensOf(days);
        gsap.fromTo(days,
          { autoAlpha: 0, x: direction * 9 },
          {
            autoAlpha: 1, x: 0, duration: 0.3, stagger: 0.004,
            ease: 'power2.out', overwrite: true,
            clearProps: 'opacity,visibility,transform',
          },
        );
      } else {
        const selected = node.querySelector<HTMLElement>('[data-calendar-selected="true"]');
        if (!selected) return;
        gsap.killTweensOf(selected);
        gsap.fromTo(selected,
          { scale: 0.89, transformOrigin: 'center center' },
          {
            scale: 1, duration: 0.32, ease: 'back.out(2)',
            overwrite: true, clearProps: 'transform,transformOrigin',
          },
        );
      }
    },
    destroy() {
      motion.removeEventListener('change', onMotionChange);
      clear();
    },
  };
}

/** Odometer-style clock glyph with short, interruptible GSAP transitions.
 * The actual character, ARIA label and datetime remain Svelte-owned. This
 * action decorates only changed numerals, never replays unchanged digits.
 */
export function rollingClockDigit(node: HTMLElement, initial: string) {
  let previous = initial;
  let animation: gsap.core.Timeline | null = null;
  let ghost: HTMLSpanElement | null = null;
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const stop = () => {
    animation?.kill();
    animation = null;
    ghost?.remove();
    ghost = null;
    gsap.set(node, { clearProps: 'opacity,transform,filter,color' });
  };
  const onMotionChange = () => { if (motion.matches) stop(); };
  motion.addEventListener('change', onMotionChange);

  return {
    update(next: string) {
      if (next === previous) return;
      const outgoing = previous;
      previous = next;
      stop();
      if (motion.matches) return;

      const parent = node.parentElement;
      if (!parent) return;
      ghost = node.ownerDocument.createElement('span');
      ghost.textContent = outgoing;
      ghost.setAttribute('aria-hidden', 'true');
      ghost.className = 'pointer-events-none absolute inset-0 flex items-center justify-center text-kira-muted';
      parent.appendChild(ghost);

      const currentGhost = ghost;
      animation = gsap.timeline({
        defaults: { duration: 0.42, ease: 'power3.out' },
        onComplete: () => {
          currentGhost.remove();
          if (ghost === currentGhost) ghost = null;
          animation = null;
          gsap.set(node, { clearProps: 'opacity,transform,filter,color' });
        },
      });
      animation.fromTo(node,
        { yPercent: 85, autoAlpha: 0, filter: 'blur(2px)', color: '#fca311' },
        { yPercent: 0, autoAlpha: 1, filter: 'blur(0px)', color: 'inherit' },
        0);
      animation.to(currentGhost, {
        yPercent: -85, autoAlpha: 0, duration: 0.35, ease: 'power2.inOut',
      }, 0);
    },
    destroy() {
      motion.removeEventListener('change', onMotionChange);
      stop();
    },
  };
}

FILE	frontend/src/lib/overlay-size.ts
import { notifyOverlayHeight } from './sdk/core';

/**
 * Svelte's intrinsic root height, not the WebKit viewport, drives the GTK
 * layer-shell surface. The CSS max-height is a native monitor-sized pixel
 * cap, so resizing the viewport cannot make the measurement oscillate.
 */
export function observeOverlaySize(root: HTMLElement, generation: number): () => void {
  let lastHeight = 0;
  let stopped = false;
  const measure = () => {
    if (stopped || !root.isConnected) return;
    const height = Math.ceil(root.getBoundingClientRect().height);
    if (!Number.isSafeInteger(height) || height <= 0 || height > 20000 || height === lastHeight) return;
    lastHeight = height;
    notifyOverlayHeight(generation, height);
  };

  // The first size report is synchronous and precedes mounted:<generation>,
  // allowing GTK to set window geometry before the double-rAF reveal.
  measure();
  const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure);
  observer?.observe(root);

  return () => {
    stopped = true;
    observer?.disconnect();
  };
}

