import { describe, expect, it } from 'vitest';
import { dualTime, temporalProgress, tenetFragmentsFor } from './calendar-tenet-model';
import { nextClockFlights } from './clock-flight';

describe('TENET Calendar temporal contract', () => {
  it('advances simultaneous forward and inverted flows from a single cursor', () => {
    expect(dualTime(0)).toEqual({ forward: 0, inverted: 1 });
    expect(dualTime(0.25)).toEqual({ forward: 0.25, inverted: 0.75 });
    expect(dualTime(0.5)).toEqual({ forward: 0.5, inverted: 0.5 });
    expect(dualTime(1)).toEqual({ forward: 1, inverted: 0 });
    expect(temporalProgress(-5, -1)).toBe(1);
    expect(temporalProgress(5, 1)).toBe(1);
    expect(temporalProgress(Number.NaN, 1)).toBe(0);
  });

  it('inverts one remembered flight without recalculating coordinates', () => {
    const outward = tenetFragmentsFor(1);
    const inbound = [...outward].reverse().reverse();
    expect(inbound).toEqual(outward);
    for (const flight of outward) {
      // The very same recorded flight becomes a return when time is reversed.
      const center = { x: 0, y: 0 };
      const position = (progress: number) => ({
        x: center.x + progress * flight.x,
        y: center.y + progress * flight.y,
        rotation: progress * flight.rotation,
      });
      for (const t of [0, 0.1, 0.5, 0.9, 1]) {
        expect(position(dualTime(t).inverted))
          .toEqual(position(dualTime(1 - t).forward));
      }
      // IEEE-754 -0 is physically identical to +0; compare magnitudes.
      expect(Math.abs(position(0).x)).toBe(0);
      expect(Math.abs(position(0).y)).toBe(0);
      expect(Math.abs(position(0).rotation)).toBe(0);
    }
  });

  it('changes outbound history when month direction changes, not the contact point', () => {
    const forward = tenetFragmentsFor(1);
    const backward = tenetFragmentsFor(-1);
    expect(forward).toHaveLength(4);
    expect(backward).toHaveLength(4);
    for (let i = 0; i < forward.length; i++) {
      expect(backward[i].x).toBe(-forward[i].x);
      expect(backward[i].y).toBe(forward[i].y);
      expect(backward[i].rotation).toBe(forward[i].rotation);
    }
  });

  it('randomizes only between clock events, never while reversing a single one', () => {
    const first = nextClockFlights(6, [], () => 0.2);
    // Saved outbound positions are reused as-is on the return.
    const memory = [...first];
    expect(memory).toEqual(first);
    const second = nextClockFlights(6, first, () => 0.2);
    expect(second.every((flight, i) => flight.sector !== first[i].sector)).toBe(true);
    expect(first).toEqual(memory);
  });
});

FILE	frontend/src/lib/calendar-tenet-model.ts
/** Pure, inspectable time laws for Calendar's GSAP TENET scenes.
 * One event records its outbound path once; inverted playback runs the same
 * keyframes in the opposite chronology. Not a mirrored x-axis.
 */
export type FlowDirection = 1 | -1;
export interface FragmentFlight { x: number; y: number; rotation: number; }

export function temporalProgress(progress: number, direction: FlowDirection): number {
  const u = Number.isFinite(progress) ? Math.max(0, Math.min(1, progress)) : 0;
  return direction === 1 ? u : 1 - u;
}

/** Coordinates relative to the same contact point; saved for the event.
 * Changing month direction changes the outbound history, not the return.
 */
export function tenetFragmentsFor(direction: number): FragmentFlight[] {
  const sign = direction < 0 ? -1 : 1;
  return [
    { x: -39 * sign, y: -18, rotation: -65 },
    { x: 31 * sign, y: 29, rotation: 42 },
    { x: -14 * sign, y: 40, rotation: 80 },
    { x: 37 * sign, y: -32, rotation: -35 },
  ];
}

/** Same master cursor for both streams. Each uses its own chronology. */
export function dualTime(progress: number): { forward: number; inverted: number } {
  return { forward: temporalProgress(progress, 1), inverted: temporalProgress(progress, -1) };
}

FILE	frontend/src/lib/calendar-tenet-motion.ts
/** TENET Motion System for the Calendar.
 *
 * A single interaction owns a remembered scene. FORWARD elements settle
 * normally while INVERTED fragments replay one pre-recorded outward flight
 * backward towards the SAME contact point. All scenes are cancellable and
 * leave no transforms, fragments, timers or RAF loops behind.
 */
import { gsap } from 'gsap';
import { tenetWidgetReveal } from './motion';
import { nextClockFlights, type ClockFlight } from './clock-flight';
import { dualTime, tenetFragmentsFor, type FragmentFlight } from './calendar-tenet-model';

type Scene = { forward: gsap.core.Timeline; inverted: gsap.core.Timeline; fragments: HTMLElement[] };
const ACCENT = '#fca311';
const MUTED = '#e5e5e5';

function reduced(motion: MediaQueryList): boolean { return motion.matches; }

function createFragments(root: HTMLElement, contact: HTMLElement, positions: readonly FragmentFlight[]): HTMLElement[] {
  const base = root.getBoundingClientRect();
  const target = contact.getBoundingClientRect();
  const x = target.left - base.left + target.width / 2;
  const y = target.top - base.top + target.height / 2;
  return positions.map((_, i) => {
    const fragment = root.ownerDocument.createElement('span');
    fragment.dataset.tenetFragment = 'inverted';
    fragment.setAttribute('aria-hidden', 'true');
    fragment.style.cssText = [
      'position:absolute', 'pointer-events:none', 'z-index:1', 'width:4px', 'height:4px',
      `left:${x}px`, `top:${y}px`, `background:${i % 2 ? MUTED : ACCENT}`,
      'opacity:0', 'transform-origin:center center',
    ].join(';');
    root.appendChild(fragment);
    return fragment;
  });
}

/** Scene master timeline advances forward content and reverses the exact
 * same recorded fragment keyframes. Both streams meet at the contact point.
 */
function dualScene(
  root: HTMLElement,
  contact: HTMLElement,
  targets: readonly HTMLElement[],
  direction: number,
  cleanup: () => void,
): Scene {
  const positions = tenetFragmentsFor(direction);
  const fragments = createFragments(root, contact, positions);
  gsap.set(fragments, { x: 0, y: 0, rotation: 0, scale: 0, opacity: 0 });
  const inverted = gsap.timeline({ paused: true });
  inverted.to(fragments, {
    x: (i: number) => positions[i].x,
    y: (i: number) => positions[i].y,
    rotation: (i: number) => positions[i].rotation,
    scale: 1,
    opacity: 0.85,
    duration: 0.52,
    stagger: 0.025,
    ease: 'power3.out',
  }, 0);
  inverted.progress(1); // Future trace exists first; then returns to contact.
  const forward = gsap.timeline({
    paused: true,
    onUpdate: () => { inverted.progress(dualTime(forward.progress()).inverted); },
    onComplete: cleanup,
  });
  // Month content arrives as ONE compositor surface, not 35 individual
  // day cells racing the real WebKit frame budget. For same-month selection,
  // the persistent highlight owns the forward geometry and this master
  // only provides the inverse contact chronology.
  forward.to({}, { duration: 0.44 }, 0);
  if (targets.length) {
    forward.fromTo(targets,
      { x: 8 * direction, y: 2, scale: 0.991, opacity: 0.94 },
      { x: 0, y: 0, scale: 1, duration: 0.44, ease: 'back.out(1.18)' }, 0);
    forward.to(targets, { opacity: 1, duration: 0.20, ease: 'power2.out' }, 0);
  }
  forward.play(0);
  return { forward, inverted, fragments };
}

/** Shared entry scene anchored at the clock. Independent digit and day
 * interactions retain their recorded trajectories and timeline direction.
 */
export function tenetCalendarReveal(node: HTMLElement) {
  return tenetWidgetReveal(node, {
    contact: '[data-calendar-clock-play]', direction: 1,
  });
}

/** Calendar navigation: day/date text moves FORWARD; four fragments move
 * INVERTED back into the newly selected day. The real date has already
 * changed in Svelte; motion never delays selection, focus or keyboard input.
 */
export function tenetCalendarGrid(
  node: HTMLElement,
  initial: { month: number; selected: string },
) {
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let lastMonth = initial.month;
  let lastSelected = initial.selected;
  let scene: Scene | null = null;
  let restoreTimer: number | null = null;
  let activeTargets: HTMLElement[] = [];

  function stop() {
    if (restoreTimer !== null) {
      window.clearTimeout(restoreTimer);
      restoreTimer = null;
    }
    const old = scene;
    scene = null;
    old?.forward.kill();
    old?.inverted.kill();
    old?.fragments.forEach(fragment => fragment.remove());
    gsap.killTweensOf(activeTargets);
    gsap.set(activeTargets, { clearProps: 'opacity,visibility,transform' });
    activeTargets = [];
  }
  const onMotionChange = () => { if (reduced(motion)) stop(); };
  motion.addEventListener('change', onMotionChange);

  return {
    update(next: { month: number; selected: string }) {
      const changedMonth = next.month !== lastMonth;
      const changedSelection = next.selected !== lastSelected;
      const direction = next.month < lastMonth ? -1 : 1;
      lastMonth = next.month;
      lastSelected = next.selected;
      if (!changedMonth && !changedSelection) return;

      stop();
      if (reduced(motion)) return;
      const selected = node.querySelector<HTMLElement>('[data-calendar-selected="true"]');
      if (!selected) return;
      activeTargets = changedMonth ? [node] : [];
      node.dataset.tenetScenes = String(Number(node.dataset.tenetScenes || '0') + 1);
      node.dataset.tenetContact = next.selected;
      scene = dualScene(node, selected, activeTargets, direction, stop);
      restoreTimer = window.setTimeout(stop, 950);
    },
    destroy() {
      motion.removeEventListener('change', onMotionChange);
      stop();
    },
  };
}

/** Each second: the stale numeral moves forward out of the cell while
 * the real current numeral replays a remembered outbound path INVERTED
 * into the SAME cell. The real datetime and accessible clock never pause.
 */
export function tenetClockDigit(node: HTMLElement, initial: string) {
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let previous = initial;
  let forward: gsap.core.Timeline | null = null;
  let inverted: gsap.core.Timeline | null = null;
  let ghost: HTMLSpanElement | null = null;
  let restoreTimer: number | null = null;

  function stop() {
    if (restoreTimer !== null) {
      window.clearTimeout(restoreTimer);
      restoreTimer = null;
    }
    forward?.kill();
    inverted?.kill();
    forward = null;
    inverted = null;
    ghost?.remove();
    ghost = null;
    gsap.killTweensOf(node);
    gsap.set(node, { clearProps: 'opacity,visibility,transform,color' });
  }
  const onMotionChange = () => { if (reduced(motion)) stop(); };
  motion.addEventListener('change', onMotionChange);
  return {
    update(next: string) {
      if (next === previous) return;
      const outgoing = previous;
      previous = next;
      stop();
      if (reduced(motion) || !node.parentElement) return;
      const relic = node.ownerDocument.createElement('span');
      relic.textContent = outgoing;
      relic.setAttribute('aria-hidden', 'true');
      relic.className = 'pointer-events-none absolute inset-0 flex items-center justify-center text-kira-muted';
      node.parentElement.appendChild(relic);
      ghost = relic;

      inverted = gsap.timeline({ paused: true });
      inverted.to(node, { yPercent: 85, autoAlpha: 0, duration: 0.4, ease: 'power3.out' }, 0);
      inverted.progress(1); // New numeral is known; reverse its future exit.
      forward = gsap.timeline({
        paused: true,
        onUpdate: () => { inverted?.progress(dualTime(forward?.progress() ?? 1).inverted); },
        onComplete: stop,
      });
      forward.fromTo(relic,
        { yPercent: 0, autoAlpha: 1 },
        { yPercent: -85, autoAlpha: 0, duration: 0.4, ease: 'power3.out' }, 0);
      forward.play(0);
      // When WebKit throttles animation frames, do not leave a numeral
      // invisible until the next real second tick.
      restoreTimer = window.setTimeout(stop, 750);
    },
    destroy() {
      motion.removeEventListener('change', onMotionChange);
      stop();
    },
  };
}

/** Clock easter egg: every click chooses a fresh set of six paths, but
 * each single event uses ONE GSAP timeline played FORWARD and then
 * REVERSED. This reverses the exact easing, stagger, rotation and opacity,
 * unlike separate "fly away" and "spring back" tweens.
 */
export function tenetClockJuggle(node: HTMLButtonElement) {
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let animation: gsap.core.Timeline | null = null;
  let restoreTimer: number | null = null;
  let previousFlights: ClockFlight[] = [];
  const cells = () => Array.from(node.querySelectorAll<HTMLElement>('[data-clock-cell]'));

  function reset() {
    if (restoreTimer !== null) {
      window.clearTimeout(restoreTimer);
      restoreTimer = null;
    }
    const current = animation;
    animation = null;
    current?.kill();
    const targets = cells();
    gsap.killTweensOf(targets);
    gsap.set(targets, { clearProps: 'transform,opacity,visibility' });
    node.dataset.tenetPlayback = 'settled';
  }

  function play() {
    reset();
    if (reduced(motion)) return;
    const targets = cells();
    if (!targets.length) return;
    const flights = nextClockFlights(targets.length, previousFlights);
    previousFlights = flights; // Next event differs; reverse never rerolls.
    let returning = false;
    node.dataset.tenetEvents = String(Number(node.dataset.tenetEvents || '0') + 1);
    node.dataset.tenetPlayback = 'forward';
    animation = gsap.timeline({
      paused: true,
      onComplete: () => {
        if (!returning) {
          returning = true;
          node.dataset.tenetPlayback = 'inverted';
          animation?.reverse(); // Same recorded physical history backwards.
        }
      },
      onReverseComplete: reset,
    });
    animation.to(targets, {
      x: (i: number) => flights[i].x,
      y: (i: number) => flights[i].y,
      rotation: (i: number) => flights[i].rotation,
      scale: (i: number) => flights[i].scale,
      opacity: (i: number) => flights[i].opacity,
      duration: 0.38,
      stagger: 0.026,
      ease: 'power3.out',
    }, 0);
    animation.play(0);
    // Guard against throttled frames in WebKitGTK. Never strand digits.
    restoreTimer = window.setTimeout(reset, 1450);
  }

  const onMotionChange = () => { if (reduced(motion)) reset(); };
  node.addEventListener('click', play);
  motion.addEventListener('change', onMotionChange);
  return {
    destroy() {
      node.removeEventListener('click', play);
      motion.removeEventListener('change', onMotionChange);
      reset();
    },
  };
}

FILE	frontend/src/lib/clock-flight.test.ts
import { describe, expect, it } from 'vitest';
import { nextClockFlights } from './clock-flight';

describe('Calendar GSAP clock chaos flight plans', () => {
  it('sends six numerals into six distinct directions on every click', () => {
    const plan = nextClockFlights(6, [], () => 0.4);
    expect(plan).toHaveLength(6);
    expect(new Set(plan.map(digit => digit.sector)).size).toBe(6);
    for (const digit of plan) {
      expect(digit.sector).toBeGreaterThanOrEqual(0);
      expect(digit.sector).toBeLessThan(8);
      expect(Math.hypot(digit.x, digit.y)).toBeGreaterThanOrEqual(24);
      expect(Math.hypot(digit.x, digit.y)).toBeLessThan(47);
      expect(Math.abs(digit.rotation)).toBeGreaterThanOrEqual(32);
      expect(digit.scale).toBeGreaterThanOrEqual(0.64);
      expect(digit.opacity).toBeGreaterThanOrEqual(0.48);
    }
  });

  it('never sends the same numeral into its previous direction', () => {
    // Even pathological RNG returning identical values on every draw must
    // produce a different sector for each digit on consecutive clicks.
    let previous = nextClockFlights(6, [], () => 0);
    for (let click = 0; click < 30; click++) {
      const next = nextClockFlights(6, previous, () => 0);
      expect(new Set(next.map(digit => digit.sector)).size).toBe(6);
      expect(next.every((digit, i) => digit.sector !== previous[i].sector)).toBe(true);
      previous = next;
    }
  });

  it('changes angle, distance and spin when the random seed changes', () => {
    const previous = nextClockFlights(6, [], () => 0.2);
    const left = nextClockFlights(6, previous, () => 0.1);
    const right = nextClockFlights(6, previous, () => 0.9);
    expect(left.map(({ x, y, rotation }) => [x, y, rotation]))
      .not.toEqual(right.map(({ x, y, rotation }) => [x, y, rotation]));
    expect(left.every((digit, i) => digit.sector !== previous[i].sector)).toBe(true);
    expect(right.every((digit, i) => digit.sector !== previous[i].sector)).toBe(true);
  });

  it('handles empty glyph lists and repeated clicks with more than eight glyphs', () => {
    expect(nextClockFlights(0)).toEqual([]);
    expect(nextClockFlights(-2)).toEqual([]);
    const old = nextClockFlights(10, [], () => 0.5);
    const next = nextClockFlights(10, old, () => 0.5);
    expect(next).toHaveLength(10);
    expect(next.every((digit, i) => digit.sector !== old[i].sector)).toBe(true);
  });
});

FILE	frontend/src/lib/clock-flight.ts
/** A random but non-repeating flight plan for the calendar clock easter egg.
 *
 * Every click uses a new randomized direction for every numeral. Adjacent
 * numerals also choose different 45-degree sectors to avoid synchronized
 * movement. An individual numeral is explicitly forbidden from revisiting
 * its sector from the previous click, even when random() returns the same
 * sequence twice. No DOM, timers or GSAP dependencies: easy to regression-test.
 */
export interface ClockFlight {
  sector: number;
  x: number;
  y: number;
  rotation: number;
  scale: number;
  opacity: number;
}

const SECTORS = 8;
const directions = Array.from({ length: SECTORS }, (_, index) => index);

export function nextClockFlights(
  count: number,
  previous: readonly ClockFlight[] = [],
  random: () => number = Math.random,
): ClockFlight[] {
  const used = new Set<number>();
  const unit = () => Math.max(0, Math.min(0.9999999999999999, random()));
  return Array.from({ length: Math.max(0, Math.min(32, Math.floor(count))) }, (_, index) => {
    const oldSector = previous[index]?.sector;
    // Try to keep every digit in a distinct direction AND never repeat its
    // previous direction. More than eight digits can reuse sectors safely.
    const distinct = directions.filter(sector => !used.has(sector) && sector !== oldSector);
    const options = distinct.length ? distinct : directions.filter(sector => sector !== oldSector);
    const sector = options[Math.floor(unit() * options.length)];
    used.add(sector);

    // Randomize angle inside the selected sector and distance independently.
    const angle = (sector + 0.16 + unit() * 0.68) * Math.PI / 4;
    const distance = 24 + unit() * 23;
    const spin = (unit() < 0.5 ? -1 : 1) * (32 + unit() * 73);
    return {
      sector,
      x: Math.cos(angle) * distance,
      y: Math.sin(angle) * distance,
      rotation: spin,
      scale: 0.64 + unit() * 0.2,
      opacity: 0.48 + unit() * 0.29,
    };
  });
}

