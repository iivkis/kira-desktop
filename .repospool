FILE	crates/kira-shell/src/main.rs
//! GTK4/WebKitGTK host and bounded JSON-RPC bridge to the Core daemon.

mod ui_assets;
use std::env;
use std::path::{Path, PathBuf};
use std::sync::mpsc;
use std::time::Duration;

use gtk::prelude::*;
use gtk4_layer_shell::{Edge, Layer, LayerShell};
use kira_ipc::{PROTOCOL_VERSION, RpcRequest, RpcResponse};
use webkit6::prelude::*;

const BAR_HEIGHT: i32 = 42;
const MAX_BRIDGE_MESSAGE_BYTES: usize = 4096;

fn ui_index() -> PathBuf {
    let directory = env::var_os("KIRA_UI_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../frontend/dist"));
    directory.join("index.html")
}

// Navigation is limited to the exact packaged UI document. Prefix matching
// would allow unrelated file:// paths (or attacker-controlled remote pages).
fn permitted_ui_page(requested_uri: &str, index_uri: &str) -> bool {
    requested_uri == index_uri
}

fn core_socket() -> Option<PathBuf> {
    kira_ipc::core_socket_path().ok()
}

/// Only expose explicit, read-only Core operations to the Svelte page.
fn process_message(message: &str, socket: Option<&Path>) -> RpcResponse {
    let request = match serde_json::from_str::<RpcRequest>(message) {
        Ok(value) => value,
        Err(_) => return RpcResponse::failure(None, -32700, "Invalid JSON-RPC message"),
    };
    if request.jsonrpc != PROTOCOL_VERSION {
        return RpcResponse::failure(Some(request.id), -32600, "Invalid JSON-RPC version");
    }
    if !matches!(request.method.as_str(), "ping" | "get_state") {
        return RpcResponse::failure(Some(request.id), -32601, "Method not allowed");
    }
    match socket {
        Some(path) => kira_ipc::client::call(path, &request).unwrap_or_else(|_| {
            RpcResponse::failure(Some(request.id), -32000, "Kira Core unavailable")
        }),
        None => RpcResponse::failure(Some(request.id), -32000, "XDG_RUNTIME_DIR is not set"),
    }
}

fn main() {
    let index = ui_index();
    if !index.is_file() {
        eprintln!(
            "Kira UI assets not found: {}. Run 'task frontend:build' first or set KIRA_UI_DIR.",
            index.display()
        );
        std::process::exit(1);
    }

    // The build embeds CSS and JS in index.html. Load it directly as an
    // about:blank document so WebKit never needs to execute scripts from a
    // custom URI origin. Keep the previous scheme for opt-in diagnostics.
    let html = std::fs::read_to_string(&index).unwrap_or_else(|error| {
        eprintln!(
            "kira-shell: failed to read UI HTML {}: {error}",
            index.display()
        );
        std::process::exit(1);
    });
    let use_legacy_scheme = env::var_os("KIRA_WEBKIT_LEGACY_SCHEME").is_some();

    // A nested preview must not activate another GTK application with the same ID
    // already running in the user's primary desktop session.
    let flags = if env::var_os("KIRA_PREVIEW").is_some() {
        gtk::gio::ApplicationFlags::NON_UNIQUE
    } else {
        gtk::gio::ApplicationFlags::empty()
    };
    let app = gtk::Application::builder()
        .application_id("dev.kira.Desktop")
        .flags(flags)
        .build();
    app.connect_activate(move |app| {
        let window = gtk::ApplicationWindow::new(app);
        window.set_title(Some("Kira Desktop"));
        window.set_decorated(false);
        window.set_default_size(800, BAR_HEIGHT);

        window.init_layer_shell();
        window.set_namespace(Some("kira-desktop"));
        window.set_layer(Layer::Top);
        window.set_anchor(Edge::Top, true);
        window.set_anchor(Edge::Left, true);
        window.set_anchor(Edge::Right, true);
        window.set_exclusive_zone(BAR_HEIGHT);

        // Vite's production JS is an ES module. The file:// scheme blocks
        // module requests in WebKitGTK; serve packaged files as a private
        // CORS-enabled scheme instead of granting file:// broad access.
        let context = webkit6::WebContext::new();
        if let Some(security) = context.security_manager() {
            security.register_uri_scheme_as_local("kira-ui");
            security.register_uri_scheme_as_secure("kira-ui");
            security.register_uri_scheme_as_cors_enabled("kira-ui");
            security.register_uri_scheme_as_display_isolated("kira-ui");
        }

        let ui_root = index.parent().expect("UI index must have a parent").to_path_buf();
        context.register_uri_scheme("kira-ui", move |request| {
            let Some(uri) = request.uri() else {
                let mut error = gtk::glib::Error::new(
                    gtk::gio::IOErrorEnum::InvalidArgument,
                    "Missing Kira UI asset URI",
                );
                request.finish_error(&mut error);
                return;
            };
            match ui_assets::read_asset(uri.as_str(), &ui_root) {
                Ok((content, mime)) => {
                    let length = content.len() as i64;
                    let bytes = gtk::glib::Bytes::from_owned(content);
                    let stream = gtk::gio::MemoryInputStream::from_bytes(&bytes);
                    request.finish(&stream, length, Some(mime));
                }
                Err(error) => {
                    eprintln!("kira-shell: UI asset denied: {uri}: {error}");
                    let mut webkit_error = gtk::glib::Error::new(
                        gtk::gio::IOErrorEnum::NotFound,
                        "Kira UI asset not found",
                    );
                    request.finish_error(&mut webkit_error);
                }
            }
        });

        let manager = webkit6::UserContentManager::new();
        let view = webkit6::WebView::builder()
            .web_context(&context)
            .user_content_manager(&manager)
            .build();
        view.set_background_color(&gtk::gdk::RGBA::new(0.09, 0.09, 0.12, 1.0));

        // GTK and WebKit are not Send: socket IO runs on workers, UI updates
        // return to the GTK main loop through this channel.
        let (sender, receiver) = mpsc::channel::<String>();
        let socket = core_socket();
        manager.connect_script_message_received(Some("kira"), move |_, value| {
            let message = value.to_string().to_string();
            let id = serde_json::from_str::<RpcRequest>(&message).ok().map(|r| r.id);
            let sender = sender.clone();
            let socket = socket.clone();
            std::thread::spawn(move || {
                let response = if message.len() > MAX_BRIDGE_MESSAGE_BYTES {
                    RpcResponse::failure(id, -32600, "Bridge message too large")
                } else {
                    process_message(&message, socket.as_deref())
                };
                if let Ok(serialized) = serde_json::to_string(&response) {
                    let _ = sender.send(serialized);
                }
            });
        });
        assert!(manager.register_script_message_handler("kira", None));
        manager.connect_script_message_received(Some("kiraDiagnostics"), |_, value| {
            eprintln!("kira-shell [ui]: {}", value.to_string());
        });
        assert!(manager.register_script_message_handler("kiraDiagnostics", None));

        view.connect_load_failed(|_, event, uri, error| {
            eprintln!("kira-shell: WebKit load failed ({event:?}) for {uri}: {error}");
            false
        });
        view.connect_web_process_terminated(|_, reason| {
            eprintln!("kira-shell: WebKit renderer terminated: {reason:?}");
        });
        view.connect_load_changed(|webview, event| {
            if event == webkit6::LoadEvent::Finished {
                let webview = webview.clone();
                gtk::glib::timeout_add_local_once(Duration::from_millis(1500), move || {
                    webview.evaluate_javascript(
                        "if (!document.querySelector('main.bar')) { throw new Error('Svelte UI did not mount; ' + 'boot=' + JSON.stringify(window.__kiraBoot || {}) + '; readyState=' + document.readyState + '; scripts=' + document.scripts.length); }",
                        None,
                        None,
                        None::<&gtk::gio::Cancellable>,
                        |result| {
                            if let Err(error) = result {
                                eprintln!("kira-shell: UI rendering check failed: {error}");
                            } else {
                                eprintln!("kira-shell: Svelte panel DOM verified");
                            }
                        },
                    );
                });
            }
        });

        let webview = view.clone();
        gtk::glib::timeout_add_local(Duration::from_millis(30), move || {
            while let Ok(response) = receiver.try_recv() {
                // Double encoding ensures response content cannot become JS source.
                if let Ok(encoded) = serde_json::to_string(&response) {
                    let script = format!(
                        "window.dispatchEvent(new CustomEvent('kira:rpc', {{ detail: JSON.parse({encoded}) }}));"
                    );
                    webview.evaluate_javascript(
                        &script,
                        None,
                        None,
                        None::<&gtk::gio::Cancellable>,
                        |result| {
                            if let Err(error) = result {
                                eprintln!("Kira bridge delivery error: {error}");
                            }
                        },
                    );
                }
            }
            gtk::glib::ControlFlow::Continue
        });

        let allowed_uri = if use_legacy_scheme {
            ui_assets::UI_DOCUMENT_URI.to_string()
        } else {
            "about:blank".to_string()
        };
        view.connect_decide_policy(move |_, decision, kind| {
            if kind == webkit6::PolicyDecisionType::NewWindowAction {
                decision.ignore();
                return true;
            }
            if kind == webkit6::PolicyDecisionType::NavigationAction {
                let permitted = decision
                    .downcast_ref::<webkit6::NavigationPolicyDecision>()
                    .and_then(|navigation| navigation.navigation_action())
                    .and_then(|action| action.request())
                    .and_then(|request| request.uri())
                    .is_some_and(|uri| permitted_ui_page(uri.as_str(), &allowed_uri));
                if !permitted {
                    decision.ignore();
                    return true;
                }
            }
            false
        });
        if use_legacy_scheme {
            eprintln!("kira-shell: diagnostic legacy scheme {}", ui_assets::UI_DOCUMENT_URI);
            view.load_uri(ui_assets::UI_DOCUMENT_URI);
        } else {
            eprintln!("kira-shell: loading self-contained HTML using WebKit load_html()");
            view.load_html(&html, None);
        }
        window.set_child(Some(&view));
        window.present();
    });
    app.run();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn rejects_unsupported_method_without_core_connection() {
        let result = process_message(r#"{"jsonrpc":"2.0","id":9,"method":"execute_shell"}"#, None);
        assert_eq!(result.error.unwrap().code, -32601);
    }

    #[test]
    fn navigation_is_restricted_to_exact_ui_document() {
        for local in [ui_assets::UI_DOCUMENT_URI, "about:blank"] {
            assert!(permitted_ui_page(local, local));
            assert!(!permitted_ui_page("https://evil.example/", local));
            assert!(!permitted_ui_page("kira-ui://app/index.html.evil", local));
            assert!(!permitted_ui_page("file:///etc/passwd", local));
        }
    }

    #[test]
    fn reports_missing_core() {
        let result = process_message(r#"{"jsonrpc":"2.0","id":3,"method":"ping"}"#, None);
        assert_eq!(result.error.unwrap().code, -32000);
    }
}

FILE	crates/kira-shell/src/ui_assets.rs
//! Expose only packaged UI assets through WebKit's private kira-ui scheme.
//! ES modules do not reliably run when index.html is opened via file://.

use std::io;
use std::path::{Component, Path, PathBuf};

const MAX_ASSET_BYTES: u64 = 8 * 1024 * 1024;
pub const UI_DOCUMENT_URI: &str = "kira-ui://app/index.html";

fn invalid_asset() -> io::Error {
    io::Error::new(
        io::ErrorKind::PermissionDenied,
        "Invalid Kira UI asset path",
    )
}

fn asset_path(uri: &str, root: &Path) -> io::Result<(PathBuf, &'static str)> {
    let relative = uri
        .strip_prefix("kira-ui://app/")
        .ok_or_else(invalid_asset)?;
    // Do not accept percent-encoded path components, queries or fragments.
    // The bundled Vite output uses simple ASCII filenames under assets/.
    if relative.is_empty()
        || relative.split('/').any(|part| {
            part.is_empty()
                || part == "."
                || part == ".."
                || !part
                    .bytes()
                    .all(|b| b.is_ascii_alphanumeric() || b == b'.' || b == b'_' || b == b'-')
        })
    {
        return Err(invalid_asset());
    }

    let relative_path = Path::new(relative);
    if !relative_path
        .components()
        .all(|part| matches!(part, Component::Normal(_)))
    {
        return Err(invalid_asset());
    }

    let mime = match relative_path.extension().and_then(|ext| ext.to_str()) {
        Some("html") => "text/html; charset=utf-8",
        Some("js" | "mjs") => "text/javascript; charset=utf-8",
        Some("css") => "text/css; charset=utf-8",
        Some("svg") => "image/svg+xml",
        Some("png") => "image/png",
        Some("webp") => "image/webp",
        Some("ico") => "image/x-icon",
        Some("woff2") => "font/woff2",
        Some("json") => "application/json",
        _ => return Err(invalid_asset()),
    };
    let root = root.canonicalize()?;
    let target = root.join(relative_path).canonicalize()?;
    if !target.starts_with(&root) || !target.is_file() {
        return Err(invalid_asset());
    }
    Ok((target, mime))
}

pub fn read_asset(uri: &str, root: &Path) -> io::Result<(Vec<u8>, &'static str)> {
    let (path, mime) = asset_path(uri, root)?;
    if path.metadata()?.len() > MAX_ASSET_BYTES {
        return Err(io::Error::new(
            io::ErrorKind::InvalidData,
            "UI asset too large",
        ));
    }
    Ok((std::fs::read(path)?, mime))
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::fs;
    use std::time::{SystemTime, UNIX_EPOCH};

    struct Fixture {
        root: PathBuf,
    }

    impl Fixture {
        fn new() -> Self {
            let unique = SystemTime::now()
                .duration_since(UNIX_EPOCH)
                .unwrap()
                .as_nanos();
            let root =
                std::env::temp_dir().join(format!("kira-ui-{}-{unique}", std::process::id()));
            fs::create_dir_all(root.join("assets")).unwrap();
            fs::write(root.join("index.html"), "<html></html>").unwrap();
            fs::write(root.join("assets/app.js"), "console.log('Kira')").unwrap();
            Self { root }
        }
    }

    impl Drop for Fixture {
        fn drop(&mut self) {
            fs::remove_dir_all(&self.root).unwrap();
        }
    }

    #[test]
    fn permits_packaged_document_and_javascript() {
        let fixture = Fixture::new();
        let (html, mime) = read_asset(UI_DOCUMENT_URI, &fixture.root).unwrap();
        assert_eq!(mime, "text/html; charset=utf-8");
        assert_eq!(html, b"<html></html>");
        let (js, mime) = read_asset("kira-ui://app/assets/app.js", &fixture.root).unwrap();
        assert_eq!(mime, "text/javascript; charset=utf-8");
        assert!(js.starts_with(b"console"));
    }

    #[test]
    fn rejects_external_origins_and_traversal() {
        let fixture = Fixture::new();
        for uri in [
            "file:///etc/passwd",
            "https://example.com/",
            "kira-ui://evil/index.html",
            "kira-ui://app/../secret.js",
            "kira-ui://app/%2e%2e/secret.js",
            "kira-ui://app/assets/../../secret.js",
            "kira-ui://app/assets/app.js?x=1",
            "kira-ui://app/assets//app.js",
        ] {
            assert!(read_asset(uri, &fixture.root).is_err(), "{uri}");
        }
    }

    #[cfg(unix)]
    #[test]
    fn symlinks_cannot_escape_ui_directory() {
        use std::os::unix::fs::symlink;
        let fixture = Fixture::new();
        symlink("/etc/passwd", fixture.root.join("assets/escape.js")).unwrap();
        assert!(read_asset("kira-ui://app/assets/escape.js", &fixture.root).is_err());
    }

    #[test]
    fn missing_resource_fails_with_error() {
        let fixture = Fixture::new();
        assert!(read_asset("kira-ui://app/assets/unknown.js", &fixture.root).is_err());
    }
}

FILE	docs/DESIGN_SYSTEM.md
# Kira Desktop · Design System

**Status:** first implementation of Kira Default for the Svelte top bar. This
document operationalizes [specification §15](SPECIFICATION.md#15-премиальный-ui-и-фирменная-палитра-обязательное-требование);
the other desktop surfaces are not implemented yet.

## Visual direction

Kira is calm, deliberate and refined. Prefer proportion, legibility and quiet
depth over trendy effects. A premium interface should feel cohesive even when
reduced motion is enabled and visual effects are unavailable.

- Consistent 4 px spacing grid with 8 px as the preferred increment.
- Compact, carefully aligned typography; a limited range of weights.
- Soft corners (6–12 px), measured separators, restrained overlays.
- State communicated with color **and** shape/position/text.
- Micro-transitions around 150–200 ms, disabled with `prefers-reduced-motion`.
- High-contrast text, visible keyboard focus and no fake interactive controls.

## Kira Default · canonical palette

| Name | HEX | Default meaning |
| --- | --- | --- |
| Space Indigo | `#22223b` | Dark background, text on accent |
| Dusty Grape | `#4a4e69` | Raised surfaces, supporting materials |
| Lilac Ash | `#9a8c98` | Muted details on Space Indigo |
| Almond Silk | `#c9ada7` | Active and focused elements |
| Parchment | `#f2e9e4` | Primary readable text |

The canonical typed palette is defined by
[`frontend/src/lib/themes/kira-default.ts`](../frontend/src/lib/themes/kira-default.ts).
CSS variables are declared in
[`kira-default.css`](../frontend/src/lib/themes/kira-default.css).
Unit tests ensure the five values remain synchronized.

## Public CSS contract

| Semantic variable | Canonical HEX | Intended usage |
| --- | --- | --- |
| `--kira-color-background` | `#22223b` | Main surface/background |
| `--kira-color-surface` | `#4a4e69` | Elevated surface |
| `--kira-color-muted` | `#9a8c98` | Secondary details on dark background |
| `--kira-color-accent` | `#c9ada7` | Accent, selection, focus |
| `--kira-color-text` | `#f2e9e4` | Foreground text |

Derived tokens: `--kira-color-on-accent`,
`--kira-color-text-secondary`, `--kira-color-surface-subtle`,
`--kira-color-border`. Layout and motion tokens start with
`--kira-space-`, `--kira-radius-`, `--kira-motion-`.

Example for a future Svelte widget:

```svelte
<div class="widget">Widget content</div>

<style>
  .widget {
    padding: var(--kira-space-3);
    border-radius: var(--kira-radius-md);
    background: var(--kira-color-surface);
    color: var(--kira-color-text);
  }
</style>
```

**Do not hardcode HEX values inside individual components.** Theme overrides
must happen by redefining semantic variables, not by copying stylesheet rules.
User-configurable themes through KDL are a future milestone.

## Color contrast and accessibility

- Parchment on Space Indigo: **12.91:1**.
- Parchment on Dusty Grape: **6.79:1**.
- Lilac Ash on Space Indigo: **4.84:1**.
- Space Indigo on Almond Silk: **7.37:1**.
- **Avoid** Lilac Ash text on Dusty Grape (only 2.55:1).

Regular text should meet at least 4.5:1, large text and relevant non-text
indicators at least 3:1. Do not rely only on color to indicate selection.
Keyboard navigation and visible focus outlines are required when a widget
becomes interactive. Respect `prefers-reduced-motion`.

## Current component implementation

- `frontend/src/App.svelte`: premium 42 px top bar, balanced left/center/right
  regions, brand and local clock.
- `frontend/src/lib/components/WorkspacePreview.svelte`: three **visual**
  workspace chips. These are deliberately **not clickable**, because Niri IPC
  has not been implemented. Workspace 1 is highlighted as a design preview
  only, not a claim about the active Niri workspace.
- `frontend/src/lib/components/CoreStatus.svelte`: status badge with
  text and a dot, tied to the existing real Core bridge; an accessible
  `role="status"` communicates transitions.
- `frontend/src/style.css`: responsive layout and focus styling. The UI
  stays 42 px tall to match the native layer-shell reservation.
- `frontend/index.html`: uses matching fallback colors before Svelte mounts.

## Verification

```sh
nix develop --command task check
nix develop --command task frontend:build
nix develop --command task dev:preview
```

Run a manual visual review in nested Niri at common display scales and
sizes. The automated tests verify palette constants, color contrast,
required token names and reduced-motion support. They do **not** replace
a screenshot or interactive accessibility test of the WebKit surface.

Next design-system milestones: shared interactive primitives, complete
keyboard navigation, configurable KDL themes, actual Niri workspaces,
Launcher, Dock, notifications, and their consistent states.

FILE	docs/DEVELOPMENT.md
# Developing Kira Desktop

## Requirements

Kira Desktop targets NixOS, Niri and Wayland. Flakes must be enabled. The repository commits the generated `Cargo.lock`, `flake.lock` and `frontend/package-lock.json`, as well as the verified frontend `npmDepsHash`.

The GitHub Actions workflows are split into fast, non-graphical checks (`.github/workflows/ci.yml`) and native Nix integration (`.github/workflows/nix.yml`).

## Kira Default visual design

The premium visual baseline is implemented using semantic CSS tokens in
`frontend/src/lib/themes/kira-default.css` and typed color metadata in
`frontend/src/lib/themes/kira-default.ts`. `WorkspacePreview.svelte` and
`CoreStatus.svelte` demonstrate theme-aware components without hardcoded HEX
values. The former is deliberately non-interactive until Niri IPC is wired.

See [DESIGN_SYSTEM.md](DESIGN_SYSTEM.md) and specification §15 for accessibility,
spacing, contrast and future widget conventions. The small HTML fallback in
`frontend/index.html` uses the exact canonical colors because it runs before
CSS assets finish loading.

## Safe nested development preview

```sh
nix develop --command task dev:preview
```

The default preview builds with Cargo in `target/debug` and Vite in
`frontend/dist`, reusing compiled Rust dependencies. A full Nix package build
is reserved for `task dev:preview:release`; `task dev:preview:run` launches
already-built binaries without compiling anything.

The preview validates an isolated minimal Niri KDL config, launches Niri
**windowed without `--session`**, then receives the actual nested
`WAYLAND_DISPLAY` from a `spawn-at-startup` handshake. Only after verifying
the nested display differs from the parent does it start Core and Shell.

`KIRA_CORE_SOCKET` points to a private temporary directory, so an existing
Kira Core process cannot be touched. `KIRA_PREVIEW=1` enables the GTK
`NON_UNIQUE` application flag to avoid activating a primary-session Shell.

Closing the nested window or pressing Ctrl+C stops only processes owned by the
preview. Config and logs are temporary; recent logs are printed on unexpected
exit. Tests use mock executables, not a GPU:

```sh
task dev:preview:test
```

See [PREVIEW.md](PREVIEW.md) for additional safety checks and troubleshooting.

## Native Nix package

The following build has passed on Linux in GitHub Actions with the pinned Nix inputs:

```sh
nix build .#default
```

The package installs `kira-core`, `kira-shell` and the compiled UI assets; the GTK wrapper sets `KIRA_UI_DIR` to the installed frontend directory.

To manually smoke-test from an existing Niri session:

```sh
nix build
./result/bin/kira-core  # terminal 1
./result/bin/kira-shell # terminal 2
```

The native Nix package build is tested in CI; verify appearance and behavior manually under Niri.

## Developer tasks

```sh
nix develop
npm ci --prefix frontend
task check           # formatting, Clippy, IPC tests, TypeScript, Vitest
task shell:check     # compile the native GTK/WebKit Shell
task dev:preview     # fast Cargo + Vite nested preview
task dev:preview:run # reopen already built preview, no compilation
task dev:preview:release # full Nix release preview
task build           # frontend + all release binaries
task core:run        # launch the Core daemon
task shell:run       # rebuild frontend and launch the Shell
task nix:check       # nix flake check
task nix:build       # nix build
```

Use separate terminals for the two running processes. `XDG_RUNTIME_DIR` must point to the active user session runtime directory. The Shell returns an explicit error when its UI resources are missing. `KIRA_UI_DIR` can override the UI directory for development or packaging.

## Review hardening

The Shell WebView only allows navigation to its exact packaged `index.html` URI
and ignores attempts to open a new window. The Rust bridge remains explicitly
allowlisted to read-only methods. This is defense-in-depth for trusted UI code,
not a security boundary for untrusted extensions.

Core now bounds individual JSON-RPC messages to 4096 bytes and removes the
Unix socket it owns after SIGINT/SIGTERM, checking inode identity first. The
preview traps SIGTERM and terminates process groups even when their leaders
have already exited, reducing the chance of orphaned processes.

## Core ⇄ Shell ⇄ Svelte bridge

Svelte uses the typed SDK at `frontend/src/lib/sdk/core.ts`, sending JSON-RPC requests to `window.webkit.messageHandlers.kira.postMessage`. The Rust Host forwards **only `ping` and `get_state`** over Unix Domain Socket on a worker thread. Its GTK main loop returns replies as `kira:rpc` events.

The SDK correlates numeric request IDs, applies timeouts, and reports disconnected Core as an error. Browser-only Vite preview has no WebKit bridge and displays `Core: unavailable` rather than a fake connection.

```json
{"jsonrpc":"2.0","id":1,"method":"ping"}
```

```json
{"jsonrpc":"2.0","id":1,"result":"pong"}
```

The IPC transport uses newline-delimited JSON. The bootstrap `get_state` response contains version and status only. There is no Niri integration or event subscription mechanism yet. The Core socket is intended for the trusted local user session only.

## Updating dependencies

The initial lockfiles were generated by `.github/workflows/lockfiles.yml`. Update them deliberately using the appropriate tooling and commit changes together with any required Nix hash update. The separate Nix integration workflow must pass after dependency changes.

## Next milestones

1. Visual QA for Kira Default on several screen scales, then packaged Shell smoke test.
2. Niri IPC workspace state and typed event subscriptions.
3. KDL configuration engine with validation and hot reload.
4. Real workspace, launcher and dock widgets.
5. System-service integrations and user widget loading.

Do not claim implementation or isolation of untrusted plugins until the code and tests exist.

FILE	docs/SPECIFICATION.md
# Kira Desktop

**Техническая спецификация:** v0.1 (Draft)  
**Целевая платформа:** NixOS / Linux / Wayland  
**Основа:** Niri Wayland Compositor  
**Статус:** идёт bootstrap: созданы Rust Workspace, Core, IPC, Shell Host и Svelte-превью; типизированный WebKit ↔ Core bridge работает, панель визуально проверена во вложенном Niri; Niri IPC и Event Bus ещё не подключены; MVP не готов.

## 1. Цель проекта

Kira Desktop — современное, высокопроизводительное, модульное, декларативное и расширяемое окружение рабочего стола, построенное на Rust и Svelte 5.

Основные требования:

- Декларативная конфигурация через KDL.
- Модульная архитектура и независимые компоненты.
- Пользовательские виджеты и расширения на Svelte 5 / TypeScript.
- Горячая перезагрузка конфигурации и компонентов, где это технически возможно.
- **Премиальная дизайн-система:** визуальная целостность, типографика и качество деталей обязательны для всех поверхностей и виджетов.
- Единая дизайн-система и настраиваемые темы.
- Минимальное потребление ресурсов и высокая отзывчивость.
- Независимость системного ядра от пользовательского интерфейса.
- **NixOS-first:** разработка, сборка и поставка проекта ориентированы прежде всего на NixOS.

## 2. Технологический стек

| Слой | Технологии |
| --- | --- |
| Compositor | Niri |
| Backend | Rust, Tokio |
| Frontend | Svelte 5, TypeScript, Vite |
| UI Components | shadcn-svelte, Tailwind CSS |
| WebView | GTK4, WebKitGTK 6 |
| Wayland | gtk4-layer-shell |
| IPC | Unix Domain Socket, JSON-RPC |
| Configuration | KDL |
| Serialization | Serde |
| System Integration | Niri IPC, D-Bus, PipeWire |
| Build | Cargo Workspace, Vite |
| NixOS build / development | Nix Flakes, `flake.nix`, `nix/package.nix` |
| Task runner | Taskfile (`go-task`) |
| CI | GitHub Actions |

Frontend собирается в статические ресурсы и загружается через WebKitGTK. Tauri, Node.js-сервер и Lua **не используются в runtime**. Node.js допустим только на этапе разработки и сборки frontend.

## 3. Архитектура

Система состоит из двух основных процессов.

### Kira Core (Rust Daemon)

- Управление системным состоянием.
- Интеграция с Niri.
- Управление конфигурацией и расширениями.
- Системные сервисы и Event Bus.
- Предоставление типизированного IPC API.

### Kira Shell (Rust Host + Svelte UI)

- Создание Wayland layer-shell поверхностей.
- Отображение Svelte-компонентов через WebKitGTK.
- Управление панелями, доком и рабочим столом.
- Связь с Kira Core через Unix Domain Socket.

**Схема взаимодействия:**

```text
Svelte UI ↔ WebKit Bridge ↔ Rust Host ↔ Unix Socket ↔ Kira Core ↔ Niri / Linux
```

Kira Core является единым источником системного состояния. UI подписывается на изменения и отправляет команды через типизированный API.

## 4. Структура репозитория и Rust Workspace

**Целевая структура по мере реализации MVP** (не утверждение о существовании всех файлов на этапе Draft):

```text
kira-desktop/
├── Cargo.toml
├── Cargo.lock
├── crates/
│   ├── kira-core/
│   ├── kira-ipc/
│   ├── kira-config/
│   ├── kira-niri/
│   ├── kira-services/
│   └── kira-shell/
├── frontend/
│   ├── src/
│   │   ├── lib/
│   │   │   ├── components/
│   │   │   ├── widgets/
│   │   │   ├── sdk/
│   │   │   └── themes/
│   │   └── surfaces/
│   ├── package.json
│   └── package-lock.json
├── config/
├── nix/
│   └── package.nix
├── flake.nix
├── flake.lock
├── Taskfile.yml
├── .github/
│   └── workflows/
│       └── ci.yml
├── tests/
├── docs/
│   └── SPECIFICATION.md
└── README.md
```

Каждый Rust-крейт имеет конкретную ответственность и публичный API. Новые крейты создаются только при реальной необходимости. `Cargo.lock`, `frontend/package-lock.json` и `flake.lock` фиксируются в Git после создания соответствующих компонентов/lock-файлов.

## 5. Декларативная конфигурация

Конфигурация хранится в `~/.config/kira-desktop/` в формате KDL.

Пример:

```kdl
theme "dark" {
    accent "#c9ada7"
    radius 12
}

surface "topbar" {
    layer "top"
    height 42

    left {
        widget "workspaces"
        widget "launcher"
    }

    center {
        widget "clock"
    }

    right {
        widget "system-tray"
        widget "audio"
    }
}
```

**Требования:**

- Валидация конфигурации до применения.
- Hot Reload без перезапуска оболочки, где это технически возможно.
- Сохранение предыдущего работоспособного состояния при ошибке.
- Настройки виджетов через единый механизм.
- Возможность переопределения стандартных настроек.

## 6. Система виджетов и расширений

Все встроенные и пользовательские виджеты разрабатываются на Svelte 5.

**Widget SDK** предоставляет:

- Доступ к системному состоянию через типизированный API.
- Подписки на события.
- Команды управления Niri.
- Доступ к темам и UI-компонентам.
- Хранение пользовательских настроек.
- Управление жизненным циклом виджета.

Сторонние виджеты распространяются в виде предварительно собранных JS-модулей с манифестом, версией SDK и декларацией необходимых разрешений.

В первой версии поддерживаются **доверенные** пользовательские расширения. Декларация разрешений сама по себе не является изоляцией. Выполнение недоверенных плагинов требует отдельного механизма (например, отдельных изолированных WebView) и не входит в MVP.

## 7. Инженерные принципы

- **KISS:** минимальное количество абстракций, процессов и зависимостей.
- **DRY:** общие типы, SDK, компоненты и бизнес-логика без дублирования.
- **SOLID:** чёткие границы ответственности, явные интерфейсы, зависимости от контрактов, а не реализаций.
- **Pragmatic Engineering:** простые работающие решения важнее преждевременных обобщений.
- **Modular Composition:** функциональность собирается из независимых заменяемых компонентов с минимальной связанностью.

Дополнительные требования:

- Композиция предпочтительнее наследования и монолитных структур.
- Типизированные ошибки и явная обработка отказов.
- Минимизация глобального изменяемого состояния.
- Стабильные версионированные контракты IPC и Widget SDK.
- Возможность тестирования модулей без запущенного Niri.

## 8. NixOS: разработка, сборка и доставка (обязательное требование)

**NixOS — основная целевая система.** Поддержка других Linux-дистрибутивов возможна в будущем, но не является критерием MVP.

Репозиторий **обязан содержать**:

1. `flake.nix` — декларацию Nix Flake с воспроизводимой средой разработки (`devShells`), проверками (`checks`) и, после появления исходного кода приложения, собираемым пакетом (`packages.default`).
2. `nix/package.nix` — отдельное Nix-выражение для сборки и упаковки Kira Desktop. Nix-сборка должна собирать Rust Core/Shell и production frontend, устанавливать UI-ресурсы и обеспечивать необходимые GTK4/WebKitGTK/Wayland зависимости.
3. `flake.lock` — зафиксированные входные зависимости Flake; файл добавляется и поддерживается после первого `nix flake lock`.

Требования к Nix-сборке:

- Разработка — через `nix develop`; сборка — через `nix build`; проверка Flake — через `nix flake check`.
- Результат финальной сборки — installable-пакет приложения, а не только архив исходников или документации.
- Сборка frontend и backend воспроизводима, зависимости фиксируются lock-файлами; обращение к сети из build sandbox не допускается.
- Системные библиотеки и build-time инструменты объявляются явно; глобально установленные Node.js/Rust не должны быть обязательны в Nix-окружении.
- Приложение должно устанавливаться и запускаться в NixOS с Niri; интеграция с NixOS-модулем может появиться отдельно, без преждевременного усложнения структуры.

**Текущий статус реализации:** Rust Workspace, frontend, lock-файлы и Nix-пакет добавлены. `nix build` и нативная компиляция `kira-shell` прошли GitHub Actions на Linux с зафиксированными зависимостями. Графический запуск и визуальная проверка панели во **вложенной оконной сессии Niri** подтверждены вручную; полноценная системная установка и интеграционные E2E-тесты пока не выполнены. Это не означает готовность MVP: Niri IPC, KDL и система виджетов ещё не реализованы.

## 9. Taskfile: единый интерфейс команд (обязательное требование)

Команды проекта централизуются в корневом `Taskfile.yml` с использованием [Task](https://taskfile.dev/). CI по возможности вызывает **те же** задачи, что доступны локально, без дублирования логики.

Предусмотренные задачи:

| Команда | Назначение |
| --- | --- |
| `task check` | Комплексная проверка репозитория |
| `task spec:check` | Наличие обязательной документации и Nix/CI-файлов |
| `task fmt` | Проверка форматирования Rust |
| `task lint` | Clippy и статическая проверка Svelte/TypeScript |
| `task test` | Rust unit/integration и frontend component tests |
| `task build` | Локальная production-сборка (когда исходники готовы) |
| `task nix:check` | `nix flake check` |
| `task nix:build` | `nix build` |

Taskfile должен ясно указывать, какие проверки ещё нельзя запустить до появления соответствующих исходников. **Отсутствие кода нельзя считать успешно протестированным кодом.** Команды сборки должны возвращать ошибку до появления необходимой структуры.

## 10. Тестирование и качество

- **Unit Tests:** конфигурация, бизнес-логика, обработчики команд.
- **Integration Tests:** IPC, сервисы, взаимодействие между крейтами.
- **Contract Tests:** соответствие Rust API и TypeScript SDK.
- **Component Tests:** Svelte-компоненты и пользовательские виджеты.
- **E2E Tests:** запуск оболочки и поверхностей в тестовой Wayland-сессии.

По мере реализации CI должен выполнять:

- `cargo fmt --all -- --check`;
- `cargo clippy --workspace --all-targets -- -D warnings`;
- `cargo test --workspace --all-targets`;
- проверку TypeScript/Svelte;
- тесты frontend;
- production-сборку frontend и проекта.

**Лёгкий CI обязателен** в `.github/workflows/ci.yml` на `push` и `pull_request`. Начальный GitHub Actions workflow выполняет `task check`, всегда валидирует структуру спецификации и условно активирует Rust/frontend-проверки после появления соответствующих компонентов. Тяжёлые NixOS/Wayland E2E-тесты можно вынести в отдельный этап, не утяжеляя базовый CI.

Frontend должен предоставлять npm scripts `check`, `test:ci`, `build`, которые вызываются Taskfile. CI не должен притворяться, что Rust/frontend-тесты уже выполняются до появления исходного кода.

## 11. MVP

Первая версия должна включать:

1. Rust Core и Shell Host.
2. Unix Socket IPC и типизированный Svelte SDK.
3. KDL Config Engine с Hot Reload.
4. Top Bar и Workspaces.
5. Application Launcher.
6. Dock и Clock.
7. Премиальную дизайн-систему и темы с обязательной палитрой по умолчанию (раздел 15).
8. Загрузку пользовательских Svelte-виджетов.
9. Автоматизированные тесты основных компонентов.
10. Сборку и запуск на NixOS через Nix Flake.
11. Taskfile и работающий лёгкий CI.

## 12. Критерии готовности MVP

- Shell запускается поверх Niri на NixOS без Tauri.
- Панель корректно использует Wayland layer-shell.
- Изменение KDL обновляет UI без полной перезагрузки процесса.
- Системные события передаются из Rust в Svelte.
- Пользовательский виджет устанавливается без пересборки Kira Desktop.
- Ошибка отдельного виджета не должна приводить к завершению Kira Core.
- Критическая системная логика покрыта автоматизированными тестами.
- `nix build` создаёт запускаемый пакет с собранным frontend; `nix develop` предоставляет все build-time инструменты.
- `task check` и CI выполняют реальные тесты добавленных Rust/TypeScript компонентов.
- Стандартные поверхности и виджеты соответствуют дизайн-системе раздела 15: премиальное визуальное качество, семантические токены, читаемость, клавиатурная навигация и reduced motion.

## 13. Главный архитектурный принцип

*Kira Desktop — это не монолитное приложение, а композиция независимых системных сервисов и интерфейсных компонентов.*

**Rust отвечает за возможности системы. Svelte 5 отвечает за интерфейс. KDL определяет декларативное состояние рабочего стола. Nix обеспечивает воспроизводимую разработку и поставку для NixOS.**


## 14. Безопасное локальное превью (Developer Experience)

Разработка и проверка поверхностей выполняются без замены основного рабочего
окружения через команду `task dev:preview`.

- Превью использует вложенный Niri в оконном режиме с временной KDL-конфигурацией.
- Shell получает только фактический Wayland-дисплей дочернего Niri.
- Core использует отдельный IPC-сокет, задаваемый `KIRA_CORE_SOCKET`.
- GTK Host использует отдельный экземпляр приложения при `KIRA_PREVIEW=1`.
- Завершение превью останавливает только его собственные процессы.
- Команда не выполняет `nixos-rebuild switch`, не меняет системные службы
  и не редактирует настройки основного Niri.
- Изоляция ограничена композитором и процессами. Это не полноценная VM.

Подробная инструкция: [PREVIEW.md](PREVIEW.md).

## 15. Премиальный UI и фирменная палитра (обязательное требование)

### 15.1. Визуальный характер

**Kira Desktop должен выглядеть премиально:** современно, сдержанно,
элегантно, цельно и внимательно к деталям. Это обязательный критерий
качества, а не необязательное дизайнерское пожелание.

- **Чистая визуальная иерархия.** Основные действия и системное состояние
  читаются сразу, вторичные элементы не перегружают экран.
- **Единый ритм.** Базовый шаг отступов 4 px, предпочтительно кратные
  8 px; согласованные радиусы, высоты, выравнивание и размеры элементов.
- **Типографика.** Разборчивые шрифты, ограниченное количество начертаний,
  аккуратные интервалы, продуманная иерархия.
- **Материалы и глубина.** Сдержанные поверхности, деликатные границы,
  тени и полупрозрачность лишь при наличии функциональной пользы. Никакого
  декоративного шума и злоупотребления blur/градиентами.
- **Плавность.** Короткие, ненавязчивые переходы, ориентир 120–220 мс;
  обязательно учитывать `prefers-reduced-motion`.
- **Согласованность.** Top Bar, Dock, Launcher, уведомления, меню,
  настройки и виджеты образуют одну дизайн-систему со всеми состояниями:
  default, hover, focus, active, disabled, loading, error.
- **Практичность.** Премиальный вид не может ухудшать отзывчивость,
  доступность, контрастность или клавиатурное управление.

### 15.2. Каноническая палитра Kira Default

По умолчанию используется **тёмная тема Kira Default** с **ровно пятью
базовыми цветами**. Названия и значения ниже фиксированы:

| Имя | HEX | RGB | Назначение |
| --- | --- | --- | --- |
| **Space Indigo** | `#22223b` | `rgb(34, 34, 59)` | Главный фон, глубокая основа интерфейса |
| **Dusty Grape** | `#4a4e69` | `rgb(74, 78, 105)` | Приподнятые поверхности, меню и карточки |
| **Lilac Ash** | `#9a8c98` | `rgb(154, 140, 152)` | Вспомогательные детали, неактивные элементы |
| **Almond Silk** | `#c9ada7` | `rgb(201, 173, 167)` | Главный акцент, выбранные элементы, focus |
| **Parchment** | `#f2e9e4` | `rgb(242, 233, 228)` | Основной текст на тёмных поверхностях |

Каноническая машинно-читаемая запись:

```json
{
  "Space Indigo": "#22223b",
  "Dusty Grape": "#4a4e69",
  "Lilac Ash": "#9a8c98",
  "Almond Silk": "#c9ada7",
  "Parchment": "#f2e9e4"
}
```

CSV, массивы, XML и другие формы являются представлениями **той же
палитры**, а не дополнительными темами или цветами. Произвольные новые
базовые цвета в Kira Default запрещены без изменения спецификации.
Пользовательские темы в будущем могут переопределять все цвета.

### 15.3. Семантические токены

Встроенный UI и Widget SDK должны использовать семантические токены,
а не дублировать HEX в каждом компоненте. Предполагаемый контракт CSS:

| CSS-токен | Значение в Kira Default | Роль |
| --- | --- | --- |
| `--kira-color-background` | `#22223b` | Фон |
| `--kira-color-surface` | `#4a4e69` | Поверхности |
| `--kira-color-muted` | `#9a8c98` | Неактивные детали |
| `--kira-color-accent` | `#c9ada7` | Выделение, фокус |
| `--kira-color-text` | `#f2e9e4` | Основной текст |

Для hover, border, disabled и overlay допустимы производные оттенки,
смешивание и прозрачность этих цветов при соблюдении контраста.
Семантические роли и значения палитры должны настраиваться единым
механизмом темы, а в перспективе через декларативную конфигурацию KDL.

### 15.4. Контрастность и доступность

Примеры контрастных сочетаний (округлённые значения WCAG):

| Текст / фон | Контраст | Применение |
| --- | --- | --- |
| Parchment / Space Indigo | **12.91:1** | Основной текст |
| Parchment / Dusty Grape | **6.79:1** | Текст на карточках |
| Lilac Ash / Space Indigo | **4.84:1** | Второстепенный текст |
| Space Indigo / Almond Silk | **7.37:1** | Текст внутри активных элементов |

**Lilac Ash на Dusty Grape** (≈ 2.55:1) не подходит для обычного
мелкого текста; **Almond Silk на Parchment** (≈ 1.75:1) также не подходит.

Критерии приёмки:

- Контраст обычного текста не ниже **4.5:1**, крупного текста и
  значимых нетекстовых элементов управления не ниже **3:1** там,
  где соответствуют требованиям WCAG.
- Активное состояние, выбор и фокус различимы **не только цветом**.
- Клавиатурная навигация, видимый focus indicator, корректные
  состояния элементов и `prefers-reduced-motion` обязательны.
- Финальные поверхности проходят визуальную проверку во вложенном
  Niri при различных размерах и масштабах дисплея. Успешный CI сам
  по себе не подтверждает премиальный визуальный результат.

**Статус реализации:** базовые CSS-токены `Kira Default`, переиспользуемые
компоненты Workspaces Preview и Core Status, а также визуальная тема Top Bar
реализованы. Это **первый этап** дизайн-системы, не подтверждение готовности
всех поверхностей и виджетов. Клавиатурные сценарии будущих интерактивных
компонентов, пользовательские темы, Launcher, Dock и уведомления ещё предстоит
реализовать и визуально проверить.

Практические правила и API токенов: [DESIGN_SYSTEM.md](DESIGN_SYSTEM.md).

FILE	flake.nix
{
  description = "Kira Desktop: NixOS-first Wayland shell built on Niri";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs = { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = f:
        nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});

      # Expose the package when the application sources and locks exist.
      hasApplicationSources =
        builtins.pathExists ./Cargo.toml
        && builtins.pathExists ./Cargo.lock
        && builtins.pathExists ./frontend/package.json
        && builtins.pathExists ./frontend/package-lock.json;
    in
    {
      devShells = forAllSystems (pkgs: {
        default = pkgs.mkShell {
          packages = with pkgs; [
            cargo
            rustc
            rustfmt
            clippy
            nodejs
            go-task
            python3
            niri
            pkg-config
            gtk4
            gtk4-layer-shell
            webkitgtk_6_0
            pipewire
          ];
        };
      });

      packages = forAllSystems (pkgs:
        if hasApplicationSources
        then { default = pkgs.callPackage ./nix/package.nix { }; }
        else { }
      );

      checks = forAllSystems (pkgs: {
        repository-spec = pkgs.runCommand "kira-desktop-spec-check" { } ''
          test -s ${./docs/SPECIFICATION.md}
          test -s ${./nix/package.nix}
          test -s ${./Taskfile.yml}
          test -s ${./.github/workflows/ci.yml}
          touch "$out"
        '';
      });
    };
}

FILE	frontend/index.html
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#22223b" />
    <title>Kira Desktop</title>
    <script>
      // Head runs before the compiled Svelte bundle. Track boot milestones
      // so failures are distinguishable from resource/scheme errors.
      window.__kiraBoot = { head: true, lastError: null };
      const report = (message) => {
        try {
          window.webkit?.messageHandlers?.kiraDiagnostics?.postMessage(message);
        } catch (error) {
          // Diagnostics must never prevent the Svelte entrypoint from loading.
          console.warn('Kira diagnostics bridge unavailable:', error);
        }
      };
      report('HTML head script executed; location=' + location.href);

      window.addEventListener('error', (event) => {
        const error = event.error;
        const details = [
          'error: ' + String(event.message || error?.message || 'unknown'),
          'source=' + String(event.filename || location.href),
          'line=' + String(event.lineno || 0),
          'column=' + String(event.colno || 0),
          error?.stack ? 'stack=' + String(error.stack) : '',
        ].filter(Boolean).join(' | ');
        window.__kiraBoot.lastError = details;
        report(details);
      });
      window.addEventListener('unhandledrejection', (event) => {
        const reason = event.reason;
        const details = 'unhandled rejection: ' + String(reason?.stack || reason);
        window.__kiraBoot.lastError = details;
        report(details);
      });
      window.addEventListener('DOMContentLoaded', () => {
        window.setTimeout(() => {
          const pending = document.querySelector('#kira-loading');
          if (pending) {
            const stage = JSON.stringify({
              ...window.__kiraBoot,
              entryStarted: window.__kiraEntryStarted === true,
              mountReturned: window.__kiraMountReturned === true,
            });
            pending.textContent = 'Kira UI did not start (' + stage + '). Check terminal logs.';
            report('Svelte not mounted: ' + stage);
          }
        }, 2500);
      });
    </script>
  </head>
  <body>
    <div id="app">
      <div id="kira-loading" style="height:42px; display:flex; align-items:center; padding:0 14px; font:12px system-ui; background:#22223b; color:#f2e9e4;">
        Kira Desktop · Loading interface…
      </div>
    </div>
    <script type="module" src="/src/main.ts"></script>
  </body>
</html>

