"""Svelte System Monitor and bounded read-only Rust backend contract."""
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RUST = (ROOT / "crates/kira-shell/src/system_panel.rs").read_text()
MONITOR = (ROOT / "crates/kira-shell/src/system_metrics.rs").read_text()
PROCESSES = (ROOT / "crates/kira-shell/src/process_monitor.rs").read_text()
HOST = (ROOT / "crates/kira-shell/src/main.rs").read_text()
OVERLAY = (ROOT / "crates/kira-shell/src/calendar.rs").read_text()
ENTRY = (ROOT / "frontend/src/main.ts").read_text()
APP = (ROOT / "frontend/src/App.svelte").read_text()
HEALTH = (ROOT / "frontend/src/lib/components/SystemHealth.svelte").read_text()
WIDGET = (ROOT / "frontend/src/lib/components/SystemWidget.svelte").read_text()
MODEL = (ROOT / "frontend/src/lib/system-model.ts").read_text()
SDK = (ROOT / "frontend/src/lib/sdk/core.ts").read_text()
NIX = (ROOT / "nix/package.nix").read_text()


class DetailedHealthContractTests(unittest.TestCase):
    def test_same_warm_webview_hosts_calendar_and_system(self):
        self.assertIn('register_script_message_handler("kiraSystem", None)', HOST)
        self.assertIn('if value.to_string() == "toggle"', HOST)
        self.assertIn("calendar::toggle_system(", HOST)
        self.assertIn("postNativeCommand('kiraSystem', 'toggle')", SDK)
        self.assertIn('onclick={onOpen}', HEALTH)
        self.assertIn('aria-haspopup="dialog"', HEALTH)
        self.assertIn('set_exclusive_zone(0)', OVERLAY)
        self.assertIn('set_namespace(Some("kira-overlay"))', OVERLAY)
        self.assertIn('configure_webview_popup(&window, 420, 1)', OVERLAY)
        self.assertIn("self.active.set(Some(kind))", OVERLAY)
        self.assertIn("state.show(Surface::System)", OVERLAY)
        self.assertIn("state.show(Surface::Calendar)", OVERLAY)
        self.assertIn("kira:overlay:show", OVERLAY)
        self.assertIn("kira:overlay:hide", OVERLAY)
        self.assertIn("mount(SystemWidget", ENTRY)
        self.assertIn("mount(CalendarWidget", ENTRY)
        self.assertIn("host.hide()", ENTRY)
        self.assertIn("unmount(instance)", ENTRY)
        self.assertIn('data-kira-ui-root', WIDGET)
        self.assertIn('aria-label="Kira System Monitor"', WIDGET)
        self.assertNotIn("webkit6::WebView::builder()", RUST)

    def test_resources_preserved_with_real_safe_kernel_sources(self):
        for path in ("/proc/stat", "/proc/meminfo", "/proc/uptime",
                     "/proc/loadavg", "/sys/class/power_supply"):
            self.assertIn(path, MONITOR)
        self.assertIn("query_filesystem_info(", RUST)
        self.assertIn('kira:system:data', OVERLAY)
        self.assertIn('kira:system:processes', OVERLAY)
        self.assertIn('onSystemOverlayData(', WIDGET)
        self.assertIn('onSystemProcesses(', WIDGET)
        self.assertIn("MEMORY PRESSURE", MODEL)
        self.assertIn("LOW STORAGE", MODEL)
        self.assertIn("LOW BATTERY", MODEL)
        self.assertIn("NOT DETECTED", WIDGET)
        self.assertIn("COPY REPORT", WIDGET)
        self.assertIn("sendCalendarUi('copy-report')", SDK)
        self.assertIn("display.clipboard().set_text(&model.report())", OVERLAY)
        for source in (RUST, OVERLAY, MONITOR):
            self.assertNotIn("std::process::Command", source)
            self.assertNotIn("Command::new", source)

    def test_processes_sample_only_while_visible_and_full_table_is_svelte(self):
        for source in (WIDGET, MODEL):
            self.assertNotIn("gtk::", source)
        self.assertIn("ProcessSampler::default()", RUST)
        self.assertIn("std::thread::spawn", RUST)
        self.assertIn("mpsc::sync_channel(1)", RUST)
        self.assertIn("set_processes_active(false)", OVERLAY)
        self.assertIn("Some(UiCommand::ProcessesTab(active))", OVERLAY)
        self.assertIn("tab:processes", OVERLAY)
        self.assertIn("tab:overview", OVERLAY)
        self.assertIn("setSystemMonitorTab", ENTRY)
        self.assertIn("01 / OVERVIEW", WIDGET)
        self.assertIn("02 / PROCESSES", WIDGET)
        self.assertIn("Filter by process name or PID", WIDGET)
        self.assertIn("sortedProcesses(", WIDGET)
        self.assertIn("matching.slice(0, 36)", WIDGET)
        self.assertIn("function nextSort(", MODEL)
        self.assertIn("function sortedProcesses(", MODEL)
        self.assertIn("String(row.pid)", MODEL)
        for file in ("/proc", "/proc/stat", 'stat', 'status'):
            self.assertIn(file, PROCESSES)
        self.assertIn("pid, stat.start_ticks", PROCESSES)
        self.assertNotIn("kill(", RUST)
        self.assertNotIn("gtk::Grid", RUST)
        self.assertNotIn("gtk::SearchEntry", RUST)
        self.assertNotIn("gtk::ProgressBar", RUST)

    def test_native_views_and_styles_are_removed(self):
        self.assertNotIn("mod process_page;", HOST)
        self.assertFalse((ROOT / "crates/kira-shell/src/process_page.rs").exists())
        self.assertFalse((ROOT / "crates/kira-shell/src/system_panel.css").exists())
        self.assertNotIn("system_panel.css", NIX)
        self.assertIn("onSystemMetrics(", APP)
        self.assertIn("stopMetrics();", APP)


if __name__ == "__main__":
    unittest.main()

FILE	tests/test_dev_preview.py
"""Mocked preview lifecycle tests. No graphics hardware or Niri required."""
import importlib.util
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import tempfile
import time
import unittest

SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "dev_preview.py"
spec = importlib.util.spec_from_file_location("dev_preview", SCRIPT)
assert spec and spec.loader
preview = importlib.util.module_from_spec(spec)
spec.loader.exec_module(preview)


class PreviewTests(unittest.TestCase):
    def test_config_does_not_start_host_services(self):
        config = preview.preview_config(Path("/usr/bin/python3"), SCRIPT, Path("/tmp/ready"), "abc")
        self.assertIn("spawn-at-startup", config)
        self.assertIn('"report"', config)
        self.assertIn("Alt+Shift+Q", config)
        self.assertIn('Mod+T repeat=false { spawn "foot"; }', config)
        self.assertIn("Mod+2 { focus-workspace 2; }", config)
        self.assertIn("Mod+Ctrl+1 repeat=false { move-window-to-workspace focus=false 1; }", config)
        self.assertIn("Mod+Ctrl+2 repeat=false { move-window-to-workspace focus=false 2; }", config)
        # Alt+Shift can be swallowed by host keyboard-layout switching;
        # never resurrect the earlier four-modifier move shortcut.
        self.assertNotIn("Alt+Shift+Ctrl+2", config)
        self.assertNotIn("Mod+Return", config)
        self.assertNotIn("waybar", config)
        self.assertNotIn("--session", config)

    def test_refuses_parent_wayland_socket(self):
        with tempfile.TemporaryDirectory() as temp:
            with self.assertRaisesRegex(preview.PreviewError, "PARENT Wayland"):
                preview.nested_display_path("wayland-1", "wayland-1", Path(temp))
            self.assertEqual(
                preview.nested_display_path("wayland-2", "wayland-1", Path(temp)),
                Path(temp) / "wayland-2",
            )

    def test_report_records_child_display(self):
        with tempfile.TemporaryDirectory() as temp:
            filename = Path(temp) / "ready.json"
            original = os.environ.get("WAYLAND_DISPLAY")
            os.environ["WAYLAND_DISPLAY"] = "wayland-nested"
            try:
                preview.report_ready(filename, "nonce")
            finally:
                if original is None:
                    os.environ.pop("WAYLAND_DISPLAY", None)
                else:
                    os.environ["WAYLAND_DISPLAY"] = original
            self.assertEqual(json.loads(filename.read_text())["display"], "wayland-nested")

    def test_refuses_non_wayland_session(self):
        env = os.environ.copy()
        env.pop("WAYLAND_DISPLAY", None)
        completed = subprocess.run(
            [sys.executable, str(SCRIPT)],
            env=env, capture_output=True, text=True, timeout=6,
        )
        self.assertNotEqual(completed.returncode, 0)
        self.assertIn("Wayland session", completed.stderr)

    def test_cleanup_kills_grandchildren_after_leader_exits(self):
        with tempfile.TemporaryDirectory() as temp:
            child_file = Path(temp) / "child.pid"
            parent = subprocess.Popen(
                [
                    sys.executable,
                    "-c",
                    "import subprocess,sys; "
                    "p=subprocess.Popen(['sleep','30'], stdout=subprocess.DEVNULL,"
                    "stderr=subprocess.DEVNULL); "
                    "open(sys.argv[1],'w').write(str(p.pid))",
                    str(child_file),
                ],
                start_new_session=True,
            )
            try:
                parent.wait(timeout=4)
                child_pid = int(child_file.read_text())
                preview.stop_process(parent)
                deadline = time.monotonic() + 3
                while time.monotonic() < deadline:
                    state_file = Path(f"/proc/{child_pid}/stat")
                    if not state_file.exists():
                        break
                    state = state_file.read_text().split(") ", 1)[1][0]
                    if state == "Z":  # A zombie is dead but awaits reaping.
                        break
                    time.sleep(0.05)
                else:
                    self.fail("Grandchild survived cleanup after its leader exited")
            finally:
                preview.stop_process(parent)

    def test_lifecycle_with_mock_niri_core_and_shell(self):
        self.run_mock_lifecycle(signal.SIGINT)

    def test_sigterm_cleans_up_mock_preview(self):
        self.run_mock_lifecycle(signal.SIGTERM)

    def test_fast_preview_uses_debug_binaries_and_frontend(self):
        self.run_mock_lifecycle(signal.SIGINT, fast=True)

    def test_debug_preview_streams_shell_logs(self):
        self.run_mock_lifecycle(signal.SIGINT, fast=True, debug=True)

    def run_mock_lifecycle(self, exit_signal, fast=False, debug=False):
        with tempfile.TemporaryDirectory() as temp:
            root = Path(temp)
            runtime = root / "runtime"
            runtime.mkdir()
            parent = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            parent.bind(str(runtime / "wayland-parent"))
            parent.listen(1)

            bins = root / ("target/debug" if fast else "result/bin")
            bins.mkdir(parents=True)
            ui = root / "frontend/dist"
            ui.mkdir(parents=True)
            (ui / "index.html").write_text("<html>UI</html>")
            output = root / "shell-env.json"
            (bins / "kira-core").write_text("""#!/usr/bin/env python3
import os, socket, time
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.bind(os.environ['KIRA_CORE_SOCKET'])
sock.listen(2)
while True: time.sleep(.1)
""")
            (bins / "kira-shell").write_text("""#!/usr/bin/env python3
import json, os, time
from pathlib import Path
Path(os.environ['PREVIEW_AUDIT']).write_text(json.dumps({
  'wayland': os.environ.get('WAYLAND_DISPLAY'),
  'core': os.environ.get('KIRA_CORE_SOCKET'),
  'preview': os.environ.get('KIRA_PREVIEW'),
  'ui': os.environ.get('KIRA_UI_DIR'),
  'kira_config': os.environ.get('KIRA_CONFIG_FILE'),
}))
print('kira-shell: diagnostic probe', flush=True)
while True: time.sleep(.1)
""")
            for binary in bins.iterdir():
                binary.chmod(0o755)

            niri = root / "niri"
            niri.write_text("""#!/usr/bin/env python3
import os, shlex, socket, subprocess, sys, time
from pathlib import Path
args = sys.argv[1:]
if args[0] == 'validate': sys.exit(0)
config = Path(args[args.index('--config') + 1])
line = next(line for line in config.read_text().splitlines() if line.startswith('spawn-at-startup '))
command = shlex.split(line[len('spawn-at-startup '):])
path = Path(os.environ['XDG_RUNTIME_DIR']) / 'wayland-mock-nested'
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.bind(str(path)); sock.listen(2)
env = os.environ.copy()
env['WAYLAND_DISPLAY'] = path.name
subprocess.run(command, env=env, check=True)
while True: time.sleep(.1)
""")
            niri.chmod(0o755)

            env = os.environ.copy()
            env.update({
                "XDG_RUNTIME_DIR": str(runtime),
                "WAYLAND_DISPLAY": "wayland-parent",
                "PATH": f"{root}:{env.get('PATH', '')}",
                "PREVIEW_AUDIT": str(output),
            })
            command = [sys.executable, str(SCRIPT)]
            if fast:
                command += ["--bin-dir", str(bins), "--ui-dir", str(ui)]
            if debug:
                command += ["--debug"]
            if not fast:
                command += ["--package-dir", str(root / "result")]
            process = subprocess.Popen(
                command,
                env=env, start_new_session=True,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            try:
                until = time.monotonic() + 8
                while process.poll() is None and not output.exists() and time.monotonic() < until:
                    time.sleep(0.1)
                self.assertTrue(output.exists(), "Shell did not launch in mock nested Niri")
                actual = json.loads(output.read_text())
                self.assertEqual(actual["wayland"], "wayland-mock-nested")
                self.assertEqual(actual["preview"], "1")
                self.assertEqual(actual["ui"], str(ui.resolve()) if fast else None)
                self.assertIn("kira-preview-", actual["core"])
                self.assertIn("kira-preview-", actual["kira_config"])
                self.assertTrue(Path(actual["kira_config"]).is_file())
                self.assertIn("kira {", Path(actual["kira_config"]).read_text())
                self.assertFalse((runtime / "kira-desktop.sock").exists())
            finally:
                if process.poll() is None:
                    process.send_signal(exit_signal)
                stdout, stderr = process.communicate(timeout=8)
                parent.close()
            self.assertEqual(process.returncode, 0, stdout + stderr)
            self.assertIn("Nested display: wayland-mock-nested", stdout)
            self.assertIn("cleaned up", stdout)
            if debug:
                self.assertIn("[preview:shell] kira-shell: diagnostic probe", stderr)


if __name__ == "__main__":
    unittest.main()

