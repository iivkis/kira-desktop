serde_json.workspace = true

FILE	crates/kira-shell/src/calendar.rs
//! One warm WebKit layer-shell host shared by the Svelte Calendar and System.
//! GTK owns one window, trusted IPC and clipboard; Svelte renders both widgets.
use std::cell::{Cell, RefCell};
use std::rc::Rc;
use std::time::{Duration, Instant};

use gtk::prelude::*;
use gtk4_layer_shell::{Edge, KeyboardMode, Layer, LayerShell};
use webkit6::prelude::*;

const TITLE: &str = "Kira Overlay";
const CALENDAR_MARKER: &str = "<html lang=\"en\">";
const CALENDAR_SURFACE: &str = "<html lang=\"en\" data-kira-surface=\"calendar\">";

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum Surface {
    Calendar,
    System,
    Launcher,
}

impl Surface {
    fn name(self) -> &'static str {
        match self {
            Self::Calendar => "calendar",
            Self::System => "system",
            Self::Launcher => "launcher",
        }
    }
}

thread_local! {
    // One GTK/WebKit host, shared by every built-in overlay type.
    static CALENDAR: RefCell<Option<Rc<CalendarOverlay>>> = const { RefCell::new(None) };
}

struct CalendarOverlay {
    window: gtk::ApplicationWindow,
    view: webkit6::WebView,
    document: String,
    host_ready: Cell<bool>,
    widget_ready: Cell<bool>,
    content_height: Cell<i32>,
    active: Cell<Option<Surface>>,
    system: RefCell<Option<crate::system_panel::Model>>,
    launcher: RefCell<Option<crate::launcher::Catalog>>,
    last_metrics: Cell<Option<Instant>>,
    requested: Cell<bool>,
    reposition_pending: Cell<bool>,
    revealed: Cell<bool>,
    paint_pending: Cell<bool>,
    generation: Cell<u32>,
    was_active: Cell<bool>,
    open_started: Cell<Option<Instant>>,
}

impl CalendarOverlay {
    /// The single WebKit layer-shell window has different geometry depending
    /// on the active widget. With no edge anchors, wlr-layer-shell centers
    /// the launcher's fixed-size surface on its output.
    fn position_for(&self, kind: Surface) {
        let centered = kind == Surface::Launcher;

        // Reset margins before removing anchors. Margins only belong to
        // anchored edges, so stale top/right values cannot leak into the
        // centered launcher (or trigger a compositor protocol error).
        self.window.set_margin(Edge::Top, 0);
        self.window.set_margin(Edge::Right, 0);
        self.window.set_margin(Edge::Bottom, 0);
        self.window.set_margin(Edge::Left, 0);
        self.window.set_anchor(Edge::Top, !centered);
        self.window.set_anchor(Edge::Right, !centered);
        self.window.set_anchor(Edge::Bottom, false);
        self.window.set_anchor(Edge::Left, false);

        if centered {
            // Ignore the bar's reserved top zone to center in the entire
            // output, rather than the usable area below the bar.
            self.window.set_exclusive_zone(-1);
        } else {
            // Calendar and System keep their existing top-right placement.
            self.window.set_exclusive_zone(0);
            self.window
                .set_margin(Edge::Top, crate::native_ui::POPUP_TOP_MARGIN);
            self.window.set_margin(Edge::Right, 12);
        }
    }

    fn hide(&self) {
        self.requested.set(false);
        self.reposition_pending.set(false);
        if let Some(model) = self.system.borrow().as_ref() {
            model.set_processes_active(false);
            model.set_pulse_active(false);
        }
        self.active.set(None);
        self.launcher.borrow_mut().take();
        self.widget_ready.set(false);
        self.content_height.set(0);
        self.revealed.set(false);
        self.paint_pending.set(false);
        self.open_started.take();
        // Deliver a generation-scoped hide. WebKit evaluates scripts
        // asynchronously: a stale hide must never unmount a newer show.
        if self.host_ready.get() {
            let generation = self.generation.get();
            let script = format!(
                "window.dispatchEvent(new CustomEvent('kira:overlay:hide', {{ detail: {{ generation: {generation} }} }}));"
            );
            self.view.evaluate_javascript(
                &script,
                None,
                None,
                None::<&gtk::gio::Cancellable>,
                |result| {
                    if let Err(error) = result {
                        eprintln!("kira-shell: Overlay hide delivery failed: {error}");
                    }
                },
            );
        }
        self.window.set_visible(false);
    }

    fn show(self: &Rc<Self>, kind: Surface) {
        // Moving an already mapped layer-shell surface causes Niri to display
        // its previous WebKit buffer for a frame at the NEW coordinates.
        // Unmap first and allow the compositor to process that unmap in a
        // different main-loop iteration before remapping at the new anchors.
        // Switching Calendar <-> System keeps its instant in-place path.
        let relocating = self.window.is_visible()
            && self
                .active
                .get()
                .is_some_and(|old| (old == Surface::Launcher) != (kind == Surface::Launcher));
        let defer_present = relocating || self.reposition_pending.get();
        if relocating {
            // Unmapping can trigger is_active_notify: it must not count as
            // an outside click that closes the *new* popup.
            self.was_active.set(false);
            self.window.set_visible(false);
        }
        self.reposition_pending.set(defer_present);

        if self.active.get() == Some(Surface::System) && kind != Surface::System {
            if let Some(model) = self.system.borrow().as_ref() {
                model.set_processes_active(false);
                model.set_pulse_active(false);
            }
        }
        self.position_for(kind);
        self.active.set(Some(kind));
        // The launcher needs reliable keyboard focus for type-to-search;
        // other popups preserve their former on-demand keyboard behavior.
        self.window.set_keyboard_mode(if kind == Surface::Launcher {
            KeyboardMode::Exclusive
        } else {
            KeyboardMode::OnDemand
        });
        self.requested.set(true);
        self.revealed.set(false);
        self.widget_ready.set(false);
        self.content_height.set(0);
        self.paint_pending.set(false);
        self.was_active.set(false);
        self.open_started.set(Some(Instant::now()));
        self.generation
            .set(self.generation.get().wrapping_add(1).max(1));
        // An unpainted layer-shell surface must never flash grey. GTK4
        // supports fully transparent toplevels on Wayland.
        self.window.set_opacity(0.0);
        // The next widget will report its intrinsic height before reveal.
        // Reset the previous widget's geometry while still transparent.
        crate::native_ui::resize_webview_popup(&self.window, 420, 1);
        let generation = self.generation.get();
        if defer_present {
            // Start replacing the Svelte DOM while the old buffer is NOT
            // mapped. The window is revealed only after the new generation
            // has mounted and painted (or the verified-DOM fallback runs).
            self.request_mount();
            let weak = Rc::downgrade(self);
            gtk::glib::timeout_add_local_once(Duration::from_millis(32), move || {
                if let Some(state) = weak.upgrade()
                    && state.requested.get()
                    && state.generation.get() == generation
                {
                    state.reposition_pending.set(false);
                    state.window.present();
                }
            });
        } else {
            self.window.present();
            self.request_mount();
        }
        eprintln!(
            "kira-shell: Overlay requested: {} generation {} (host ready: {}, reposition: {})",
            kind.name(),
            generation,
            self.host_ready.get(),
            defer_present
        );

        // A dead renderer should not leave an invisible focus-stealing popup.
        let generation = self.generation.get();
        let weak = Rc::downgrade(self);
        gtk::glib::timeout_add_local_once(Duration::from_secs(3), move || {
            if let Some(state) = weak.upgrade() {
                if state.requested.get()
                    && state.generation.get() == generation
                    && !state.revealed.get()
                {
                    eprintln!(
                        "kira-shell: Overlay did not mount within 3s (host ready: {}, widget ready: {}); hiding popup",
                        state.host_ready.get(),
                        state.widget_ready.get()
                    );
                    state.hide();
                }
            }
        });
    }

    fn request_mount(&self) {
        if !self.requested.get() || !self.host_ready.get() {
            return;
        }
        let generation = self.generation.get();
        let Some(kind) = self.active.get() else {
            return;
        };
        // Only hardcoded, trusted Svelte widget types may be selected.
        let kind = kind.name();
        let max_height = crate::native_ui::webview_popup_height_limit(&self.window);
        let script = format!(
            "window.dispatchEvent(new CustomEvent('kira:overlay:show', {{ detail: {{ kind: '{kind}', generation: {generation}, maxHeight: {max_height} }} }}));"
        );
        self.view.evaluate_javascript(
            &script,
            None,
            None,
            None::<&gtk::gio::Cancellable>,
            |result| {
                if let Err(error) = result {
                    eprintln!("kira-shell: Calendar mount delivery failed: {error}");
                }
            },
        );
    }

    fn request_paint(&self) {
        if !self.requested.get()
            || !self.widget_ready.get()
            || self.content_height.get() == 0
            || self.paint_pending.replace(true)
        {
            return;
        }
        let generation = self.generation.get();
        // Two animation frames give WebKit a chance to commit its Svelte
        // content before GTK makes the popup opaque. This script only sends a
        // fixed-purpose acknowledgement to the private calendar channel.
        let script = format!(
            "requestAnimationFrame(() => requestAnimationFrame(() => \
             window.webkit.messageHandlers.kiraCalendarUi.postMessage('painted:{generation}')));"
        );
        self.view.evaluate_javascript(
            &script,
            None,
            None,
            None::<&gtk::gio::Cancellable>,
            |result| {
                if let Err(error) = result {
                    eprintln!("kira-shell: Calendar frame request failed: {error}");
                }
            },
        );
    }
    // Compositors may throttle requestAnimationFrame for a transparent
    // popup. A verified, synchronously flushed Svelte mount must never
    // remain invisible solely because the paint acknowledgement was skipped.
    fn schedule_reveal_fallback(self: &Rc<Self>, generation: u32) {
        let weak = Rc::downgrade(self);
        gtk::glib::timeout_add_local_once(Duration::from_millis(150), move || {
            let Some(state) = weak.upgrade() else {
                return;
            };
            if state.requested.get()
                && state.generation.get() == generation
                && state.widget_ready.get()
                && !state.revealed.get()
            {
                eprintln!(
                    "kira-shell: Overlay frame acknowledgement delayed; revealing verified Svelte DOM"
                );
                state.reveal();
            }
        });
    }

    fn reveal(&self) {
        self.revealed.set(true);
        self.paint_pending.set(false);
        self.window.set_opacity(1.0);
        if let Some(start) = self.open_started.take() {
            eprintln!(
                "kira-shell: Overlay visible after {} ms",
                start.elapsed().as_millis()
            );
        }
    }

    fn on_message(self: &Rc<Self>, message: &str) {
        match calendar_command(message) {
            Some(UiCommand::HostReady) => {
                eprintln!("kira-shell: Shared Svelte overlay host ready");
                self.host_ready.set(true);
                self.request_mount();
            }
            Some(UiCommand::Mounted(generation))
                if self.requested.get() && self.generation.get() == generation =>
            {
                eprintln!("kira-shell: Svelte overlay DOM verified");
                if self.active.get() == Some(Surface::System) {
                    self.send_metrics();
                }
                self.widget_ready.set(true);
                if self.content_height.get() > 0 {
                    self.request_paint();
                    self.schedule_reveal_fallback(generation);
                }
            }
            Some(UiCommand::ContentHeight(generation, height))
                if self.requested.get() && self.generation.get() == generation =>
            {
                // Layout-driven dimensions come only from the bounded,
                // trusted overlay channel. Ignore stale generations and
                // no-op resizes to avoid feedback from ResizeObserver.
                let clamped =
                    height.min(crate::native_ui::webview_popup_height_limit(&self.window));
                if clamped != self.content_height.get() {
                    self.content_height.set(clamped);
                    crate::native_ui::resize_webview_popup(&self.window, 420, clamped);
                }
                if self.widget_ready.get() && !self.paint_pending.get() && !self.revealed.get() {
                    self.request_paint();
                    self.schedule_reveal_fallback(generation);
                }
            }
            Some(UiCommand::Painted(generation))
                if self.requested.get()
                    && self.widget_ready.get()
                    && self.paint_pending.get()
                    && self.generation.get() == generation =>
            {
                self.reveal();
            }
            Some(UiCommand::Close) if self.requested.get() => self.hide(),
            Some(UiCommand::CopyDate(date))
                if self.requested.get()
                    && self.revealed.get()
                    && self.active.get() == Some(Surface::Calendar) =>
            {
                if let Some(display) = gtk::gdk::Display::default() {
                    display.clipboard().set_text(date);
                }
            }
            Some(UiCommand::ProcessesTab(active))
                if self.requested.get() && self.active.get() == Some(Surface::System) =>
            {
                if let Some(model) = self.system.borrow().as_ref() {
                    model.set_processes_active(active);
                    model.set_pulse_active(!active);
                }
            }
            Some(UiCommand::CopyReport)
                if self.requested.get()
                    && self.revealed.get()
                    && self.active.get() == Some(Surface::System) =>
            {
                if let Some(model) = self.system.borrow().as_ref()
                    && let Some(display) = gtk::gdk::Display::default()
                {
                    display.clipboard().set_text(&model.report());
                }
            }
            Some(UiCommand::LauncherCatalog(generation))
                if self.requested.get()
                    && self.active.get() == Some(Surface::Launcher)
                    && self.generation.get() == generation =>
            {
                if self.launcher.borrow().is_none() {
                    // Do not enumerate installed apps on GTK's event loop.
                    match crate::launcher::Catalog::discover() {
                        Ok(catalog) => *self.launcher.borrow_mut() = Some(catalog),
                        Err(error) => self.dispatch_launcher(
                            "kira:launcher:error",
                            serde_json::json!({ "message": error }),
                        ),
                    }
                } else {
                    let ready = self
                        .launcher
                        .borrow()
                        .as_ref()
                        .and_then(|catalog| catalog.ready_json());
                    if let Some(payload) = ready {
                        self.dispatch_launcher("kira:launcher:apps", payload);
                    }
                }
            }
            Some(UiCommand::LauncherIcons(generation, ids))
                if self.requested.get()
                    && self.active.get() == Some(Surface::Launcher)
                    && self.generation.get() == generation =>
            {
                // GTK only looks up themed file paths. A worker reads the
                // icons and encodes bounded image bytes asynchronously.
                let result = self
                    .launcher
                    .borrow()
                    .as_ref()
                    .ok_or_else(|| "Application catalog unavailable".to_string())
                    .and_then(|catalog| catalog.request_icons(&ids));
                if let Err(error) = result {
                    self.dispatch_launcher(
                        "kira:launcher:error",
                        serde_json::json!({ "message": error }),
                    );
                }
            }
            Some(UiCommand::LaunchApp(generation, id))
                if self.requested.get()
                    && self.revealed.get()
                    && self.active.get() == Some(Surface::Launcher)
                    && self.generation.get() == generation =>
            {
                // Launching via GIO can also block (desktop portals/D-Bus).
                // Retain the trusted index and await the worker result.
                let result = self
                    .launcher
                    .borrow()
                    .as_ref()
                    .ok_or_else(|| "Application catalog unavailable".to_string())
                    .and_then(|catalog| catalog.launch(id));
                if let Err(error) = result {
                    self.dispatch_launcher(
                        "kira:launcher:error",
                        serde_json::json!({ "message": error }),
                    );
                }
            }
            _ => eprintln!("kira-shell: ignored invalid/stale Overlay UI command"),
        }
    }

    /// Drain a small number of completed worker operations per GTK frame.
    /// Closing/reopening Launcher drops its worker receiver, so stale results
    /// cannot update a newer overlay generation.
    fn poll_launcher(&self) {
        if !self.requested.get() || self.active.get() != Some(Surface::Launcher) {
            return;
        }
        for _ in 0..4 {
            let message = self
                .launcher
                .borrow_mut()
                .as_mut()
                .and_then(|catalog| catalog.poll());
            let Some(message) = message else {
                break;
            };
            match message {
                crate::launcher::LauncherMessage::Apps(payload) => {
                    self.dispatch_launcher("kira:launcher:apps", payload);
                }
                crate::launcher::LauncherMessage::Icons(payload) => {
                    self.dispatch_launcher("kira:launcher:icons", payload);
                }
                crate::launcher::LauncherMessage::Launched(Ok(())) => self.hide(),
                crate::launcher::LauncherMessage::Launched(Err(error))
                | crate::launcher::LauncherMessage::Error(error) => {
                    self.dispatch_launcher(
                        "kira:launcher:error",
                        serde_json::json!({ "message": error }),
                    );
                }
            }
            if self.active.get() != Some(Surface::Launcher) {
                break;
            }
        }
    }

    fn dispatch_launcher(&self, event: &str, payload: serde_json::Value) {
        if !self.requested.get() || self.active.get() != Some(Surface::Launcher) {
            return;
        }
        // Serialize data twice so installed app names never become JS source.
        if let Ok(serialized) = serde_json::to_string(&payload)
            && let Ok(encoded) = serde_json::to_string(&serialized)
        {
            let script = format!(
                "window.dispatchEvent(new CustomEvent('{event}', {{ detail: JSON.parse({encoded}) }}));"
            );
            self.view.evaluate_javascript(
                &script,
                None,
                None,
                None::<&gtk::gio::Cancellable>,
                |result| {
                    if let Err(error) = result {
                        eprintln!("kira-shell: Launcher catalog delivery failed: {error}");
                    }
                },
            );
        }
    }

    fn dispatch_data(&self, event: &str, payload: serde_json::Value) {
        if !self.requested.get() || self.active.get() != Some(Surface::System) {
            return;
        }
        // Use JSON.parse on a quoted JSON string, never inject untrusted
        // process names as executable JavaScript.
        if let Ok(serialized) = serde_json::to_string(&payload)
            && let Ok(encoded) = serde_json::to_string(&serialized)
        {
            let script = format!(
                "window.dispatchEvent(new CustomEvent('{event}', {{ detail: JSON.parse({encoded}) }}));"
            );
            self.view.evaluate_javascript(
                &script,
                None,
                None,
                None::<&gtk::gio::Cancellable>,
                |result| {
                    if let Err(error) = result {
                        eprintln!("kira-shell: System data delivery failed: {error}");
                    }
                },
            );
        }
    }

    fn poll_pulse(&self) {
        if !self.requested.get() || self.active.get() != Some(Surface::System) {
            return;
        }
        let pulse = self
            .system
            .borrow()
            .as_ref()
            .and_then(|model| model.poll_pulse());
        if let Some(payload) = pulse {
            self.dispatch_data("kira:system:pulse", payload);
        }
    }

    fn send_metrics(&self) {
        let data = self
            .system
            .borrow()
            .as_ref()
            .map(|model| model.metrics_json());
        if let Some(payload) = data {
            self.dispatch_data("kira:system:data", payload);
            self.last_metrics.set(Some(Instant::now()));
        }
    }

    fn tick(&self) {
        if !self.requested.get() || self.active.get() != Some(Surface::System) {
            return;
        }
        if self
            .last_metrics
            .get()
            .is_none_or(|then| then.elapsed() >= Duration::from_secs(2))
        {
            self.send_metrics();
        }
        let process = self
            .system
            .borrow()
            .as_ref()
            .and_then(|model| model.poll_processes());
        if let Some(payload) = process {
            self.dispatch_data("kira:system:processes", payload);
        }
    }
}

#[derive(Debug, PartialEq, Eq)]
enum UiCommand<'a> {
    Close,
    HostReady,
    Mounted(u32),
    Painted(u32),
    ContentHeight(u32, i32),
    CopyDate(&'a str),
    ProcessesTab(bool),
    CopyReport,
    LauncherCatalog(u32),
    LauncherIcons(u32, Vec<usize>),
    LaunchApp(u32, usize),
}

/// Revalidate date-copy requests without duplicating the Svelte date grid.
fn valid_date(year: i32, month: u8, day: u8) -> bool {
    if !(1..=9999).contains(&year) || !(1..=12).contains(&month) {
        return false;
    }
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    let last = match month {
        2 if leap => 29,
        2 => 28,
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    };
    (1..=last).contains(&day)
}

fn calendar_command(message: &str) -> Option<UiCommand<'_>> {
    match message {
        "close" => return Some(UiCommand::Close),
        "host-ready" => return Some(UiCommand::HostReady),
        "tab:processes" => return Some(UiCommand::ProcessesTab(true)),
        "tab:overview" => return Some(UiCommand::ProcessesTab(false)),
        "copy-report" => return Some(UiCommand::CopyReport),
        _ => {}
    }
    if let Some(value) = message.strip_prefix("apps-request:") {
        if value.is_empty() || value.len() > 10 || !value.bytes().all(|b| b.is_ascii_digit()) {
            return None;
        }
        return value
            .parse::<u32>()
            .ok()
            .filter(|v| *v > 0)
            .map(UiCommand::LauncherCatalog);
    }
    if let Some(value) = message.strip_prefix("icons-request:") {
        let (generation, raw_ids) = value.split_once(':')?;
        if generation.is_empty()
            || generation.len() > 10
            || !generation.bytes().all(|b| b.is_ascii_digit())
            || raw_ids.len() > 79
        {
            return None;
        }
        let generation = generation.parse::<u32>().ok().filter(|v| *v > 0)?;
        let parts: Vec<_> = raw_ids.split(',').collect();
        if parts.is_empty() || parts.len() > 16 {
            return None;
        }
        let mut ids = Vec::with_capacity(parts.len());
        for raw in parts {
            if raw.is_empty() || raw.len() > 4 || !raw.bytes().all(|b| b.is_ascii_digit()) {
                return None;
            }
            let id = raw.parse::<usize>().ok().filter(|id| *id < 1024)?;
            if ids.contains(&id) {
                return None;
            }
            ids.push(id);
        }
        return Some(UiCommand::LauncherIcons(generation, ids));
    }
    if let Some(value) = message.strip_prefix("launch:") {
        let (generation, id) = value.split_once(':')?;
        if generation.is_empty()
            || generation.len() > 10
            || !generation.bytes().all(|b| b.is_ascii_digit())
            || id.is_empty()
            || id.len() > 4
            || !id.bytes().all(|b| b.is_ascii_digit())
        {
            return None;
        }
        return Some(UiCommand::LaunchApp(
            generation.parse::<u32>().ok().filter(|v| *v > 0)?,
            id.parse::<usize>().ok().filter(|v| *v < 1024)?,
        ));
    }
    if let Some(value) = message.strip_prefix("mounted:") {
        if value.is_empty() || value.len() > 10 || !value.bytes().all(|b| b.is_ascii_digit()) {
            return None;
        }
        return value.parse().ok().map(UiCommand::Mounted);
    }
    if let Some(value) = message.strip_prefix("size:") {
        let (generation, height) = value.split_once(':')?;
        if generation.is_empty()
            || generation.len() > 10
            || !generation.bytes().all(|b| b.is_ascii_digit())
            || height.is_empty()
            || height.len() > 5
            || !height.bytes().all(|b| b.is_ascii_digit())
        {
            return None;
        }
        return Some(UiCommand::ContentHeight(
            generation.parse::<u32>().ok().filter(|v| *v > 0)?,
            height
                .parse::<i32>()
                .ok()
                .filter(|v| (1..=20_000).contains(v))?,
        ));
    }
    if let Some(value) = message.strip_prefix("painted:") {
        if value.is_empty() || value.len() > 10 || !value.bytes().all(|b| b.is_ascii_digit()) {
            return None;
        }
        return value.parse().ok().map(UiCommand::Painted);
    }
    let date = message.strip_prefix("copy:")?;
    let bytes = date.as_bytes();
    if bytes.len() != 10
        || bytes[4] != b'-'
        || bytes[7] != b'-'
        || !bytes
            .iter()
            .enumerate()
            .all(|(i, b)| i == 4 || i == 7 || b.is_ascii_digit())
    {
        return None;
    }
    let year = date[..4].parse().ok()?;
    let month = date[5..7].parse().ok()?;
    let day = date[8..10].parse().ok()?;
    if !valid_date(year, month, day) {
        return None;
    }
    Some(UiCommand::CopyDate(date))
}

fn calendar_document(html: &str) -> Option<String> {
    html.contains(CALENDAR_MARKER)
        .then(|| html.replacen(CALENDAR_MARKER, CALENDAR_SURFACE, 1))
}

fn build(application: &gtk::Application, document: String) -> Rc<CalendarOverlay> {
    let window = gtk::ApplicationWindow::new(application);
    window.set_title(Some(TITLE));
    window.set_decorated(false);
    window.init_layer_shell();
    window.set_namespace(Some("kira-overlay"));
    window.set_layer(Layer::Overlay);
    window.set_anchor(Edge::Top, true);
    window.set_anchor(Edge::Right, true);
    window.set_margin(Edge::Top, crate::native_ui::POPUP_TOP_MARGIN);
    window.set_margin(Edge::Right, 12);
    window.set_exclusive_zone(0);
    window.set_keyboard_mode(KeyboardMode::OnDemand);
    crate::native_ui::configure_webview_popup(&window, 420, 1);

    // The calendar has no general Core RPC bridge, only its own messages.
    let context = webkit6::WebContext::new();
    let manager = webkit6::UserContentManager::new();
    let view = webkit6::WebView::builder()
        .web_context(&context)
        .user_content_manager(&manager)
        .build();
    view.set_background_color(&gtk::gdk::RGBA::new(0.0, 0.0, 0.0, 1.0));
    crate::native_ui::restrict_webview_navigation(&view);

    let overlay = Rc::new(CalendarOverlay {
        window: window.clone(),
        view: view.clone(),
        document,
        host_ready: Cell::new(false),
        widget_ready: Cell::new(false),
        content_height: Cell::new(0),
        active: Cell::new(None),
        system: RefCell::new(None),
        launcher: RefCell::new(None),
        last_metrics: Cell::new(None),
        requested: Cell::new(false),
        reposition_pending: Cell::new(false),
        revealed: Cell::new(false),
        paint_pending: Cell::new(false),
        generation: Cell::new(0),
        was_active: Cell::new(false),
        open_started: Cell::new(None),
    });
    let weak = Rc::downgrade(&overlay);
    manager.connect_script_message_received(Some("kiraCalendarUi"), move |_, value| {
        if let Some(overlay) = weak.upgrade() {
            overlay.on_message(&value.to_string());
        }
    });
    assert!(manager.register_script_message_handler("kiraCalendarUi", None));

    manager.connect_script_message_received(Some("kiraDiagnostics"), |_, value| {
        eprintln!("kira-shell [calendar]: {}", value.to_string());
    });
    assert!(manager.register_script_message_handler("kiraDiagnostics", None));

    let weak = Rc::downgrade(&overlay);
    view.connect_load_failed(move |_, event, uri, error| {
        eprintln!("kira-shell: Calendar WebKit load failed ({event:?}) for {uri}: {error}");
        if let Some(state) = weak.upgrade() {
            state.host_ready.set(false);
            state.hide();
        }
        false
    });
    let weak = Rc::downgrade(&overlay);
    view.connect_web_process_terminated(move |_, reason| {
        eprintln!("kira-shell: Calendar WebKit renderer terminated: {reason:?}");
        if let Some(state) = weak.upgrade() {
            state.host_ready.set(false);
            state.hide();
            state.view.load_html(&state.document, None);
        }
    });

    let weak = Rc::downgrade(&overlay);
    window.connect_is_active_notify(move |window| {
        if let Some(state) = weak.upgrade() {
            if window.is_active() {
                state.was_active.set(true);
            } else if state.requested.get() && state.was_active.get() {
                state.hide();
            }
        }
    });

    // Load WebKit once; only the lightweight JS host survives between
    // shows. The Calendar component, timer and DOM are unmounted on hide.
    window.set_child(Some(&view));
    view.load_html(&overlay.document, None);
    let weak = Rc::downgrade(&overlay);
    gtk::glib::timeout_add_local(Duration::from_millis(30), move || {
        if let Some(state) = weak.upgrade() {
            state.poll_launcher();
            // Reuse the existing 30ms GTK source for the 500ms CPU/RAM
            // stream. Never schedule WebKit scripts on a worker thread.
            state.poll_pulse();
            gtk::glib::ControlFlow::Continue
        } else {
            gtk::glib::ControlFlow::Break
        }
    });
    let weak = Rc::downgrade(&overlay);
    gtk::glib::timeout_add_local(Duration::from_millis(250), move || {
        if let Some(state) = weak.upgrade() {
            state.tick();
            gtk::glib::ControlFlow::Continue
        } else {
            gtk::glib::ControlFlow::Break
        }
    });
    overlay
}

fn ensure(application: &gtk::Application, html: &str) -> Option<Rc<CalendarOverlay>> {
    CALENDAR.with(|cache| {
        let existing = cache.borrow().clone();
        if existing.is_some() {
            return existing;
        }
        let document = calendar_document(html)?;
        let overlay = build(application, document);
        *cache.borrow_mut() = Some(overlay.clone());
        Some(overlay)
    })
}

/// Start WebKit loading shortly after the bar is activated, not on first click.
pub fn prewarm(application: &gtk::Application, html: &str) {
    if ensure(application, html).is_none() {
        eprintln!("kira-shell: Calendar HTML root not found");
    }
}

pub fn dismiss(_application: &gtk::Application) -> bool {
    CALENDAR.with(|cache| {
        if let Some(state) = cache.borrow().as_ref() {
            if state.requested.get() {
                state.hide();
                return true;
            }
        }
        false
    })
}

pub fn dismiss_system(_application: &gtk::Application) -> bool {
    CALENDAR.with(|cache| {
        if let Some(state) = cache.borrow().as_ref()
            && state.requested.get()
            && state.active.get() == Some(Surface::System)
        {
            state.hide();
            return true;
        }
        false
    })
}

pub fn toggle(application: &gtk::Application, html: &str) {
    let Some(state) = ensure(application, html) else {
        eprintln!("kira-shell: Overlay HTML root not found");
        return;
    };
    if state.requested.get() && state.active.get() == Some(Surface::Calendar) {
        state.hide();
        return;
    }
    state.show(Surface::Calendar);
}

pub fn open_launcher(application: &gtk::Application, html: &str) {
    let Some(state) = ensure(application, html) else {
        eprintln!("kira-shell: Overlay HTML root not found");
        return;
    };
    // Opening the launcher again should focus its existing search field.
    if state.requested.get() && state.active.get() == Some(Surface::Launcher) {
        state.window.present();
        return;
    }
    state.launcher.borrow_mut().take();
    state.show(Surface::Launcher);
}

pub fn toggle_system(
    application: &gtk::Application,
    html: &str,
    metrics: Rc<RefCell<crate::system_metrics::Snapshot>>,
    core: Rc<Cell<bool>>,
    niri: Rc<Cell<bool>>,
) {
    let Some(state) = ensure(application, html) else {
        eprintln!("kira-shell: Overlay HTML root not found");
        return;
    };
    if state.requested.get() && state.active.get() == Some(Surface::System) {
        state.hide();
        return;
    }
    *state.system.borrow_mut() = Some(crate::system_panel::Model::new(metrics, core, niri));
    if let Some(model) = state.system.borrow().as_ref() {
        model.set_pulse_active(true);
    }
    state.last_metrics.set(None);
    state.show(Surface::System);
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn rejects_untrusted_calendar_commands() {
        for invalid in [
            "",
            "COPY",
            "toggle",
            "painted:",
            "painted:2;exit",
            "painted:-1",
            "painted:18446744073709551616",
            "tab:everything",
            "apps-request:",
            "apps-request:abc",
            "icons-request:",
            "icons-request:0:1",
            "icons-request:1:",
            "icons-request:1:1024",
            "icons-request:1:1,,2",
            "icons-request:1:1,1",
            "icons-request:1:1;sh",
            "icons-request:1:1:2",
            "icons-request:4294967296:1",
            "launch:1:1024",
            "launch:1:-1",
            "launch:1:0;sh",
            "launch:18446744073709551616:0",
            "copy:2026-01-01;exit",
            "mounted:",
            "mounted:abc",
            "mounted:4294967296",
            "size:",
            "size:0:100",
            "size:1:0",
            "size:1:20001",
            "size:1:-1",
            "size:1:4;rm",
            "copy:",
            "copy:2026-02-30",
            "copy:1900-02-29",
            "copy:0000-01-01",
            "copy:2026-13-01",
            "copy:2026-11-1",
            "copy:2026-11-01\n",
            "copy:2026-11-01;rm",
            "copy:🔥",
            r#"{"method":"execute_shell"}"#,
        ] {
            assert_eq!(calendar_command(invalid), None, "{invalid:?}");
        }
        assert_eq!(calendar_command("close"), Some(UiCommand::Close));
        assert_eq!(calendar_command("host-ready"), Some(UiCommand::HostReady));
        assert_eq!(
            calendar_command("tab:processes"),
            Some(UiCommand::ProcessesTab(true))
        );
        assert_eq!(
            calendar_command("tab:overview"),
            Some(UiCommand::ProcessesTab(false))
        );
        assert_eq!(calendar_command("copy-report"), Some(UiCommand::CopyReport));
        assert_eq!(
            calendar_command("apps-request:12"),
            Some(UiCommand::LauncherCatalog(12))
        );
        assert_eq!(
            calendar_command("launch:12:42"),
            Some(UiCommand::LaunchApp(12, 42))
        );
        assert_eq!(calendar_command("mounted:42"), Some(UiCommand::Mounted(42)));
        assert_eq!(
            calendar_command("size:42:512"),
            Some(UiCommand::ContentHeight(42, 512))
        );
        assert_eq!(calendar_command("painted:42"), Some(UiCommand::Painted(42)));
        assert_eq!(
            calendar_command("copy:2024-02-29"),
            Some(UiCommand::CopyDate("2024-02-29"))
        );
    }

    #[test]
    fn calendar_uses_trusted_surface_marker_only() {
        assert_eq!(
            calendar_document("<html lang=\"en\"><body></body></html>").as_deref(),
            Some("<html lang=\"en\" data-kira-surface=\"calendar\"><body></body></html>")
        );
        assert!(calendar_document("<html><body></body></html>").is_none());
    }
}

FILE	crates/kira-shell/src/launcher.rs
//! Trusted GIO desktop-app adapter for the Svelte Launcher. No GTK widgets,
//! command strings, executable paths, terminal spawning or Core RPC.
//! GIO application objects stay in one worker; only owned Rust data crosses
//! into the GTK thread. Icon file I/O and base64 encoding never block GTK.
use std::collections::HashMap;
use std::fs::File;
use std::io::Read;
use std::path::{Path, PathBuf};
use std::sync::mpsc::{self, Receiver, Sender};

use gtk::gio;
use gtk::gio::prelude::*;

const MAX_ICON_BYTES: usize = 128 * 1024;
const ICON_BATCH_LIMIT: usize = 16;
const MAX_APPS: usize = 1024;

#[derive(Clone)]
struct AppEntry {
    id: usize,
    name: String,
    description: String,
    // GIcon's standard string serialization, not a Gio object or user input.
    icon: Option<String>,
}

enum WorkerRequest {
    Icons(Vec<(usize, Option<PathBuf>, Option<PathBuf>)>),
    Launch(usize),
}

enum WorkerResponse {
    Apps(Vec<AppEntry>),
    Icons(Vec<(usize, Option<String>)>),
    Launched(Result<(), String>),
}

pub enum LauncherMessage {
    Apps(serde_json::Value),
    Icons(serde_json::Value),
    Launched(Result<(), String>),
    Error(String),
}

/// Catalog is a GTK-thread handle to an isolated GIO worker. The Gio AppInfo
/// objects are created, used, and dropped on that same worker thread because
/// GObject wrappers are not Send.
pub struct Catalog {
    commands: Sender<WorkerRequest>,
    results: Receiver<WorkerResponse>,
    apps: Option<Vec<AppEntry>>,
    disconnected: bool,
}

impl Catalog {
    /// Nonblocking for GTK: enumeration/sorting happen in a dedicated thread.
    pub fn discover() -> Result<Self, String> {
        let (commands, requests) = mpsc::channel();
        let (results_tx, results) = mpsc::channel();
        std::thread::Builder::new()
            .name("kira-launcher".into())
            .spawn(move || run_worker(requests, results_tx))
            .map_err(|error| format!("Cannot start application catalog: {error}"))?;
        Ok(Self {
            commands,
            results,
            apps: None,
            disconnected: false,
        })
    }

    pub fn poll(&mut self) -> Option<LauncherMessage> {
        match self.results.try_recv() {
            Ok(WorkerResponse::Apps(apps)) => {
                self.apps = Some(apps);
                Some(LauncherMessage::Apps(self.as_json()))
            }
            Ok(WorkerResponse::Icons(icons)) => Some(LauncherMessage::Icons(serde_json::json!({
                "icons": icons.into_iter().map(|(id, data_url)| {
                    serde_json::json!({"id": id, "data_url": data_url})
                }).collect::<Vec<_>>()
            }))),
            Ok(WorkerResponse::Launched(result)) => Some(LauncherMessage::Launched(result)),
            Err(mpsc::TryRecvError::Empty) => None,
            Err(mpsc::TryRecvError::Disconnected) if !self.disconnected => {
                self.disconnected = true;
                Some(LauncherMessage::Error(
                    "Application service disconnected".into(),
                ))
            }
            Err(mpsc::TryRecvError::Disconnected) => None,
        }
    }

    fn as_json(&self) -> serde_json::Value {
        let Some(apps) = self.apps.as_ref() else {
            return serde_json::json!({"apps": []});
        };
        serde_json::json!({
            "apps": apps.iter().map(|app| {
                serde_json::json!({
                    "id": app.id,
                    "name": app.name,
                    "description": app.description,
                })
            }).collect::<Vec<_>>()
        })
    }

    pub fn ready_json(&self) -> Option<serde_json::Value> {
        self.apps.as_ref().map(|_| self.as_json())
    }

    /// GTK-owned IconTheme resolves paths, but never reads image data. Actual
    /// file opening, validation, and encoding all happen in run_worker().
    pub fn request_icons(&self, ids: &[usize]) -> Result<(), String> {
        let apps = self.apps.as_ref().ok_or("Application catalog not ready")?;
        let theme =
            gtk::gdk::Display::default().map(|display| gtk::IconTheme::for_display(&display));
        let generic = theme.as_ref().and_then(generic_icon_path);
        let requested = ids
            .iter()
            .take(ICON_BATCH_LIMIT)
            .filter_map(|id| {
                let app = apps.get(*id)?;
                Some((
                    *id,
                    resolve_icon_path(app.icon.as_deref(), theme.as_ref()),
                    generic.clone(),
                ))
            })
            .collect();
        self.commands
            .send(WorkerRequest::Icons(requested))
            .map_err(|_| "Application service unavailable".into())
    }

    /// IDs remain indices into the worker's trusted application snapshot.
    /// Never accept an executable path or command from WebKit.
    pub fn launch(&self, id: usize) -> Result<(), String> {
        if self.apps.as_ref().and_then(|apps| apps.get(id)).is_none() {
            return Err("Unknown application index".into());
        }
        self.commands
            .send(WorkerRequest::Launch(id))
            .map_err(|_| "Application service unavailable".into())
    }
}

fn run_worker(requests: Receiver<WorkerRequest>, results: Sender<WorkerResponse>) {
    // GIO can enumerate apps outside GTK's main loop. Keep every AppInfo on
    // this thread, including the launch call, rather than sending GObjects.
    let mut apps: Vec<_> = gio::AppInfo::all()
        .into_iter()
        .filter(|info| info.should_show())
        .collect();
    apps.sort_by_key(|info| info.display_name().to_string().to_lowercase());
    apps.truncate(MAX_APPS);
    let entries = apps
        .iter()
        .enumerate()
        .map(|(id, info)| AppEntry {
            id,
            name: info
                .display_name()
                .chars()
                .filter(|c| !c.is_control())
                .take(120)
                .collect(),
            description: info
                .description()
                .map(|v| v.to_string())
                .unwrap_or_default()
                .chars()
                .filter(|c| !c.is_control())
                .take(240)
                .collect(),
            icon: info
                .icon()
                .and_then(|icon| icon.to_string().map(|s| s.to_string())),
        })
        .collect();
    if results.send(WorkerResponse::Apps(entries)).is_err() {
        return; // Launcher closed before enumeration completed.
    }

    let mut cache: HashMap<usize, Option<String>> = HashMap::new();
    while let Ok(command) = requests.recv() {
        let reply = match command {
            WorkerRequest::Icons(paths) => {
                let icons = paths
                    .into_iter()
                    .take(ICON_BATCH_LIMIT)
                    .filter(|(id, _, _)| *id < apps.len())
                    .map(|(id, path, fallback)| {
                        let icon = cache
                            .entry(id)
                            .or_insert_with(|| encode_icon(path.as_deref(), fallback.as_deref()))
                            .clone();
                        (id, icon)
                    })
                    .collect();
                WorkerResponse::Icons(icons)
            }
            WorkerRequest::Launch(id) => WorkerResponse::Launched(
                apps.get(id)
                    .ok_or_else(|| "Unknown application index".to_string())
                    .and_then(|info| {
                        info.launch(&[], None::<&gio::AppLaunchContext>)
                            .map_err(|error| {
                                error
                                    .to_string()
                                    .chars()
                                    .filter(|c| !c.is_control())
                                    .take(180)
                                    .collect()
                            })
                    }),
            ),
        };
        if results.send(reply).is_err() {
            break;
        }
    }
}

/// Theme lookup stays with GTK, which owns the display and icon theme. File
/// bytes are not accessed here. Serialized icons originate from trusted GIO.
fn resolve_icon_path(icon: Option<&str>, theme: Option<&gtk::IconTheme>) -> Option<PathBuf> {
    let icon = gio::Icon::for_string(icon?).ok()?;
    if let Some(file_icon) = icon.downcast_ref::<gio::FileIcon>() {
        let file = file_icon.file();
        if file.is_native() {
            return file.path();
        }
    }
    theme?
        .lookup_by_gicon(
            &icon,
            40,
            1,
            gtk::TextDirection::None,
            gtk::IconLookupFlags::empty(),
        )
        .file()
        .and_then(|file| file.is_native().then(|| file.path()).flatten())
}

fn generic_icon_path(theme: &gtk::IconTheme) -> Option<PathBuf> {
    const NAME: &str = "application-x-executable";
    if !theme.has_icon(NAME) {
        return None;
    }
    theme
        .lookup_icon(
            NAME,
            &[],
            40,
            1,
            gtk::TextDirection::None,
            gtk::IconLookupFlags::empty(),
        )
        .file()
        .and_then(|file| file.is_native().then(|| file.path()).flatten())
}

/// Prefer the requested app icon; use the system-theme generic icon if
/// a file is missing, too large or has an invalid signature.
fn encode_icon(primary: Option<&Path>, fallback: Option<&Path>) -> Option<String> {
    primary
        .and_then(file_data_url)
        .or_else(|| fallback.and_then(file_data_url))
}

/// Read only small, signature-checked image files into bounded data URIs.
/// A suffix alone is never sufficient, and even a racing file replacement
/// cannot make the worker read more than MAX_ICON_BYTES + 1 bytes.
fn file_data_url(path: &Path) -> Option<String> {
    let extension = path.extension()?.to_str()?.to_ascii_lowercase();
    let mime = match extension.as_str() {
        "png" => "image/png",
        "svg" => "image/svg+xml",
        "jpg" | "jpeg" => "image/jpeg",
        "webp" => "image/webp",
        _ => return None,
    };
    let metadata = std::fs::metadata(path).ok()?;
    if !metadata.is_file() || metadata.len() == 0 || metadata.len() > MAX_ICON_BYTES as u64 {
        return None;
    }
    let mut content = Vec::with_capacity(metadata.len() as usize);
    File::open(path)
        .ok()?
        .take((MAX_ICON_BYTES + 1) as u64)
        .read_to_end(&mut content)
        .ok()?;
    if content.is_empty() || content.len() > MAX_ICON_BYTES {
        return None;
    }
    let valid = match extension.as_str() {
        "png" => content.starts_with(b"\x89PNG\r\n\x1a\n"),
        "jpg" | "jpeg" => content.starts_with(&[0xff, 0xd8, 0xff]),
        "webp" => content.starts_with(b"RIFF") && content.get(8..12) == Some(b"WEBP".as_slice()),
        "svg" => {
            let prefix = String::from_utf8_lossy(&content[..content.len().min(1024)]);
            prefix.contains("<svg") && !prefix.contains("<!DOCTYPE")
        }
        _ => false,
    };
    valid.then(|| format!("data:{mime};base64,{}", gtk::glib::base64_encode(&content)))
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::io::Write;

    #[test]
    fn out_of_range_id_cannot_launch_arbitrary_programs() {
        let (tx, _rx) = mpsc::channel();
        let (_result_tx, results) = mpsc::channel();
        let catalog = Catalog {
            commands: tx,
            results,
            apps: Some(vec![]),
            disconnected: false,
        };
        assert_eq!(catalog.launch(0), Err("Unknown application index".into()));
        assert_eq!(
            catalog.launch(usize::MAX),
            Err("Unknown application index".into())
        );
        assert_eq!(catalog.as_json(), serde_json::json!({"apps":[]}));
    }

    #[test]
    fn invalid_icon_data_is_rejected_without_launching_anything() {
        let directory = std::env::temp_dir().join(format!(
            "kira-icons-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let fake = directory.join("bad.png");
        std::fs::write(&fake, b"not actually a png").unwrap();
        assert!(file_data_url(&fake).is_none());

        let huge = directory.join("huge.svg");
        let mut file = File::create(&huge).unwrap();
        file.write_all(b"<svg>").unwrap();
        file.write_all(&vec![b'x'; MAX_ICON_BYTES]).unwrap();
        drop(file);
        assert!(file_data_url(&huge).is_none());
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn invalid_app_icon_falls_back_to_valid_generic_icon() {
        let directory = std::env::temp_dir().join(format!(
            "kira-icon-fallback-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let broken = directory.join("broken.png");
        let generic = directory.join("generic.png");
        std::fs::write(&broken, b"not an image").unwrap();
        std::fs::write(&generic, b"\x89PNG\r\n\x1a\nimage").unwrap();
        assert!(
            encode_icon(Some(&broken), Some(&generic))
                .unwrap()
                .starts_with("data:image/png;base64,")
        );
        std::fs::remove_dir_all(directory).unwrap();
    }

    #[test]
    fn small_local_image_is_encoded_as_bounded_data_url() {
        let directory = std::env::temp_dir().join(format!(
            "kira-icon-valid-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        std::fs::create_dir_all(&directory).unwrap();
        let icon = directory.join("valid.png");
        std::fs::write(&icon, b"\x89PNG\r\n\x1a\nimage").unwrap();
        let image = file_data_url(&icon).unwrap();
        assert!(image.starts_with("data:image/png;base64,"));
        assert!(!image.contains(icon.to_str().unwrap()));
        std::fs::remove_dir_all(directory).unwrap();
    }
}

FILE	crates/kira-shell/src/main.rs
//! GTK4/WebKitGTK host and bounded JSON-RPC bridge to the Core daemon.

mod calendar;
mod launcher;
mod native_ui;
mod process_monitor;
mod renderer_recovery;
mod system_metrics;
mod system_panel;
use std::cell::{Cell, RefCell};
use std::env;
use std::path::{Path, PathBuf};
use std::rc::Rc;
use std::sync::mpsc;
use std::time::{Duration, Instant};

use gtk::prelude::*;
use gtk4_layer_shell::{Edge, Layer, LayerShell};
use kira_ipc::{ConfigState, PROTOCOL_VERSION, RpcRequest, RpcResponse, WorkspaceState};
use webkit6::prelude::*;

const BAR_HEIGHT: i32 = 42;
const MAX_BRIDGE_MESSAGE_BYTES: usize = 4096;

/// Only the GTK main loop dispatches JS events; the worker threads contain
/// no GTK/WebKit handles.
enum ShellDelivery {
    Rpc(String),
    Workspaces(WorkspaceState),
    Config(ConfigState),
    CoreAvailability(bool),
    Metrics(system_metrics::Snapshot),
}

fn ui_index() -> PathBuf {
    let directory = env::var_os("KIRA_UI_DIR")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../frontend/dist"));
    directory.join("index.html")
}

// Never allow navigation away from the self-contained UI document.
fn permitted_ui_page(requested_uri: &str) -> bool {
    requested_uri == "about:blank"
}

fn core_socket() -> Option<PathBuf> {
    kira_ipc::core_socket_path().ok()
}

/// Expose read-only Core queries and one explicit, checked focus-workspace action.
fn process_message(message: &str, socket: Option<&Path>) -> RpcResponse {
    let request = match serde_json::from_str::<RpcRequest>(message) {
        Ok(value) => value,
        Err(_) => return RpcResponse::failure(None, -32700, "Invalid JSON-RPC message"),
    };
    if request.jsonrpc != PROTOCOL_VERSION {
        return RpcResponse::failure(Some(request.id), -32600, "Invalid JSON-RPC version");
    }
    if !matches!(
        request.method.as_str(),
        "ping" | "get_state" | "get_workspaces" | "get_config" | "focus_workspace"
    ) {
        return RpcResponse::failure(Some(request.id), -32601, "Method not allowed");
    }
    match socket {
        Some(path) => kira_ipc::client::call(path, &request).unwrap_or_else(|_| {
            RpcResponse::failure(Some(request.id), -32000, "Kira Core unavailable")
        }),
        None => RpcResponse::failure(Some(request.id), -32000, "XDG_RUNTIME_DIR is not set"),
    }
}

fn main() {
    let index = ui_index();
    if !index.is_file() {
        eprintln!(
            "Kira UI assets not found: {}. Run 'task frontend:build' first or set KIRA_UI_DIR.",
            index.display()
        );
        std::process::exit(1);
    }

    // Production assets are inlined into index.html. WebKit loads one
    // self-contained document without external script or stylesheet requests.
    let html = std::fs::read_to_string(&index).unwrap_or_else(|error| {
        eprintln!(
            "kira-shell: failed to read UI HTML {}: {error}",
            index.display()
        );
        std::process::exit(1);
    });

    // A nested preview must not activate another GTK application with the same ID
    // already running in the user's primary desktop session.
    let flags = if env::var_os("KIRA_PREVIEW").is_some() {
        gtk::gio::ApplicationFlags::NON_UNIQUE
    } else {
        gtk::gio::ApplicationFlags::empty()
    };
    let app = gtk::Application::builder()
        .application_id("dev.kira.Desktop")
        .flags(flags)
        .build();
    app.connect_activate(move |app| {
        let window = gtk::ApplicationWindow::new(app);
        window.set_title(Some("Kira Desktop"));
        window.set_decorated(false);
        window.set_default_size(800, BAR_HEIGHT);

        window.init_layer_shell();
        window.set_namespace(Some("kira-desktop"));
        window.set_layer(Layer::Top);
        window.set_anchor(Edge::Top, true);
        window.set_anchor(Edge::Left, true);
        window.set_anchor(Edge::Right, true);
        window.set_exclusive_zone(BAR_HEIGHT);

        // Keep a dedicated context for the locked-down, self-contained UI.
        let context = webkit6::WebContext::new();
        let manager = webkit6::UserContentManager::new();
        let view = webkit6::WebView::builder()
            .web_context(&context)
            .user_content_manager(&manager)
            .build();
        view.set_background_color(&gtk::gdk::RGBA::new(0.0, 0.0, 0.0, 1.0));

        // GTK and WebKit are not Send: socket IO runs on workers, UI updates
        // return to the GTK main loop through this channel.
        let (sender, receiver) = mpsc::channel::<ShellDelivery>();
        let socket = core_socket();
        let latest_metrics = Rc::new(RefCell::new(system_metrics::Snapshot::default()));
        let core_online = Rc::new(Cell::new(false));
        let niri_online = Rc::new(Cell::new(false));

        // Only cheap read-only kernel files are sampled off the GTK thread.
        // The monitor stops when the UI receiver has been dropped.
        let metrics_tx = sender.clone();
        std::thread::spawn(move || {
            let mut sampler = system_metrics::Sampler::default();
            loop {
                if metrics_tx.send(ShellDelivery::Metrics(sampler.sample())).is_err() {
                    break;
                }
                std::thread::sleep(Duration::from_secs(2));
            }
        });

        // One long-lived, read-only Core subscription. Core receives Niri
        // EventStream and immediately forwards changed snapshots to this
        // worker, avoiding the previous 1.5-second Svelte polling lag.
        if let Some(path) = socket.clone() {
            let updates = sender.clone();
            std::thread::spawn(move || {
                loop {
                    let result = kira_ipc::client::subscribe_workspaces(&path, |state| {
                        let _ = updates.send(ShellDelivery::CoreAvailability(true));
                        let _ = updates.send(ShellDelivery::Workspaces(state));
                    });
                    // Never show stale status after a Core stream disconnect.
                    let _ = updates.send(ShellDelivery::CoreAvailability(false));
                    let _ = updates.send(ShellDelivery::Workspaces(WorkspaceState::default()));
                    if let Err(error) = result {
                        eprintln!("kira-shell: Core workspace stream disconnected: {error}");
                    }
                    std::thread::sleep(Duration::from_millis(750));
                }
            });
        }
        // Core owns config validation and last-known-good rollback. A second
        // independent read-only stream forwards updates to the trusted page.
        if let Some(path) = socket.clone() {
            let updates = sender.clone();
            std::thread::spawn(move || {
                loop {
                    let result = kira_ipc::client::subscribe_config(&path, |state| {
                        let _ = updates.send(ShellDelivery::Config(state));
                    });
                    if let Err(error) = result {
                        eprintln!("kira-shell: Core config stream disconnected: {error}");
                    }
                    // Retain the last valid UI settings while Core reconnects.
                    std::thread::sleep(Duration::from_millis(750));
                }
            });
        }
        manager.connect_script_message_received(Some("kira"), move |_, value| {
            let message = value.to_string().to_string();
            let id = serde_json::from_str::<RpcRequest>(&message).ok().map(|r| r.id);
            let sender = sender.clone();
            let socket = socket.clone();
            std::thread::spawn(move || {
                let response = if message.len() > MAX_BRIDGE_MESSAGE_BYTES {
                    RpcResponse::failure(id, -32600, "Bridge message too large")
                } else {
                    process_message(&message, socket.as_deref())
                };
                if let Ok(serialized) = serde_json::to_string(&response) {
                    let _ = sender.send(ShellDelivery::Rpc(serialized));
                }
            });
        });
        assert!(manager.register_script_message_handler("kira", None));
        manager.connect_script_message_received(Some("kiraDiagnostics"), |_, value| {
            eprintln!("kira-shell [ui]: {}", value.to_string());
        });
        assert!(manager.register_script_message_handler("kiraDiagnostics", None));

        // A dedicated fixed-purpose message from the trusted, navigation-locked
        // local UI. Never forward launcher requests to Core or execute JS text.
        let launcher_application = app.clone();
        let launcher_html = html.clone();
        manager.connect_script_message_received(Some("kiraLauncher"), move |_, value| {
            if value.to_string() == "open" {
                calendar::open_launcher(&launcher_application, &launcher_html);
            }
        });
        assert!(manager.register_script_message_handler("kiraLauncher", None));

        // Separate, fixed-purpose UI control. Never interpret arbitrary JS
        // messages or expand the Core JSON-RPC method allowlist.
        let calendar_application = app.clone();
        let calendar_html = html.clone();
        manager.connect_script_message_received(Some("kiraCalendar"), move |_, value| {
            if value.to_string() == "toggle" {
                calendar::toggle(&calendar_application, &calendar_html);
            }
        });
        assert!(manager.register_script_message_handler("kiraCalendar", None));

        // Fixed-purpose system diagnostics toggle. GTK samples the kernel
        // read-only; the page can neither supply metric values nor commands.
        let system_app = app.clone();
        let system_stats = latest_metrics.clone();
        let system_core = core_online.clone();
        let system_niri = niri_online.clone();
        let system_html = html.clone();
        manager.connect_script_message_received(Some("kiraSystem"), move |_, value| {
            if value.to_string() == "toggle" {
                calendar::toggle_system(
                    &system_app,
                    &system_html,
                    system_stats.clone(),
                    system_core.clone(),
                    system_niri.clone(),
                );
            }
        });
        assert!(manager.register_script_message_handler("kiraSystem", None));

        view.connect_load_failed(|_, event, uri, error| {
            eprintln!("kira-shell: WebKit load failed ({event:?}) for {uri}: {error}");
            false
        });
        // The WebKit child can die while the GTK layer-shell window stays
        // alive. Reload the original trusted HTML after a bounded backoff;
        // never recreate the IPC/GTK handlers or silently navigate elsewhere.
        let bar_document = html.clone();
        let recovery = Rc::new(RefCell::new(renderer_recovery::RendererRecovery::default()));
        view.connect_web_process_terminated(move |webview, reason| {
            use renderer_recovery::RetryDecision;
            match recovery.borrow_mut().on_terminated(Instant::now()) {
                RetryDecision::After(delay) => {
                    eprintln!(
                        "kira-shell: Top Bar WebKit renderer terminated ({reason:?}); retrying in {} ms",
                        delay.as_millis()
                    );
                    let weak_view = webview.downgrade();
                    let document = bar_document.clone();
                    let recovery = recovery.clone();
                    gtk::glib::timeout_add_local_once(delay, move || {
                        recovery.borrow_mut().retry_started();
                        if let Some(webview) = weak_view.upgrade()
                            && webview.root().is_some()
                        {
                            webview.load_html(&document, None);
                        }
                    });
                }
                RetryDecision::AlreadyPending => {
                    eprintln!("kira-shell: Top Bar renderer recovery already scheduled");
                }
                RetryDecision::Exhausted => {
                    eprintln!(
                        "kira-shell: Top Bar renderer crashed repeatedly; restart kira-shell to recover"
                    );
                }
            }
        });
        view.connect_load_changed(|webview, event| {
            if event == webkit6::LoadEvent::Finished {
                let webview = webview.clone();
                gtk::glib::timeout_add_local_once(Duration::from_millis(1500), move || {
                    webview.evaluate_javascript(
                        "if (!document.querySelector('main[data-kira-ui-root]')) { throw new Error('Svelte UI did not mount; ' + 'boot=' + JSON.stringify(window.__kiraBoot || {}) + '; readyState=' + document.readyState + '; scripts=' + document.scripts.length); }",
                        None,
                        None,
                        None::<&gtk::gio::Cancellable>,
                        |result| {
                            if let Err(error) = result {
                                eprintln!("kira-shell: UI rendering check failed: {error}");
                            } else {
                                eprintln!("kira-shell: Svelte panel DOM verified");
                            }
                        },
                    );
                });
            }
        });

        let webview = view.clone();
        gtk::glib::timeout_add_local(Duration::from_millis(30), move || {
            while let Ok(delivery) = receiver.try_recv() {
                // Double encoding ensures payload content cannot become JS.
                let (event, payload) = match delivery {
                    ShellDelivery::Rpc(serialized) => ("kira:rpc", serialized),
                    ShellDelivery::Workspaces(state) => {
                        niri_online.set(state.connected);
                        let Ok(serialized) = serde_json::to_string(&state) else {
                            continue;
                        };
                        ("kira:workspaces", serialized)
                    }
                    ShellDelivery::Config(state) => {
                        let Ok(serialized) = serde_json::to_string(&state) else {
                            continue;
                        };
                        ("kira:config", serialized)
                    }
                    ShellDelivery::CoreAvailability(online) => {
                        core_online.set(online);
                        continue;
                    }
                    ShellDelivery::Metrics(mut snapshot) => {
                        // Gio queries the current root filesystem from the GTK
                        // thread, while /proc reads happen off-thread.
                        if let Some((total, available)) = system_panel::disk() {
                            snapshot.root_total_kib = Some(total);
                            snapshot.root_available_kib = Some(available);
                        }
                        *latest_metrics.borrow_mut() = snapshot.clone();
                        ("kira:system-metrics", snapshot.as_json().to_string())
                    }
                };
                if let Ok(encoded) = serde_json::to_string(&payload) {
                    let script = format!(
                        "window.dispatchEvent(new CustomEvent('{event}', {{ detail: JSON.parse({encoded}) }}));"
                    );
                    webview.evaluate_javascript(
                        &script,
                        None,
                        None,
                        None::<&gtk::gio::Cancellable>,
                        |result| {
                            if let Err(error) = result {
                                eprintln!("Kira bridge delivery error: {error}");
                            }
                        },
                    );
                }
            }
            gtk::glib::ControlFlow::Continue
        });

        native_ui::restrict_webview_navigation(&view);
        eprintln!("kira-shell: loading self-contained HTML using WebKit load_html()");
        view.load_html(&html, None);
        window.set_child(Some(&view));
        window.present();

        // Warm the isolated Calendar WebKit process after the Top Bar starts.
        // The popup stays unmapped until requested; initial startup is not
        // blocked by the Calendar's JS initialization.
        let calendar_app = app.clone();
        let calendar_source = html.clone();
        gtk::glib::timeout_add_local_once(Duration::from_millis(200), move || {
            calendar::prewarm(&calendar_app, &calendar_source);
        });
    });
    app.run();
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn rejects_unsupported_method_without_core_connection() {
        let result = process_message(r#"{"jsonrpc":"2.0","id":9,"method":"execute_shell"}"#, None);
        assert_eq!(result.error.unwrap().code, -32601);
    }

    #[test]
    fn allows_read_only_workspace_method_but_reports_missing_core() {
        let result = process_message(
            r#"{"jsonrpc":"2.0","id":7,"method":"get_workspaces"}"#,
            None,
        );
        assert_eq!(result.error.unwrap().code, -32000);
    }

    #[test]
    fn allows_read_only_config_but_rejects_writes() {
        let response = process_message(r#"{"jsonrpc":"2.0","id":8,"method":"get_config"}"#, None);
        assert_eq!(response.error.unwrap().code, -32000);
        let response = process_message(r#"{"jsonrpc":"2.0","id":9,"method":"set_config"}"#, None);
        assert_eq!(response.error.unwrap().code, -32601);
        let response = process_message(
            r#"{"jsonrpc":"2.0","id":10,"method":"subscribe_config"}"#,
            None,
        );
        assert_eq!(response.error.unwrap().code, -32601);
    }

    #[test]
    fn allows_exact_focus_action_only_but_not_generic_niri_actions() {
        let focus = process_message(
            r#"{"jsonrpc":"2.0","id":4,"method":"focus_workspace","params":{"id":"2"}}"#,
            None,
        );
        // Accepted by the bridge, unavailable only because Core is absent.
        assert_eq!(focus.error.unwrap().code, -32000);
        for method in ["niri_action", "move_window", "focus_window", "set_config"] {
            let request = format!(r#"{{"jsonrpc":"2.0","id":5,"method":"{method}"}}"#);
            let result = process_message(&request, None);
            assert_eq!(result.error.unwrap().code, -32601);
        }
    }

    #[test]
    fn navigation_is_restricted_to_exact_ui_document() {
        assert!(permitted_ui_page("about:blank"));
        for uri in [
            "https://evil.example/",
            "kira-ui://app/index.html",
            "file:///etc/passwd",
        ] {
            assert!(!permitted_ui_page(uri));
        }
    }

    #[test]
    fn reports_missing_core() {
        let result = process_message(r#"{"jsonrpc":"2.0","id":3,"method":"ping"}"#, None);
        assert_eq!(result.error.unwrap().code, -32000);
    }
}

FILE	crates/kira-shell/src/native_ui.rs
//! Shared layer-shell/WebKit infrastructure for Svelte overlays.
use gtk::prelude::*;

/// Every WebKit surface renders a self-contained trusted HTML document.
/// Block arbitrary navigation and new windows, including from popup widgets.
pub fn restrict_webview_navigation(view: &webkit6::WebView) {
    use webkit6::prelude::*;
    view.connect_decide_policy(|_, decision, kind| {
        if kind == webkit6::PolicyDecisionType::NewWindowAction {
            decision.ignore();
            return true;
        }
        if kind == webkit6::PolicyDecisionType::NavigationAction {
            let permitted = decision
                .downcast_ref::<webkit6::NavigationPolicyDecision>()
                .and_then(|navigation| navigation.navigation_action())
                .and_then(|action| action.request())
                .and_then(|request| request.uri())
                .is_some_and(|uri| crate::permitted_ui_page(uri.as_str()));
            if !permitted {
                decision.ignore();
                return true;
            }
        }
        false
    });
}

/// WebKit does not expose its HTML's intrinsic height as a GTK size request.
/// The trusted Svelte host measures its natural root height and sends it to
/// GTK, which uses the current *logical output* for the 70% upper bound.
fn output_size(window: &gtk::ApplicationWindow) -> (i32, i32) {
    let display = gtk::prelude::WidgetExt::display(window);
    let monitor = window
        .surface()
        .and_then(|surface| display.monitor_at_surface(&surface))
        .or_else(|| {
            display
                .monitors()
                .item(0)
                .and_then(|item| item.downcast::<gtk::gdk::Monitor>().ok())
        });
    monitor
        .map(|m| (m.geometry().width(), m.geometry().height()))
        .unwrap_or((800, 800))
}

pub fn webview_popup_height_limit(window: &gtk::ApplicationWindow) -> i32 {
    let (_, output_height) = output_size(window);
    (i64::from(output_height.max(1)) * 7 / 10).max(1) as i32
}

/// Window sizing is driven by Svelte's measured root, never by a fixed
/// WebKit default. Do NOT reset size on GTK's map callback: a widget may
/// already have reported its correct height while the surface was hidden.
pub fn resize_webview_popup(
    window: &gtk::ApplicationWindow,
    preferred_width: i32,
    content_height: i32,
) -> i32 {
    let (output_width, _) = output_size(window);
    let width = preferred_width.min(output_width.saturating_sub(24)).max(1);
    let height = content_height.clamp(1, webview_popup_height_limit(window));
    window.set_default_size(width, height);
    height
}

pub fn configure_webview_popup(window: &gtk::ApplicationWindow, width: i32, height: i32) {
    resize_webview_popup(window, width, height);
}

/// The offset below the 42px Top Bar.
pub const POPUP_TOP_MARGIN: i32 = 25;

FILE	crates/kira-shell/src/process_monitor.rs
//! Read-only Linux process accounting for the System Monitor.
//! CPU is shown as percentage of the *entire host*, not one logical core.
//! Sampling and /proc enumeration run only while Processes is the active tab.
use std::collections::HashMap;
use std::fs;
use std::io::{self, Read};
use std::path::Path;

use crate::system_metrics::cpu_ticks;

const MAX_SCANNED: usize = 4096;
// smaps_rollup is more expensive than /proc/status. Refresh a bounded,
// rotating slice of processes each 2-second worker sample.
const MAX_PSS_READS_PER_SAMPLE: usize = 96;
const MAX_SMAPS_ROLLUP_BYTES: u64 = 16 * 1024;

#[derive(Debug, Clone)]
pub struct ProcessRow {
    pub pid: u32,
    pub name: String,
    pub state: char,
    pub cpu_percent: Option<f64>,
    pub rss_kib: Option<u64>,
    pub pss_kib: Option<u64>,
}

#[derive(Debug, Clone)]
pub struct ProcessSnapshot {
    pub rows: Vec<ProcessRow>,
    pub total: usize,
    pub truncated: bool,
}

#[derive(Debug, PartialEq)]
struct Stat {
    name: String,
    state: char,
    ticks: u64,
    start_ticks: u64,
}

/// /proc/[pid]/stat has a parenthesized comm field, potentially containing
/// spaces or parentheses. The final ')' marks its end, not split_whitespace.
fn parse_stat(input: &str) -> Option<Stat> {
    let begin = input.find('(')?;
    let end = input.rfind(')')?;
    if end <= begin {
        return None;
    }
    let name: String = input[begin + 1..end]
        .chars()
        .filter(|c| !c.is_control())
        .take(64)
        .collect();
    let fields: Vec<&str> = input[end + 1..].split_whitespace().collect();
    // After comm, the first field is field 3: state.
    if fields.len() < 20 {
        return None;
    }
    let state = fields[0].chars().next()?;
    let user: u64 = fields[11].parse().ok()?;
    let kernel: u64 = fields[12].parse().ok()?;
    Some(Stat {
        name,
        state,
        ticks: user.checked_add(kernel)?,
        start_ticks: fields[19].parse().ok()?,
    })
}

fn rss_kib(input: &str) -> Option<u64> {
    input.lines().find_map(|line| {
        line.strip_prefix("VmRSS:")?
            .split_whitespace()
            .next()?
            .parse::<u64>()
            .ok()
    })
}

fn parse_pss_kib(text: &str) -> Option<u64> {
    text.lines().find_map(|line| {
        let mut parts = line.strip_prefix("Pss:")?.split_whitespace();
        let value = parts.next()?.parse::<u64>().ok()?;
        (parts.next()? == "kB").then_some(value)
    })
}

fn read_pss_kib(path: &Path) -> Option<u64> {
    let mut text = String::new();
    fs::File::open(path)
        .ok()?
        .take(MAX_SMAPS_ROLLUP_BYTES)
        .read_to_string(&mut text)
        .ok()?;
    parse_pss_kib(&text)
}

fn pss_refresh_indices(total: usize, cursor: usize) -> Vec<usize> {
    if total == 0 {
        return Vec::new();
    }
    (0..total.min(MAX_PSS_READS_PER_SAMPLE))
        .map(|offset| (cursor + offset) % total)
        .collect()
}

fn cpu_percent(prev: Option<u64>, current: u64, total_delta: Option<u64>) -> Option<f64> {
    let delta = current.checked_sub(prev?)?;
    let total = total_delta?;
    if total == 0 || delta > total {
        return None;
    }
    Some(100.0 * delta as f64 / total as f64)
}

/// Identity is (PID, kernel start time) so fast PID reuse cannot inherit
/// another process's past CPU ticks.
#[derive(Default)]
pub struct ProcessSampler {
    previous: HashMap<(u32, u64), u64>,
    previous_total: Option<u64>,
    pss_cache: HashMap<(u32, u64), Option<u64>>,
    pss_cursor: usize,
}

impl ProcessSampler {
    pub fn sample(&mut self) -> io::Result<ProcessSnapshot> {
        let total = cpu_ticks(&fs::read_to_string("/proc/stat")?).map(|x| x.0);
        let total_delta = self
            .previous_total
            .zip(total)
            .and_then(|(before, after)| after.checked_sub(before));
        self.previous_total = total;
        let mut next = HashMap::new();
        let mut collected = Vec::new();
        let mut scanned = 0;
        let mut truncated = false;
        let entries = fs::read_dir("/proc")?;
        for entry in entries.flatten() {
            let Some(pid) = entry
                .file_name()
                .to_str()
                .and_then(|v| v.parse::<u32>().ok())
            else {
                continue;
            };
            if scanned >= MAX_SCANNED {
                truncated = true;
                break;
            }
            scanned += 1;
            let path = entry.path();
            let Some(stat) = read_stat(&path) else {
                // Processes can exit during enumeration or be unreadable.
                continue;
            };
            let identity = (pid, stat.start_ticks);
            let usage = cpu_percent(
                self.previous.get(&identity).copied(),
                stat.ticks,
                total_delta,
            );
            next.insert(identity, stat.ticks);
            let rss = fs::read_to_string(path.join("status"))
                .ok()
                .and_then(|s| rss_kib(&s));
            collected.push((
                ProcessRow {
                    pid,
                    name: stat.name,
                    state: stat.state,
                    cpu_percent: usage,
                    rss_kib: rss,
                    pss_kib: None,
                },
                identity,
                path,
            ));
        }
        // A process is identified by PID plus kernel start ticks. Never
        // transfer stale PSS measurements across a fast PID reuse.
        self.pss_cache
            .retain(|identity, _| next.contains_key(identity));
        collected.sort_by_key(|(row, _, _)| row.pid);
        for index in pss_refresh_indices(collected.len(), self.pss_cursor) {
            let (_, identity, path) = &collected[index];
            let pss = read_pss_kib(&path.join("smaps_rollup"));
            self.pss_cache.insert(*identity, pss);
        }
        if !collected.is_empty() {
            self.pss_cursor =
                (self.pss_cursor + collected.len().min(MAX_PSS_READS_PER_SAMPLE)) % collected.len();
        }
        let rows = collected
            .into_iter()
            .map(|(mut row, identity, _)| {
                row.pss_kib = self.pss_cache.get(&identity).copied().flatten();
                row
            })
            .collect();
        self.previous = next;
        Ok(ProcessSnapshot {
            rows,
            total: scanned,
            truncated,
        })
    }
}

fn read_stat(path: &Path) -> Option<Stat> {
    parse_stat(&fs::read_to_string(path.join("stat")).ok()?)
}

#[cfg(test)]
mod tests {
    use super::*;

    fn stat_line(name: &str, utime: u64, stime: u64, start: u64) -> String {
        let mut fields = vec!["0".to_string(); 20];
        fields[0] = "S".into();
        fields[11] = utime.to_string();
        fields[12] = stime.to_string();
        fields[19] = start.to_string();
        format!("42 ({name}) {}", fields.join(" "))
    }

    #[test]
    fn parse_process_names_with_spaces_and_parentheses() {
        let record = parse_stat(&stat_line("renderer (worker) extra)", 20, 5, 902)).unwrap();
        assert_eq!(record.name, "renderer (worker) extra)");
        assert_eq!(record.state, 'S');
        assert_eq!(record.ticks, 25);
        assert_eq!(record.start_ticks, 902);
        assert_eq!(parse_stat("42 (truncated"), None);
    }

    #[test]
    fn cpu_is_delta_of_total_host_and_never_invented_on_first_sample() {
        assert_eq!(cpu_percent(None, 120, Some(100)), None);
        assert_eq!(cpu_percent(Some(100), 150, Some(500)), Some(10.0));
        assert_eq!(cpu_percent(Some(200), 150, Some(500)), None);
        assert_eq!(cpu_percent(Some(100), 150, Some(0)), None);
        assert_eq!(cpu_percent(Some(100), 200, Some(50)), None);
    }

    #[test]
    fn rss_and_pid_identity_work_without_cmdline_access() {
        assert_eq!(rss_kib("Name:\ttest\nVmRSS:\t2048 kB\n"), Some(2048));
        assert_eq!(rss_kib("Name:\ttest\n"), None);
        let mut sampler = ProcessSampler::default();
        sampler.previous.insert((42, 111), 200);
        assert_eq!(sampler.previous.get(&(42, 222)), None);
    }

    #[test]
    fn pss_is_parsed_only_from_exact_rollup_field() {
        assert_eq!(
            parse_pss_kib("Rss: 8000 kB\nPss: 1234 kB\nPss_Anon: 100 kB\n"),
            Some(1234)
        );
        assert_eq!(parse_pss_kib("Pss_Anon: 600 kB\n"), None);
        assert_eq!(parse_pss_kib("Pss: -1 kB\n"), None);
        assert_eq!(parse_pss_kib("Pss: 111 KiB\n"), None);
        assert_eq!(parse_pss_kib("Pss: 0 kB\n"), Some(0));
    }

    #[test]
    fn pss_scanning_is_bounded_and_fair() {
        assert!(pss_refresh_indices(0, 0).is_empty());
        assert_eq!(pss_refresh_indices(3, 0), vec![0, 1, 2]);
        let first = pss_refresh_indices(101, 0);
        let second = pss_refresh_indices(101, first.len());
        assert_eq!(first.len(), MAX_PSS_READS_PER_SAMPLE);
        assert!(second.contains(&96));
        assert!(second.contains(&100));
        assert!(second.contains(&0));
    }

    #[test]
    fn malformed_stats_are_discarded() {
        assert_eq!(parse_stat(""), None);
        assert_eq!(parse_stat("42 () S x"), None);
        assert_eq!(parse_stat(&stat_line("test", u64::MAX, 1, 9)), None);
    }
}

FILE	crates/kira-shell/src/renderer_recovery.rs
//! Bounded Top Bar WebKit renderer recovery policy, independent of GTK.
//! Retrying immediately in the termination signal risks a crash/reload loop.

use std::time::{Duration, Instant};

const MAX_CONSECUTIVE_CRASHES: u8 = 5;
const RESET_AFTER: Duration = Duration::from_secs(60);
const FIRST_RETRY_MS: u64 = 250;

#[derive(Debug, PartialEq, Eq)]
pub enum RetryDecision {
    After(Duration),
    AlreadyPending,
    Exhausted,
}

#[derive(Default)]
pub struct RendererRecovery {
    crashes: u8,
    last_crash: Option<Instant>,
    pending: bool,
}

impl RendererRecovery {
    /// Retry at most five times (250ms, 500ms, 1s, 2s, 4s).
    /// A process that stayed alive for 60 seconds gets a fresh retry budget.
    pub fn on_terminated(&mut self, now: Instant) -> RetryDecision {
        if self.pending {
            return RetryDecision::AlreadyPending;
        }
        if self
            .last_crash
            .is_none_or(|last| now.saturating_duration_since(last) >= RESET_AFTER)
        {
            self.crashes = 0;
        }
        self.last_crash = Some(now);
        if self.crashes == MAX_CONSECUTIVE_CRASHES {
            return RetryDecision::Exhausted;
        }
        let delay = Duration::from_millis(FIRST_RETRY_MS << self.crashes);
        self.crashes += 1;
        self.pending = true;
        RetryDecision::After(delay)
    }

    /// Called when the GTK timer fires, immediately before a new load_html().
    pub fn retry_started(&mut self) {
        self.pending = false;
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn retries_are_bounded_and_exponential() {
        let mut recovery = RendererRecovery::default();
        let start = Instant::now();
        for (index, millis) in [250, 500, 1000, 2000, 4000].into_iter().enumerate() {
            let now = start + Duration::from_secs(index as u64);
            assert_eq!(
                recovery.on_terminated(now),
                RetryDecision::After(Duration::from_millis(millis))
            );
            assert_eq!(
                recovery.on_terminated(now),
                RetryDecision::AlreadyPending,
                "Only one restart timer is allowed per crash"
            );
            recovery.retry_started();
        }
        assert_eq!(
            recovery.on_terminated(start + Duration::from_secs(5)),
            RetryDecision::Exhausted
        );
    }

    #[test]
    fn a_stable_renderer_restores_retry_budget() {
        let mut recovery = RendererRecovery::default();
        let start = Instant::now();
        assert_eq!(
            recovery.on_terminated(start),
            RetryDecision::After(Duration::from_millis(250))
        );
        recovery.retry_started();
        assert_eq!(
            recovery.on_terminated(start + Duration::from_secs(1)),
            RetryDecision::After(Duration::from_millis(500))
        );
        recovery.retry_started();
        assert_eq!(
            recovery.on_terminated(start + Duration::from_secs(61)),
            RetryDecision::After(Duration::from_millis(250))
        );
    }

    #[test]
    fn retry_budget_does_not_reset_during_crash_loop() {
        let mut recovery = RendererRecovery::default();
        let start = Instant::now();
        for second in 0..5 {
            assert!(matches!(
                recovery.on_terminated(start + Duration::from_secs(second)),
                RetryDecision::After(_)
            ));
            recovery.retry_started();
        }
        assert_eq!(
            recovery.on_terminated(start + Duration::from_secs(59)),
            RetryDecision::Exhausted
        );
    }
}

FILE	crates/kira-shell/src/system_metrics.rs
//! Read-only Linux system telemetry. No external commands, privileged APIs or
//! additional dependencies. Optional fields are absent when the kernel does
//! not provide a metric; lack of data must never be displayed as zero.
use std::fs;
use std::path::{Path, PathBuf};
use std::time::Duration;

/// Actual CPU/RAM samples, not 500ms interpolation of two-second readings.
pub const PULSE_INTERVAL: Duration = Duration::from_millis(500);

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Pulse {
    pub cpu_percent: Option<u8>,
    pub memory_total_kib: Option<u64>,
    pub memory_available_kib: Option<u64>,
}

impl Pulse {
    pub fn as_json(&self) -> serde_json::Value {
        serde_json::json!({
            "cpu_percent": self.cpu_percent,
            "memory_total_kib": self.memory_total_kib,
            "memory_available_kib": self.memory_available_kib,
        })
    }
}

/// Short-lived, read-only worker sampler. Avoids all sysfs/hwmon, disk,
/// battery, GPU enumeration, and process scans at the 500ms pulse cadence.
#[derive(Default)]
pub struct PulseSampler {
    previous_cpu: Option<(u64, u64)>,
}

impl PulseSampler {
    pub fn sample(&mut self) -> Pulse {
        self.sample_from(Path::new("/proc/stat"), Path::new("/proc/meminfo"))
    }

    fn sample_from(&mut self, cpu_path: &Path, memory_path: &Path) -> Pulse {
        let cpu_percent = fs::read_to_string(cpu_path)
            .ok()
            .and_then(|text| cpu_ticks(&text))
            .and_then(|next| {
                let value = self.previous_cpu.and_then(|prev| cpu_usage(prev, next));
                self.previous_cpu = Some(next);
                Some(value)
            })
            .flatten();
        let mut snapshot = Snapshot::default();
        if let Ok(text) = fs::read_to_string(memory_path) {
            parse_memory(&text, &mut snapshot);
        }
        Pulse {
            cpu_percent,
            memory_total_kib: snapshot.memory_total_kib,
            memory_available_kib: snapshot.memory_available_kib,
        }
    }
}

#[derive(Debug, Clone)]
pub struct GpuSnapshot {
    pub label: String,
    pub utilization_percent: Option<u8>,
    pub temperature_c: Option<f64>,
}

#[derive(Debug, Clone, Default)]
pub struct Snapshot {
    pub cpu_percent: Option<u8>,
    pub cpu_temperature_c: Option<f64>,
    pub gpus: Vec<GpuSnapshot>,
    pub memory_total_kib: Option<u64>,
    pub memory_available_kib: Option<u64>,
    pub swap_total_kib: Option<u64>,
    pub swap_free_kib: Option<u64>,
    pub uptime_seconds: Option<u64>,
    pub load: Option<[f64; 3]>,
    pub battery_percent: Option<u8>,
    pub battery_charging: Option<bool>,
    pub root_total_kib: Option<u64>,
    pub root_available_kib: Option<u64>,
}

impl Snapshot {
    pub fn as_json(&self) -> serde_json::Value {
        serde_json::json!({
            "cpu_percent": self.cpu_percent,
            "cpu_temperature_c": self.cpu_temperature_c,
            "gpus": self.gpus.iter().map(|gpu| serde_json::json!({
                "label": gpu.label,
                "utilization_percent": gpu.utilization_percent,
                "temperature_c": gpu.temperature_c,
            })).collect::<Vec<_>>(),
            "memory_total_kib": self.memory_total_kib,
            "memory_available_kib": self.memory_available_kib,
            "swap_total_kib": self.swap_total_kib,
            "swap_free_kib": self.swap_free_kib,
            "uptime_seconds": self.uptime_seconds,
            "load": self.load,
            "battery_percent": self.battery_percent,
            "battery_charging": self.battery_charging,
            "root_total_kib": self.root_total_kib,
            "root_available_kib": self.root_available_kib,
        })
    }

    pub fn memory_percent(&self) -> Option<u8> {
        percent_used(self.memory_total_kib?, self.memory_available_kib?)
    }
}

pub fn percent_used(total: u64, available: u64) -> Option<u8> {
    if total == 0 || available > total {
        return None;
    }
    let used = total - available;
    Some(((u128::from(used) * 100 / u128::from(total)).min(100)) as u8)
}

fn mem_value(text: &str, key: &str) -> Option<u64> {
    let line = text
        .lines()
        .find(|line| line.starts_with(key) && line.as_bytes().get(key.len()) == Some(&b':'))?;
    line.split_whitespace().nth(1)?.parse().ok()
}

fn parse_memory(text: &str, snapshot: &mut Snapshot) {
    snapshot.memory_total_kib = mem_value(text, "MemTotal");
    snapshot.memory_available_kib = mem_value(text, "MemAvailable");
    snapshot.swap_total_kib = mem_value(text, "SwapTotal");
    snapshot.swap_free_kib = mem_value(text, "SwapFree");
}

pub(crate) fn cpu_ticks(text: &str) -> Option<(u64, u64)> {
    let line = text.lines().next()?;
    let mut tokens = line.split_whitespace();
    if tokens.next()? != "cpu" {
        return None;
    }
    let ticks = tokens
        .map(str::parse::<u64>)
        .collect::<Result<Vec<_>, _>>()
        .ok()?;
    if ticks.len() < 4 {
        return None;
    }
    let total = ticks.iter().copied().sum::<u64>();
    let idle = ticks[3].checked_add(*ticks.get(4).unwrap_or(&0))?;
    Some((total, idle))
}

fn cpu_usage(previous: (u64, u64), next: (u64, u64)) -> Option<u8> {
    let total = next.0.checked_sub(previous.0)?;
    let idle = next.1.checked_sub(previous.1)?;
    if total == 0 || idle > total {
        return None;
    }
    Some(
        (((total - idle) as f64 / total as f64) * 100.0)
            .round()
            .clamp(0.0, 100.0) as u8,
    )
}

fn parse_load(text: &str) -> Option<[f64; 3]> {
    let mut words = text.split_whitespace();
    let vals = [
        words.next()?.parse::<f64>().ok()?,
        words.next()?.parse::<f64>().ok()?,
        words.next()?.parse::<f64>().ok()?,
    ];
    vals.iter()
        .all(|v| v.is_finite() && *v >= 0.0)
        .then_some(vals)
}

fn battery() -> (Option<u8>, Option<bool>) {
    let Ok(entries) = fs::read_dir("/sys/class/power_supply") else {
        return (None, None);
    };
    for entry in entries.flatten() {
        let path = entry.path();
        let kind = fs::read_to_string(path.join("type")).unwrap_or_default();
        if kind.trim() != "Battery" {
            continue;
        }
        let percentage = fs::read_to_string(path.join("capacity"))
            .ok()
            .and_then(|s| s.trim().parse::<u8>().ok())
            .filter(|v| *v <= 100);
        let charging = fs::read_to_string(path.join("status"))
            .ok()
            .and_then(|status| match status.trim() {
                "Charging" | "Full" => Some(true),
                "Not charging" => None,
                "Discharging" => Some(false),
                _ => None,
            });
        return (percentage, charging);
    }
    (None, None)
}

// sysfs is kernel-provided; optional sensors must never become zero by default.
// GPU utilization is driver-dependent (e.g. AMD gpu_busy_percent).
const MAX_GPUS: usize = 8;
const MAX_HWMON_SENSORS: usize = 32;

fn read_small(path: &Path) -> Option<String> {
    use std::io::Read;
    let mut bytes = Vec::new();
    fs::File::open(path)
        .ok()?
        .take(4096)
        .read_to_end(&mut bytes)
        .ok()?;
    String::from_utf8(bytes).ok()
}

fn temperature_c(text: &str) -> Option<f64> {
    let millidegrees = text.trim().parse::<i64>().ok()?;
    (-40_000..=150_000)
        .contains(&millidegrees)
        .then_some(millidegrees as f64 / 1000.0)
}

fn utilization(text: &str) -> Option<u8> {
    text.trim().parse::<u8>().ok().filter(|p| *p <= 100)
}

fn hwmon_temperature(root: &Path, cpu: bool) -> Option<f64> {
    let entries = fs::read_dir(root).ok()?;
    for directory in entries.flatten() {
        if directory.file_name().to_string_lossy().starts_with("hwmon")
            && let Some(value) = hwmon_temperature_for_device(&directory.path(), cpu)
        {
            return Some(value);
        }
    }
    None
}

fn hwmon_temperature_for_device(path: &Path, cpu: bool) -> Option<f64> {
    let mut sensors: Vec<(u8, f64)> = Vec::new();
    for index in 1..=MAX_HWMON_SENSORS {
        let input = path.join(format!("temp{index}_input"));
        let Some(value) = read_small(&input).and_then(|text| temperature_c(&text)) else {
            continue;
        };
        let label = read_small(&path.join(format!("temp{index}_label")))
            .unwrap_or_default()
            .trim()
            .to_ascii_lowercase();
        // CPU: prefer package/die readings. GPU: prefer the edge sensor
        // over hotspot/junction/VRAM readings on multi-sensor cards.
        let priority = if cpu {
            if label.starts_with("package") || label == "tdie" || label == "cpu" {
                0
            } else if label == "tctl" || label.starts_with("core ") {
                1
            } else {
                2
            }
        } else if label == "edge" || label == "gpu" {
            0
        } else if label.contains("junction") || label.contains("hotspot") {
            1
        } else if label.contains("mem") {
            3
        } else {
            2
        };
        sensors.push((priority, value));
    }
    sensors.sort_by_key(|sensor| sensor.0);
    sensors.first().map(|sensor| sensor.1)
}

fn cpu_temperature(sys: &Path) -> Option<f64> {
    if let Ok(entries) = fs::read_dir(sys.join("class/hwmon")) {
        for entry in entries.flatten() {
            let path = entry.path();
            let Some(name) = read_small(&path.join("name")) else {
                continue;
            };
            if matches!(
                name.trim(),
                "coretemp" | "k10temp" | "zenpower" | "cpu_thermal" | "cpu-thermal"
            ) && let Some(temp) = hwmon_temperature_for_device(&path, true)
            {
                return Some(temp);
            }
        }
    }
    // Names of thermal zones matter. A generic ACPI/SoC temperature should
    // not be mislabeled as CPU package temperature.
    let zones = fs::read_dir(sys.join("class/thermal")).ok()?;
    for entry in zones.flatten() {
        if !entry
            .file_name()
            .to_string_lossy()
            .starts_with("thermal_zone")
        {
            continue;
        }
        let path = entry.path();
        let name = read_small(&path.join("type")).unwrap_or_default();
        if matches!(name.trim(), "x86_pkg_temp" | "cpu-thermal" | "cpu_thermal")
            && let Some(temp) = read_small(&path.join("temp")).and_then(|s| temperature_c(&s))
        {
            return Some(temp);
        }
    }
    None
}

fn gpu_label(card: &str, vendor: &str, uevent: &str) -> String {
    let manufacturer = match vendor.trim() {
        "0x8086" => "Intel",
        "0x1002" => "AMD",
        "0x10de" => "NVIDIA",
        "0x1af4" => "Virtio",
        _ => "Unknown",
    };
    // PCI 00:02.0 is the standard integrated Intel graphics device.
    // For other GPUs do not guess integrated vs discrete from vendor.
    let integrated = vendor.trim() == "0x8086"
        && uevent
            .lines()
            .any(|line| line == "PCI_SLOT_NAME=0000:00:02.0");
    let kind = if integrated { "iGPU" } else { "GPU" };
    format!("{kind} / {manufacturer} ({card})")
}

fn sample_gpus(sys: &Path) -> Vec<GpuSnapshot> {
    let Ok(entries) = fs::read_dir(sys.join("class/drm")) else {
        return Vec::new();
    };
    let mut cards: Vec<(String, PathBuf)> = entries
        .flatten()
        .filter_map(|entry| {
            let name = entry.file_name().to_str()?.to_owned();
            name.strip_prefix("card")?.parse::<u8>().ok()?;
            let device = entry.path().join("device");
            device.exists().then_some((name, device))
        })
        .collect();
    cards.sort_by(|a, b| a.0.cmp(&b.0));
    cards
        .into_iter()
        .take(MAX_GPUS)
        .map(|(card, device)| {
            let vendor = read_small(&device.join("vendor")).unwrap_or_default();
            let uevent = read_small(&device.join("uevent")).unwrap_or_default();
            let utilization_percent = [
                device.join("gpu_busy_percent"),
                device.join("gt_busy_percent"),
                device.join("gt/gt0/gt_busy_percent"),
            ]
            .iter()
            .find_map(|path| read_small(path).and_then(|s| utilization(&s)));
            GpuSnapshot {
                label: gpu_label(&card, &vendor, &uevent),
                utilization_percent,
                temperature_c: hwmon_temperature(&device.join("hwmon"), false),
            }
        })
        .collect()
}

#[derive(Default)]
pub struct Sampler {
    previous_cpu: Option<(u64, u64)>,
}

impl Sampler {
    pub fn sample(&mut self) -> Snapshot {
        let mut s = Snapshot::default();
        if let Ok(text) = fs::read_to_string("/proc/stat")
            && let Some(next) = cpu_ticks(&text)
        {
            s.cpu_percent = self.previous_cpu.and_then(|prev| cpu_usage(prev, next));
            self.previous_cpu = Some(next);
        }
        if let Ok(text) = fs::read_to_string("/proc/meminfo") {
            parse_memory(&text, &mut s);
        }
        if let Ok(text) = fs::read_to_string("/proc/loadavg") {
            s.load = parse_load(&text);
        }
        if let Ok(text) = fs::read_to_string("/proc/uptime") {
            s.uptime_seconds = text
                .split_whitespace()
                .next()
                .and_then(|value| value.parse::<f64>().ok())
                .filter(|v| v.is_finite() && *v >= 0.0)
                .map(|v| Duration::from_secs_f64(v).as_secs());
        }
        (s.battery_percent, s.battery_charging) = battery();
        s.cpu_temperature_c = cpu_temperature(Path::new("/sys"));
        s.gpus = sample_gpus(Path::new("/sys"));
        s
    }
}

pub fn bytes_label(kib: u64) -> String {
    let gib = kib as f64 / 1_048_576.0;
    if gib >= 1.0 {
        format!("{gib:.1} GiB")
    } else {
        format!("{:.0} MiB", kib as f64 / 1024.0)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn memory_ratio_is_bounded_and_not_fabricated() {
        assert_eq!(percent_used(1000, 90), Some(91));
        assert_eq!(percent_used(0, 0), None);
        assert_eq!(percent_used(100, 101), None);
        let mut s = Snapshot::default();
        parse_memory(
            "MemTotal: 16384 kB\nMemAvailable: 4096 kB\nSwapTotal: 1024 kB\nSwapFree: 512 kB\n",
            &mut s,
        );
        assert_eq!(s.memory_percent(), Some(75));
        assert_eq!(s.swap_free_kib, Some(512));
    }

    #[test]
    fn cpu_uses_differences_not_lifetime_average() {
        assert_eq!(cpu_ticks("cpu  10 10 10 70 0 0 0 0\n"), Some((100, 70)));
        assert_eq!(cpu_usage((100, 70), (200, 130)), Some(40));
        assert_eq!(cpu_usage((100, 70), (100, 70)), None);
        assert_eq!(cpu_usage((100, 70), (90, 60)), None);
    }

    #[test]
    fn pulse_reads_real_cpu_deltas_and_memory_without_sysfs() {
        let dir = std::env::temp_dir().join(format!(
            "kira-pulse-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        fs::create_dir_all(&dir).unwrap();
        let stat = dir.join("stat");
        let memory = dir.join("meminfo");
        fs::write(&stat, "cpu 10 10 10 70 0 0 0 0\n").unwrap();
        fs::write(&memory, "MemTotal: 8000 kB\nMemAvailable: 6000 kB\n").unwrap();
        let mut sampler = PulseSampler::default();
        let first = sampler.sample_from(&stat, &memory);
        assert_eq!(first.cpu_percent, None); // First sample has no CPU baseline.
        assert_eq!(first.memory_total_kib, Some(8000));
        assert_eq!(first.memory_available_kib, Some(6000));
        fs::write(&stat, "cpu 20 20 20 140 0 0 0 0\n").unwrap();
        let next = sampler.sample_from(&stat, &memory);
        assert_eq!(next.cpu_percent, Some(30));
        assert_eq!(next.as_json()["cpu_percent"], 30);
        // Unreadable values stay unknown; zero is not fabricated.
        fs::write(&stat, "malformed").unwrap();
        fs::remove_file(&memory).unwrap();
        let missing = sampler.sample_from(&stat, &memory);
        assert_eq!(missing.cpu_percent, None);
        assert_eq!(missing.memory_total_kib, None);
        fs::remove_dir_all(dir).unwrap();
    }

    #[test]
    fn pulse_interval_is_100ms_and_only_exports_cpu_and_memory() {
        assert_eq!(PULSE_INTERVAL, Duration::from_millis(500));
        let pulse = Pulse {
            cpu_percent: Some(0),
            memory_total_kib: Some(1024),
            memory_available_kib: Some(1024),
        };
        let value = pulse.as_json();
        assert_eq!(value["cpu_percent"], 0);
        assert!(value.get("gpus").is_none());
        assert!(value.get("swap_total_kib").is_none());
    }

    #[test]
    fn sensor_parsers_reject_invalid_or_missing_measurements() {
        assert_eq!(temperature_c("50250\n"), Some(50.25));
        assert_eq!(temperature_c("151000"), None);
        assert_eq!(temperature_c("n/a"), None);
        assert_eq!(utilization("83\n"), Some(83));
        assert_eq!(utilization("101"), None);
        assert_eq!(utilization("-1"), None);
        assert_eq!(
            gpu_label("card0", "0x8086", "PCI_SLOT_NAME=0000:00:02.0\n"),
            "iGPU / Intel (card0)"
        );
        assert_eq!(
            gpu_label("card1", "0x1002", "PCI_SLOT_NAME=0000:03:00.0\n"),
            "GPU / AMD (card1)"
        );
    }

    #[test]
    fn cpu_thermal_zone_is_used_without_hwmon() {
        let root = std::env::temp_dir().join(format!(
            "kira-cpu-thermal-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        let zone = root.join("class/thermal/thermal_zone0");
        fs::create_dir_all(&zone).unwrap();
        fs::write(zone.join("type"), "x86_pkg_temp\n").unwrap();
        fs::write(zone.join("temp"), "48250\n").unwrap();
        assert_eq!(cpu_temperature(&root), Some(48.25));
        fs::remove_dir_all(root).unwrap();
    }

    #[test]
    fn gpu_and_cpu_sensors_are_optional_and_device_scoped() {
        let root = std::env::temp_dir().join(format!(
            "kira-sys-hwmon-{}-{:?}",
            std::process::id(),
            std::thread::current().id()
        ));
        let hwmon = root.join("class/hwmon/hwmon0");
        let gpu = root.join("class/drm/card1/device");
        fs::create_dir_all(&hwmon).unwrap();
        fs::create_dir_all(gpu.join("hwmon/hwmon2")).unwrap();
        fs::write(hwmon.join("name"), "k10temp\n").unwrap();
        fs::write(hwmon.join("temp1_label"), "Tctl\n").unwrap();
        fs::write(hwmon.join("temp1_input"), "61125\n").unwrap();
        fs::write(gpu.join("vendor"), "0x1002\n").unwrap();
        fs::write(gpu.join("gpu_busy_percent"), "47\n").unwrap();
        fs::write(gpu.join("hwmon/hwmon2/temp1_label"), "edge\n").unwrap();
        fs::write(gpu.join("hwmon/hwmon2/temp1_input"), "55375\n").unwrap();
        fs::write(gpu.join("hwmon/hwmon2/temp2_label"), "junction\n").unwrap();
        fs::write(gpu.join("hwmon/hwmon2/temp2_input"), "79900\n").unwrap();
        assert_eq!(cpu_temperature(&root), Some(61.125));
        let cards = sample_gpus(&root);
        assert_eq!(cards.len(), 1);
        assert_eq!(cards[0].label, "GPU / AMD (card1)");
        assert_eq!(cards[0].utilization_percent, Some(47));
        assert_eq!(cards[0].temperature_c, Some(55.375));
        fs::remove_dir_all(&root).unwrap();
    }

    #[test]
    fn unavailable_or_malformed_data_is_unknown() {
        assert_eq!(parse_load("bad data"), None);
        assert_eq!(
            parse_load("0.23 1.02 2.33 4/5 111"),
            Some([0.23, 1.02, 2.33])
        );
        assert_eq!(cpu_ticks("cpu 10 foo"), None);
        assert_eq!(mem_value("MemTotal: x kB", "MemTotal"), None);
    }
}

FILE	crates/kira-shell/src/system_panel.rs
//! Read-only Linux telemetry adapter for the Svelte System Monitor.
//! All presentation is in SystemWidget.svelte, never native GTK controls.
use std::cell::{Cell, RefCell};
use std::rc::Rc;
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::{Arc, mpsc};
use std::time::Duration;

use crate::process_monitor::{ProcessSampler, ProcessSnapshot};
use crate::system_metrics::{
    PULSE_INTERVAL, Pulse, PulseSampler, Snapshot, bytes_label, percent_used,
};

/// Root filesystem data is queried on the GTK thread, like the Top Bar.
pub fn disk() -> Option<(u64, u64)> {
    let file = gtk::gio::File::for_path("/");
    use gtk::gio::prelude::*;
    let info = file
        .query_filesystem_info(
            "filesystem::size,filesystem::free",
            None::<&gtk::gio::Cancellable>,
        )
        .ok()?;
    let total = info.attribute_uint64("filesystem::size") / 1024;
    let available = info.attribute_uint64("filesystem::free") / 1024;
    (total > 0 && available <= total).then_some((total, available))
}

/// A bounded channel prevents stale 500ms samples from building up in a
/// busy GTK main loop. This worker only exists on Overview while visible.
struct PulseFeed {
    running: Arc<AtomicBool>,
    receiver: mpsc::Receiver<Pulse>,
}

impl Drop for PulseFeed {
    fn drop(&mut self) {
        self.running.store(false, Ordering::Relaxed);
    }
}

struct ProcessFeed {
    running: Arc<AtomicBool>,
    receiver: mpsc::Receiver<Result<ProcessSnapshot, String>>,
}

impl Drop for ProcessFeed {
    fn drop(&mut self) {
        self.running.store(false, Ordering::Relaxed);
    }
}

/// The UI may only start/stop a bounded, read-only sampler. No PID actions,
/// shell execution, command lines or generic Core RPC endpoints are exposed.
pub struct Model {
    metrics: Rc<RefCell<Snapshot>>,
    core: Rc<Cell<bool>>,
    niri: Rc<Cell<bool>>,
    processes: RefCell<Option<ProcessFeed>>,
    pulse: RefCell<Option<PulseFeed>>,
}

impl Model {
    pub fn new(metrics: Rc<RefCell<Snapshot>>, core: Rc<Cell<bool>>, niri: Rc<Cell<bool>>) -> Self {
        Self {
            metrics,
            core,
            niri,
            processes: RefCell::new(None),
            pulse: RefCell::new(None),
        }
    }

    pub fn metrics_json(&self) -> serde_json::Value {
        serde_json::json!({
            "metrics": self.metrics.borrow().as_json(),
            "core": self.core.get(),
            "niri": self.niri.get(),
        })
    }

    pub fn set_pulse_active(&self, active: bool) {
        let mut feed = self.pulse.borrow_mut();
        if !active {
            *feed = None;
            return;
        }
        if feed.is_some() {
            return;
        }
        let (sender, receiver) = mpsc::sync_channel(1);
        let running = Arc::new(AtomicBool::new(true));
        let alive = running.clone();
        std::thread::spawn(move || {
            let mut sampler = PulseSampler::default();
            while alive.load(Ordering::Relaxed) {
                let started = std::time::Instant::now();
                let pulse = sampler.sample();
                match sender.try_send(pulse) {
                    Ok(()) | Err(mpsc::TrySendError::Full(_)) => {}
                    Err(mpsc::TrySendError::Disconnected(_)) => break,
                }
                // The interval is measured start-to-start, not IO + 500ms.
                // Skip missed cycles instead of flooding the GTK/UI channel.
                if let Some(remaining) = PULSE_INTERVAL.checked_sub(started.elapsed()) {
                    std::thread::sleep(remaining);
                }
            }
        });
        *feed = Some(PulseFeed { running, receiver });
    }

    pub fn poll_pulse(&self) -> Option<serde_json::Value> {
        self.pulse
            .borrow()
            .as_ref()?
            .receiver
            .try_recv()
            .ok()
            .map(|pulse| pulse.as_json())
    }

    pub fn set_processes_active(&self, active: bool) {
        let mut feed = self.processes.borrow_mut();
        if !active {
            *feed = None;
            return;
        }
        if feed.is_some() {
            return;
        }
        let (sender, receiver) = mpsc::sync_channel(1);
        let running = Arc::new(AtomicBool::new(true));
        let alive = running.clone();
        std::thread::spawn(move || {
            let mut sampler = ProcessSampler::default();
            while alive.load(Ordering::Relaxed) {
                let result = sampler.sample().map_err(|error| error.to_string());
                // A slow UI must not queue unlimited /proc snapshots.
                match sender.try_send(result) {
                    Ok(()) | Err(mpsc::TrySendError::Full(_)) => {}
                    Err(mpsc::TrySendError::Disconnected(_)) => break,
                }
                std::thread::sleep(Duration::from_secs(2));
            }
        });
        *feed = Some(ProcessFeed { running, receiver });
    }

    pub fn poll_processes(&self) -> Option<serde_json::Value> {
        let feed = self.processes.borrow();
        let latest = feed.as_ref()?.receiver.try_recv().ok()?;
        Some(match latest {
            Ok(snapshot) => {
                // The native reader bounds scans to 4096 PIDs; preserve the
                // searchable full snapshot. Svelte renders only 36 visible rows.
                let rows: Vec<_> = snapshot
                    .rows
                    .iter()
                    .map(|row| {
                        serde_json::json!({
                            "pid": row.pid,
                            "name": row.name,
                            "state": row.state.to_string(),
                            "cpu_percent": row.cpu_percent,
                            "rss_kib": row.rss_kib,
                            "pss_kib": row.pss_kib,
                        })
                    })
                    .collect();
                serde_json::json!({
                    "rows": rows,
                    "total": snapshot.total,
                    "truncated": snapshot.truncated,
                    "error": null,
                })
            }
            Err(error) => serde_json::json!({
                "rows": [],
                "total": 0,
                "truncated": false,
                "error": error.chars().take(120).collect::<String>(),
            }),
        })
    }

    /// Clipboard text is generated by trusted Rust data, not arbitrary JS.
    pub fn report(&self) -> String {
        let s = self.metrics.borrow();
        let pair = |total: Option<u64>, available: Option<u64>| {
            total
                .zip(available)
                .map_or("UNAVAILABLE".to_string(), |(total, avail)| {
                    format!(
                        "{} / {}",
                        bytes_label(total.saturating_sub(avail)),
                        bytes_label(total)
                    )
                })
        };
        let load = s.load.map_or("UNAVAILABLE".to_string(), |v| {
            format!("{:.2} / {:.2} / {:.2}", v[0], v[1], v[2])
        });
        let uptime = s
            .uptime_seconds
            .map_or("UNAVAILABLE".to_string(), |seconds| {
                let days = seconds / 86_400;
                let hours = (seconds % 86_400) / 3_600;
                let minutes = (seconds % 3_600) / 60;
                if days > 0 {
                    format!("{days}d {hours}h {minutes}m")
                } else {
                    format!("{hours}h {minutes}m")
                }
            });
        let power = s
            .battery_percent
            .map_or("NOT DETECTED".to_string(), |battery| {
                let suffix = match s.battery_charging {
                    Some(true) => " / AC OR CHARGING",
                    Some(false) => " / DISCHARGING",
                    None => "",
                };
                format!("{battery}%{suffix}")
            });
        let cpu_temp = s
            .cpu_temperature_c
            .map_or("UNAVAILABLE".to_string(), |v| format!("{v:.1} °C"));
        let gpus = if s.gpus.is_empty() {
            "GPU: NOT DETECTED".to_string()
        } else {
            s.gpus
                .iter()
                .map(|gpu| {
                    format!(
                        "{}: {} / {} °C",
                        gpu.label,
                        gpu.utilization_percent
                            .map_or("UNAVAILABLE".into(), |v| format!("{v}%")),
                        gpu.temperature_c
                            .map_or("UNAVAILABLE".into(), |v| format!("{v:.1}")),
                    )
                })
                .collect::<Vec<_>>()
                .join("\n")
        };
        let root = pair(s.root_total_kib, s.root_available_kib);
        let memory = pair(s.memory_total_kib, s.memory_available_kib);
        let swap = pair(s.swap_total_kib, s.swap_free_kib);
        let health = if !self.core.get() {
            "CORE OFFLINE"
        } else if !self.niri.get() {
            "NIRI DISCONNECTED"
        } else if s
            .root_total_kib
            .zip(s.root_available_kib)
            .and_then(|(total, avail)| percent_used(total, avail))
            .is_some_and(|p| p >= 90)
        {
            "LOW STORAGE"
        } else if s.memory_percent().is_some_and(|p| p >= 90) {
            "MEMORY PRESSURE"
        } else {
            "SYSTEM STATUS"
        };
        format!(
            "KIRA SYSTEM / {health}\nCore: {}\nNiri: {}\nCPU: {}\nCPU temperature: {cpu_temp}\n{gpus}\nMemory: {memory}\nSwap: {swap}\nStorage /: {root}\nLoad 1/5/15: {load}\nUptime: {uptime}\nBattery: {power}",
            if self.core.get() {
                "CONNECTED"
            } else {
                "OFFLINE"
            },
            if self.niri.get() {
                "CONNECTED"
            } else {
                "DISCONNECTED"
            },
            s.cpu_percent
                .map_or("MEASURING".into(), |v| format!("{v}%")),
        )
    }
}

pub fn dismiss(app: &gtk::Application) -> bool {
    crate::calendar::dismiss_system(app)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn sampler_is_activated_only_by_processes_tab() {
        let model = Model::new(
            Rc::new(RefCell::new(Snapshot::default())),
            Rc::new(Cell::new(false)),
            Rc::new(Cell::new(false)),
        );
        assert!(model.processes.borrow().is_none());
        assert!(model.pulse.borrow().is_none());
        model.set_pulse_active(true);
        assert!(model.pulse.borrow().is_some());
        model.set_pulse_active(true); // Idempotent, no duplicate worker.
        model.set_pulse_active(false);
        assert!(model.pulse.borrow().is_none());
        model.set_processes_active(true);
        assert!(model.processes.borrow().is_some());
        model.set_processes_active(false);
        assert!(model.processes.borrow().is_none());
        assert!(model.pulse.borrow().is_none());
        model.set_pulse_active(true);
        assert!(model.pulse.borrow().is_some());
        model.set_pulse_active(true); // Idempotent, no duplicate worker.
        model.set_pulse_active(false);
        assert!(model.pulse.borrow().is_none());
        assert!(model.report().contains("CORE OFFLINE"));
    }
}

FILE	docs/CONFIG.md
# Kira Desktop: KDL configuration (first functional profile)

Kira Core owns configuration parsing and validation. The GUI only receives
**validated, read-only state**. The first profile intentionally accepts a
limited set of KDL nodes/properties; **it is not yet a full KDL 2.0 parser**.
Unsupported syntax, nodes or properties fail validation rather than silently
changing the desktop.

## User configuration

Copy the sample to the normal XDG location:

```sh
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/kira-desktop"
cp config/kira.kdl.example "${XDG_CONFIG_HOME:-$HOME/.config}/kira-desktop/config.kdl"
```

Default lookup is `$XDG_CONFIG_HOME/kira-desktop/config.kdl`, or
`$HOME/.config/kira-desktop/config.kdl` when XDG_CONFIG_HOME is unset.
An absolute `KIRA_CONFIG_FILE` environment variable takes priority.
Relative paths are rejected. Core **never creates or overwrites** the
user's config file.

An absent file on initial startup uses Kira's built-in defaults. Editing
or atomically replacing an existing file triggers a **hot reload without
restarting Core or Shell**. Current implementation checks the small file
every 250 ms and notifies Shell only when the validated state changes.

## Supported KDL profile

```kdl
kira {
    bar compact=#false title="KIRA DESKTOP"
    clock seconds=#false
    workspaces show-names=#true limit=12
}
```

| Node | Property | Type / range | Effect |
| --- | --- | --- | --- |
| `bar` | `compact` | `#true` / `#false` | Reduce horizontal padding while keeping Niri's 42px reserved bar |
| `bar` | `title` | quoted text, 1–32 printable characters | Center title; text is escaped by Svelte |
| `clock` | `seconds` | `#true` / `#false` | Show seconds in the Top Bar clock |
| `workspaces` | `show-names` | `#true` / `#false` | Show workspace names or only numeric indices |
| `workspaces` | `limit` | integer 1–32 | Maximum number of displayed workspaces; keep the focused one visible |

Formatting rules for this **minimal KDL profile**:
- Exactly one `kira {` opening line and a `}` closing line.
- Each child node on **one line**, properties written as `key=value`
  without whitespace around `=`. Child nodes can appear in any order.
- Values are KDL 2.0 booleans (`#true` / `#false`), unsigned integers, or single-line double-quoted strings with printable Unicode characters.
  Only escaped double quotes and escaped backslashes are supported in this
  initial title profile; all other escapes and multiline/raw strings are rejected.
- Blank lines and `//` comments outside quoted strings are allowed.
- Children, lists, arbitrary attributes, slashdash, multiline/raw strings,
  annotations, node arguments and additional KDL constructs are **not yet
  supported**. Unknown or duplicate keys/nodes are errors.

This limited profile is intentional for v0.1: configuration cannot execute
commands, spawn processes, change Niri config or load arbitrary extensions.

## Validate before applying

```sh
nix develop --command cargo run --locked -p kira-core -- \
  --check-config "$(pwd)/config/kira.kdl.example"
```

For a quick check of the committed example, `nix develop --command task config:check`
runs that same CLI. `task check` also validates the example in CI.

A valid file prints the normalized JSON UI settings and exits successfully.
An invalid file exits nonzero with a diagnostic. This **does not bind**
the Core socket or start Niri. For a custom file, pass its absolute path.

### Error handling

Core processes the entire file before publishing it. On an invalid edit
(including unsupported nodes, missing closing brace, excessive size or
unreadable file), it keeps **the last valid settings** and publishes an error
in `ConfigState.error`. The Top Bar shows `CONFIG !` with a tooltip;
it remains usable and its other widgets continue working. A subsequent
valid edit clears the warning and applies the new settings.

The maximum config size is **64 KiB** with at most **128 lines**. These
bounds apply to reads in the hot-reload loop as well as CLI validation.
On deleting a file after it was loaded, the last working settings remain
active with a diagnostic. On first startup with no file, defaults apply.

## Try it in the safe nested preview

```sh
nix develop --command task dev:preview
```

The preview writes a **separate temporary Kira config**, copied from the
sample. The terminal prints its `[preview] Live Kira KDL config:` path.
While the preview is open, edit **that exact path** using a text editor,
for example change `clock seconds=#false` to `clock seconds=#true` or
`bar compact=#false` to `bar compact=#true`. Changes appear in the nested
Top Bar without restarting. The temporary file disappears when the preview
closes, and the host user's `~/.config/kira-desktop/` is untouched.

To test a persistent custom file in nested preview instead, set
`KIRA_CONFIG_FILE=/absolute/path/config.kdl` before invoking the task.
The preview reads it but never modifies it.

## Internal data flow

`config.kdl` → Core bounded parser + last-good watcher →
`get_config` / internal `subscribe_config` → Shell worker thread →
WebKit `kira:config` CustomEvent → typed Svelte SDK → live components.

The `subscribe_config` method is private to the Core Unix socket and is
**not** exposed via the WebKit JSON-RPC allowlist. Only `get_config`
is available to the UI, along with the existing read-only methods.
Changing config cannot invoke Niri `Action`. Existing workspaces remain
connected even if the config becomes invalid.

## Scope beyond this first increment

Full KDL grammar, schema migrations, themes, layout/monitor geometry,
widget ordering, per-output panels and secure user-provided modules are
separate future milestones. Do not treat this profile as general KDL
evaluation or an extension/command system.

FILE	docs/DESIGN_SYSTEM.md
# Kira Desktop · Design System

**Status:** implemented visual system for the Svelte Top Bar, native GTK
Launcher and custom Calendar. Visual acceptance is still open. This document operationalizes [specification §15](SPECIFICATION.md#15-премиальный-ui-и-фирменная-палитра-обязательное-требование).
Dock, notifications and other desktop surfaces remain future milestones.

## Kira official visual direction

**Neo-Brutalism + Editorial Design + Expressive Minimalism** is the
official visual language of Kira Desktop.

- **Neo-Brutalism:** deliberate geometry, high-contrast states and visible
  structure where it carries meaning. It does **not** mean borders and offset
  shadows on every element.
- **Editorial Design:** a strong type hierarchy (eyebrow, heading,
  description, metadata), measured spacing and deliberate grouping.
- **Expressive Minimalism:** one canonical accent, every element functional,
  short quiet motion rather than decoration.
- **KISS:** keep each UI feature and interaction easy to trace. Prefer a small
  direct function over an abstract component framework; new layers must solve
  a demonstrated problem.
- **DRY:** define shared palettes and genuinely identical infrastructure once.
  Keep distinct behaviors separate, even when they both use GTK buttons.

### Visual rules

1. Organize the Top Bar as three intentionally different **materials**:
   Prussian Blue identity, Black workspace navigation, subdued Blue system.
2. Keep the main orange fill on the current workspace; add only a narrow
   orange baseline/mark to connect brand and active navigation.
3. Build a compact typographic hierarchy: wordmark and workspace kicker/title.
   The right edge is a **single vertically centered utility row**, not
   stacked SYSTEM/LOCAL labels with inconsistent inner widget heights.
4. Keep the full Top Bar at exactly 42 logical pixels; the navigation is
   real Niri state and the text is sourced from the current KDL config.
5. Divide the Launcher into a Black editorial intro and a Blue working area
   for search and catalog; avoid filling the entire selected row with orange.
6. A slim orange selection rail and orange item title identify the active
   application; the catalog retains descriptive text and system icons.
7. Preserve visible keyboard focus, urgent/offline states, reduced-motion,
   and readable contrast. Decoration must not disguise function.

### Implementation rules: KISS + DRY

1. **Single native palette:** `native-palette.css` declares the five GTK
   colors for Launcher, Calendar and the System Monitor. `native_ui.rs` assembles it with each
   overlay stylesheet, and `test_native_theme.py` verifies the values match
   Svelte's canonical palette. Do not duplicate `@define-color` in widgets.
2. **Small shared operations:** the common overlay helper only installs style
   providers, finds windows and dismisses them. Keep Launcher search/launch
   Calendar date-picker state and read-only System Monitor telemetry in
   their own modules.
3. **No premature abstraction:** two similarly named elements are not
   necessarily the same component. Extract code only when it has the same
   semantics and at least two real callers.
4. **Behavior before snapshots:** prefer unit tests of dates, state and real
   interactions; supplement with visual Niri QA for layout and focus. Never
   treat checking CSS class strings as proof that UI looks correct.
5. **Preserve public contracts:** Niri's 42px exclusive zone, the bounded
   WebKit bridge, KDL config and keyboard access are not negotiable during
   style or internal structure refactors.

### Component principles

- **Top Bar:** a 42 px strip with three continuous horizontal zones:
  Blue brand, Black workspaces and metadata, softer Blue system status/clock.
  The right zone is a condensed single line: combined Core + Niri health,
  subtle divider and local time, all sharing one optical vertical center.
  Date and diagnostic details are available via native title tooltips.
  The time is a semantic button that toggles a separate native calendar overlay;
  the Top Bar remains 42 px tall.
- **Calendar overlay:** top-right native GTK layer surface with no exclusive
  zone. Black time hero, Prussian Blue month/day selector and Black detail
  footer; the time updates live, a custom Monday-first 6×7 GTK Grid of
  accessible buttons supports month/year navigation, adjacent-month dates,
  ISO weeks and arrow/PageUp/PageDown/Home keyboard navigation. Selecting
  a date exposes the correct ISO week-year and day of year.
  Today and Copy Date are both flat orange typographic commands, without
  background fills, framed chips or active-tab underlines. Copy Date keeps
  hover/pressed text feedback and a keyboard-only focus outline, and writes
  to the clipboard only on click.
  Clicking time again or pressing Escape closes; focus loss also dismisses
  after activation. The calendar and Launcher close each other when opened.
  The calendar uses **GSAP** for a staggered section entrance,
  directional month/year transitions, and a restrained selected-day pop.
  Only opacity/transform are animated: actual date arithmetic, keyboard
  focus, clipboard, and the 42px top bar remain unchanged. Motion is
  disabled by `prefers-reduced-motion`, interrupted transitions are killed,
  and all GSAP tweens/listeners are cleaned up when the calendar unmounts.
  The live wall clock uses GSAP **odometer rolls per changed numeral**,
  keeping unchanged digits and separators fixed. The displayed text and
  datetime always come from the same localized clock reading; animation
  cannot delay or falsify the actual time. Digit rolls are interrupted
  cleanly on a subsequent tick and disabled by `prefers-reduced-motion`.
- **Launcher:** Black editorial introduction and Prussian Blue workbench.
  Search, catalog, stable application icons, and an orange selection rail
  communicate function without painting the entire row orange.
- **Workspace controls:** orange filled selection only; hover/active/urgent
  and visible keyboard focus remain distinct. Niri events are authoritative.
- **System health:** the Top Bar is a compact **system** indicator, not just
  a Core heartbeat. READY requires Core/Niri connectivity **and** actual
  CPU/memory samples; LOW DISK, LOW MEM, LOW BAT or BUSY report measured
  pressure, and CHECKING is shown until first valid samples. Hover offers
  a short truthful snapshot; clicking opens the native System Monitor.
  PARTIAL indicates that CPU and RAM have been sampled but root disk data
  is unavailable, so the status never claims full readiness without it.
  It has the same Black heading / Prussian Blue workbench / Black details
  composition as the Calendar and Launcher, uses small orange progress
  meters and real values from Linux /proc, sysfs and Gio's root filesystem
  information. It shows Core and Niri, CPU, RAM, swap, root storage,
  1/5/15 load, uptime and battery (if present). Missing readings are
  UNAVAILABLE / NOT DETECTED rather than zero. A fixed-purpose WebKit
  `kiraSystem` channel only accepts `toggle` and cannot run commands.
  The monitor updates every two seconds and can copy a plain-text report.
  The system popover contains **two custom flat tabs**: 01 OVERVIEW
  (the existing diagnostics) and 02 PROCESSES (the read-only mini task
  monitor). The second tab reads readable tasks from Linux /proc only
  while active, displaying process name, PID, sampled CPU percentage
  relative to the entire host, and resident memory (RSS), with a search
  field, reversible sorting by clicking PROCESS/PID/CPU/RAM headers
  (orange active state and direction arrow), an independently scrollable
  top-36 list
  and honest counts. Samples update every two seconds on a worker.
  Initial CPU has no historical baseline and is displayed as a dash,
  and unreadable RSS/processes are not replaced with fake zero.
  The UI never reads process command-line arguments or offers termination.
  A PID plus kernel start-time identity prevents reuse from attributing
  another process's CPU history. No new Core JSON-RPC methods or
  user-data collection are introduced.

### Charting and motion libraries (project standard)

**Apache ECharts** is the only supported chart engine for quantitative
visualizations, including resource gauges/bars and live time-series.
Import ECharts modularly via `echarts/core` and use the SVG renderer in
compact WebKitGTK popovers. The system monitor shows actual sampled CPU,
RAM, GPU and other available percentages, with a bounded 60-second history.
A missing/unsupported sensor is `UNAVAILABLE`, never a zero-shaped graph.
Visible text and labels supplement SVG for accessibility.

**GSAP** is the standard for interface animations, including staggered
tab entrances and gentle reading updates. Animations are short, scoped to
their own Svelte widget and fully disabled under
`prefers-reduced-motion: reduce`. On widget unmount, dispose ECharts
instances and kill GSAP tweens/observers. No canvas/WebGL loops, network
requests or detached subscriptions may survive a closed overlay.

Both libraries are **bundled into the one self-contained offline HTML**
that WebKitGTK loads; never use CDNs, runtime dynamic imports, or extra
asset chunks. Preserve the canonical five-color palette and the 42 px
native top bar. The system monitor's Processes view retains searchable,
sortable RSS and PSS process data while the Overview chart uses only the
existing read-only native telemetry feed.

### System Monitor Overview visual acceptance

The Overview is an **editorial instrument panel**, not a stack of identical
diagnostic bars. The visual hierarchy is intentional:
1. **Primary:** two large ECharts SVG dials for actual CPU and RAM usage, each
   with accessible HTML numbers and accurate unknown state.
2. **Secondary:** activity history in **separate, clearly labeled CPU and RAM
   lanes**, both sampled at 500 ms and using the **same adaptive-axis rules**
   and continuous ECharts update strategy. RAM keeps measured hundredth-percent
   precision instead of rounding away real movement, while accessible axis
   labels disclose the actual zoom. GPU has its own lane only when a real
   utilization sensor is available. History is bounded to 120 genuine
   500ms CPU/RAM samples, never fabricated.
3. **Tertiary:** compact Swap and Root Storage figures, then a concise hardware
   / thermal row and OS metadata, with no empty card for unavailable GPU data.
   Nonzero fractional swap use is not rounded down to a misleading 0%.
4. **Scrolling:** GTK/WebKit scrollbar chrome is hidden on the monitor but
   mouse, touchpad and keyboard scrolling remain operable. Content must not
   be cropped to conceal overflow.
5. **Motion:** ECharts animates only actual sample changes. GSAP marks tab
   entrances and readout updates, with reduced-motion support and lifecycle
   disposal. Visual tests must check the **real packaged overlay** at a
   narrow width in isolated Niri, not infer beauty from passing unit tests.

### 500ms CPU/RAM pulse

The **SYSTEM / PULSE** dials and activity lanes receive genuine Linux
`/proc/stat` and `/proc/meminfo` measurements **every 500 milliseconds**,
in a dedicated read-only worker, only while the System Monitor's Overview
tab is visible. A bounded, single-slot channel sends the latest pulse
through the existing GTK event loop to a strictly validated
`kira:system:pulse` event. ECharts keeps no more than 120 real samples
(60 seconds). No 500ms interpolation, browser polling or fake zero values.

The full system feed, including GPU, CPU/GPU temperatures, battery, root
storage, and KDL/Core status, still refreshes every two seconds. GPU
readings appear only once per actual slow sample, not twenty times as
invented high-frequency measurements. Process RSS/PSS scanning still runs
only on the Processes tab at its original slower cadence.

Closing Overview, switching tabs, or dismissing the overlay stops the
fast worker and clears the chart listener. A closed WebKit view never
continues sampling at 10 Hz. Motion respects `prefers-reduced-motion`.

### Popup geometry

Calendar and System Monitor share a **25 logical pixel** top margin,
half the previous 50px. A single GTK helper caps each popup's
scrollable viewport at **70% of the logical height of its monitor**,
recalculating after the Wayland surface maps. Both remain non-exclusive
overlays; Top Bar still reserves 42px.

### Geometry and motion

Use a 4 px rhythm (prefer 8 px), compact 4–10 px radii, mostly borderless
controls, and **one deliberate surface contrast per functional region**.
An orange line can anchor a section, but offset shadows and nested borders
are not a shortcut to depth. Use 120–180 ms transitions without positional
jumps. Keep interaction functional without motion. Niri's reserved 42 px
height is unchanged, including the bottom accent rule.

## Kira Default · canonical palette

The default dark theme uses exactly five fully opaque RGBA hex colors,
provided by the project owner. No additional base colors are permitted.

| Name | CSS variable | RGBA HEX | Intended role |
| --- | --- | --- | --- |
| Black | `--black` | `#000000ff` | Background, text on Orange |
| Prussian Blue | `--prussian-blue` | `#14213dff` | Surfaces, structural depth |
| Orange | `--orange` | `#fca311ff` | Selection, focus, interactive accent |
| Alabaster Grey | `--alabaster-grey` | `#e5e5e5ff` | Secondary text and borders |
| White | `--white` | `#ffffffff` | Primary text on dark surfaces |

The canonical values are declared in
[`frontend/src/lib/themes/kira-default.ts`](../frontend/src/lib/themes/kira-default.ts).
The frontend exposes them through
[`kira-default.css`](../frontend/src/lib/themes/kira-default.css).
Native GTK declares the same five colors **once** in
[`native-palette.css`](../crates/kira-shell/src/native-palette.css),
assembled with each overlay stylesheet by
[`native_ui.rs`](../crates/kira-shell/src/native_ui.rs).
Contract tests verify the values match; each overlay owns only its
component selectors, not a second color palette.

## Public CSS contract

| Semantic variable | Canonical alias | Intended usage |
| --- | --- | --- |
| `--kira-color-background` | `var(--black)` | Background |
| `--kira-color-surface` | `var(--prussian-blue)` | Elevated surfaces |
| `--kira-color-muted` | `var(--alabaster-grey)` | Secondary text |
| `--kira-color-accent` | `var(--orange)` | Selection and keyboard focus |
| `--kira-color-text` | `var(--white)` | Primary text |
| `--kira-color-earth` | `var(--prussian-blue)` | Legacy structural alias |
| `--kira-color-on-accent` | `var(--black)` | Legible text on Orange |

Derived tokens: `--kira-color-on-accent`,
`--kira-color-text-secondary`, `--kira-color-surface-subtle`
and `--kira-color-border` blend or alias these five colors.
Layout and motion tokens begin with `--kira-space-`,
`--kira-radius-` and `--kira-motion-`. Legacy structural tokens
remain for compatibility but are **not** instructions to draw borders
or hard shadows on every component.

## Tailwind CSS v4 frontend contract

`frontend/src/style.css` imports `tailwindcss` and the canonical color
tokens, and maps semantic colors with CSS-first `@theme inline`.
`frontend/vite.config.ts` uses `@tailwindcss/vite`. Keep utility classes
**literal** in Svelte templates: Tailwind's scanner cannot infer runtime
class-name concatenation. Conditionals must contain complete class strings.

Example for a future Svelte widget:

```svelte
<div class="rounded-md bg-kira-surface p-3 text-kira-text">
  Widget content
</div>
```

Use `bg-kira-accent text-kira-on-accent` for an active control, and explicit
`focus-visible:outline-2 focus-visible:outline-kira-accent` for keyboard
focus. Keep responsive and reduced-motion variants close to their markup.
Use `frontend/src/style.css` only for global browser constraints and
theme mapping, not for another manual component stylesheet.

**Never hardcode colors in Svelte utility class values.** Theme changes
belong to semantic tokens, not each component. GTK is a separate
native CSS surface sharing the same five-color palette. User-overridable
themes via KDL remain a future feature; current KDL config adjusts bar
behavior only.

## Color contrast and accessibility

Representative WCAG relative contrast ratios (each canonical alpha is `ff`):

- White on Black: **21.00:1**.
- White on Prussian Blue: **15.97:1**.
- Alabaster Grey on Black: **16.67:1**.
- Alabaster Grey on Prussian Blue: **12.68:1**.
- Orange on Black: **10.39:1**.
- Orange on Prussian Blue: **7.90:1**.
- Black on Orange: **10.39:1**, used on selected chips.
- **White on Orange is 2.02:1**: use Black for text on Orange.

Regular-size text requires at least 4.5:1, and meaningful non-text indicators
at least 3:1 as applicable under WCAG. Do not indicate focus by color alone:
workspaces also use a mark, labels and `aria-pressed`.
Provide visible keyboard outlines and honor reduced-motion preferences.

## Current component implementation

- `frontend/src/App.svelte`: identity / workspace / system architecture.
  The configurable title is a compact second-line workspace descriptor;
  compact and narrow screens collapse secondary labels.
- `frontend/src/lib/components/WorkspacePreview.svelte`: real Niri workspaces
  with accessible clickable buttons, live focus/active/urgent state, and
  stable workspace IDs for the intentional `FocusWorkspace` action.
- `frontend/src/lib/components/SystemHealth.svelte` and
  `frontend/src/lib/system-health.ts`: a compact, centered readiness indicator
  derived from real Core and Niri states. Accessible `role="status"`
  announces changes; unavailable details remain visible instead of an
  unexplained indicator.
- `frontend/src/style.css`: Tailwind v4 import, semantic `@theme inline`
  aliases and minimal global styles. Responsive composition and focus rules
  live in Svelte utility classes; the native 42 px reservation is unchanged.
- `frontend/index.html`: uses matching fallback colors before Svelte mounts.
- `crates/kira-shell/src/calendar.rs` and `calendar.css`: native time/date
  overlay, live timezone-aware clock and fully custom date-picker Grid (no GtkCalendar). The dedicated
  WebKit `kiraCalendar` bridge accepts exactly the literal `toggle`;
  it never forwards commands to Core.
- `crates/kira-shell/src/launcher.rs` and `launcher.css`: GTK layer-shell
  editorial introduction, Blue workbench, Gio application catalog, orange
  rail selection, pointer/keyboard activation and canonical five-color theme.

The KIRA button uses the dedicated `kiraLauncher` WebKit handler, which accepts
only the literal `open` message. Actual process launch uses registered Gio
`AppInfo` desktop entries, not interpolated shell commands. The Launcher is
non-persistent and has no exclusive zone. Esc closes it; Up/Down select and
Enter launches the selected application.

## Verification

```sh
nix develop --command task check
nix develop --command task frontend:build
nix develop --command task dev:preview
```

Run a manual visual review in nested Niri at common display scales and
sizes. Track remaining confirmed and suspected visual issues in
[VISUAL_REVIEW.md](VISUAL_REVIEW.md). The automated tests verify palette, contrast, semantic Tailwind v4 tokens,
structural zones, the native row selection rail, and accessible state
controls. The production Vite build compiles utilities into one inlined
WebKit CSS asset. Automated tests do **not** replace screenshot or
interactive GTK/WebKit review. Native compilation is checked by the Nix
workflow.

Next design-system milestones: shared interactive primitives, configurable KDL
theme overrides, Dock, notifications and their consistent states.

FILE	docs/DEVELOPMENT.md
# Developing Kira Desktop

## Requirements

Kira Desktop targets NixOS, Niri and Wayland. Flakes must be enabled. The repository commits the generated `Cargo.lock`, `flake.lock` and `frontend/package-lock.json`, as well as the verified frontend `npmDepsHash`.

Pull requests and main pushes run only the lightweight Core + Svelte checks
(`.github/workflows/ci.yml`). The slow GTK/WebKit/Nix release build
(`.github/workflows/nix.yml`) runs nightly on main or manually through
GitHub Actions → **Nix package (nightly / manual)** → **Run workflow**
(select the desired branch). It does not block PR iteration.


The Calendar is **mounted lazily**: its WebKit process prewarms without a
Svelte Calendar component. Opening mounts one instance; hiding explicitly
unmounts it, stopping its one-second clock and releasing DOM/effects while
retaining the warm WebKit engine for fast reopening. `lazy-widget.ts`
serializes asynchronous mount/unmount across rapid toggles and skips stale
show generations. The single offline frontend bundle contains all component
code in advance, but creates and destroys active component instances on
demand. It makes no network requests.
This does **not** guarantee WebKit process RSS returns to zero. Calendar, System Monitor and Launcher share the same warmed host with
no additional WebKit process. Process scanning starts only on the Processes
tab and ends on hide. The Launcher discovers GIO entries on demand, discards
its catalog on hide and can launch only an index into that native snapshot.
Use PSS and CPU sampling for actual resource measurements.

## Widget architecture migration

The intended architecture is Rust for Core, GIO/system integration and the
GTK/WebKit layer-shell **window host**, with **all widget views in Svelte 5**.
All three built-in widgets are Svelte 5: `CalendarWidget.svelte`,
`SystemWidget.svelte` and `LauncherWidget.svelte` use one shared,
prewarmed WebKit/layer-shell overlay.
Do not build additional widget layouts in GTK.

See [UI_ARCHITECTURE.md](UI_ARCHITECTURE.md) for the staged migration.
The Svelte Calendar host is integrated and covered by frontend, Rust and
Nix tests; real multi-scale nested Niri graphical QA remains pending.

## Kira Default visual design

The Svelte 5 Top Bar uses **Tailwind CSS v4** through `@tailwindcss/vite`.
`frontend/src/style.css` imports Tailwind and exposes semantic utility colors
via `@theme inline`: `bg-kira-bg`, `bg-kira-surface`,
`bg-kira-surface-soft`, `text-kira-muted`, `text-kira-text`,
`bg-kira-accent`, and `text-kira-on-accent`. No JavaScript Tailwind
configuration file, shadcn dependency, PostCSS plugin or runtime CSS engine
is needed.

The five canonical colors remain defined in
`frontend/src/lib/themes/kira-default.css` and typed in
`frontend/src/lib/themes/kira-default.ts`. Svelte components
(`App.svelte`, `WorkspacePreview.svelte`, `SystemHealth.svelte`) use
utility classes directly; their visual styling is no longer duplicated in
component-scoped `<style>` blocks. Niri focus/urgent states, keyboard
focus, Core state and live KDL config updates remain behavioral concerns,
not CSS assumptions.

The narrow Svelte host bridge exposes `openLauncher()`,
`toggleCalendar()` and `toggleSystemPanel()` for native overlays. All three share the same private,
non-throwing message helper, while Rust checks the literal `open` and
`toggle` payloads independently. If the native handler is missing or
fails, the UI reports the overlay offline instead of throwing.

The shared Calendar/System Monitor/Launcher WebKit surface uses
`configure_webview_popup`, which caps both width and height against the
actual logical output, up to 70% of its height; HTML handles inner
overflow. The top margin remains 25px.

The Process Monitor uses `process_monitor.rs` for read-only /proc sampling
on a background worker and `system_panel.rs` for its bounded, typed
event adapter. CPU is computed from consecutive total-host tick counters
keyed by (PID, start-time) to avoid reuse. `SystemWidget.svelte`
renders the Processes tab,
search and ascending/descending sorting by clicking the four
table column headers, with no redundant SORT toolbar. No process termination, command lines, extra Core
RPC or permanent process enumeration is included. The fast CI checks the
Python contracts and Rust Core/IPC tests. Native shell test groups can be
run locally with `nix develop --command cargo test --locked -p kira-shell`
or before a release; the nightly/manual Nix workflow verifies full packaging.

All overlay widgets use Tailwind and the canonical frontend palette.
Their non-exclusive layer-shell WebKit window accepts only fixed-purpose
`kiraCalendarUi` commands: validated date copy, read-only system tabs,
generation-scoped GIO catalog lookup and indexed desktop-app launch.
The WebKit view cannot supply arbitrary executable paths, shell commands
or a general Core RPC method. Opening it does not change the 42px Niri reservation.
The WebKit host continues to embed a single production CSS file, including
Tailwind utilities, through `frontend/scripts/inline-assets.mjs`.

The five canonical colors live in the frontend theme; obsolete GTK
launcher/system monitor styles and palette have been removed. The shared
`native_ui.rs` keeps WebKit navigation restrictions and monitor-aware
popup sizing. `calendar.rs` manages one window and three lazily mounted
Svelte widgets. `launcher.rs` holds only a bounded GIO AppInfo catalog
and calls `AppInfo::launch()` for a validated index, while
`system_panel.rs` handles read-only system data and process sampling.
Launcher now resolves the system's themed GIO icons through GTK IconTheme
only for the currently rendered rows. The Rust bridge accepts up to 16 app
indices per request, caps individual icon files at 128 KiB, checks image
signatures, and returns image-only data URIs (no paths/URLs). Svelte caches
images only during the visible launcher's lifetime. The icon adapter
first reads any local GIO FileIcon from the desktop entry, then uses GTK
IconTheme, and finally tries the theme's generic
`application-x-executable` icon if an app-specific asset is missing.
A simple four-tile placeholder is the final fallback when no readable
image is available; only this fallback gets a subtle colored background.
Real 32px icons sit on transparent 36px slots with no added tile background.
All Svelte widget text, including Top Bar and lazy overlays, is nonselectable
via shared `#app` CSS, except inputs, textareas and editable fields, where
normal text selection and clipboard shortcuts remain available.
The launcher list uses hidden scrollbars in WebKit but retains scroll
functionality, and selected rows no longer have rounded right corners.
Its outer WebKit surface is square with no decorative border or shadow.
No generic command execution is exposed.

When adding npm dependencies, commit the updated
`frontend/package-lock.json` and update `npmDepsHash` in
`nix/package.nix`; otherwise `npm ci` or the Nix frontend package fails.
`nix build .#frontend` isolates the frontend package so the npm lock/hash
can be validated before the expensive native GTK/Rust build. The
nightly/manual Nix workflow performs one full `nix build .#default`,
which includes the frontend package.

See [DESIGN_SYSTEM.md](DESIGN_SYSTEM.md) and specification §15 for accessibility,
spacing, contrast and future widget conventions. The small HTML fallback in
`frontend/index.html` uses the exact canonical colors because it runs before
CSS assets finish loading.

## CI: fast by default

The lightweight workflow is read-only. It runs `task check` (including
`cargo fmt --all -- --check`, Clippy, Rust/TypeScript/Svelte/Python tests and
configuration checks) and `task frontend:build`. npm downloads and Cargo
dependencies are cached between runs. There is no automatic Rust formatting
commit, no branch rewrite and no duplicate branch-push/PR jobs.

Native GTK/WebKit compilation and full release packaging are intentionally
**not PR gates**. To verify a native Shell change before merging, run
`nix develop --command cargo check --locked -p kira-shell` locally, or
dispatch `Nix package (nightly / manual)` on that PR's branch in GitHub
Actions. The scheduled build catches packaging regressions on main; it
does not run every native Shell unit test.

## Safe nested development preview

```sh
nix develop --command task dev:preview
```

The default preview builds with Cargo in `target/debug` and Vite in
`frontend/dist`, reusing compiled Rust dependencies. A full Nix package build
is reserved for `task dev:preview:release`; `task dev:preview:run` launches
already-built binaries without compiling anything.

The preview validates an isolated minimal Niri KDL config, launches Niri
**windowed without `--session`**, then receives the actual nested
`WAYLAND_DISPLAY` from a `spawn-at-startup` handshake. Only after verifying
the nested display differs from the parent does it start Core and Shell.

`KIRA_CORE_SOCKET` points to a private temporary directory, so an existing
Kira Core process cannot be touched. `KIRA_PREVIEW=1` enables the GTK
`NON_UNIQUE` application flag to avoid activating a primary-session Shell.

Closing the nested window or pressing Ctrl+C stops only processes owned by the
preview. Config and logs are temporary; recent logs are printed on unexpected
exit. Tests use mock executables, not a GPU:

```sh
task dev:preview:test
```

See [PREVIEW.md](PREVIEW.md) for additional safety checks and troubleshooting.

## Native Nix package

The following build has passed on Linux in GitHub Actions with the pinned Nix inputs:

```sh
nix build .#default
```

The package installs `kira-core`, `kira-shell` and the compiled UI assets; the GTK wrapper sets `KIRA_UI_DIR` to the installed frontend directory.

To manually smoke-test from an existing Niri session:

```sh
nix build
./result/bin/kira-core  # terminal 1
./result/bin/kira-shell # terminal 2
```

The native Nix package build is tested nightly or on manual dispatch, not per PR;
verify appearance and behavior manually under Niri. The user confirmed that the nested packaged QA smoke passed locally (Core bootstrap, WebKit/Svelte DOM, clean shutdown), but visual screenshot review remains pending.

## Build caching and release iteration

**Why the previous release build was slow:** the old
`rustPlatform.buildRustPackage` compiled third-party Rust bindings (GTK4,
JavaScriptCore/WebKitGTK, Soup3) and Kira's own Rust code in one derivation.
A change to a Rust file could invalidate that whole build and trigger the
expensive compilation again. The runtime GTK/WebKit C libraries themselves
are normally prebuilt Nix store inputs; the `Compiling gtk4 v...` log is the
**Rust crate**.

The packaged build is now split with pinned **Crane** into:

1. `cargoArtifacts`: compiles third-party Rust crates from
   `Cargo.toml`/`Cargo.lock` using a dummy workspace. Editing Kira's
   `.rs` files or Svelte files does **not** invalidate this output.
2. `rustBinaries`: builds `kira-core` and `kira-shell` from
   `crates/` against the cached artifacts. It is not influenced by
   Svelte-only changes.
3. `frontend`: independent fixed-hash npm dependency fetch and Vite bundle.
4. Final `kira-desktop`: inexpensive output assembly and GTK wrapper
   pointing `KIRA_UI_DIR` at bundled UI.

The `nix develop` shell also provides **sccache** and automatically sets
`RUSTC_WRAPPER` for Cargo. Compiler artifacts persist under
`${XDG_CACHE_HOME:-$HOME/.cache}/kira-desktop/sccache` (default 10 GiB
limit) and can be reused across target directories and branches when
compiler version and flags match. Existing `target/debug` artifacts are still
used by Cargo itself. To inspect actual compiler-cache hits:

```sh
nix develop --command sccache --show-stats
```

`sccache` does not make unrelated build profiles interchangeable, and cannot
reuse artifacts if Rust or native dependency versions change. The release Nix
sandbox intentionally does not use this mutable local cache.

To run a fast, **incremental local** smoke without Nix release compilation:

```sh
nix develop --command task qa:visual:fast
```

For true release QA:

```sh
nix develop --command task qa:visual:release
```

The first Nix build after this packaging change must compile the new
dependency derivation **once**, even if old `buildRustPackage` outputs are
already in the Nix store. Subsequent changes to Kira's Rust sources should
reuse it if `Cargo.lock`, manifests, native library inputs, toolchain and
Crane lock remain the same. A Nix garbage collection removing the derivation
can force a rebuild, so avoid `nix store gc` while actively iterating.

Use `nix build .#default -L` to inspect what compiles. To measure
derivation reuse, inspect:

```sh
nix path-info --derivation .#default
nix build .#default --dry-run
```

Nix stores build outputs by hashes; Cargo's local `target/debug` and
Nix's `/nix/store` are **separate caches**, and are not automatically
interchangeable. An exact release derivation should be a no-op on subsequent
runs; a changed dependency set or Nix toolchain legitimately requires a
fresh dependency compilation.

### Optional shared CI / multi-machine cache

Nix's local store persists on the same machine, but GitHub-hosted runners
are ephemeral. To share compiled dependency derivations between CI runs,
an optional **Cachix** cache can be enabled by configuring:

- Repository variable `KIRA_CACHIX_NAME`: existing Cachix cache name.
- Repository secret `CACHIX_AUTH_TOKEN`: write token for that cache.
- On a trusted local NixOS machine, configure the same cache as an
  explicitly trusted binary substituter using Cachix's published instructions.

The GitHub workflow only enables this when the variable is configured.
Forked pull requests do not upload packages. Do not paste cache tokens
into source files or commit `nix.conf` changes with private keys.
Without a shared cache, dependency reuse remains local to each Nix store.

## Developer tasks

```sh
nix develop
npm ci --prefix frontend
task check           # formatting, Clippy, IPC tests, TypeScript, Vitest
task shell:check     # compile the native GTK/WebKit Shell
task dev:preview     # fast Cargo + Vite nested preview
task dev:preview:run # reopen already built preview, no compilation
task dev:preview:release # full Nix release preview
task qa:visual:fast    # passive Niri/Core/Svelte smoke (no screenshots)
task qa:visual:release # passive packaged Nix smoke (no screenshots)
task qa:visual:capture:fast    # explicit four-scale PNGs via grim, no clipboard
task qa:visual:capture:release # explicit packaged four-scale PNG capture
task build           # frontend + all release binaries
task core:run        # launch the Core daemon
task shell:run       # rebuild frontend and launch the Shell
task nix:check       # nix flake check
task nix:build       # nix build
```

Use separate terminals for the two running processes. `XDG_RUNTIME_DIR` must point to the active user session runtime directory. The Shell returns an explicit error when its UI resources are missing. `KIRA_UI_DIR` can override the UI directory for development or packaging.

## Review hardening

The Shell WebView only allows navigation to its exact packaged `index.html` URI
and ignores attempts to open a new window. The Rust bridge allowlists read-only queries plus one narrowly scoped
`focus_workspace` action by an already known Niri workspace ID. This is defense-in-depth for trusted UI code,
not a security boundary for untrusted extensions.

Core now bounds individual JSON-RPC messages to 4096 bytes and removes the
Unix socket it owns after SIGINT/SIGTERM, checking inode identity first. The
preview traps SIGTERM and terminates process groups even when their leaders
have already exited, reducing the chance of orphaned processes.

## Core ⇄ Shell ⇄ Svelte bridge

Svelte uses the typed SDK at `frontend/src/lib/sdk/core.ts`, sending JSON-RPC requests to `window.webkit.messageHandlers.kira.postMessage`. The Rust Host forwards read-only `ping`, `get_state`, `get_workspaces`, `get_config`, plus a single validated `focus_workspace` request over Unix Domain Socket on a worker thread. Its GTK main loop returns replies as `kira:rpc` events.

The SDK correlates numeric request IDs, applies timeouts, and reports disconnected Core as an error. Browser-only Vite preview has no WebKit bridge and displays `Core: unavailable` rather than a fake connection.

```json
{"jsonrpc":"2.0","id":1,"method":"ping"}
```

```json
{"jsonrpc":"2.0","id":1,"result":"pong"}
```

The IPC transport uses newline-delimited JSON. The bootstrap `get_state` response contains version and status only. Niri workspaces now update through Core's Niri EventStream and a persistent read-only Core → Shell subscription, forwarded as typed `kira:workspaces` WebKit DOM events to Svelte. The Core socket is intended for the trusted local user session only.

## Read-only Niri workspaces (Stage 1 first increment)

Kira Core connects to the exact absolute `NIRI_SOCKET` supplied by its
environment. The nested preview ensures the value points to its **child**
compositor, never the parent. With no Niri socket, Core still serves
`ping` and `get_state`, while `get_workspaces` returns
`{"connected":false,"workspaces":[]}`, **not** hardcoded workspace 1–3.

Core primarily reads the Niri `"EventStream"` and its full initial
`WorkspacesChanged` snapshot plus subsequent `WorkspaceActivated` and
`WorkspaceUrgencyChanged` events. The **only** available action is `FocusWorkspace` by stable workspace ID,
requested explicitly through a mouse click. No move/window/output/configuration
or arbitrary Action request is accepted. On disconnect or malformed events,
Core clears stale state and reconnects with a one-second delay.

The public Core contract is:

```json
{"jsonrpc":"2.0","id":2,"method":"get_workspaces"}
```

Example (illustrative values; not fabricated in the actual UI):

```json
{
  "jsonrpc": "2.0",
  "id": 2,
  "result": {
    "connected": true,
    "workspaces": [
      {
        "id": "42",
        "idx": 1,
        "name": null,
        "output": "DP-1",
        "is_active": true,
        "is_focused": true,
        "is_urgent": false
      }
    ]
  }
}
```

`id` is a stable Niri `u64` serialized to a **string** so JavaScript
never rounds it. `idx` is the workspace position **per output**, not a
global identifier. `is_active` and `is_focused` are distinct: on multiple
outputs each can have an active workspace but only one is globally focused.
Unknown Niri event variants are ignored; message size is bounded.

The Shell allows the read-only `get_workspaces` RPC plus the exact
`focus_workspace` method, blocking all other write-like operations. The Svelte Top Bar renders real workspace names/indices,
focus/activation/urgency, or an explicit `NIRI OFFLINE` state; it no longer
uses the fake `[1, 2, 3]` visual demo. **Core listens to events**;
the frontend receives a pushed snapshot whenever Core detects a change.
Core-to-UI workspace subscriptions are now implemented; updates use a persistent read-only Core socket and WebKit DOM events.

### Click to focus a workspace

The top bar workspace chips are now accessible buttons. Left-click or
keyboard-activate a nonfocused workspace to send the single
`focus_workspace` JSON-RPC request:
`{"jsonrpc":"2.0","id":5,"method":"focus_workspace","params":{"id":"42"}}`.

**IDs must be decimal strings** (u64), not indexes, so changing output
order or multiple outputs with workspace index 1 do not target the
wrong workspace. Core verifies that Niri is connected, that the
workspace ID exists in the current snapshot, and that the parameters
contain **only** the `id`. It then sends the single Niri IPC
`Action.FocusWorkspace.reference.Id` request over the exact
`NIRI_SOCKET` already supplied to Core. The WebKit bridge explicitly
allowlists only this action, not generic Niri requests or shell commands.

The widget does not invent a new focused state after a click; it waits
for Niri's EventStream. Disabled/offline/current chips do not send
actions, and a rejected action shows `WS !` with a diagnostic tooltip.
Keyboard shortcuts remain independent and work as before. The
isolated preview continues pointing Core to the child Niri socket,
so this action cannot target the parent compositor in preview.

### Immediate Core → Shell → Svelte workspace updates

The shell opens exactly one persistent Core IPC subscription with the internal
`subscribe_workspaces` request (newline-delimited JSON-RPC, id `0`). Core
sends an initial typed `WorkspaceState` snapshot, then another frame each
time Niri changes its workspace state. The GTK Shell reads the socket on a
worker thread and dispatches a `kira:workspaces` DOM CustomEvent on its
main thread. Svelte subscribes on mount, unsubscribes on cleanup, and makes
one initial `get_workspaces` request only to cover any startup race.

**There is no 1.5-second Svelte polling timer anymore.** Core reconnects
to Niri after a disconnect; Shell reconnects to Core and pushes
`connected:false` while unavailable so the UI does not retain stale state.
`subscribe_workspaces` is an internal Core socket operation and is *not*
exposed to WebKit's JS request allowlist. Kira sends only Niri `FocusWorkspace` for a user-clicked stable workspace ID; no other Niri actions are supported.

This removes the artificial 1–2 second lag. Actual latency and keyboard
focus transitions still require an interactive NixOS/Wayland check.

### Smoke-test nested Niri workspace state

```sh
nix develop --command task qa:visual:fast
nix develop --command task qa:visual:release
```

Both smoke modes now wait for the Niri event stream's initial workspace
snapshot **through Core's actual `get_workspaces` RPC**. They do not resize
the screen, capture screenshots or modify the host compositor.

For a manual interaction check:

```sh
nix develop --command task dev:preview
```

The generated **nested-only** Niri KDL uses `Mod`, which resolves to
**Alt** in a windowed Niri. This avoids the four-modifier
`Alt+Shift+Ctrl+2` shortcut that could conflict with a host layout switch.

- Focus the **nested Niri** and press **Alt+T** to launch `foot`
  inside it (`foot` is included in `nix develop`).
- Press **Alt+2** to focus workspace 2 and **Alt+T** to open another
  terminal there; **Alt+1/2/3** switches workspace.
- For moving the **focused window**, press **Alt+Ctrl+2** (or **Alt+Ctrl+1** to move it back).
  The bindings use `move-window-to-workspace focus=false N`: the window
  moves, but the focus stays on the original workspace. Switch manually
  with **Alt+1/2** to see the moved window and verify Kira's focus.
- **Alt+Shift+Q** exits nested Niri and cleans up the preview.

Niri dynamically creates and removes empty workspaces; leave a
terminal on each if comparing two persistent workspaces. If the
shortcut is not handled, inspect `echo "$NIRI_SOCKET"` followed by
`niri msg --json workspaces` and `niri msg --json windows` **inside
the nested terminal**. Do not run these commands if that socket is
missing. Compare actual `is_focused` and `is_active` with the Top Bar.

Bindings exist **only** in the throwaway preview config. They do not
change the host Niri or any user config. They do not run when calling
read-only QA smoke, and they do not add workspace actions to Kira Core.
If Niri IPC is unavailable the bar should say `NIRI OFFLINE`.

Official protocol references:
- https://github.com/niri-wm/niri/wiki/IPC
- https://docs.rs/niri-ipc/latest/niri_ipc/enum.Event.html
- https://docs.rs/niri-ipc/latest/niri_ipc/struct.Workspace.html

## Validated KDL settings and hot reload (Stage 2)

Kira Core now accepts `KIRA_CONFIG_FILE=/absolute/path/file.kdl` or
defaults to `$XDG_CONFIG_HOME/kira-desktop/config.kdl`
(`~/.config/kira-desktop/config.kdl` without XDG_CONFIG_HOME).

This release deliberately implements a small **strict KDL profile**,
not every possible KDL expression. Configurable UI properties currently
include compact bar layout, center title, clock seconds, workspace names
and max visible chips. The file is limited to 64 KiB / 128 lines, and
unknown keys or invalid types fail without changing the active config.
`kira-core --check-config /absolute/path` validates offline without
starting Core, Niri or a WebKit window.

Internally Core watches the file every 250ms, publishes the last valid
`ConfigState` (including optional diagnostic) over `get_config` and the
private `subscribe_config` stream. Shell forwards read-only
`kira:config` DOM events. An invalid edit keeps the last good layout,
but shows a `CONFIG !` warning with diagnostics.

The **nested preview** always creates its own temporary editable KDL,
shows its path in the terminal and does not overwrite the user's config.
To test a persistent custom file opt in with absolute `KIRA_CONFIG_FILE`.

See [CONFIG.md](CONFIG.md) for exact supported syntax, safety model,
examples and preview steps. Niri KDL remains a separate compositor
configuration and is not modified by this feature.

## Updating dependencies

The initial lockfiles were generated by `.github/workflows/lockfiles.yml`. Update them deliberately using the appropriate tooling and commit changes together with any required Nix hash update. After dependency changes, trigger the Nix package workflow manually for
the branch before release; PRs no longer start a full native rebuild.

## Next milestones

1. Visual QA for Kira Default across scales and packaged Shell smoke test. The user confirmed prior capture runs, but the PNGs still require visual review. The default QA command is now passive; explicit screenshot capture uses grim without clipboard side effects. See [QA_VISUAL.md](QA_VISUAL.md).
2. Read-only Niri workspace state from Core EventStream is implemented in the Stage 1 draft PR. Core-to-Svelte typed workspace pushes are implemented.
3. Initial strict KDL configuration profile with type validation, Core hot reload and last-good rollback is implemented in draft PR #14; full KDL grammar and custom widget layouts remain future increments.
4. Real workspace, launcher and dock widgets.
5. System-service integrations and user widget loading.

Do not claim implementation or isolation of untrusted plugins until the code and tests exist.


The active Calendar day grid and navigation now live in
`frontend/src/lib/components/CalendarWidget.svelte`, using the pure
`frontend/src/lib/calendar-model.ts`. Vitest checks Gregorian boundaries,
leap years and ISO weeks. `calendar.rs` creates the isolated
WebKit/layer-shell window and validates the copied ISO date with a small
independent leap-year check before touching the system clipboard.
The obsolete duplicate Rust month-grid model has been deleted.


### Content-sized popup geometry

Calendar, System Monitor and Launcher use **natural Svelte content height** rather
than the old 620px fixed GTK window size. `observeOverlaySize` reads the
active widget's root `getBoundingClientRect().height` and sends
`size:<generation>:<height>` through the private, allowlisted WebKit bridge.
Rust rejects stale generations and invalid sizes and clamps GTK's default
height to **70% of the current output's logical height**. The native output
height is passed to Svelte as an absolute CSS-pixel `maxHeight`: never use
`70vh` here, because WebKit viewport height is itself controlled by GTK and
can form a layout feedback loop. Under the cap the window hugs its content;
over it, Calendar/Overview scroll vertically, while Launcher/Processes scroll
their result lists. `ResizeObserver` is disconnected when Svelte unmounts,
and the original single warm WebView and safe center/corner relocation remain.

FILE	docs/QA_VISUAL.md
# Этап 0: Visual QA и проверка Nix-пакета

**Статус:** пользователь успешно запустил предыдущую QA-команду дважды
(2026-11-01: каталоги `20261101-004226-83233` и `20261101-004330-83927`).
По предоставленным логам Nix-пакет собран, автоматический захват завершён и
дочерние процессы остановлены. **Сами PNG не были просмотрены, поэтому
визуальная приёмка остаётся открытой.** Задача: [#10](https://github.com/iivkis/kira-desktop/issues/10).

## Безопасная проверка по умолчанию: без скриншотов

Из существующей графической Wayland-сессии на NixOS:

```sh
nix develop --command task qa:visual:release
```

Команда собирает `nix build .#default`, запускает отдельный оконный Niri,
Core и Shell, дожидается `Svelte entrypoint mounted` и
`Svelte panel DOM verified`, отправляет настоящий `get_state` в Core
через отдельный Unix socket и запрашивает список виртуальных выходов Niri.
После проверки завершает только собственные дочерние процессы.

**Важно:** `qa:visual:release` теперь **не переключает масштабы, не делает
скриншотов, не сохраняет PNG и не копирует ничего в буфер обмена**. Это
проверка работоспособности, а не полноценная визуальная приёмка.

Быстрый вариант (Cargo debug, не проверяет поставляемый Nix-пакет):

```sh
nix develop --command task qa:visual:fast
```

## Снимки экрана: только явный выбор

Для проверки масштабов пользователь **отдельно** запускает:

```sh
nix develop --command task qa:visual:capture:release
```

Для Cargo debug:

```sh
nix develop --command task qa:visual:capture:fast
```

Только эти команды временно меняют масштаб **вложенного** Niri на
100%, 125%, 150% и 200%, записывая по одному PNG на каждом уровне в
`artifacts/visual-qa/<timestamp>-<pid>/`.

Снимки снимаются `grim -o <nested-output> <file>`, работающим через
дочерний `WAYLAND_DISPLAY` с поддержкой `wlr-screencopy`. В отличие от
встроенной команды `niri msg action screenshot-screen`, **grim не
копирует снимок в буфер обмена**. `grim` присутствует в `nix develop`;
при его отсутствии захват завершится ошибкой, без скрытого возврата к
команде Niri, копирующей картинку.

Вместе с PNG сохраняется `manifest.json` (Core, масштаб, разрешение,
SHA-256, `captured_review_pending`). Скриншоты **не выгружаются в GitHub**
и каталог `artifacts/visual-qa/` добавлен в `.gitignore`.
Снимки относятся к изолированному Niri; основная графическая сессия и
конфигурация `~/.config/niri` не меняются.

**Предыдущая версия QA**, запущенная 1 ноября 2026, применяла
`niri msg action screenshot-screen`. Эта команда Niri также копирует
снимок в буфер обмена, что было неожиданным побочным эффектом.
Для новых запусков такое поведение устранено.

## Ручная визуальная приёмка

После явного захвата скриншотов открыть все PNG и проверить:

- Top Bar на верхнем крае, высота 42 логических пикселя, нет обрезанных
  областей, пустых полос и смещений.
- Верхняя панель занимает ровно 42 px: слева синяя зона KIRA с оранжевой
  меткой, в центре чёрная рабочая область, справа более спокойная системная
  область. Нижняя цветная линия не добавляет высоты.
- Выбранное рабочее пространство выделено оранжевым блоком, а остальные
  состояния различимы; нет отдельных тяжёлых рамок или теней у кнопок.
- Справа один вертикально центрированный ряд: READY/STARTING/CORE OFF/
  NIRI OFF, тонкий разделитель и часы. Отдельных заголовков SYSTEM/LOCAL
  больше нет, статус Core не проваливается вниз относительно часов.
- READY показывается только когда Core/Niri подключены **и** получены
  корректные значения CPU и RAM. При ошибках ресурсов вместо READY видны
  LOW DISK / LOW MEM / LOW BAT / BUSY, при отсутствии данных — CHECKING,
  при отсутствии Core/Niri — конкретная ошибка.
- При нажатии на системный статус открывается отдельная GTK-панель.
  Таб 01 OVERVIEW показывает реальные CPU, RAM, swap, размер корневого
  диска, нагрузку 1/5/15, uptime, питание, Core и Niri. Таб 02 PROCESSES
  показывает живые имена процессов, PID, CPU (% всего хоста) и RSS RAM,
  поиск по имени/PID; сортировка кликом по заголовкам PROCESS/PID/CPU/RAM,
  повторный клик меняет направление (↑/↓). Активная колонка оранжевая,
  отдельного ряда SORT нет, неизвестные значения всегда внизу.
  Для календаря и системного монитора проверить отступ сверху 25 вместо
  50 логических пикселей, **естественную** высоту окна до 70% текущего
  монитора. Если содержимое занимает меньше этого лимита, никаких лишних
  прокруток быть не должно; если больше, нижние действия доступны
  прокруткой. Проверить высоту экрана, масштабы и крупные шрифты.
  Проверить переключение вкладок без системного GtkNotebook, чтение
  /proc только при активном PROCESSES, две последовательные пробы для
  CPU, несуществующие процессы, фильтр без совпадений, переполнение 36
  строк и прокрутку, неизвестный RSS как «—», отсутствие действий Kill.
  Проверить исчезновение
  показателей при недоступном /proc без вымышленных нулей, live-обновление,
  закрытие по Esc/повторному клику/потере фокуса, Copy Report и
  взаимоисключение с календарём и Launcher.
  Подсказка Top Bar содержит реальные текущие данные, а не только Core.
  Подсказка часов содержит полную дату.
- При ширине до 540 px здоровая подпись READY скрывается, точка и часы
  остаются, но сообщения об ошибках не скрываются.
- В таб-навигации видно фокус как на выбранном workspace, так и на обычном;
  active/urgent и отключённый Core остаются различимыми.
- На дробных масштабах нет заметного размытия или дробных щелей.
- Цвета соответствуют Kira Default, фокус и выбранное пространство
  различимы не только цветом.
- Дополнительно **вручную** открыть `task dev:preview` и проверить
  узкие и широкие размеры окна (ориентиры 800/1024/1280 пикселей).
  Скриншоты разных scale **не равны** проверке разных ширин.
- Открыть Launcher через кнопку KIRA: проверить чёрный редакционный
  заголовок, синюю рабочую зону, тёмное поле поиска, иконки, боковую
  оранжевую метку выделения, подсказки клавиш, Esc/↑/↓/Enter и ошибку
  запуска. Оранжевый не должен заливать всю строку. Проверить также,
  что окно не резервирует дополнительное место на экране.
- Нажать на часы: проверить отдельное окно под правым краем Top Bar
  без дополнительной резервации экранного пространства, с текущим временем,
  датой и локальным часовым поясом. Часы внутри обновляются каждую секунду.
- Проверить собственную сетку (не GtkCalendar): 6 строк, 7 дней от
  понедельника, ISO-недели, выбор соседнего месяца, навигацию месяц/год,
  клавиши стрелок, PageUp/PageDown, Ctrl+PageUp/Down и Home. Проверить
  февраль 2024/2025, стык декабря/января, ISO-неделю и номер дня года. TODAY возвращает сегодня; COPY DATE отображается простым оранжевым текстом без фона, рамки или нижней линии, как текстовая команда TODAY; клавиатурный фокус видим. COPY DATE копирует
  именно выбранную дату и меняет подпись на COPIED. Проверить Escape,
  повторный клик по часам, закрытие при потере фокуса, взаимодействие с
  Launcher, Tab/focus и узкий монитор.
- После завершения убедиться, что основные приложения Niri не были
  затронуты и остались запущены.

При дефектах оформить отдельный Issue с масштабом, шириной, ожидаемым
результатом и обезличенным кадром (если нужен). **CI и успешный
`manifest.json` не заменяют визуального просмотра.**

## Автоматические тесты

`tests/test_qa_visual.py` проверяет изоляцию Unix sockets, реальный
контракт Core `get_state` с мок-сервером, ожидание Svelte DOM,
read-only smoke без изменения масштаба и без скриншотов, четыре масштаба
только в режиме capture, `grim` без clipboard, PNG и честный
`status: failed` при отказе. Это mock-тесты, без настоящего GPU.

См. также [PREVIEW.md](PREVIEW.md) и [DEVELOPMENT.md](DEVELOPMENT.md).

FILE	docs/SPECIFICATION.md
# Kira Desktop

**Техническая спецификация:** v0.1 (Draft)  
**Целевая платформа:** NixOS / Linux / Wayland  
**Основа:** Niri Wayland Compositor  
**Статус:** идёт bootstrap: созданы Rust Workspace, Core, IPC, Shell Host и Svelte-превью; типизированный WebKit ↔ Core bridge работает, панель визуально проверена во вложенном Niri; Niri IPC и Event Bus ещё не подключены; MVP не готов.

## 1. Цель проекта

Kira Desktop — современное, высокопроизводительное, модульное, декларативное и расширяемое окружение рабочего стола, построенное на Rust и Svelte 5.

Основные требования:

- Декларативная конфигурация через KDL.
- Модульная архитектура и независимые компоненты.
- Пользовательские виджеты и расширения на Svelte 5 / TypeScript.
- Горячая перезагрузка конфигурации и компонентов, где это технически возможно.
- **Премиальная дизайн-система:** визуальная целостность, типографика и качество деталей обязательны для всех поверхностей и виджетов.
- Единая дизайн-система и настраиваемые темы.
- Минимальное потребление ресурсов и высокая отзывчивость.
- Независимость системного ядра от пользовательского интерфейса.
- **NixOS-first:** разработка, сборка и поставка проекта ориентированы прежде всего на NixOS.

## 2. Технологический стек

| Слой | Технологии |
| --- | --- |
| Compositor | Niri |
| Backend | Rust, Tokio |
| Frontend | Svelte 5, TypeScript, Vite |
| UI Components | shadcn-svelte, Tailwind CSS |
| WebView | GTK4, WebKitGTK 6 |
| Wayland | gtk4-layer-shell |
| IPC | Unix Domain Socket, JSON-RPC |
| Configuration | KDL |
| Serialization | Serde |
| System Integration | Niri IPC, D-Bus, PipeWire |
| Build | Cargo Workspace, Vite |
| NixOS build / development | Nix Flakes, `flake.nix`, `nix/package.nix` |
| Task runner | Taskfile (`go-task`) |
| CI | GitHub Actions |

Frontend собирается в статические ресурсы и загружается через WebKitGTK. Tauri, Node.js-сервер и Lua **не используются в runtime**. Node.js допустим только на этапе разработки и сборки frontend.

## 3. Архитектура

Система состоит из двух основных процессов.

### Kira Core (Rust Daemon)

- Управление системным состоянием.
- Интеграция с Niri.
- Управление конфигурацией и расширениями.
- Системные сервисы и Event Bus.
- Предоставление типизированного IPC API.

### Kira Shell (Rust Host + Svelte UI)

- Создание Wayland layer-shell поверхностей.
- Отображение Svelte-компонентов через WebKitGTK.
- Управление панелями, доком и рабочим столом.
- Связь с Kira Core через Unix Domain Socket.

**Схема взаимодействия:**

```text
Svelte UI ↔ WebKit Bridge ↔ Rust Host ↔ Unix Socket ↔ Kira Core ↔ Niri / Linux
```

Kira Core является единым источником системного состояния. UI подписывается на изменения и отправляет команды через типизированный API.

## 4. Структура репозитория и Rust Workspace

**Целевая структура по мере реализации MVP** (не утверждение о существовании всех файлов на этапе Draft):

```text
kira-desktop/
├── Cargo.toml
├── Cargo.lock
├── crates/
│   ├── kira-core/
│   ├── kira-ipc/
│   ├── kira-config/
│   ├── kira-niri/
│   ├── kira-services/
│   └── kira-shell/
├── frontend/
│   ├── src/
│   │   ├── lib/
│   │   │   ├── components/
│   │   │   ├── widgets/
│   │   │   ├── sdk/
│   │   │   └── themes/
│   │   └── surfaces/
│   ├── package.json
│   └── package-lock.json
├── config/
├── nix/
│   └── package.nix
├── flake.nix
├── flake.lock
├── Taskfile.yml
├── .github/
│   └── workflows/
│       └── ci.yml
├── tests/
├── docs/
│   └── SPECIFICATION.md
└── README.md
```

Каждый Rust-крейт имеет конкретную ответственность и публичный API. Новые крейты создаются только при реальной необходимости. `Cargo.lock`, `frontend/package-lock.json` и `flake.lock` фиксируются в Git после создания соответствующих компонентов/lock-файлов.

## 5. Декларативная конфигурация

Конфигурация хранится в `~/.config/kira-desktop/` в формате KDL.

Пример:

```kdl
theme "dark" {
    accent "#fca311ff"
    radius 12
}

surface "topbar" {
    layer "top"
    height 42

    left {
        widget "workspaces"
        widget "launcher"
    }

    center {
        widget "clock"
    }

    right {
        widget "system-tray"
        widget "audio"
    }
}
```

**Требования:**

- Валидация конфигурации до применения.
- Hot Reload без перезапуска оболочки, где это технически возможно.
- Сохранение предыдущего работоспособного состояния при ошибке.
- Настройки виджетов через единый механизм.
- Возможность переопределения стандартных настроек.

## 6. Система виджетов и расширений

Все встроенные и пользовательские виджеты разрабатываются на Svelte 5.

**Технический долг (2026-11-01):** Launcher и System Monitor пока
отрисовываются нативными GTK-виджетами на Rust. Calendar перенесён в
Svelte 5 и отображается в отдельном WebKit/layer-shell окне, но ещё
ожидает визуального QA во вложенном Niri. GTK должен оставаться хостом
окон и системных возможностей. План миграции описан в
[UI_ARCHITECTURE.md](UI_ARCHITECTURE.md).

**Widget SDK** предоставляет:

- Доступ к системному состоянию через типизированный API.
- Подписки на события.
- Команды управления Niri.
- Доступ к темам и UI-компонентам.
- Хранение пользовательских настроек.
- Управление жизненным циклом виджета.

Сторонние виджеты распространяются в виде предварительно собранных JS-модулей с манифестом, версией SDK и декларацией необходимых разрешений.

В первой версии поддерживаются **доверенные** пользовательские расширения. Декларация разрешений сама по себе не является изоляцией. Выполнение недоверенных плагинов требует отдельного механизма (например, отдельных изолированных WebView) и не входит в MVP.

## 7. Инженерные принципы

- **KISS:** минимальное количество абстракций, процессов и зависимостей.
- **DRY:** общие типы, SDK, компоненты и бизнес-логика без дублирования.
- **SOLID:** чёткие границы ответственности, явные интерфейсы, зависимости от контрактов, а не реализаций.
- **Pragmatic Engineering:** простые работающие решения важнее преждевременных обобщений.
- **Modular Composition:** функциональность собирается из независимых заменяемых компонентов с минимальной связанностью.

Дополнительные требования:

- Композиция предпочтительнее наследования и монолитных структур.
- Типизированные ошибки и явная обработка отказов.
- Минимизация глобального изменяемого состояния.
- Стабильные версионированные контракты IPC и Widget SDK.
- Возможность тестирования модулей без запущенного Niri.

## 8. NixOS: разработка, сборка и доставка (обязательное требование)

**NixOS — основная целевая система.** Поддержка других Linux-дистрибутивов возможна в будущем, но не является критерием MVP.

Репозиторий **обязан содержать**:

1. `flake.nix` — декларацию Nix Flake с воспроизводимой средой разработки (`devShells`), проверками (`checks`) и, после появления исходного кода приложения, собираемым пакетом (`packages.default`).
2. `nix/package.nix` — отдельное Nix-выражение для сборки и упаковки Kira Desktop. Nix-сборка должна собирать Rust Core/Shell и production frontend, устанавливать UI-ресурсы и обеспечивать необходимые GTK4/WebKitGTK/Wayland зависимости.
3. `flake.lock` — зафиксированные входные зависимости Flake; файл добавляется и поддерживается после первого `nix flake lock`.

Требования к Nix-сборке:

- Разработка — через `nix develop`; сборка — через `nix build`; проверка Flake — через `nix flake check`.
- Результат финальной сборки — installable-пакет приложения, а не только архив исходников или документации.
- Сборка frontend и backend воспроизводима, зависимости фиксируются lock-файлами; обращение к сети из build sandbox не допускается.
- Системные библиотеки и build-time инструменты объявляются явно; глобально установленные Node.js/Rust не должны быть обязательны в Nix-окружении.
- Приложение должно устанавливаться и запускаться в NixOS с Niri; интеграция с NixOS-модулем может появиться отдельно, без преждевременного усложнения структуры.

**Текущий статус реализации:** Rust Workspace, frontend, lock-файлы и Nix-пакет добавлены. `nix build` и нативная компиляция `kira-shell` прошли GitHub Actions на Linux с зафиксированными зависимостями. Графический запуск и визуальная проверка панели во **вложенной оконной сессии Niri** подтверждены вручную; полноценная системная установка и интеграционные E2E-тесты пока не выполнены. Это не означает готовность MVP: Niri IPC, KDL и система виджетов ещё не реализованы.

## 9. Taskfile: единый интерфейс команд (обязательное требование)

Команды проекта централизуются в корневом `Taskfile.yml` с использованием [Task](https://taskfile.dev/). CI по возможности вызывает **те же** задачи, что доступны локально, без дублирования логики.

Предусмотренные задачи:

| Команда | Назначение |
| --- | --- |
| `task check` | Комплексная проверка репозитория |
| `task spec:check` | Наличие обязательной документации и Nix/CI-файлов |
| `task fmt` | Проверка форматирования Rust |
| `task lint` | Clippy и статическая проверка Svelte/TypeScript |
| `task test` | Rust unit/integration и frontend component tests |
| `task build` | Локальная production-сборка (когда исходники готовы) |
| `task nix:check` | `nix flake check` |
| `task nix:build` | `nix build` |

Taskfile должен ясно указывать, какие проверки ещё нельзя запустить до появления соответствующих исходников. **Отсутствие кода нельзя считать успешно протестированным кодом.** Команды сборки должны возвращать ошибку до появления необходимой структуры.

## 10. Тестирование и качество

- **Unit Tests:** конфигурация, бизнес-логика, обработчики команд.
- **Integration Tests:** IPC, сервисы, взаимодействие между крейтами.
- **Contract Tests:** соответствие Rust API и TypeScript SDK.
- **Component Tests:** Svelte-компоненты и пользовательские виджеты.
- **E2E Tests:** запуск оболочки и поверхностей в тестовой Wayland-сессии.

По мере реализации CI должен выполнять:

- `cargo fmt --all -- --check`;
- `cargo clippy --workspace --all-targets -- -D warnings`;
- `cargo test --workspace --all-targets`;
- проверку TypeScript/Svelte;
- тесты frontend;
- production-сборку frontend и проекта.

**Лёгкий CI обязателен** в `.github/workflows/ci.yml` на `push` и `pull_request`. Начальный GitHub Actions workflow выполняет `task check`, всегда валидирует структуру спецификации и условно активирует Rust/frontend-проверки после появления соответствующих компонентов. Тяжёлые NixOS/Wayland E2E-тесты можно вынести в отдельный этап, не утяжеляя базовый CI.

Frontend должен предоставлять npm scripts `check`, `test:ci`, `build`, которые вызываются Taskfile. CI не должен притворяться, что Rust/frontend-тесты уже выполняются до появления исходного кода.

## 11. MVP

Первая версия должна включать:

1. Rust Core и Shell Host.
2. Unix Socket IPC и типизированный Svelte SDK.
3. KDL Config Engine с Hot Reload.
4. Top Bar и Workspaces.
5. Application Launcher.
6. Dock и Clock.
7. Премиальную дизайн-систему и темы с обязательной палитрой по умолчанию (раздел 15).
8. Загрузку пользовательских Svelte-виджетов.
9. Автоматизированные тесты основных компонентов.
10. Сборку и запуск на NixOS через Nix Flake.
11. Taskfile и работающий лёгкий CI.

## 12. Критерии готовности MVP

- Shell запускается поверх Niri на NixOS без Tauri.
- Панель корректно использует Wayland layer-shell.
- Изменение KDL обновляет UI без полной перезагрузки процесса.
- Системные события передаются из Rust в Svelte.
- Пользовательский виджет устанавливается без пересборки Kira Desktop.
- Ошибка отдельного виджета не должна приводить к завершению Kira Core.
- Критическая системная логика покрыта автоматизированными тестами.
- `nix build` создаёт запускаемый пакет с собранным frontend; `nix develop` предоставляет все build-time инструменты.
- `task check` и CI выполняют реальные тесты добавленных Rust/TypeScript компонентов.
- Стандартные поверхности и виджеты соответствуют дизайн-системе раздела 15: премиальное визуальное качество, семантические токены, читаемость, клавиатурная навигация и reduced motion.

## 13. Главный архитектурный принцип

*Kira Desktop — это не монолитное приложение, а композиция независимых системных сервисов и интерфейсных компонентов.*

**Rust отвечает за возможности системы. Svelte 5 отвечает за интерфейс. KDL определяет декларативное состояние рабочего стола. Nix обеспечивает воспроизводимую разработку и поставку для NixOS.**


## 14. Безопасное локальное превью (Developer Experience)

Разработка и проверка поверхностей выполняются без замены основного рабочего
окружения через команду `task dev:preview`.

- Превью использует вложенный Niri в оконном режиме с временной KDL-конфигурацией.
- Shell получает только фактический Wayland-дисплей дочернего Niri.
- Core использует отдельный IPC-сокет, задаваемый `KIRA_CORE_SOCKET`.
- GTK Host использует отдельный экземпляр приложения при `KIRA_PREVIEW=1`.
- Завершение превью останавливает только его собственные процессы.
- Команда не выполняет `nixos-rebuild switch`, не меняет системные службы
  и не редактирует настройки основного Niri.
- Изоляция ограничена композитором и процессами. Это не полноценная VM.

Подробная инструкция: [PREVIEW.md](PREVIEW.md).

## 15. Премиальный UI и фирменная палитра (обязательное требование)

### 15.1. Визуальный характер

**Kira Desktop должен выглядеть премиально:** современно, сдержанно,
элегантно, цельно и внимательно к деталям. Это обязательный критерий
качества, а не необязательное дизайнерское пожелание.

- **Чистая визуальная иерархия.** Основные действия и системное состояние
  читаются сразу, вторичные элементы не перегружают экран.
- **Единый ритм.** Базовый шаг отступов 4 px, предпочтительно кратные
  8 px; согласованные радиусы, высоты, выравнивание и размеры элементов.
- **Типографика.** Разборчивые шрифты, ограниченное количество начертаний,
  аккуратные интервалы, продуманная иерархия.
- **Материалы и глубина.** Сдержанные поверхности, деликатные границы,
  тени и полупрозрачность лишь при наличии функциональной пользы. Никакого
  декоративного шума и злоупотребления blur/градиентами.
- **Плавность.** Короткие, ненавязчивые переходы, ориентир 120–220 мс;
  обязательно учитывать `prefers-reduced-motion`.
- **Согласованность.** Top Bar, Dock, Launcher, уведомления, меню,
  настройки и виджеты образуют одну дизайн-систему со всеми состояниями:
  default, hover, focus, active, disabled, loading, error.
- **KISS.** Минимум необходимой сложности: понятные функции, явные состояния,
  отсутствие дополнительных уровней абстракции ради самих абстракций.
- **DRY.** Общие дизайн-токены и одинаковая инфраструктура живут в одном
  месте; различающуюся логику компонентов не объединять искусственно.
- **Практичность.** Премиальный вид не может ухудшать отзывчивость,
  доступность, контрастность или клавиатурное управление.

### 15.2. Каноническая палитра Kira Default

По умолчанию используется **тёмная тема Kira Default** из **ровно пяти**
базовых цветов с непрозрачным альфа-каналом `ff`, заданных владельцем проекта:

| Имя | HEX RGBA | RGB | Назначение |
| --- | --- | --- | --- |
| **Black** | `#000000ff` | `rgb(0, 0, 0)` | Главный фон и текст на оранжевых элементах |
| **Prussian Blue** | `#14213dff` | `rgb(20, 33, 61)` | Поверхности, структура |
| **Orange** | `#fca311ff` | `rgb(252, 163, 17)` | Выделение, активные элементы, фокус |
| **Alabaster Grey** | `#e5e5e5ff` | `rgb(229, 229, 229)` | Вторичный текст и границы |
| **White** | `#ffffffff` | `rgb(255, 255, 255)` | Основной текст на тёмном фоне |

Каноническая машинно-читаемая запись:

```json
{
  "Black": "#000000ff",
  "Prussian Blue": "#14213dff",
  "Orange": "#fca311ff",
  "Alabaster Grey": "#e5e5e5ff",
  "White": "#ffffffff"
}
```

CSV, массивы, XML и другие формы являются представлениями **той же**
палитры. Базовые цвета в компонентах не хардкодятся. Дополнительные оттенки
разрешены только как вычисляемые смеси/прозрачности этих пяти значений.
Пользовательские переопределения темы через KDL остаются будущей задачей.

### 15.3. Семантические токены

Все компоненты обязаны использовать семантические CSS-переменные.
В дополнение к исходным `--black`, `--prussian-blue`, `--orange`,
`--alabaster-grey` и `--white` определены роли:

| CSS-токен | Значение в Kira Default | Роль |
| --- | --- | --- |
| `--kira-color-background` | `var(--black)` | Фон |
| `--kira-color-surface` | `var(--prussian-blue)` | Поверхности |
| `--kira-color-muted` | `var(--alabaster-grey)` | Вторичный текст |
| `--kira-color-accent` | `var(--orange)` | Выделение и фокус |
| `--kira-color-text` | `var(--white)` | Основной текст |
| `--kira-color-on-accent` | `var(--black)` | Контрастный текст на Orange |
| `--kira-color-earth` | `var(--prussian-blue)` | Совместимый псевдоним |

Для hover, border, disabled и overlay допустимы производные оттенки.
GTK Launcher использует ту же палитру через именованные цвета CSS.

### 15.4. Контрастность и доступность

Примеры сочетаний (WCAG, относительные контрастные отношения):

| Текст / фон | Контраст | Применение |
| --- | --- | --- |
| White / Black | **21.00:1** | Основной текст |
| White / Prussian Blue | **15.97:1** | Основной текст на поверхности |
| Alabaster Grey / Black | **16.67:1** | Вторичный текст |
| Alabaster Grey / Prussian Blue | **12.68:1** | Вторичный текст на поверхности |
| Orange / Black | **10.39:1** | Акцент на фоне |
| Orange / Prussian Blue | **7.90:1** | Акцент на поверхности |
| Black / Orange | **10.39:1** | Текст на активном workspace |

**White / Orange** имеет контраст всего **2.02:1**; на оранжевых
элементах используется чёрный текст, не белый.

Критерии приёмки:

- Контраст обычного текста не ниже **4.5:1**, крупного текста и
  значимых нетекстовых элементов управления не ниже **3:1** там,
  где соответствуют требованиям WCAG.
- Активное состояние, выбор и фокус различимы **не только цветом**.
- Клавиатурная навигация, видимый focus indicator, корректные
  состояния элементов и `prefers-reduced-motion` обязательны.
- Финальные поверхности проходят визуальную проверку во вложенном
  Niri при различных размерах и масштабах дисплея. Успешный CI сам
  по себе не подтверждает премиальный визуальный результат.

**Статус реализации:** фирменные токены Kira Default, Top Bar и Calendar на
Svelte 5 + Tailwind CSS v4, нативный GTK Launcher, отдельный WebKit-хост Calendar
реализованы. Внедрена базовая клавиатурная навигация. Это **не означает
завершённой визуальной приёмки**: проверка размеров, масштабов,
локализации и всех интерактивных состояний остаётся открытой. Dock,
уведомления, настройки и пользовательские темы относятся к будущим этапам.
Текущие замечания и приоритеты ревью: [VISUAL_REVIEW.md](VISUAL_REVIEW.md).

Практические правила и API токенов: [DESIGN_SYSTEM.md](DESIGN_SYSTEM.md).

