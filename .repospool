import { describe, expect, it } from 'vitest';
import { visibleWorkspaceWindow } from './workspace-window';
import type { Workspace } from './sdk/core';

function ws(i: number, focused = false): Workspace {
  return {
    id: String(i), idx: i, name: i === 3 ? 'edit' : null,
    output: 'DP-1', is_active: focused, is_focused: focused, is_urgent: false,
  };
}

describe('Niri workspace display window', () => {
  it('preserves the full Niri list when no workspaces are hidden', () => {
    const apps = [ws(1), ws(2, true)];
    expect(visibleWorkspaceWindow(apps, 8))
      .toEqual({ items: apps, before: 0, after: 0, beforeUrgent: false, afterUrgent: false });
  });
  it('always keeps real focus visible with honest hidden counts', () => {
    const entries = [1, 2, 3, 4, 5, 6].map(i => ws(i, i === 5));
    const visible = visibleWorkspaceWindow(entries, 3);
    expect(visible.items.map(item => item.id)).toEqual(['3', '4', '5']);
    expect(visible.before).toBe(2);
    expect(visible.after).toBe(1);
    expect(visible.beforeUrgent).toBe(false);
    expect(visible.afterUrgent).toBe(false);
  });
  it('surfaces urgent Niri workspaces hidden to either side without inventing windows', () => {
    const entries = [1, 2, 3, 4, 5, 6].map(i => ws(i, i === 4));
    entries[0].is_urgent = true;
    entries[5].is_urgent = true;
    const windowed = visibleWorkspaceWindow(entries, 2);
    expect(windowed.items.map(item => item.idx)).toEqual([3, 4]);
    expect(windowed.before).toBe(2);
    expect(windowed.after).toBe(2);
    expect(windowed.beforeUrgent).toBe(true);
    expect(windowed.afterUrgent).toBe(true);
    entries[0].is_urgent = false;
    expect(visibleWorkspaceWindow(entries, 2).beforeUrgent).toBe(false);
  });

  it('handles no focused workspace and bounds the configured limit', () => {
    const entries = [1, 2, 3, 4].map(i => ws(i));
    expect(visibleWorkspaceWindow(entries, 2)).toEqual({
      items: entries.slice(0, 2), before: 0, after: 2,
      beforeUrgent: false, afterUrgent: false,
    });
    expect(visibleWorkspaceWindow(entries, Number.NaN).items).toHaveLength(1);
    expect(visibleWorkspaceWindow(entries, 0).items).toHaveLength(1);
    expect(visibleWorkspaceWindow(entries, 999).items).toHaveLength(4);
    expect(entries).toHaveLength(4);
  });
});

FILE	frontend/src/lib/workspace-window.ts
import type { Workspace } from './sdk/core';

/** Niri's focused workspace must remain visible when the KDL limit hides
 * some entries. Counts refer only to omitted workspaces, never windows.
 */
export interface WorkspaceWindow {
  items: Workspace[];
  before: number;
  after: number;
  beforeUrgent: boolean;
  afterUrgent: boolean;
}

export function visibleWorkspaceWindow(
  workspaces: readonly Workspace[], limit: number,
): WorkspaceWindow {
  const count = Number.isFinite(limit)
    ? Math.max(1, Math.min(32, Math.trunc(limit))) : 1;
  const focus = workspaces.findIndex(workspace => workspace.is_focused);
  const start = Math.min(
    Math.max(0, focus - count + 1),
    Math.max(0, workspaces.length - count),
  );
  const items = workspaces.slice(start, start + count);
  return {
    items,
    before: start,
    after: Math.max(0, workspaces.length - start - items.length),
    beforeUrgent: workspaces.slice(0, start).some(item => item.is_urgent),
    afterUrgent: workspaces.slice(start + items.length).some(item => item.is_urgent),
  };
}

FILE	frontend/src/main.ts
import { flushSync, mount, unmount } from 'svelte';
import App from './App.svelte';
import CalendarWidget from './lib/components/CalendarWidget.svelte';
import SystemWidget from './lib/components/SystemWidget.svelte';
import LauncherWidget from './lib/components/LauncherWidget.svelte';
import SettingsWidget from './lib/components/SettingsWidget.svelte';
import { closeCalendarOverlay, copyCalendarDate, closeSystemOverlay, copySystemReport, setSystemMonitorTab, closeLauncherOverlay, detachOverlay, notifyCalendarHostReady, notifyCalendarMounted, notifyOverlayMotion } from './lib/sdk/core';
import { createLazyWidget } from './lib/lazy-widget';
import { observeOverlaySize } from './lib/overlay-size';
import { startUi, whenDocumentReady } from './lib/bootstrap';
import './style.css';

function report(message: string): void {
  try {
    window.webkit?.messageHandlers?.kiraDiagnostics?.postMessage(message);
  } catch {
    // Diagnostic transport is best-effort and must not break the UI.
  }
}

Reflect.set(window, '__kiraEntryStarted', true);
report('Svelte entrypoint evaluating; document.readyState=' + document.readyState);

// The inline bundle is a classic <script> in <head>; wait for #app.
// The shared overlay page is bootstrapped without mounting any Svelte widget.
whenDocumentReady(document, () => {
  report('Svelte bootstrap after DOMContentLoaded; readyState=' + document.readyState);
  const target = document.getElementById('app');
  if (document.documentElement.dataset.kiraSurface === 'calendar') {
    if (!target) {
      report('Calendar bootstrap failure: #app missing');
      return;
    }
    let requestedKind: 'calendar' | 'system' | 'launcher' | 'settings' = 'calendar';
    let visibleGeneration: number | null = null;
    let lastGeneration = 0;
    const host = createLazyWidget(
      async () => {
        // Both components are prebundled, but neither owns DOM, timers or
        // subscriptions until its popup is explicitly requested.
        const kind = requestedKind;
        let stopSizing: (() => void) | null = null;
        return {
          mount() {
            // Commands capture THIS generation, not the mutable current one.
            // A late callback from a recycled slot can never close a newer
            // widget or change its subscriptions.
            const lease = visibleGeneration ?? 0;
            const instance = kind === 'calendar'
              ? mount(CalendarWidget, {
                target,
                props: {
                  onClose: () => closeCalendarOverlay(lease),
                  onPopout: () => detachOverlay(lease),
                  generation: lease,
                  onCopy: (date: string) => copyCalendarDate(lease, date),
                },
              })
              : kind === 'system'
                ? mount(SystemWidget, {
                  target,
                  props: {
                    onClose: () => closeSystemOverlay(lease),
                    onPopout: () => detachOverlay(lease),
                    generation: lease,
                    onCopy: () => copySystemReport(lease),
                    onTab: (tab: 'overview' | 'processes') => setSystemMonitorTab(lease, tab),
                  },
                })
                : kind === 'settings'
                  ? mount(SettingsWidget, { target, props: {
                      onClose: () => closeCalendarOverlay(lease),
                      onPopout: () => detachOverlay(lease),
                      generation: lease,
                    } })
                  : mount(LauncherWidget, { target, props: {
                      onClose: () => closeLauncherOverlay(lease),
                      onPopout: () => detachOverlay(lease),
                      generation: lease,
                    } });
            flushSync();
            const label = kind === 'calendar' ? 'Kira Calendar' : kind === 'system' ? 'Kira System Monitor' : kind === 'settings' ? 'Kira Settings' : 'Kira Launcher';
            if (!target.querySelector('main[data-kira-ui-root][aria-label="' + label + '"]')) {
              throw new Error('Svelte ' + kind + ' root missing after mount');
            }
            return instance;
          },
          unmount(instance: ReturnType<typeof mount>) {
            stopSizing?.();
            stopSizing = null;
            return unmount(instance);
          },
          onMounted(generation: number) {
            const root = target.querySelector<HTMLElement>('main[data-kira-ui-root]');
            if (!root) throw new Error('Overlay root missing when measuring size');
            // Bind the native visibility acknowledgement to this exact
            // Svelte generation; stale GTK callbacks cannot animate
            // whichever overlay happens to be mounted next.
            root.dataset.kiraGeneration = String(generation);
            // Size must reach GTK before mounted, otherwise a 1px popup
            // could become visible before the first actual resize.
            stopSizing = observeOverlaySize(root, generation);
            report('Overlay Svelte ' + kind + ' mounted; generation=' + generation);
            notifyCalendarMounted(generation, window.matchMedia('(prefers-reduced-motion: reduce)').matches);
          },
        };
      },
      (error) => report('Overlay lazy mount/unmount failed: ' + String(error)),
    );
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionPreference.addEventListener('change', () => {
      if (visibleGeneration !== null) notifyOverlayMotion(visibleGeneration, motionPreference.matches);
    });
    window.addEventListener('kira:overlay:show', (event: Event) => {
      const detail = (event as CustomEvent<{ kind: string; generation: number; maxHeight: number }>).detail;
      if ((detail?.kind !== 'calendar' && detail?.kind !== 'system' && detail?.kind !== 'launcher' && detail?.kind !== 'settings') ||
          !Number.isSafeInteger(detail.generation) || detail.generation <= 0 ||
          detail.generation > 0xffffffff || detail.generation <= lastGeneration ||
          !Number.isSafeInteger(detail.maxHeight) || detail.maxHeight < 1 ||
          detail.maxHeight > 20000) {
        report('Overlay rejected invalid or stale show payload');
        return;
      }
      // An output-sized limit in absolute CSS pixels prevents the layout
      // from feeding WebKit's own changing viewport dimensions back into
      // the popup height (which otherwise causes resize oscillation).
      document.documentElement.style.setProperty('--kira-overlay-max-height', detail.maxHeight + 'px');
      lastGeneration = detail.generation;
      visibleGeneration = detail.generation;
      report('Overlay received show: ' + detail.kind + ' generation=' + detail.generation);
      requestedKind = detail.kind;
      host.show(detail.generation);
    });
    window.addEventListener('kira:overlay:hide', (event: Event) => {
      const generation = (event as CustomEvent<{ generation: number }>).detail?.generation;
      if (generation !== visibleGeneration) {
        report('Overlay ignored stale hide generation=' + generation);
        return;
      }
      visibleGeneration = null;
      host.hide();
    });
    // Remove the HTML fallback so no widget DOM remains when hidden.
    target.querySelector('#kira-loading')?.remove();
    Reflect.set(window, '__kiraMountReturned', true);
    report('Overlay host ready; no widget mounted');
    notifyCalendarHostReady();
    return;
  }

  const mounted = startUi(
    target,
    (container) => {
      mount(App, { target: container });
      flushSync();
    },
    report,
  );
  Reflect.set(window, '__kiraMountReturned', mounted);
  if (mounted) report('Svelte entrypoint mounted');
});

FILE	frontend/src/style.css
@import "tailwindcss";
@import "./lib/themes/kira-default.css";

/* Tailwind v4 CSS-first theme. The canonical palette remains in
 * kira-default.css; semantic aliases let KDL themes evolve independently. */
@theme inline {
  --color-kira-bg: var(--kira-color-background);
  --color-kira-surface: var(--kira-color-surface);
  --color-kira-surface-soft: var(--kira-color-surface-subtle);
  --color-kira-muted: var(--kira-color-muted);
  --color-kira-text: var(--kira-color-text);
  --color-kira-accent: var(--kira-color-accent);
  --color-kira-on-accent: var(--kira-color-on-accent);
  --font-sans: Inter, "Segoe UI Variable", "Noto Sans", system-ui, sans-serif;
}

@layer base {
  :root {
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    color: var(--kira-color-text);
    background: var(--kira-color-background);
  }

  html, body, #app {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Desktop widgets are controls, not selectable web documents.
   * This covers the Top Bar and every lazy Svelte overlay (Calendar,
   * System Monitor and Launcher). Keep editable text selectable so
   * typing, selection, cut/copy/paste and input IME still behave normally. */
  #app {
    -webkit-user-select: none;
    user-select: none;
  }

  #app :is(input, textarea, [contenteditable]:not([contenteditable="false"])),
  #app [contenteditable]:not([contenteditable="false"]) * {
    -webkit-user-select: text;
    user-select: text;
  }

  /* Top Bar stays full-height within its own WebKit surface.
   * Overlay documents must have an intrinsic page height instead.
   * Otherwise html/body/#app's 100% viewport height forces every
   * popup to the previous window size regardless of Svelte content. */
  html[data-kira-surface="calendar"],
  html[data-kira-surface="calendar"] body,
  html[data-kira-surface="calendar"] #app {
    height: auto;
    min-height: 0;
    overflow: visible;
  }

  /* A transparent popup backing surface is essential: otherwise the native
   * WebKit full-window black fills pixels before the TENET reveal clip opens.
   * The actual widget <main> remains opaque black, and the Top Bar is
   * unaffected by this selector. The clip changes only painted pixels,
   * never intrinsic dimensions, layer-shell anchors or pointer geometry. */
  html[data-kira-surface="calendar"],
  html[data-kira-surface="calendar"] body,
  html[data-kira-surface="calendar"] #app {
    background: transparent;
  }

  /* TENET clips <main>, so silhouette shadows belong to its transparent
   * wrapper. Reserve room on ALL edges for the soft black falloff, plus
   * the short black/dark-orange offsets at the right and bottom. Only
   * transient popups get these insets; the Top Bar stays untouched. */
  html[data-kira-surface="calendar"]:not([data-kira-detached="true"]) #app {
    padding: var(--kira-widget-shadow-offset);
    filter:
      drop-shadow(var(--kira-widget-shadow-black))
      drop-shadow(var(--kira-widget-shadow-accent))
      drop-shadow(var(--kira-widget-shadow-soft));
  }

  html[data-kira-surface="calendar"] main[data-kira-ui-root] {
    max-height: calc(var(--kira-overlay-max-height, 560px) - var(--kira-widget-shadow-offset) - var(--kira-widget-shadow-offset));
    /* Calendar/Overview use page scrolling; Launcher and Processes
     * keep their own list scrollers inside a constrained flex column. */
  }

  /* A promoted WebView keeps its DOM, but now fills a normal, resizable
   * Niri xdg-toplevel rather than constraining a layer-shell popup. */
  html[data-kira-detached="true"],
  html[data-kira-detached="true"] body,
  html[data-kira-detached="true"] #app {
    height: 100%;
    overflow: hidden;
    background: var(--kira-color-background);
  }

  /* Niri owns decorated/tiling-window shadows. Never add the popup's
   * layered shadows or transparent gutter inside a detached window. */
  html[data-kira-detached="true"] #app {
    padding: 0;
    filter: none;
  }

  html[data-kira-detached="true"] main[data-kira-ui-root] {
    height: 100%;
    max-height: 100vh;
  }

  /* Calendar preserves all six ISO weeks within a height-capped native
   * overlay. Hide only the scrollbar chrome, never the scroll behavior. */
  .kira-calendar-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-y: contain;
  }

  .kira-calendar-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* The launcher list still scrolls with mouse wheel, touchpad and
   * keyboard, but a WebKitGTK scrollbar must not overlap the right edge
   * of the highlighted row. Keep this scoped to Launcher only. */
  .kira-launcher-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .kira-launcher-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* Hide WebKitGTK's heavy scrollbar chrome on the System Monitor only.
   * Wheel, touchpad, arrow keys and nested process scrolling remain usable.
   * Do not disable overflow or clip content to make the scrollbar disappear.
   */
  .kira-monitor-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-y: contain;
  }

  .kira-monitor-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* Keep an explicit keyboard-visible outline even outside our components. */
  :focus-visible {
    outline-color: var(--kira-color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

/* Settings is intentionally wider than other widgets but has a stable
 * size. After promotion to Niri it occupies the full resizable WebView. */
.kira-settings {
  height: min(560px, calc(var(--kira-overlay-max-height, 560px) - var(--kira-widget-shadow-offset) - var(--kira-widget-shadow-offset)));
}
html[data-kira-detached="true"] .kira-settings {
  height: 100%;
  max-height: 100vh;
}
.kira-settings-scroll {
  scrollbar-width: thin;
  scrollbar-color: var(--kira-color-muted) transparent;
}

/* A moving solid selection must not turn its new label into black-on-black.
 * Keep actual selection/ARIA immediate; switch foreground contrast only while
 * its ONE orange background is travelling between physical positions.
 * Unlayered so this wins over Tailwind's generated utility color classes.
 */
[data-kira-flow-moving="true"] [data-calendar-selected="true"],
[data-kira-flow-moving="true"] [data-focused="true"] {
  color: var(--kira-color-text);
}
[data-kira-flow-moving="true"] [data-focused="true"] span[aria-hidden="true"] {
  background-color: var(--kira-color-accent);
}

/* The moving light seam follows the materializing physical edge of an
 * opaque popup. It is decorative only, owned by the same GSAP timeline as
 * the surface clip and TENET sections. No animations or infinite repaint. */
[data-kira-surface-seam] {
  position: absolute;
  z-index: 40;
  left: 0;
  right: 0;
  top: 0;
  height: 2px;
  pointer-events: none;
  background: linear-gradient(90deg,
    transparent 0%,
    var(--kira-color-accent) 23%,
    var(--kira-color-text) 54%,
    var(--kira-color-accent) 78%,
    transparent 100%);
  transform-origin: center center;
}

