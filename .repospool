import { afterEach, describe, expect, it, vi } from 'vitest';
import { deliverReply, request, onWorkspaceUpdate } from './core';

const originalWindow = globalThis.window;
afterEach(() => {
  vi.useRealTimers();
  globalThis.window = originalWindow;
});

describe('Core SDK JSON-RPC bridge', () => {
  it('rejects outside the host bridge', async () => {
    await expect(request('ping')).rejects.toThrow('bridge unavailable');
  });

  it('correlates responses by request id', async () => {
    const postMessage = vi.fn();
    // Browser-like mock for the native WebKit postMessage API.
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('get_state');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number; method: string };
    expect(payload.method).toBe('get_state');
    deliverReply({ jsonrpc: '2.0', id: payload.id, result: { version: '0.1.0', status: 'bootstrap' } });
    await expect(result).resolves.toEqual({ version: '0.1.0', status: 'bootstrap' });
  });

  it('requests typed real Niri workspaces with JS-safe IDs', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('get_workspaces');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number; method: string };
    expect(payload.method).toBe('get_workspaces');
    const workspace = {
      id: '18446744073709551615', idx: 2, name: 'code', output: 'DP-1',
      is_active: true, is_focused: false, is_urgent: true,
    };
    deliverReply({
      jsonrpc: '2.0', id: payload.id,
      result: { connected: true, workspaces: [workspace] },
    });
    await expect(result).resolves.toEqual({ connected: true, workspaces: [workspace] });
  });

  it('delivers live workspace events and unsubscribes without polling', () => {
    const handlers = new Map<string, EventListener>();
    const addEventListener = vi.fn((name: string, listener: EventListener) => {
      handlers.set(name, listener);
    });
    const removeEventListener = vi.fn();
    globalThis.window = { addEventListener, removeEventListener } as unknown as Window & typeof globalThis;
    const onChange = vi.fn();
    const stop = onWorkspaceUpdate(onChange);
    const handler = handlers.get('kira:workspaces');
    expect(handler).toBeDefined();
    handler!({ detail: { connected: true, workspaces: [{
      id: '33', idx: 2, name: null, output: 'winit',
      is_active: true, is_focused: true, is_urgent: false,
    }] } } as unknown as Event);
    expect(onChange).toHaveBeenCalledOnce();
    expect(onChange.mock.calls[0][0].workspaces[0].idx).toBe(2);
    handler!({ detail: { workspaces: [] } } as unknown as Event);
    expect(onChange).toHaveBeenCalledOnce();
    stop();
    expect(removeEventListener).toHaveBeenCalledWith('kira:workspaces', handler);
  });

  it('rejects Core errors', async () => {
    const postMessage = vi.fn();
    globalThis.window = { webkit: { messageHandlers: { kira: { postMessage } } } } as unknown as Window & typeof globalThis;
    const result = request('ping');
    const payload = JSON.parse(postMessage.mock.calls[0][0] as string) as { id: number };
    deliverReply({ jsonrpc: '2.0', id: payload.id, error: { code: -32000, message: 'unavailable' } });
    await expect(result).rejects.toThrow('unavailable');
  });
});

FILE	frontend/src/lib/sdk/core.ts
/** Typed, request/response bridge for trusted Svelte UI modules. */
export interface CoreState {
  version: string;
  status: 'bootstrap';
}

export interface Workspace {
  /** Stable Niri u64 ID encoded as a string (JavaScript numbers lose precision). */
  id: string;
  /** 1-based workspace position on its own output, NOT a globally unique ID. */
  idx: number;
  name: string | null;
  output: string | null;
  is_active: boolean;
  is_focused: boolean;
  is_urgent: boolean;
}

export interface WorkspaceState {
  connected: boolean;
  workspaces: Workspace[];
}

/** Listen for typed workspace push events emitted by the native Shell.
 * No Niri or Core polling is performed here. Unsubscribe on Svelte unmount.
 */
export function onWorkspaceUpdate(callback: (state: WorkspaceState) => void): () => void {
  if (typeof window === 'undefined') return () => {};
  const listener = (event: Event) => {
    const state = (event as CustomEvent<WorkspaceState>).detail;
    if (!state || typeof state.connected !== 'boolean' ||
        !Array.isArray(state.workspaces)) return;
    callback(state);
  };
  window.addEventListener('kira:workspaces', listener);
  return () => window.removeEventListener('kira:workspaces', listener);
}

type Methods = {
  ping: string;
  get_state: CoreState;
  get_workspaces: WorkspaceState;
};

type RpcReply = {
  jsonrpc: '2.0';
  id: number | null;
  result?: unknown;
  error?: { code: number; message: string };
};

type Bridge = {
  postMessage(message: string): void;
};

declare global {
  interface Window {
    webkit?: { messageHandlers?: { kira?: Bridge; kiraDiagnostics?: Bridge } };
  }
}

let nextId = 0;
const pending = new Map<number, {
  resolve: (value: unknown) => void;
  reject: (reason: Error) => void;
  timeout: ReturnType<typeof setTimeout>;
}>();

/** Deliver a reply from the Rust Host. Exported for contract tests. */
export function deliverReply(reply: RpcReply): void {
  if (reply.jsonrpc !== '2.0' || typeof reply.id !== 'number') return;
  const request = pending.get(reply.id);
  if (!request) return;
  pending.delete(reply.id);
  clearTimeout(request.timeout);
  if (reply.error) request.reject(new Error(`${reply.error.code}: ${reply.error.message}`));
  else request.resolve(reply.result);
}

if (typeof window !== 'undefined') {
  window.addEventListener('kira:rpc', (event: Event) => {
    deliverReply((event as CustomEvent<RpcReply>).detail);
  });
}

/**
 * Asks the Core for an allowlisted read-only method. Resolves only after the Rust
 * Host has returned a response; rejects if Core is unavailable or times out.
 */
export function request<M extends keyof Methods>(method: M): Promise<Methods[M]> {
  const channel = typeof window === 'undefined' ? undefined : window.webkit?.messageHandlers?.kira;
  if (!channel) return Promise.reject(new Error('Kira bridge unavailable (browser preview)'));

  const id = ++nextId;
  return new Promise<Methods[M]>((resolve, reject) => {
    const timeout = setTimeout(() => {
      pending.delete(id);
      reject(new Error('Kira Core request timed out'));
    }, 3000);
    pending.set(id, { resolve: resolve as (value: unknown) => void, reject, timeout });
    try {
      channel.postMessage(JSON.stringify({ jsonrpc: '2.0', id, method }));
    } catch (error) {
      clearTimeout(timeout);
      pending.delete(id);
      reject(error instanceof Error ? error : new Error('Kira bridge failed'));
    }
  });
}

FILE	frontend/src/lib/themes/kira-default.css
/* Kira Default: five canonical base colors, documented in SPECIFICATION §15.
 * Widgets should consume semantic variables, not hardcode theme colors.
 * Secondary surfaces, borders and overlays derive from these five values.
 */
:root {
  color-scheme: dark;

  --kira-color-background: #22223b;
  --kira-color-surface: #4a4e69;
  --kira-color-muted: #9a8c98;
  --kira-color-accent: #c9ada7;
  --kira-color-text: #f2e9e4;

  --kira-color-on-accent: var(--kira-color-background);
  --kira-color-text-secondary: var(--kira-color-muted);
  --kira-color-surface-subtle: color-mix(in srgb, var(--kira-color-surface) 30%, var(--kira-color-background));
  --kira-color-border: color-mix(in srgb, var(--kira-color-surface) 58%, var(--kira-color-background));

  --kira-space-1: 4px;
  --kira-space-2: 8px;
  --kira-space-3: 12px;
  --kira-space-4: 16px;

  --kira-radius-sm: 6px;
  --kira-radius-md: 10px;
  --kira-radius-lg: 12px;

  --kira-motion-fast: 150ms;
  --kira-motion-standard: 200ms;
  --kira-motion-easing: cubic-bezier(0.2, 0.8, 0.2, 1);
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --kira-motion-fast: 0ms;
    --kira-motion-standard: 0ms;
  }
}

FILE	frontend/src/lib/themes/kira-default.test.ts
import { readFileSync } from 'node:fs';
import { describe, expect, it } from 'vitest';
import { kiraDefaultPalette, kiraDefaultRoles } from './kira-default';

const css = readFileSync(new URL('./kira-default.css', import.meta.url), 'utf8');

function luminance(hex: string): number {
  const channels = [1, 3, 5]
    .map((index) => parseInt(hex.slice(index, index + 2), 16) / 255)
    .map((value) => value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4);
  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
}

function contrast(first: string, second: string): number {
  const light = Math.max(luminance(first), luminance(second));
  const dark = Math.min(luminance(first), luminance(second));
  return (light + 0.05) / (dark + 0.05);
}

describe('Kira Default premium design tokens', () => {
  it('contains exactly the five approved canonical base colors', () => {
    expect(Object.values(kiraDefaultPalette)).toEqual([
      '#22223b', '#4a4e69', '#9a8c98', '#c9ada7', '#f2e9e4',
    ]);
    expect(new Set(Object.values(kiraDefaultPalette)).size).toBe(5);
  });

  it('keeps public CSS tokens synchronized with the typed palette', () => {
    for (const [role, value] of Object.entries(kiraDefaultRoles)) {
      const declaration = '--kira-color-' + role + ': ' + value + ';';
      expect(css).toContain(declaration);
    }
    const hexDeclarations = [...css.matchAll(/--kira-color-[\w-]+:\s*(#[0-9a-f]{6})\s*;/g)];
    expect(hexDeclarations).toHaveLength(5);
  });

  it('chooses text/accent pairs that meet WCAG AA', () => {
    const { spaceIndigo, dustyGrape, lilacAsh, almondSilk, parchment } = kiraDefaultPalette;
    expect(contrast(parchment, spaceIndigo)).toBeGreaterThanOrEqual(4.5);
    expect(contrast(parchment, dustyGrape)).toBeGreaterThanOrEqual(4.5);
    expect(contrast(lilacAsh, spaceIndigo)).toBeGreaterThanOrEqual(4.5);
    expect(contrast(spaceIndigo, almondSilk)).toBeGreaterThanOrEqual(4.5);
    expect(contrast(lilacAsh, dustyGrape)).toBeLessThan(4.5);
  });

  it('defines compact spacing, consistent radii and reduced motion', () => {
    expect(css).toContain('--kira-space-1: 4px;');
    expect(css).toContain('--kira-radius-md: 10px;');
    expect(css).toContain('@media (prefers-reduced-motion: reduce)');
    expect(css).toContain('--kira-motion-fast: 0ms;');
  });
});

FILE	frontend/src/lib/themes/kira-default.ts
/** Canonical Kira Default palette. CSS values are contract-tested against this file. */
export const kiraDefaultPalette = Object.freeze({
  spaceIndigo: '#22223b',
  dustyGrape: '#4a4e69',
  lilacAsh: '#9a8c98',
  almondSilk: '#c9ada7',
  parchment: '#f2e9e4',
} as const);

/** Semantic roles shared by the shell and future trusted widgets. */
export const kiraDefaultRoles = Object.freeze({
  background: kiraDefaultPalette.spaceIndigo,
  surface: kiraDefaultPalette.dustyGrape,
  muted: kiraDefaultPalette.lilacAsh,
  accent: kiraDefaultPalette.almondSilk,
  text: kiraDefaultPalette.parchment,
} as const);

export type KiraThemeRole = keyof typeof kiraDefaultRoles;

