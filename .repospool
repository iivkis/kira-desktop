FILE	frontend/scripts/inline-assets.mjs
#!/usr/bin/env node
/**
 * Inline the single production Vite JS/CSS bundles into index.html.
 *
 * WebKitGTK loads the packaged HTML as a self-contained document.
 * Inlining a classic script avoids ES module subrequests and opaque
 * "Script error." failures on some WebKit versions.
 * Fails closed when Vite emits an incompatible/multi-chunk bundle.
 */
import { readFile, writeFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import { Script } from 'node:vm';
import { fileURLToPath } from 'node:url';

const SCRIPT_TAG = /<script\b(?=[^>]*\bsrc\s*=)[^>]*>\s*<\/script>/gi;
const LINK_TAG = /<link\b[^>]*>/gi;

function attribute(tag, name) {
  const pattern = new RegExp("(?:^|\\s)" + name + "\\s*=\\s*(['\"])(.*?)\\1", "i");
  return pattern.exec(tag)?.[2] ?? null;
}

function assetName(reference, kind) {
  // Vite base: './' yields ./assets/<hash>.js / .css.
  // No external URLs, absolute paths, parent traversal or URL fragments.
  const pattern = kind === 'js'
    ? /^\.\/assets\/[A-Za-z0-9_.-]+\.js$/
    : /^\.\/assets\/[A-Za-z0-9_.-]+\.css$/;
  if (!pattern.test(reference)) {
    throw new Error('Unexpected ' + kind + ' asset URL: ' + reference);
  }
  return reference.slice(2);
}

export async function inlineUiAssets(outputDirectory) {
  const directory = resolve(outputDirectory);
  const htmlPath = resolve(directory, 'index.html');
  let html = await readFile(htmlPath, 'utf8');

  const scripts = [...html.matchAll(SCRIPT_TAG)];
  if (scripts.length !== 1) {
    throw new Error('Expected exactly one external Vite JS entrypoint, found ' + scripts.length);
  }

  const scriptTag = scripts[0][0];
  const jsReference = attribute(scriptTag, 'src');
  if (!jsReference) throw new Error('Vite entrypoint has no src');
  const js = await readFile(resolve(directory, assetName(jsReference, 'js')), 'utf8');

  if (/<\/script\b/i.test(js)) {
    throw new Error('Bundled JavaScript includes a closing script tag');
  }
  // A classic script does not use opaque module origins. Do not silently
  // inline a bundle that contains ESM-only syntax.
  new Script('(function(){\n' + js + '\n})();', { filename: jsReference });
  // Inspect the original Vite HTML while discovering styles: strings
  // inside bundled JS must never count as extra stylesheet links.
  const styles = [...html.matchAll(LINK_TAG)]
    .map((match) => match[0])
    .filter((tag) => attribute(tag, 'rel')?.toLowerCase() === 'stylesheet');
  if (styles.length !== 1) {
    throw new Error('Expected exactly one Vite CSS stylesheet, found ' + styles.length);
  }

  const cssReference = attribute(styles[0], 'href');
  if (!cssReference) throw new Error('Vite stylesheet has no href');
  const css = await readFile(resolve(directory, assetName(cssReference, 'css')), 'utf8');
  if (/<\/style\b/i.test(css)) {
    throw new Error('Bundled CSS includes a closing style tag');
  }
  // The replacement argument must be a function. A string replacement
  // expands special dollar substitutions in minified assets, corrupting HTML.
  // A callback inserts bundled asset bytes unchanged.
  html = html.replace(styles[0], () => '<style>\n' + css + '\n</style>');
  html = html.replace(scriptTag, () => '<script>\n(function(){\n' + js + '\n})();\n</script>');

  // Inspect HTML markup, not strings inside the inlined JS or CSS. Vite
  // bundles may legitimately contain literal '<link rel="stylesheet" ...>'
  // snippets, which do not create network requests when inside scripts.
  // Closing script/style tags in bundled assets were already rejected above.
  const markup = html
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '')
    .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, '');
  if (SCRIPT_TAG.test(markup) || [...markup.matchAll(LINK_TAG)]
    .some((match) => attribute(match[0], 'rel')?.toLowerCase() === 'stylesheet')) {
    throw new Error('Unexpected remaining external UI assets');
  }

  await writeFile(htmlPath, html);
  return { scriptBytes: Buffer.byteLength(js), cssBytes: Buffer.byteLength(css) };
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const path = process.argv[2] ?? 'dist';
  inlineUiAssets(path)
    .then(({ scriptBytes, cssBytes }) => {
      console.log('Kira UI: inlined JS (' + scriptBytes + ' B) and CSS (' + cssBytes + ' B)');
    })
    .catch((error) => {
      console.error('Kira UI inlining failed:', error.message);
      process.exitCode = 1;
    });
}

FILE	frontend/scripts/inline-assets.test.mjs
import assert from 'node:assert/strict';
import { mkdtemp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { test } from 'node:test';
import { Script } from 'node:vm';
import { inlineUiAssets } from './inline-assets.mjs';

async function fixture(callback, options = {}) {
  const dir = await mkdtemp(join(tmpdir(), 'kira-inline-test-'));
  try {
    await mkdir(join(dir, 'assets'));
    await writeFile(join(dir, 'index.html'),
      '<!doctype html><html><head>' +
      '<link rel="stylesheet" crossorigin href="./assets/main-A1.css">' +
      '</head><body><div id="app"></div>' +
      '<script type="module" crossorigin src="./assets/main-A1.js"></script>' +
      '</body></html>');
    await writeFile(join(dir, 'assets/main-A1.js'), options.js ?? 'window.kiraReady = true;');
    await writeFile(join(dir, 'assets/main-A1.css'), options.css ?? '.bar{color:white}');
    await callback(dir);
  } finally {
    await rm(dir, { recursive: true, force: true });
  }
}

test('inlines Vite bundles without leaving module subrequests', async () => {
  await fixture(async (dir) => {
    const counts = await inlineUiAssets(dir);
    const html = await readFile(join(dir, 'index.html'), 'utf8');
    assert.ok(counts.scriptBytes > 0);
    assert.ok(counts.cssBytes > 0);
    assert.match(html, /<script>\s*\(function\(\)/);
    assert.match(html, /<style>\s*\.bar/);
    assert.doesNotMatch(html, /type="module"|src="\.\/assets|href="\.\/assets/);
    const bundled = /<script>\n([\s\S]*?)\n<\/script>/.exec(html)?.[1];
    assert.ok(bundled);
    new Script(bundled);
  });
});

test('does not interpolate replacement tokens from Vite JS or CSS into HTML', async () => {
  // Construct these dynamically because the updater itself must not parse
  // replacement syntax in an incoming source payload.
  const dollar = String.fromCharCode(36);
  const tokens = [
    dollar + '&',
    dollar + String.fromCharCode(39),
    dollar + String.fromCharCode(96),
    dollar + dollar,
  ];
  const js = 'window.kiraTokens = ' + JSON.stringify(tokens) + ';';
  const css = ':root::before { content: ' + JSON.stringify(tokens.join('|')) + '; }';
  await fixture(async (dir) => {
    await inlineUiAssets(dir);
    const html = await readFile(join(dir, 'index.html'), 'utf8');
    const script = /<script>\n\(function\(\)\{\n([\s\S]*?)\n\}\)\(\);\n<\/script>/.exec(html)?.[1];
    const style = /<style>\n([\s\S]*?)\n<\/style>/.exec(html)?.[1];
    assert.equal(script, js, 'the JS bundle must survive inlining byte for byte');
    assert.equal(style, css, 'the CSS bundle must survive inlining byte for byte');
    assert.equal((html.match(/<\/script>/g) ?? []).length, 1);
    assert.equal((html.match(/<\/style>/g) ?? []).length, 1);
    new Script(script);
    assert.doesNotMatch(html, /<script src=|<link rel="stylesheet"/);
  }, { js, css });
});

test('allows HTML-like text inside bundled JS without treating it as an external asset', async () => {
  await fixture(async (dir) => {
    const result = await inlineUiAssets(dir);
    assert.ok(result.scriptBytes > 0);
    const html = await readFile(join(dir, 'index.html'), 'utf8');
    assert.match(html, /window\.kiraMarkup/);
  }, { js: 'window.kiraMarkup = \'<link rel="stylesheet" href="https://example.invalid/a.css">\';' });
});

test('rejects an output that cannot run as a classic script', async () => {
  await fixture(async (dir) => {
    await assert.rejects(inlineUiAssets(dir), /Cannot use import statement|Unexpected token/);
  }, { js: 'import {x} from "./other.js";' });
});

test('rejects attempts to leave the output directory', async () => {
  await fixture(async (dir) => {
    const htmlPath = join(dir, 'index.html');
    const html = await readFile(htmlPath, 'utf8');
    await writeFile(htmlPath, html.replace('./assets/main-A1.js', '../outside.js'));
    await assert.rejects(inlineUiAssets(dir), /Unexpected js asset URL/);
  });
});

test('rejects unsafe HTML terminators in bundled assets', async () => {
  await fixture(async (dir) => {
    await assert.rejects(inlineUiAssets(dir), /closing script tag/);
  }, { js: 'console.log("</script>");' });
});

test('refuses to silently accept multiple JS chunks', async () => {
  await fixture(async (dir) => {
    const htmlPath = join(dir, 'index.html');
    const html = await readFile(htmlPath, 'utf8');
    await writeFile(htmlPath, html.replace('</body>',
      '<script type="module" src="./assets/other.js"></script></body>'));
    await assert.rejects(inlineUiAssets(dir), /exactly one external Vite JS entrypoint/);
  });
});

