import type { ProcessRow, SystemMetrics } from './sdk/core';

export type SortField = 'name' | 'pid' | 'cpu' | 'memory' | 'pss';
export type SortState = { field: SortField; descending: boolean };

export const defaultSort: SortState = { field: 'cpu', descending: true };

export function nextSort(current: SortState, field: SortField): SortState {
  return current.field === field
    ? { field, descending: !current.descending }
    : { field, descending: field === 'cpu' || field === 'memory' || field === 'pss' };
}

export function sortedProcesses(rows: ProcessRow[], query: string, state: SortState): ProcessRow[] {
  const q = query.trim().toLocaleLowerCase();
  const compareUnknown = (a: number | null, b: number | null): number => {
    if (a === null) return b === null ? 0 : 1;
    if (b === null) return -1;
    return state.descending ? b - a : a - b;
  };
  return rows.filter(row => !q || row.name.toLocaleLowerCase().includes(q) || String(row.pid).includes(q))
    .sort((a, b) => {
      let delta: number;
      switch (state.field) {
        case 'name':
          delta = a.name.toLocaleLowerCase().localeCompare(b.name.toLocaleLowerCase());
          if (state.descending) delta = -delta;
          break;
        case 'pid':
          delta = state.descending ? b.pid - a.pid : a.pid - b.pid;
          break;
        case 'cpu':
          delta = compareUnknown(a.cpu_percent, b.cpu_percent);
          break;
        case 'memory':
          delta = compareUnknown(a.rss_kib, b.rss_kib);
          break;
        case 'pss':
          delta = compareUnknown(a.pss_kib, b.pss_kib);
          break;
      }
      return delta || a.pid - b.pid;
    });
}

export function percentUsed(total: number | null, available: number | null): number | null {
  if (total === null || available === null || total <= 0 || available > total) return null;
  return Math.floor(100 * (total - available) / total);
}

/** Unrounded-to-integer utilization for actual chart traces.
 * The headline status still uses whole percentages, but per-pulse RAM
 * changes of 0.1% must not disappear from its time series.
 */
export function percentUsedPrecise(total: number | null, available: number | null): number | null {
  if (total === null || available === null ||
      !Number.isFinite(total) || !Number.isFinite(available) ||
      total <= 0 || available < 0 || available > total) return null;
  return Math.round((100 * (total - available) / total) * 100) / 100;
}

/** Percentage for compact telemetry labels, without pretending a small
 * but nonzero swap allocation is 0%. This does not alter pressure thresholds.
 */
export function usageLabel(total: number | null, available: number | null): string {
  if (total === null || available === null || total < 0 || available < 0 ||
      available > total) return 'UNAVAILABLE';
  if (total === 0) return 'NOT CONFIGURED';
  const used = 100 * (total - available) / total;
  if (used === 0) return '0%';
  if (used < 0.1) return '<0.1%';
  if (used < 1) return used.toFixed(1) + '%';
  return Math.round(used) + '%';
}

export function bytesLabel(kib: number): string {
  return kib >= 1_048_576 ? (kib / 1_048_576).toFixed(1) + ' GiB' : Math.round(kib / 1024) + ' MiB';
}

export function temperatureLabel(celsius: number | null): string {
  return celsius === null ? 'UNAVAILABLE' : celsius.toFixed(1) + ' °C';
}

export function processMemoryLabel(kib: number | null): string {
  if (kib === null) return '—';
  return kib < 1024 ? kib + ' KiB' : bytesLabel(kib);
}

export function fractionLabel(total: number | null, available: number | null): string {
  return total === null || available === null || available > total ? 'UNAVAILABLE'
    : bytesLabel(total - available) + ' / ' + bytesLabel(total);
}

export function systemHeadline(metrics: SystemMetrics | null, core: boolean, niri: boolean): string {
  if (!core) return 'CORE OFFLINE';
  if (!niri) return 'NIRI DISCONNECTED';
  if (!metrics) return 'MEASURING';
  if ((percentUsed(metrics.root_total_kib, metrics.root_available_kib) ?? 0) >= 90) return 'LOW STORAGE';
  if ((percentUsed(metrics.memory_total_kib, metrics.memory_available_kib) ?? 0) >= 90) return 'MEMORY PRESSURE';
  if (metrics.battery_percent !== null && metrics.battery_percent <= 15 && metrics.battery_charging === false) return 'LOW BATTERY';
  if (metrics.cpu_percent !== null && metrics.cpu_percent >= 95) return 'SYSTEM BUSY';
  if (metrics.cpu_percent === null || percentUsed(metrics.memory_total_kib, metrics.memory_available_kib) === null) return 'MEASURING';
  if (metrics.root_total_kib === null) return 'PARTIAL DATA';
  return 'ALL SYSTEMS NOMINAL';
}

export function uptimeLabel(seconds: number | null): string {
  if (seconds === null) return 'UNAVAILABLE';
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor((seconds % 86400) / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  return (days ? days + 'd ' : '') + hours + 'h ' + minutes + 'm';
}

FILE	frontend/src/lib/themes/kira-default.css
/* Kira Default: Black / Prussian Blue / Orange / Alabaster Grey / White.
 * Exactly five canonical opaque colors; all other tones are derived.
 */
:root {
  color-scheme: dark;

  --black: #000000ff;
  --prussian-blue: #14213dff;
  --orange: #fca311ff;
  --alabaster-grey: #e5e5e5ff;
  --white: #ffffffff;

  --kira-color-background: var(--black);
  --kira-color-surface: var(--prussian-blue);
  --kira-color-muted: var(--alabaster-grey);
  --kira-color-accent: var(--orange);
  --kira-color-text: var(--white);
  /* Legacy alias retained for external widgets; prefer --kira-color-border. */
  --kira-color-earth: var(--prussian-blue);

  --kira-color-on-accent: var(--black);
  --kira-color-text-secondary: var(--alabaster-grey);
  --kira-color-surface-subtle: color-mix(in srgb, var(--prussian-blue) 75%, var(--black));
  --kira-color-border: color-mix(in srgb, var(--prussian-blue) 50%, var(--alabaster-grey));

  --kira-space-1: 4px;
  --kira-space-2: 8px;
  --kira-space-3: 12px;
  --kira-space-4: 16px;
  --kira-space-5: 20px;
  --kira-space-6: 24px;

  --kira-radius-sm: 6px;
  --kira-radius-md: 10px;
  --kira-radius-lg: 14px;

  /* Neo-brutalist construction: clear borders and hard, offset depth. */
  --kira-border-strong: 2px;
  --kira-shadow-brutal: 3px 3px 0 color-mix(in srgb, var(--prussian-blue) 50%, var(--alabaster-grey));
  --kira-shadow-panel: 8px 8px 0 color-mix(in srgb, var(--prussian-blue) 60%, var(--alabaster-grey));

  --kira-motion-fast: 120ms;
  --kira-motion-standard: 180ms;
  --kira-motion-easing: cubic-bezier(0.2, 0.8, 0.2, 1);
}

@media (prefers-reduced-motion: reduce) {
  :root {
    --kira-motion-fast: 0ms;
    --kira-motion-standard: 0ms;
  }
}

FILE	frontend/src/lib/themes/kira-default.test.ts
import { readFileSync } from 'node:fs';
import { describe, expect, it } from 'vitest';
import { kiraDefaultPalette, kiraDefaultRoles } from './kira-default';

const css = readFileSync(new URL('./kira-default.css', import.meta.url), 'utf8');
const html = readFileSync(new URL('../../../index.html', import.meta.url), 'utf8');

function luminance(hex: string): number {
  const channels = [1, 3, 5]
    .map((index) => parseInt(hex.slice(index, index + 2), 16) / 255)
    .map((value) => value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4);
  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];
}

function contrast(first: string, second: string): number {
  const light = Math.max(luminance(first), luminance(second));
  const dark = Math.min(luminance(first), luminance(second));
  return (light + 0.05) / (dark + 0.05);
}

describe('Kira Default Black / Prussian Blue / Orange design tokens', () => {
  it('contains exactly the five approved canonical base colors', () => {
    expect(Object.values(kiraDefaultPalette)).toEqual([
      '#000000ff', '#14213dff', '#fca311ff', '#e5e5e5ff', '#ffffffff',
    ]);
    expect(new Set(Object.values(kiraDefaultPalette)).size).toBe(5);
  });

  it('keeps exactly five canonical RGBA hex tokens synchronized', () => {
    const names = {
      black: 'black',
      prussianBlue: 'prussian-blue',
      orange: 'orange',
      alabasterGrey: 'alabaster-grey',
      white: 'white',
    } as const;
    for (const role of Object.keys(names) as Array<keyof typeof names>) {
      expect(css).toContain('--' + names[role] + ': ' + kiraDefaultPalette[role] + ';');
    }
    const colors = [...css.matchAll(/#[0-9a-f]{8}\b/g)].map((match) => match[0]);
    expect(colors).toHaveLength(5);
    expect(new Set(colors)).toEqual(new Set(Object.values(kiraDefaultPalette)));
    expect(css).not.toMatch(/#[0-9a-f]{6}(?![0-9a-f])/);
  });

  it('maps semantic tokens to canonical colors', () => {
    const aliases = {
      background: '--black',
      surface: '--prussian-blue',
      muted: '--alabaster-grey',
      accent: '--orange',
      text: '--white',
      earth: '--prussian-blue', // legacy alias for compatibility
    } as const;
    const source = {
      '--black': 'black',
      '--prussian-blue': 'prussianBlue',
      '--orange': 'orange',
      '--alabaster-grey': 'alabasterGrey',
      '--white': 'white',
    } as const;
    for (const role of Object.keys(aliases) as Array<keyof typeof aliases>) {
      const base = aliases[role];
      expect(css).toContain('--kira-color-' + role + ': var(' + base + ');');
      expect(kiraDefaultRoles[role]).toBe(kiraDefaultPalette[source[base]]);
    }
    expect(css).toContain('--kira-color-on-accent: var(--black);');
  });

  it('uses WCAG AA text pairs, including black on Orange', () => {
    const { black, prussianBlue, orange, alabasterGrey, white } = kiraDefaultPalette;
    for (const [foreground, background] of [
      [white, black], [white, prussianBlue],
      [alabasterGrey, black], [alabasterGrey, prussianBlue],
      [orange, black], [orange, prussianBlue], [black, orange],
    ]) {
      expect(contrast(foreground, background)).toBeGreaterThanOrEqual(4.5);
    }
    expect(contrast(white, orange)).toBeLessThan(4.5);
    expect(kiraDefaultRoles.muted).toBe(alabasterGrey);
    expect(kiraDefaultRoles.accent).toBe(orange);
  });

  it('uses the default palette during pre-mount WebKit loading', () => {
    expect(html).toContain('<meta name="theme-color" content="' + kiraDefaultPalette.black + '"');
    expect(html).toContain('background:' + kiraDefaultPalette.black + ';');
    expect(html).toContain('color:' + kiraDefaultPalette.white + ';');
    expect(html).not.toContain('#22223b');
    expect(html).not.toContain('#f2e9e4');
  });

  it('defines compact spacing, consistent radii and reduced motion', () => {
    expect(css).toContain('--kira-space-1: 4px;');
    expect(css).toContain('--kira-radius-md: 10px;');
    expect(css).toContain('--kira-border-strong: 2px;');
    expect(css).toContain('--kira-shadow-brutal:');
    expect(css).toContain('--kira-shadow-panel:');
    expect(css).toContain('@media (prefers-reduced-motion: reduce)');
    expect(css).toContain('--kira-motion-fast: 0ms;');
  });
});

FILE	frontend/src/lib/themes/kira-default.ts
/** Canonical fully opaque Kira Default palette; CSS and GTK must match. */
export const kiraDefaultPalette = Object.freeze({
  black: '#000000ff',
  prussianBlue: '#14213dff',
  orange: '#fca311ff',
  alabasterGrey: '#e5e5e5ff',
  white: '#ffffffff',
} as const);

/** Semantic roles keep color usage accessible. The legacy earth role is
 * preserved as a structural alias for compatibility with older widgets.
 */
export const kiraDefaultRoles = Object.freeze({
  background: kiraDefaultPalette.black,
  surface: kiraDefaultPalette.prussianBlue,
  muted: kiraDefaultPalette.alabasterGrey,
  accent: kiraDefaultPalette.orange,
  text: kiraDefaultPalette.white,
  earth: kiraDefaultPalette.prussianBlue,
} as const);

export type KiraThemeRole = keyof typeof kiraDefaultRoles;

